   <text:p text:style-name="P19" loext:marker-style-name="T17"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T17">To configure the image and text on the Home screen, select </text:span><text:span text:style-name="T19">Screens</text:span><text:span text:style-name="T17"> from the tree view on the left of the KAB program window and select the </text:span><text:span text:style-name="T9">Home Screen</text:span><text:span text:style-name="T3"> tab. Follow the instructions on the screen.</text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T17"/>
   <text:h text:style-name="P55" text:outline-level="2" loext:marker-style-name="T17"><text:bookmark-start text:name="_Toc129968048"/><text:soft-page-break/><text:span text:style-name="T17">Setup Screen</text:span><text:bookmark-end text:name="_Toc129968048"/><text:span text:style-name="T17"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T17"><text:span text:style-name="T17">The Setup screen is shown after the user taps the </text:span><text:span text:style-name="T19">Set Up Keyboard</text:span><text:span text:style-name="T17"> button on the Home screen. It contains some introductory text and then two or three steps. </text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T17"/>
