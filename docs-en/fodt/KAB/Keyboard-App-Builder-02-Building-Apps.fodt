   <text:list text:continue-numbering="true" text:style-name="WWNum26">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P69" loext:marker-style-name="T24"><text:soft-page-break/><text:span text:style-name="T24">Tap on </text:span><text:span text:style-name="T27">Developer Options</text:span><text:span text:style-name="T24"> and ensure that it is turned on.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P69" loext:marker-style-name="T24"><text:span text:style-name="T24">Scroll down the Developer Options page and find </text:span><text:span text:style-name="T27">USB Debugging</text:span><text:span text:style-name="T24">. Enable this setting. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
