   <text:p text:style-name="P27" loext:marker-style-name="T17"/>
   <text:p text:style-name="P27" loext:marker-style-name="T17"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T17"><text:span text:style-name="T17">After completing each of the two or three steps, the keyboard is ready to be used in other apps such as WhatsApp, Gmail and Facebook.</text:span><text:span text:style-name="T17"/></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1" loext:marker-style-name="T17"><text:bookmark-start text:name="_Toc129968049"/><text:span text:style-name="T17">Navigation Drawer</text:span><text:bookmark-end text:name="_Toc129968049"/><text:bookmark-end text:name="_Toc498952700"/><text:bookmark-end text:name="_Toc500152989"/><text:span text:style-name="T17"/></text:h>
   <text:p text:style-name="P60" loext:marker-style-name="T31"/>
   <text:p text:style-name="P49" loext:marker-style-name="T11"><text:soft-page-break/><text:span text:style-name="T11">You can customise the image that appears at the top of the navigation drawer. It can be a photo, your organisation’s logo or any relevant graphic design.</text:span><text:span text:style-name="T11"/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T11"/>
   <text:p text:style-name="P18" loext:marker-style-name="T11"/>
