   <text:p text:style-name="P46" loext:marker-style-name="T24"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum26">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P69" loext:marker-style-name="T24"><text:span text:style-name="T24">Now return to the Configuration menu of your phone. Look for the Developer Options menu item. You might see </text:span><text:span text:style-name="T27">Developer Options</text:span><text:span text:style-name="T24"> above the </text:span><text:span text:style-name="T27">About Phone</text:span><text:span text:style-name="T24"> menu item. If you do not see it here, it could be in </text:span><text:span text:style-name="T27">System</text:span><text:span text:style-name="T24"> settings, under </text:span><text:span text:style-name="T27">Advanced</text:span><text:span text:style-name="T24">. Different phones place Developer Options in different places, so look around your Configuration menu until you find it.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T24"><draw:custom-shape text:anchor-type="char" draw:z-index="10" draw:name="Shape3" draw:style-name="gr3" draw:text-style-name="P122" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.45138888888889in 2.88541666666667in)">
