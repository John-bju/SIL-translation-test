   <text:p text:style-name="P13" loext:marker-style-name="T3"/>
   <text:p text:style-name="P4">You are free to print this manual for personal use and for training workshops.</text:p>
   <text:p text:style-name="P4"/>
   <text:p text:style-name="P4">The latest version is available at</text:p>
   <text:p text:style-name="P4" loext:marker-style-name="T3"><text:a xlink:type="simple" xlink:href="http://software.sil.org/keyboardappbuilder/resources/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T3">http://software.sil.org/keyboardappbuilder/resources/</text:span></text:span></text:a><text:span text:style-name="T3"> <text:s text:c="2"/></text:span></text:p>
   <text:p text:style-name="P13" loext:marker-style-name="T3"/>
   <text:p text:style-name="P4" loext:marker-style-name="T3"><text:span text:style-name="T3">and on the Help menu of Keyboard App Builder.</text:span><text:span text:style-name="T3"/></text:p>
