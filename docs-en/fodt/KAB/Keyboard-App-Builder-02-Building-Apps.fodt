   <text:p text:style-name="P25" loext:marker-style-name="T17"/>
   <text:p text:style-name="P25" loext:marker-style-name="T17"/>
   <text:p text:style-name="P12" loext:marker-style-name="T3"/>
   <text:p text:style-name="P59" loext:marker-style-name="T5"><text:span text:style-name="T5">Change Keyboard</text:span><text:span text:style-name="T5"/></text:p>
   <text:p text:style-name="P59" loext:marker-style-name="T3"><text:span text:style-name="T3">When the user taps the </text:span><text:span text:style-name="T9">Change Keyboard</text:span><text:span text:style-name="T3"> button, the phone’s </text:span><text:span text:style-name="T9">Change Keyboard</text:span><text:span text:style-name="T3"> dialog box will appear. They need to tap on the new keyboard to make it the current one.</text:span></text:p>
   <text:p text:style-name="P17" loext:marker-style-name="T3"/>
   <text:p text:style-name="P26" loext:marker-style-name="T17"/>
