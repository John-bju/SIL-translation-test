      <text:p text:style-name="P64" loext:marker-style-name="T46"><text:span text:style-name="T46">platform-tools</text:span><text:span text:style-name="T46"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B5" office:value-type="string">
      <text:p text:style-name="P64" loext:marker-style-name="T46"><text:span text:style-name="T46">Yes</text:span><text:span text:style-name="T46"/></text:p>
