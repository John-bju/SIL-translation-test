      <draw:handle draw:handle-range-x-maximum="?f1" draw:handle-range-x-minimum="0" draw:handle-position="?f5 0"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><draw:frame draw:style-name="fr1" draw:name="Picture 61" text:anchor-type="as-char" svg:width="6.2547in" svg:height="4.3209in" draw:z-index="0"><draw:image xlink:href="KAB03/4.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Table

Description automatically generated</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P26" loext:marker-style-name="T15"/>
   <text:p text:style-name="P26" loext:marker-style-name="T15"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum28">
    <text:list-item>
     <text:p text:style-name="P140" loext:marker-style-name="T15"><text:soft-page-break/><text:span text:style-name="T15">Follow the instructions on each page of the </text:span><text:span text:style-name="T24">Install Android SDK</text:span><text:span text:style-name="T15"> wizard to download each of the Android SDK packages and install them.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P27" loext:marker-style-name="T15"/>
   <text:p text:style-name="P59" loext:marker-style-name="T15"><text:span text:style-name="T15">When you are asked to specify a target folder, a good place is:</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P59" loext:marker-style-name="T15"><text:span text:style-name="T15"><text:s text:c="8"/></text:span><text:span text:style-name="T23">/Users/</text:span><text:span text:style-name="T18">your-name</text:span><text:span text:style-name="T23">/Android-SDK</text:span><text:span text:style-name="T15">.</text:span></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T15"/>
   <text:p text:style-name="P63" loext:marker-style-name="T15"><text:span text:style-name="T15">Four packages will be downloaded and installed:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum41">
    <text:list-item>
     <text:p text:style-name="P86" loext:marker-style-name="T15"><text:span text:style-name="T15">Command line tools, </text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P86" loext:marker-style-name="T15"><text:span text:style-name="T15">Build Tools, </text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P86" loext:marker-style-name="T15"><text:span text:style-name="T15">Platform Tools, and </text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P86" loext:marker-style-name="T15"><text:span text:style-name="T15">Platform API.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P27" loext:marker-style-name="T15"/>
   <text:p text:style-name="P57" loext:marker-style-name="T15"><text:span text:style-name="T15">If the installation was successful, you will see the version numbers displayed in green.</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P4" loext:marker-style-name="T36"><draw:frame draw:style-name="fr1" draw:name="Picture 62" text:anchor-type="as-char" svg:width="6.2547in" svg:height="4.3209in" draw:z-index="0"><draw:image xlink:href="KAB03/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Graphical user interface, application, table

Description automatically generated</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T15"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">If any of the Build Tools, Platform Tools or Platform API is listed as “Not Found” (displayed in red), click the </text:span><text:span text:style-name="T24">Install Packages</text:span><text:span text:style-name="T15"> button to install them.</text:span></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T15"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">Click the </text:span><text:span text:style-name="T24">Check Installation</text:span><text:span text:style-name="T15"> button to confirm that all the packages have been installed correctly.<text:line-break/></text:span></text:p>
   <text:h text:style-name="Heading_20_3" text:outline-level="3" loext:marker-style-name="T15"><text:bookmark-start text:name="_Toc78622944"/><text:bookmark-start text:name="_Toc228363879"/><text:bookmark-start text:name="_Toc77851810"/><text:span text:style-name="T15">Copying the Android SDK files from someone else</text:span><text:bookmark-end text:name="_Toc78622944"/><text:bookmark-end text:name="_Toc228363879"/><text:bookmark-end text:name="_Toc77851810"/><text:span text:style-name="T15"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">If you know someone who has already downloaded and installed the Android SDK and is successfully building apps with it, you can copy all of their Android SDK files to a folder on your computer.</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T15"><text:span text:style-name="T15">You need to look for the top-level Android SDK folder, such as </text:span><text:span text:style-name="T23">/Users/</text:span><text:span text:style-name="T18">user-name</text:span><text:span text:style-name="T23">/Android-SDK</text:span><text:span text:style-name="T15">, and copy the whole folder and its contents to your computer. A location such as </text:span><text:span text:style-name="T23">/Users/</text:span><text:span text:style-name="T18">your-name</text:span><text:span text:style-name="T23">/Android-SDK</text:span><text:span text:style-name="T15"> is good. If it makes it easier, you can zip the folders and then unzip them onto your computer.</text:span></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T15"><text:span text:style-name="T15">Note that there is </text:span><text:span text:style-name="T25">no setup program to run</text:span><text:span text:style-name="T15">. Copying the files from one computer to another is sufficient.</text:span></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T15"/>
   <text:p text:style-name="P34" loext:marker-style-name="T15"><text:span text:style-name="T23">Tip</text:span><text:span text:style-name="T15">: A typical Android SDK folder can be quite large (over 1 GB, depending on which additional packages have been installed). To build an app, you do not actually need all of the </text:span><text:span text:style-name="T15">Android SDK files. If you want to cut down the number of files, here is a list of the essential and optional folders:</text:span></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T15"/>
   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A"/>
    <table:table-column table:style-name="Table1.B"/>
    <table:table-header-rows>
