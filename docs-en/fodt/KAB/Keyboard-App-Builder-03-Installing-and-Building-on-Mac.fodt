     </table:table-cell>
     <table:table-cell table:style-name="Table1.B8" office:value-type="string">
      <text:p text:style-name="P64" loext:marker-style-name="T46"><text:span text:style-name="T46">No, unless you want to use an emulator</text:span><text:span text:style-name="T46"/></text:p>
