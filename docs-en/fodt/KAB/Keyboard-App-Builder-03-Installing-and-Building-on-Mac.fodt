     </table:table-cell>
     <table:table-cell table:style-name="Table1.B4" office:value-type="string">
      <text:p text:style-name="P64" loext:marker-style-name="T46"><text:span text:style-name="T46">Yes <text:s/>(you only need android-30 for now)</text:span><text:span text:style-name="T46"/></text:p>
