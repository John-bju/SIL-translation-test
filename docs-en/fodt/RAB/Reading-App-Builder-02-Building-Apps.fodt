     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T104"><text:a xlink:type="simple" xlink:href="#_Toc233660022" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.7.<text:span text:style-name="T108"><text:tab/></text:span><text:span text:style-name="T36">Do I have to create a new keystore for each app?</text:span><text:span text:style-name="T118"><text:tab/>28</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T104"><text:a xlink:type="simple" xlink:href="#_Toc233660023" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.8.<text:span text:style-name="T108"><text:tab/></text:span><text:span text:style-name="T36">How can I include pictures in my apps?</text:span><text:span text:style-name="T118"><text:tab/>28</text:span></text:a></text:p>
