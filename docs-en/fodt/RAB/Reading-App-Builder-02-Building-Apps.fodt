   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame33" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="203" loext:may-break-between-pages="true">
