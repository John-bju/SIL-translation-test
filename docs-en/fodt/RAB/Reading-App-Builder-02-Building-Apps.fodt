   <text:p text:style-name="P54" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum39">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P373" loext:marker-style-name="T36"><text:span text:style-name="T36">Now return to the Configuration menu of your phone. Look for the Developer Options menu item. You might see </text:span><text:span text:style-name="T48">Developer Options</text:span><text:span text:style-name="T36"> above the </text:span><text:span text:style-name="T48">About Phone</text:span><text:span text:style-name="T36"> menu item. If you do not see it here, it could be in </text:span><text:span text:style-name="T48">System</text:span><text:span text:style-name="T36"> settings, under </text:span><text:span text:style-name="T48">Advanced</text:span><text:span text:style-name="T36">. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P172" loext:marker-style-name="T130"/>
   <table:table table:name="Table16" table:style-name="Table16">
    <table:table-column table:style-name="Table16.A"/>
    <table:table-column table:style-name="Table16.B"/>
    <table:table-row table:style-name="Table16.1">
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="P90" loext:marker-style-name="T3"><text:span text:style-name="T59"></text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.B1" office:value-type="string">
      <text:p text:style-name="P90" loext:marker-style-name="T79"><text:span text:style-name="T79">If you have trouble finding the Developer Options, search for “</text:span><text:span text:style-name="T83">Developer Options</text:span><text:span text:style-name="T79">” in the settings Search bar. You can even just search for “</text:span><text:span text:style-name="T83">USB Debugging</text:span><text:span text:style-name="T79">” to go directly to that setting.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P86" loext:marker-style-name="T53"/>
   <text:p text:style-name="P173" loext:marker-style-name="T36"><text:span text:style-name="T36">Different phones place Developer Options in different places, so look around your Configuration menu until you find it (see image below).</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T36"><draw:custom-shape text:anchor-type="char" draw:z-index="185" draw:name="AutoShape 160" draw:style-name="gr1" draw:text-style-name="P702" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (3.81944444444444in 2.11111111111111in)">
     <svg:desc>P655#y1</svg:desc>
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
