       <text:p text:style-name="P373" loext:marker-style-name="T36"><text:span text:style-name="T36">Tap on </text:span><text:span text:style-name="T48">Developer Options</text:span><text:span text:style-name="T36"> and ensure that it is turned on.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P373" loext:marker-style-name="T36"><text:span text:style-name="T36">Scroll down the Developer Options page and find </text:span><text:span text:style-name="T48">USB Debugging</text:span><text:span text:style-name="T36">. Enable this setting. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
