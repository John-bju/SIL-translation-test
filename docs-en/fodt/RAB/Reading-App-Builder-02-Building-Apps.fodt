        </table:table-cell>
        <table:table-cell table:style-name="Table51.B5" office:value-type="string">
         <text:p text:style-name="P93" loext:marker-style-name="T36"><text:span text:style-name="T36">ui.bottom-navigation.item.icon</text:span></text:p>
