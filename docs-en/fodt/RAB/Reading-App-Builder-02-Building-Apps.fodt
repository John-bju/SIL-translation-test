   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P674" loext:marker-style-name="T18"><text:span text:style-name="T18">Type the style name into the dialog box and press OK.</text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P119" loext:marker-style-name="T15"><text:span text:style-name="T15">Do this for c, s, q1 and q2.</text:span><text:span text:style-name="T15"/></text:p>
   <text:list xml:id="list215634144252643" text:continue-list="list215634994095507" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P671" loext:marker-style-name="T15"><text:span text:style-name="T15">Apply the above styles to all the page numbers, song titles and the lines of the song lyrics. </text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P119" loext:marker-style-name="T15"><text:span text:style-name="T15">To apply a style:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P675" loext:marker-style-name="T15"><text:span text:style-name="T15">Select the line/paragraph to which you want to apply the style.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P675" loext:marker-style-name="T15"><text:span text:style-name="T15">Click on the down arrow to the right of the styles ribbon.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P301" loext:marker-style-name="T15"><draw:custom-shape text:anchor-type="char" draw:z-index="7" draw:name="AutoShape 149" draw:style-name="gr8" draw:text-style-name="P702" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (4.10833333333333in 1.53125in)">
     <svg:desc>P3062#y1</svg:desc>
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
