   <text:list text:continue-numbering="true" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P656" loext:marker-style-name="T15"><text:span text:style-name="T15">Insert a page break after the text using </text:span><text:span text:style-name="T21">CTRL+Enter</text:span><text:span text:style-name="T15">, or </text:span><text:span text:style-name="T21">Insert</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T68"></text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T21">Page Break</text:span><text:span text:style-name="T15">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P654" loext:marker-style-name="T15"><text:span text:style-name="T15">Insert a picture at the top of the second page and place the story text under it.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P654" loext:marker-style-name="T15"><text:span text:style-name="T15">Insert a page break after the text using </text:span><text:span text:style-name="T21">CTRL+Enter</text:span><text:span text:style-name="T15">, or </text:span><text:span text:style-name="T21">Insert</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T68"></text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T21">Page Break</text:span><text:span text:style-name="T15">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P654" loext:marker-style-name="T15"><text:span text:style-name="T15">Continue adding additional pages in this way.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P654" loext:marker-style-name="T15"><text:span text:style-name="T15">Save the document in </text:span><text:span text:style-name="T21">.docx</text:span><text:span text:style-name="T15"> format.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T15"/>
   <text:p text:style-name="P25" loext:marker-style-name="T15"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T17"><text:span text:style-name="T17">You can add images to the document in .jpeg, .jpg, .png, .tif or .gif formats and Microsoft Word will convert them automatically to the format recognised by Reading App Builder.</text:span><text:span text:style-name="T17"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T15"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">If you have large image files it is best to resize them. You can do this either before adding them to the document or within Word itself:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P658" loext:marker-style-name="T15"><text:span text:style-name="T15">Select one of the images in Word.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P660" loext:marker-style-name="T15"><text:span text:style-name="T15">Click </text:span><text:span text:style-name="T21">Compress Pictures</text:span><text:span text:style-name="T15"> on the picture format ribbon or toolbar.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P660" loext:marker-style-name="T15"><text:soft-page-break/><text:span text:style-name="T15">Select </text:span><text:span text:style-name="T21">All Pictures in document</text:span><text:span text:style-name="T15">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P660" loext:marker-style-name="T15"><text:span text:style-name="T15">Select the resolution as </text:span><text:span text:style-name="T21">Web/Screen</text:span><text:span text:style-name="T15">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T15"/>
