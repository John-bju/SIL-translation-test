   <text:p text:style-name="P75" loext:marker-style-name="T36"><text:span text:style-name="T36">To select a border from the border gallery:</text:span><text:span text:style-name="T36"/></text:p>
   <text:list text:style-name="WWNum17">
    <text:list-item>
     <text:p text:style-name="P586" loext:marker-style-name="T36"><text:span text:style-name="T36">Click </text:span><text:span text:style-name="T47">Choose from Gallery…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P586" loext:marker-style-name="T36"><text:span text:style-name="T36">Select an image from the gallery and click OK.</text:span><text:span text:style-name="T36"/></text:p>
    </text:list-item>
   </text:list>
