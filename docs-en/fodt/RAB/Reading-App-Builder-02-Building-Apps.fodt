   <text:list xml:id="list215634994095507" text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P670" loext:marker-style-name="T15"><text:span text:style-name="T15">Create the following paragraph styles:</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
