   </table:table>
   <text:p text:style-name="P119" loext:marker-style-name="T15"><text:span text:style-name="T15">To create a style:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P674" loext:marker-style-name="T15"><text:span text:style-name="T15">Select the line/paragraph of text that corresponds to this style, i.e. if you are creating the style ‘c’, select one of the lines with a song number. If you are creating the style ‘q1’, select a line of the song lyrics.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P674" loext:marker-style-name="T15"><text:span text:style-name="T15">Click on the down arrow to the right of the styles ribbon.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
