   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">There are six possible elements to link to:</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">Contents</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">This displays the contents menu screen, if there is one.</text:p>
   <text:p text:style-name="P159"/>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">Book</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">This will display the last, current book being viewed, or can display any book in the app. When adding the button you can specify the target book to open or modify it later under the button’s <text:span text:style-name="T46">Book</text:span> tab.</text:p>
   <text:p text:style-name="P152" loext:marker-style-name="T46"/>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">Search</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">If the Search function is enabled, this open the search screen.</text:p>
   <text:p text:style-name="P159"/>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">News</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">If you have a News Feed enabled, you can point to it here.</text:p>
   <text:p text:style-name="P159"/>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">Settings</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">This will display the settings screen, allowing the user to modify the app settings.</text:p>
   <text:p text:style-name="P159"><text:soft-page-break/></text:p>
   <text:p text:style-name="P159" loext:marker-style-name="T46"><text:span text:style-name="T46">About</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="P159">This will display the About box.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame9" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="3" loext:may-break-between-pages="true">
