   <text:h text:style-name="P262" text:outline-level="2"><text:bookmark text:name="_Annotations_Styles"/><text:bookmark-start text:name="_Toc233660285"/>Annotations Styles<text:bookmark-end text:name="_Toc233660285"/></text:h>
