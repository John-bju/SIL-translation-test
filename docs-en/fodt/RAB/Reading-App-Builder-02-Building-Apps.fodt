     </table:table-cell>
     <table:table-cell table:style-name="Table77.B5" office:value-type="string">
      <text:p text:style-name="P300" loext:marker-style-name="T15"><text:span text:style-name="T15">Line of a chorus (more indentation)</text:span><text:span text:style-name="T15"/></text:p>
