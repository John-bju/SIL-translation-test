   <text:p text:style-name="P75" loext:marker-style-name="T36"><text:span text:style-name="T36">To add your own border:</text:span><text:span text:style-name="T36"/></text:p>
   <text:list text:style-name="WWNum33">
    <text:list-item>
     <text:p text:style-name="P587" loext:marker-style-name="T36"><text:span text:style-name="T36">Create the border as an image file (JPEG or PNG) in portrait orientation. Ensure that the middle rectangular area of the image is blank. This blank area is where the text will be displayed.</text:span><text:span text:style-name="T36"/></text:p>
    </text:list-item>
   </text:list>
