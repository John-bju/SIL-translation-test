     <table:table-cell table:style-name="Table77.B3" office:value-type="string">
      <text:p text:style-name="P299" loext:marker-style-name="T15"><text:span text:style-name="T15">Song title</text:span><text:span text:style-name="T15"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table77.4">
