   <text:p text:style-name="P87" loext:marker-style-name="T30"/>
   <text:p text:style-name="P87" loext:marker-style-name="T30"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum28">
    <text:list-item>
     <text:p text:style-name="P217" loext:marker-style-name="T30"><text:span text:style-name="T30">Follow the instructions on each page of the </text:span><text:span text:style-name="T36">Install Android SDK</text:span><text:span text:style-name="T30"> wizard to download each of the Android SDK packages and install them.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P88" loext:marker-style-name="T30"/>
   <text:p text:style-name="P78" loext:marker-style-name="T30"><text:span text:style-name="T30">When you are asked to specify a target folder, a good place is:</text:span><text:span text:style-name="T30"/></text:p>
   <text:p text:style-name="P78" loext:marker-style-name="T30"><text:span text:style-name="T30"><text:s text:c="8"/></text:span><text:span text:style-name="T35">/Users/</text:span><text:span text:style-name="T42">your-name</text:span><text:span text:style-name="T35">/Android-SDK</text:span><text:span text:style-name="T30">.</text:span></text:p>
   <text:p text:style-name="P89" loext:marker-style-name="T30"/>
   <text:p text:style-name="P94" loext:marker-style-name="T30"><text:span text:style-name="T30">Four packages will be downloaded and installed:</text:span><text:span text:style-name="T30"/></text:p>
   <text:list text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P136" loext:marker-style-name="T30"><text:span text:style-name="T30">Command line tools, </text:span><text:span text:style-name="T30"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P136" loext:marker-style-name="T30"><text:span text:style-name="T30">Build Tools, </text:span><text:span text:style-name="T30"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P136" loext:marker-style-name="T30"><text:span text:style-name="T30">Platform Tools, and </text:span><text:span text:style-name="T30"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P136" loext:marker-style-name="T30"><text:span text:style-name="T30">Platform API.</text:span><text:span text:style-name="T30"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P88" loext:marker-style-name="T30"/>
   <text:p text:style-name="P76" loext:marker-style-name="T30"><text:span text:style-name="T30">If the installation was successful, you will see the version numbers displayed in green.</text:span><text:span text:style-name="T30"/></text:p>
   <text:p text:style-name="P87" loext:marker-style-name="T30"/>
