         9fyYwHopbGkqfiV1GxPPn0eY+HF0mL05hAwRiSsGrg8jbhSIQazVNcUKQgRXDFwfX1svMFd2
         U4CHLalRoKkXsFHYrr8YNTM0itrRt1xDO8g5jpYgV5V/jTW9pL+AAsrYa3St8QAAAABJRU5E
         rkJggg==
        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T52"> button to the right of the </text:span><text:span text:style-name="T48">Devices</text:span><text:span text:style-name="T52"> header.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P242" loext:marker-style-name="T52">In the section <text:span text:style-name="T46">Register a Device</text:span>, enter a name of the device (such as “John Smith’s iPhone”) and its UDID (unique device identifier, a sequence of 40 letters and numbers). Press <text:span text:style-name="T46">Continue</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P242" loext:marker-style-name="T52"><text:span text:style-name="T52">On the next page, check that the device information is displayed correctly and click </text:span><text:span text:style-name="T48">Register</text:span><text:span text:style-name="T52"> to confirm.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P80" loext:marker-style-name="T52"><text:span text:style-name="T52">Note that you can register up to 100 devices of each type (e.g. up to 100 iPhones, 100 iPads) per year of your Apple Developer Program membership. You can remove devices that you no longer need at the beginning of the next membership year.</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="P41" loext:marker-style-name="T52"/>
   <text:p text:style-name="P55" loext:marker-style-name="T52"><text:soft-page-break/><text:span text:style-name="T52">To create a </text:span><text:span text:style-name="T75">provisioning profile</text:span><text:span text:style-name="T52">:</text:span></text:p>
   <text:list text:style-name="WWNum18">
    <text:list-item>
     <text:p text:style-name="P243" loext:marker-style-name="T52"><text:span text:style-name="T52">Select </text:span><text:span text:style-name="T48">Profiles</text:span><text:span text:style-name="T52"> on the left of the page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P243" loext:marker-style-name="T52"><text:span text:style-name="T52">Click the</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 34" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
        <office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABwAAAAiCAYAAABMfblJAAAK3GlDQ1BJQ0MgUHJvZmlsZQAA
