   <text:h text:style-name="P61" text:outline-level="2"><text:bookmark-start text:name="_Toc228354449"/>Manually Installing Apps into the Simulator<text:bookmark-end text:name="_Toc228354449"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T14"><text:span text:style-name="T14">If there is some problem with launching the simulator from the </text:span><text:span text:style-name="T15">Run iOS Simulator</text:span><text:span text:style-name="T14"> dialog, you can manually install the app by dragging the built app from the Simulator output folder (found in ~/App Builder/Reading Apps/Sim Output) onto the Simulator. <text:s/>To start the Simulator, launch </text:span><text:span text:style-name="T15">Xcode</text:span><text:span text:style-name="T14"> and from the </text:span><text:span text:style-name="T15">Xcode</text:span><text:span text:style-name="T14"> menu select </text:span><text:span text:style-name="T15">Open Developer Tool</text:span><text:span text:style-name="T14"> </text:span><text:span text:style-name="T57"></text:span><text:span text:style-name="T14"> </text:span><text:span text:style-name="T15">Simulator</text:span><text:span text:style-name="T14">. <text:s/>You will still need to rebuild the app from the </text:span><text:span text:style-name="T15">Run iOS Simulator</text:span><text:span text:style-name="T14"> dialog.</text:span></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T14"/>
   <text:p text:style-name="P24" loext:marker-style-name="T14"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228354450"/>Creating iOS Certificates and Provisioning<text:bookmark-end text:name="_Toc475369919"/> Profiles<text:bookmark-end text:name="_Toc228354450"/></text:h>
   <text:h text:style-name="P61" text:outline-level="2"><text:bookmark-start text:name="_Toc228354451"/><text:bookmark-start text:name="OLE_LINK11"/>Enroll in the Apple Developer Program<text:bookmark-end text:name="_Toc228354451"/><text:bookmark-end text:name="OLE_LINK11"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">To build iOS apps and distribute them through the Apple App Store, you will need to be enrolled in the Apple Developer Program. You can do this as either (i) an individual, or (ii) an organisation. The cost is USD $99 per year.</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="P50" loext:marker-style-name="T52"><text:span text:style-name="T52">To enroll:</text:span><text:span text:style-name="T52"/></text:p>
   <text:list text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P146" loext:marker-style-name="T52"><text:bookmark-start text:name="OLE_LINK10"/><text:span text:style-name="T52">Go to </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/programs/enroll/" text:style-name="ListLabel_20_400" text:visited-style-name="ListLabel_20_400"><text:span text:style-name="T73">https://developer.apple.com/programs/enroll/</text:span></text:a><text:bookmark-end text:name="OLE_LINK10"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P147" loext:marker-style-name="T52"><text:soft-page-break/><text:span text:style-name="T52">Press the </text:span><text:span text:style-name="T48">Start Your Enrollment</text:span><text:span text:style-name="T52"> button to start.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P39" loext:marker-style-name="T52"/>
   <text:h text:style-name="P62" text:outline-level="2"><text:bookmark-start text:name="_Toc228354452"/>Create Signing Certificate<text:bookmark-end text:name="_Toc228354452"/></text:h>
   <text:p text:style-name="P102" loext:marker-style-name="T52"><text:span text:style-name="T52">When you create an iOS app, it needs to be signed with a certificate. </text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T52"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">To create a certificate:</text:span><text:span text:style-name="T52"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P236" loext:marker-style-name="T52"><text:span text:style-name="T52">Go to the </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Apple Developer</text:span></text:span></text:a><text:span text:style-name="T52"> website and log in to your account if you are not already.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P236" loext:marker-style-name="T52"><text:span text:style-name="T52">Select </text:span><text:span text:style-name="T48">Certificates, Identifiers &amp; Profiles</text:span><text:span text:style-name="T52">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P236" loext:marker-style-name="T52"><text:span text:style-name="T52">Click the</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 27" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
