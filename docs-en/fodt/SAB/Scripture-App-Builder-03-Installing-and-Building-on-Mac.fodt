     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354112" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.<text:span text:style-name="T22"><text:tab/></text:span>Installing Scripture App Builder<text:span text:style-name="T27"><text:tab/>6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354113" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.<text:span text:style-name="T22"><text:tab/></text:span>Installing Prerequisites for Android<text:span text:style-name="T27"><text:tab/>6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354114" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.1.<text:span text:style-name="T23"><text:tab/></text:span>Java Development Kit (JDK)<text:span text:style-name="T27"><text:tab/>7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354115" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.</text:span><text:span text:style-name="T23"><text:tab/></text:span><text:span text:style-name="T3">Installing Android Software Development Kit (SDK)</text:span><text:span text:style-name="T27"><text:tab/>8</text:span></text:a></text:p>
     <text:p text:style-name="P23" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354116" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.1.</text:span><text:span text:style-name="T23"><text:tab/></text:span><text:span text:style-name="T3">Downloading the Android SDK packages from the internet</text:span><text:span text:style-name="T27"><text:tab/>9</text:span></text:a></text:p>
