     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354118" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.<text:span text:style-name="T22"><text:tab/></text:span>Installing Prerequisites for iOS<text:span text:style-name="T27"><text:tab/>11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354119" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>4.1.<text:span text:style-name="T23"><text:tab/></text:span>Install Xcode<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354120" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.2.<text:span text:style-name="T23"><text:tab/></text:span>Verify Xcode Installation<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354121" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.3.<text:span text:style-name="T23"><text:tab/></text:span>Install Transporter<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
