   <text:p text:style-name="P29" loext:marker-style-name="T31"/>
   <text:p text:style-name="P30" loext:marker-style-name="T31"><text:span text:style-name="T31">Offline distribution</text:span><text:span text:style-name="T31"/></text:p>
