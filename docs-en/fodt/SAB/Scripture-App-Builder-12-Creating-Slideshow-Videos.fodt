     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T6"><text:a xlink:type="simple" xlink:href="#_Toc112848944" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.<text:span text:style-name="T6"><text:tab/></text:span>Running the Create Slideshow Wizard<text:span text:style-name="T7"><text:tab/>8</text:span></text:a></text:p>
