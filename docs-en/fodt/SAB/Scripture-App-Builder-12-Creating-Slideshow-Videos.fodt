   <text:p text:style-name="List_20_Paragraph"><text:line-break/><text:line-break/></text:p>
   <text:p text:style-name="List_20_Paragraph"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P56">Wait while the video is compiled. This will include extracting the audio, adding the images, applying the pan and zoom effects and creating the subtitles. </text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">When the videos have been created, you will find a subfolder corresponding to each video. </text:p>
