     <svg:desc>Graphical user interface, application

Description automatically generated</svg:desc>
    </draw:frame><text:line-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P56">Click <text:span text:style-name="T11">Next</text:span> and specify the <text:span text:style-name="T11">Titles Language</text:span>, <text:span text:style-name="T11">Language Name</text:span> and <text:span text:style-name="T11">Country</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P56">Click <text:span text:style-name="T11">Next</text:span> and specify the <text:span text:style-name="T11">Language Code</text:span>, text and audio <text:span text:style-name="T11">Copyright </text:span>information. </text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph"><text:line-break/>The Text and Audio copyright information will be inserted automatically from the <text:span text:style-name="T11">Copyright &amp; Licensing</text:span> tab if it is already specified in the app project. It can be to edited here too. This information will be included in the video title and final copyright slides.<text:line-break/></text:p>
   <text:p text:style-name="List_20_Paragraph"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P56"><text:soft-page-break/>Click <text:span text:style-name="T11">Next</text:span> and then the <text:span text:style-name="T11">Create Slideshows</text:span> button.</text:p>
    </text:list-item>
   </text:list>
