     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T8"><text:a xlink:type="simple" xlink:href="#_Toc112848939" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.3.<text:span text:style-name="T8"><text:tab/></text:span>What slideshow templates are currently available?<text:span text:style-name="T7"><text:tab/>5</text:span></text:a></text:p>
