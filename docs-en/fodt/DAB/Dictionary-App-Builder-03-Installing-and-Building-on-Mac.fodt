         DbEtxyVkCG+0CxyXIAgjhjfKkP8u0+cXf7C1OHDMhjq1R70VBOH6MGIZ1pK3tJrMyKaoHG5X
         9fyYwHopbGkqfiV1GxPPn0eY+HF0mL05hAwRiSsGrg8jbhSIQazVNcUKQgRXDFwfX1svMFd2
         U4CHLalRoKkXsFHYrr8YNTM0itrRt1xDO8g5jpYgV5V/jTW9pL+AAsrYa3St8QAAAABJRU5E
         rkJggg==
        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T18"> button to the right of the </text:span><text:span text:style-name="T46">Profiles</text:span><text:span text:style-name="T18"> header.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">On the </text:span><text:span text:style-name="T46">Register a New Provisioning Profile</text:span><text:span text:style-name="T18"> page, under </text:span><text:span text:style-name="T46">Distribution</text:span><text:span text:style-name="T18">, select </text:span><text:span text:style-name="T46">Ad Hoc</text:span><text:span text:style-name="T18"> (for testing) or </text:span><text:span text:style-name="T46">App Store</text:span><text:span text:style-name="T18"> (for submission to the App Store). Click </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18"> to move to the next page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">On the ‘Select an App ID’ page, select the App ID from the list of App IDs you have already defined. Click the </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">On the ‘Select Certificates’ page, select the certificate (Distribution) to include in the profile. Click the </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">If creating an AdHoc provisioning profile:<text:line-break/>On the ‘Select Devices’ page, check the device(s) that you want to be able to install and run the app. Click the </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">On the ‘Review, Name, and Generate’ page, give the profile a name of your choice. It is helpful to include “App Store” or “AdHoc” in the name. Click the </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T18"><text:span text:style-name="T18">On the ‘Download and Install’ page, click </text:span><text:span text:style-name="T46">Download</text:span><text:span text:style-name="T18"> to save your new .mobileprovision file to your computer. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P86" loext:marker-style-name="T18"><text:span text:style-name="T18">This is the Provisioning Profile file that you will select in Dictionary App Builder.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P89" loext:marker-style-name="T46"><text:span text:style-name="T46">Download existing mobile provision files</text:span><text:span text:style-name="T46"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">If other members of your team have already created provisioning profiles, there are several ways to download them. They can be downloaded from the App Developer website by selecting the profile to be downloaded and pressing the </text:span><text:span text:style-name="T46">Download</text:span><text:span text:style-name="T18"> button. <text:s/></text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="_q7i9umrolddd"/><text:bookmark-start text:name="_Toc475369921"/><text:bookmark-start text:name="_Toc228353920"/>Building an iOS App<text:bookmark-end text:name="_Toc475369921"/><text:bookmark-end text:name="_Toc228353920"/></text:h>
   <text:p text:style-name="P90" loext:marker-style-name="T23"><text:span text:style-name="T23">To build an iOS app:</text:span><text:span text:style-name="T23"/></text:p>
   <text:list text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T18"><text:span text:style-name="T18">Create a new app project following the instructions in the DAB </text:span><text:span text:style-name="T46">Building Apps</text:span><text:span text:style-name="T18"> document.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T18"><text:span text:style-name="T18">Select the </text:span><text:span text:style-name="T46">Signing (iOS)</text:span><text:span text:style-name="T18"> tab to open the iOS signing options for the app.<text:line-break/></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P92" loext:marker-style-name="T18"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="Picture 17" text:anchor-type="as-char" svg:width="5.6811in" svg:height="3.928in" draw:z-index="32"><draw:image xlink:href="DAB03/10.tif" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/tiff"/>
    </draw:frame></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T18"><text:span text:style-name="T18">Select the </text:span><text:span text:style-name="T46">Signing Identity</text:span><text:span text:style-name="T18"> from the drop-down list of signing certificates which have been downloaded and installed to this system in the earlier steps.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T18"><text:span text:style-name="T18">For the </text:span><text:span text:style-name="T46">Provisioning Profile </text:span><text:span text:style-name="T18">entry, enter or browse to the mobile provisioning file associated with the app that was downloaded in the earlier steps. <text:line-break/></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P35" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="Picture 3" text:anchor-type="as-char" svg:width="6.2681in" svg:height="3.3362in" draw:z-index="33"><draw:image xlink:href="DAB03/11.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
     <svg:desc>A screenshot of a dictionary

AI-generated content may be incorrect.</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P94" loext:marker-style-name="T18"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T18"><text:span text:style-name="T18">Click on the </text:span><text:span text:style-name="T46">IPA</text:span><text:span text:style-name="T18"> tab. <text:s/></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P79" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">This allows you to set the name of the ipa file to be generated as well as the build and version information.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P79" loext:marker-style-name="T18"><text:span text:style-name="T18">The </text:span><text:span text:style-name="T52">Filename</text:span><text:span text:style-name="T18"> field on the screen specifies the base name of the ipa file to be generated. <text:s/>If the checkbox at the bottom of the screen for </text:span><text:span text:style-name="T53">Append version name to ipa filename</text:span><text:span text:style-name="T18"> is checked, then the version indicated by the </text:span><text:span text:style-name="T53">Version Name</text:span><text:span text:style-name="T18"> fields is added to the base filename. <text:s/></text:span></text:p>
   <text:p text:style-name="P95" loext:marker-style-name="T18"><text:span text:style-name="T18">The </text:span><text:span text:style-name="T52">Build</text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T18">field referenced as </text:span><text:span text:style-name="T53">Build </text:span><text:span text:style-name="T18">is also called </text:span><text:span text:style-name="T53">Bundle Version String, Bundle Version</text:span><text:span text:style-name="T18"> or </text:span><text:span text:style-name="T53">CFBundleVersion</text:span><text:span text:style-name="T18"> within Xcode and ITunes Connect. It represents the build number. The </text:span><text:span text:style-name="T53">Build</text:span><text:span text:style-name="T18"> field expects an integer value and should be incremented with each file that is submitted to the ITunes Connect for release or testing. </text:span></text:p>
   <text:p text:style-name="P95" loext:marker-style-name="T18"><text:span text:style-name="T18">The </text:span><text:span text:style-name="T52">Version Name</text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T18">field is referenced as </text:span><text:span text:style-name="T53">Version, Bundle Short Version String, Bundle versions string, short </text:span><text:span text:style-name="T18">and </text:span><text:span text:style-name="T53">CFBundleShortVersionString </text:span><text:span text:style-name="T18">within Xcode and ITunes Connect. The field is created as a concatenation of the values of the three fields separated by a period. If the final field has a value of 0, then the version string is created from just the first two values. So for values of 1, 2 and 0, the resulting string is “1.2”. <text:s/>For values of 1, 2 and 3, the resulting version string is “1.2.3”.</text:span></text:p>
   <text:p text:style-name="P95" loext:marker-style-name="T18"><text:span text:style-name="T18">The </text:span><text:span text:style-name="T54">Apple ID</text:span><text:span text:style-name="T18"> field is the id assigned by App Store Connect to the application in the app store. <text:s/>It can be obtained from </text:span><text:span text:style-name="T24">Apple ID </text:span><text:span text:style-name="T18">filed on the App Information tab in the App Store Connect entry for the app.</text:span></text:p>
   <text:p text:style-name="P96" loext:marker-style-name="T24"><text:span text:style-name="T18">The </text:span><text:span text:style-name="T54">Bundle ID</text:span><text:span text:style-name="T18"> section allows the user to specify a Bundle ID for the app that is different than the package name. <text:s/>By default, the </text:span><text:span text:style-name="T54">Package Name </text:span><text:span text:style-name="T18">field from the </text:span><text:span text:style-name="T54">Package</text:span><text:span text:style-name="T18"> tab is used as the Application Bundle ID that is used in creating the provisioning profiles and as the application identifier for the Apple App Store. <text:s/>If the user wants the iOS version of the app to have an identifier that is different than the package name that is used for the Android version of the app, press the </text:span><text:span text:style-name="T54">Specify a Bundle ID</text:span><text:span text:style-name="T18"> button and then enter the ID to be used in the text box labelled </text:span><text:span text:style-name="T54">Bundle ID.</text:span></text:p>
   <text:p text:style-name="P97" loext:marker-style-name="T18"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P98" loext:marker-style-name="T18"><text:span text:style-name="T18">Click on the </text:span><text:span text:style-name="T46">Build iOS App </text:span><text:span text:style-name="T18">button at the top of the screen. A terminal window should open. The build script for the iOS app should run within that terminal window.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P99" loext:marker-style-name="T18"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="Picture 18" text:anchor-type="as-char" svg:width="5.7083in" svg:height="4.0028in" draw:z-index="25"><draw:image xlink:href="DAB03/12.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T18"><text:span text:style-name="T18">Examine the terminal window once the shell script has been completed. The message “Signed release IPA built successfully” should appear in the window if the app has been built successfully. (Note that occasionally the terminal window will appear behind the Dictionary App Builder and that you have to select the terminal to review the results).</text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P100" loext:marker-style-name="T18"><text:span text:style-name="T18">The results of the build are an IPA file and an app that can be run in the simulator.<text:line-break/></text:span><text:bookmark-start text:name="OLE_LINK14"/><text:span text:style-name="T18">They can be found in ~/App Builder/Dictionary Apps/Ipa Output/</text:span><text:bookmark-end text:name="OLE_LINK14"/><text:span text:style-name="T18"> and ~/App Builder/Dictionary Apps/Sim Output/.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T1"><text:span text:style-name="T1"><text:tab/></text:span><draw:frame draw:style-name="fr1" draw:name="Picture 26" text:anchor-type="as-char" svg:width="5.0016in" svg:height="2.5492in" draw:z-index="2"><draw:image xlink:href="DAB03/13.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P101" loext:marker-style-name="T1"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="_e55ehiika5jz"/><text:bookmark-start text:name="_Toc228353921"/><text:bookmark-start text:name="_Toc475369922"/><text:soft-page-break/>Testing an iOS App<text:bookmark-end text:name="_Toc228353921"/></text:h>
   <text:p text:style-name="No_20_Spacing">After building the iOS IPA file, you will want to install it and test it on one or more devices before you submit it for publication to the Apple App Store. This manual describes two ways of doing this:</text:p>
   <text:p text:style-name="No_20_Spacing"/>
   <text:list text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P102">Use <text:span text:style-name="T33">Xcode</text:span> to install the IPA file to an iPhone or iPad that is connected to your computer.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P103" loext:marker-style-name="T55"><text:span text:style-name="T55">This method is recommended if you have your test devices with you. It does not involve uploading and downloading the IPA to and from the internet.</text:span><text:span text:style-name="T55"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P104">Use <text:span text:style-name="T33">DeployGate</text:span> to upload the IPA file to the internet and share it with limited number of devices to download, install and test.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P103" loext:marker-style-name="T55"><text:span text:style-name="T55">This method is recommended if you have good internet access and/or you have a team of testers who are elsewhere.</text:span><text:span text:style-name="T55"/></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T25"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228353922"/><text:bookmark-start text:name="_Toc508705017"/>Using Xcode to Test an iOS App<text:bookmark-end text:name="_Toc228353922"/><text:bookmark-end text:name="_Toc508705017"/></text:h>
   <text:p text:style-name="No_20_Spacing" loext:marker-style-name="T23"><text:span text:style-name="T23">To test your iOS IPA file using </text:span><text:span text:style-name="T56">Xcode</text:span><text:span text:style-name="T23">, do the following:</text:span></text:p>
   <text:list text:style-name="WWNum24">
    <text:list-item>
     <text:p text:style-name="P105" loext:marker-style-name="T23"><text:span text:style-name="T23">Launch </text:span><text:span text:style-name="T56">Xcode</text:span><text:span text:style-name="T23"> and select </text:span><text:bookmark-start text:name="OLE_LINK28"/><text:bookmark-start text:name="OLE_LINK29"/><text:span text:style-name="T56">Window</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T48"></text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T56">Devices and Simulators</text:span><text:bookmark-end text:name="OLE_LINK28"/><text:bookmark-end text:name="OLE_LINK29"/><text:span text:style-name="T23">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P105" loext:marker-style-name="T23"><text:span text:style-name="T23">Connect an iPhone or iPad to the Mac using a cable and unlock the device.</text:span><text:span text:style-name="T23"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P105" loext:marker-style-name="T23"><text:span text:style-name="T23">On the Mac, iTunes may launch and show a dialog asking “Do you want to allow this computer to access information…” Click on the </text:span><text:span text:style-name="T56">Cancel</text:span><text:span text:style-name="T23"> button. </text:span></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P106" loext:marker-style-name="T23"><text:span text:style-name="T23">Note: This feature can be turned off in iTunes. Select </text:span><text:span text:style-name="T56">iTunes</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T48"></text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T56">Preferences…</text:span><text:span text:style-name="T23">, select the </text:span><text:span text:style-name="T56">Devices</text:span><text:span text:style-name="T23"> tab, and click on the </text:span><text:span text:style-name="T56">Prevent iPods, iPhone, and iPad from syncing automatically</text:span><text:span text:style-name="T23"> checkbox.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P105" loext:marker-style-name="T23"><text:span text:style-name="T23">On the device, it may prompt to </text:span><text:span text:style-name="T56">Trust This Computer</text:span><text:span text:style-name="T23">. Tap on the </text:span><text:span text:style-name="T56">Trust</text:span><text:span text:style-name="T23"> button. <text:s/>This may require to enter the Passcode to trust this computer. <text:s/>The device will show up in the </text:span><text:span text:style-name="T56">Xcode</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T56">Devices</text:span><text:span text:style-name="T23"> window.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P107" loext:marker-style-name="T23"><text:span text:style-name="T23">The first time the device is connected to the Mac, Xcode will take some time to Prepare debugger support. <text:s/>This may take some time. <text:s/>Please wait.</text:span><text:span text:style-name="T23"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P107" loext:marker-style-name="T23"><text:span text:style-name="T23">In the </text:span><text:span text:style-name="T56">Xcode</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T56">Devices</text:span><text:span text:style-name="T23"> window, there will be a section named </text:span><text:span text:style-name="T56">INSTALLED APPS</text:span><text:span text:style-name="T23">. Click on the </text:span><text:span text:style-name="T56">+</text:span><text:span text:style-name="T23"> button. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P107" loext:marker-style-name="T23"><text:span text:style-name="T23">Find the IPA file to add. Click </text:span><text:span text:style-name="T56">Open</text:span><text:span text:style-name="T23"> after you have selected it.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P107" loext:marker-style-name="T23"><text:span text:style-name="T23">Click the </text:span><text:span text:style-name="T56">Install</text:span><text:span text:style-name="T23"> button next to the name of the app.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P107" loext:marker-style-name="T23"><text:span text:style-name="T23">Wait until the Mac installs the app to your device.</text:span><text:span text:style-name="T23"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P108" loext:marker-style-name="T23"/>
   <text:p text:style-name="No_20_Spacing" loext:marker-style-name="T23"><text:span text:style-name="T23">After the install is complete, you will see the app icon on your device and you can test it.</text:span><text:span text:style-name="T23"/></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T25"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228353923"/><text:soft-page-break/>Using DeployGate to Test an iOS App<text:bookmark-end text:name="_Toc228353923"/><text:bookmark-end text:name="_Toc475369922"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T46">DeployGate</text:span><text:span text:style-name="T18"> enables you to test your app and share it with a limited number of users to test. You upload the IPA file for iOS apps or the APK for Android apps and then download them to your phone or tablet device. You can also invite testers to install your app and help with the testing.</text:span></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T18"><text:span text:style-name="T18">A DeployGate app is installed on the testing device. It will show all of the apps that you have uploaded to DeployGate and allows them to be installed on the device.</text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P31" text:outline-level="2"><text:bookmark text:name="_1pqgp28vmb7n"/><text:bookmark-start text:name="_Toc475369923"/><text:bookmark-start text:name="_Toc228353924"/>Creating a DeployGate Account<text:bookmark-end text:name="_Toc475369923"/><text:bookmark-end text:name="_Toc228353924"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">The first step is to create a DeployGate account. To do this:</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P109" loext:marker-style-name="T18"><text:span text:style-name="T18">Go to </text:span><text:a xlink:type="simple" xlink:href="https://deploygate.com/" text:style-name="ListLabel_20_401" text:visited-style-name="ListLabel_20_401"><text:span text:style-name="T49">https://deploygate.com</text:span></text:a><text:span text:style-name="T18"> </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P110" loext:marker-style-name="T18"><text:span text:style-name="T18">Press the </text:span><text:span text:style-name="T46">Get Started</text:span><text:span text:style-name="T18"> button. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P110" loext:marker-style-name="T18"><text:span text:style-name="T18">Enter an email address, a user name and a password. </text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P110" loext:marker-style-name="T18"><text:span text:style-name="T18">Press the </text:span><text:span text:style-name="T46">Sign up for DeployGate</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P111" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18"><text:s text:c="2"/></text:span><draw:frame draw:style-name="fr1" draw:name="image39.png" text:anchor-type="as-char" svg:width="5.8075in" svg:height="2.4291in" draw:z-index="3"><draw:image xlink:href="DAB03/14.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:h text:style-name="P31" text:outline-level="2"><text:bookmark text:name="_es66kyf6etzn"/><text:bookmark-start text:name="_Toc475369924"/><text:bookmark-start text:name="_Toc228353925"/>Uploading Your First App<text:bookmark-end text:name="_Toc475369924"/><text:bookmark-end text:name="_Toc228353925"/></text:h>
   <text:p text:style-name="P29" loext:marker-style-name="T18"><text:span text:style-name="T18">Once the sign in screen has been successfully completed, you are presented with a screen that prompts you to upload your app. <text:s/>While there are several methods described for embedding it as part of your build process, the way we have used this to date is to simply upload the IPA file that has been created by locating the ipa file in Finder and then dragging it to the bottom area of the screen where it has a green </text:span><text:span text:style-name="T46">Upload App</text:span><text:span text:style-name="T18"> area:</text:span></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T18"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="image49.png" text:anchor-type="as-char" svg:width="4.8807in" svg:height="4.4374in" draw:z-index="4"><draw:image xlink:href="DAB03/15.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P112" loext:marker-style-name="T18"><text:span text:style-name="T18">Dragging the file to the upload area causes a new dialog to be displayed with the name of the file and a text box where you can enter a short note that will be displayed on your profile window and also on the DeployGate app when the user is selecting the app. It is a good place to write a short note on the reason for the update so that it is easy for the testers to see that the app has been updated and to see what the primary reason they need to update is. Complete the screen and press the </text:span><text:span text:style-name="T46">Upload</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T1"><draw:frame draw:style-name="fr1" draw:name="image28.png" text:anchor-type="as-char" svg:width="5.5161in" svg:height="2.8638in" draw:z-index="5"><draw:image xlink:href="DAB03/16.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P101" loext:marker-style-name="T1"/>
   <text:p text:style-name="P29" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">When the upload is complete, a new dialog is displayed with a QCode bar code and the option to send an email to your device. The QCode can be read in with your iPhone or iPad which will trigger an installation of the DeployGate app using your app profile. </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P29" loext:marker-style-name="T18"><text:span text:style-name="T18">Alternatively, you can enter an email address at this point, which you would also open on the iPhone to install the DeployGate app with the correct profile. Or you can simply go on and add users and devices later.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image38.png" text:anchor-type="as-char" svg:width="4.2965in" svg:height="2.3465in" draw:z-index="6"><draw:image xlink:href="DAB03/17.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P112" loext:marker-style-name="T18"><text:span text:style-name="T18">After this, the screen that is displayed is what you will normally see when you login. The screen has an entry for each app that you have uploaded. It has an </text:span><text:span text:style-name="T46">Upload App</text:span><text:span text:style-name="T18"> button that can be used to upload new versions of the same app or to upload a new app.<text:line-break/></text:span></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image48.png" text:anchor-type="as-char" svg:width="5.339in" svg:height="3.1138in" draw:z-index="7"><draw:image xlink:href="DAB03/18.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:h text:style-name="P31" text:outline-level="2"><text:bookmark text:name="_707sllp4p5x6"/><text:bookmark-start text:name="_Toc475369925"/><text:bookmark-start text:name="_Toc228353926"/>Registering a Device<text:bookmark-end text:name="_Toc475369925"/><text:bookmark-end text:name="_Toc228353926"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">If the iOS device was not originally in the mobile provisioning profile and if the device has not been previously registered in your Apple Developer account, you need to add it to both. </text:span><text:soft-page-break/><text:span text:style-name="T18">There is a method for manually doing this, but DeployGate provides a way of simplifying the process so that you don’t need to go and look up UDID for the device.</text:span></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T18"><text:span text:style-name="T18">First, try to install the app using the method described above. You will not be able to install it because the UDID is not registered for the app. However this will result in the device being registered in DeployGate which allows the following steps.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T18"><text:span text:style-name="T18">After attempting to install the app, re-enter DeployGate in your browser and open the entry for your app. As you can see in the screen below, it will show that a new UDID has been registered for the device. Press the </text:span><text:span text:style-name="T46">Options</text:span><text:span text:style-name="T18"> button below and select the </text:span><text:span text:style-name="T46">Package Archive</text:span><text:span text:style-name="T18"> option. </text:span><text:span text:style-name="T57">Next click the little tag symbol inside the app box to open the UDID list.</text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image47.png" text:anchor-type="as-char" svg:width="6.5in" svg:height="3.5417in" draw:z-index="8"><draw:image xlink:href="DAB03/19.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P113" loext:marker-style-name="T18"><text:span text:style-name="T18">The next screen shows a list of the devices that have been observed by DeployGate or that were included in the provisioning profile. Your new device entry will show up on the screen with a </text:span><text:span text:style-name="T46">Not Exist</text:span><text:span text:style-name="T18"> entry. Make sure that the entry for the new device is checked and then press the </text:span><text:span text:style-name="T46">Export Selected UDIDs</text:span><text:span text:style-name="T18"> button. This will create a file “multiple-device-upload-ios.txt” that can be used on the Apple Developer website to add these devices to the mobile provisioning file.</text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="image21.png" text:anchor-type="as-char" svg:width="5.9425in" svg:height="2.8571in" draw:z-index="9"><draw:image xlink:href="DAB03/20.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P114" loext:marker-style-name="T18"><text:span text:style-name="T18">After logging in to Apple Developer, click on </text:span><text:span text:style-name="T46">Certificates, IDs and Profiles</text:span><text:span text:style-name="T18">. Press the </text:span><text:span text:style-name="T46">All</text:span><text:span text:style-name="T18"> selection under </text:span><text:span text:style-name="T46">Devices</text:span><text:span text:style-name="T18"> as shown in the illustration below and then select </text:span><text:span text:style-name="T46">Register Multiple Devices</text:span><text:span text:style-name="T18">. Then press the </text:span><text:span text:style-name="T46">Choose File</text:span><text:span text:style-name="T18"> button.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image23.png" text:anchor-type="as-char" svg:width="6.172in" svg:height="5.2126in" draw:z-index="0"><draw:image xlink:href="DAB03/21.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P113" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">Find the multiple-device-upload-ios.txt file that was created by DeployGate and then press </text:span><text:span text:style-name="T46">Continue</text:span><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image17.png" text:anchor-type="as-char" svg:width="6.1098in" svg:height="5.1008in" draw:z-index="10"><draw:image xlink:href="DAB03/22.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">A review screen will be displayed which should list the name to be assigned to the device along with the UDID associated with the device. Review to ensure this is correct and press </text:span><text:span text:style-name="T46">Register</text:span><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image15.png" text:anchor-type="as-char" svg:width="6.2244in" svg:height="5.6953in" draw:z-index="11"><draw:image xlink:href="DAB03/23.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">At this point your device has been registered to your Apple Developer account. <text:s/>You now need to add the device to the provisioning profile for your app. <text:s/>Select the provisioning profile being used to test the app. Make sure your test device is checked in the list of devices at the bottom of the screen. Press </text:span><text:span text:style-name="T46">Generate</text:span><text:span text:style-name="T18">. <text:s/></text:span></text:p>
   <text:p text:style-name="P62" loext:marker-style-name="T18"><text:span text:style-name="T46">Note:</text:span><text:span text:style-name="T18"> For the purposes of testing with DeployGate, an AdHoc type of provision profile must be created and used. If you have not selected AdHoc, the list of devices will not be available on the screen.</text:span></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T18"><draw:frame draw:style-name="fr1" draw:name="image18.png" text:anchor-type="as-char" svg:width="5.7453in" svg:height="4.9929in" draw:z-index="12"><draw:image xlink:href="DAB03/24.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T18"/>
   <text:p text:style-name="P113" loext:marker-style-name="T18"><text:span text:style-name="T18">The following screen will display:</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T18"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="image33.png" text:anchor-type="as-char" svg:width="5.7035in" svg:height="4.7965in" draw:z-index="13"><draw:image xlink:href="DAB03/25.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P113" loext:marker-style-name="T18"><text:span text:style-name="T18">Now you can download the new provisioning profile that has been generated.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P113" loext:marker-style-name="T18"><text:span text:style-name="T18">Next you need to rebuild the iOS app using the new profile and upload it to DeployGate again. This time when you attempt to install it, the </text:span><text:span text:style-name="T46">Install</text:span><text:span text:style-name="T18"> button should be enabled and will allow you to install your app.</text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228353927"/>Uploading an iOS App to Apple App Store<text:bookmark-end text:name="_Toc228353927"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T37"><text:span text:style-name="T23">Before attempting to upload the app, you will need to create an entry in App Store Connect (</text:span><text:a xlink:type="simple" xlink:href="https://appstoreconnect.apple.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">https://appstoreconnect.apple.com</text:span></text:span></text:a><text:span text:style-name="T23">). <text:s/></text:span></text:p>
   <text:p text:style-name="P108" loext:marker-style-name="T23"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Select the appropriate distribution </text:span><text:span text:style-name="T58">Signing Identity</text:span><text:span text:style-name="T23"> and </text:span><text:span text:style-name="T58">App Store</text:span><text:span text:style-name="T23"> provisioning profile on the </text:span><text:span text:style-name="T58">Signing (iOS)</text:span><text:span text:style-name="T23"> tab and click Build iOS App. This will create an IPA file in the IPA Output Folder.</text:span></text:p>
   <text:p text:style-name="P108" loext:marker-style-name="T23"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Launch </text:span><text:span text:style-name="T58">Transporter</text:span><text:span text:style-name="T23"> and click </text:span><text:span text:style-name="T58">Sign In</text:span><text:span text:style-name="T23"> using the Apple ID for your Apple Developer Account. Drag and drop the IPA file from the IPA Output Folder to Transporter. Once the app is added to Transporter, click on the </text:span><text:span text:style-name="T58">Deliver</text:span><text:span text:style-name="T23"> button. After it is uploaded, you can click on the </text:span><text:span text:style-name="T58">…</text:span><text:span text:style-name="T23"> button and select </text:span><text:span text:style-name="T58">View in App Store Connect</text:span><text:span text:style-name="T23">. Selecting the Activity tab will show the status of the processing of the upload.</text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228353928"/><text:bookmark-start text:name="_Toc31914052"/><text:soft-page-break/>Using <text:bookmark-end text:name="_Toc31914052"/>Test Flight to Test an iOS App<text:bookmark-end text:name="_Toc228353928"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">It will take a little bit of time (around 20 minutes) for the app to be processed in App Store Connect. You will receive an email when the app is done processing. Switching to the Test Flight tab in App Store Connect, you will see that app is Missing Compliance.</text:span><text:span text:style-name="T23"/></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T23"><draw:frame draw:style-name="fr1" draw:name="Picture 45" text:anchor-type="as-char" svg:width="4.4972in" svg:height="1.3516in" draw:z-index="14"><draw:image xlink:href="DAB03/26.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Click on the build number and you will be taken to a page where you can click on </text:span><text:span text:style-name="T58">Provide Export Compliance Information</text:span><text:span text:style-name="T23">. The app uses an encryption algorithm to protect the text of the app. </text:span></text:p>
   <text:p text:style-name="P108" loext:marker-style-name="T23"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Click </text:span><text:span text:style-name="T58">Yes</text:span><text:span text:style-name="T23"> to the first dialog that the app uses encryption and then click </text:span><text:span text:style-name="T58">Next</text:span><text:span text:style-name="T23">.</text:span></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T23"><draw:frame draw:style-name="fr1" draw:name="Picture 46" text:anchor-type="as-char" svg:width="4.4937in" svg:height="1.3071in" draw:z-index="15"><draw:image xlink:href="DAB03/27.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Click </text:span><text:span text:style-name="T58">Yes</text:span><text:span text:style-name="T23"> to the second dialog to indicate that the app qualifies for an exemption due to </text:span><text:span text:style-name="T58">(b) Limited to intellectual property and copyright protection</text:span><text:span text:style-name="T23"> and then click </text:span><text:span text:style-name="T58">Start Internal Testing</text:span><text:span text:style-name="T23">.</text:span></text:p>
   <text:p text:style-name="P5" loext:marker-style-name="T23"><draw:frame draw:style-name="fr1" draw:name="Picture 47" text:anchor-type="as-char" svg:width="4.5102in" svg:height="3.4972in" draw:z-index="16"><draw:image xlink:href="DAB03/28.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:filter-name="&lt;All images&gt;" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T25"><text:soft-page-break/><text:span text:style-name="T23">You can add App Store Connect users (normally users in your organization) to test the app. There is a link at the left for </text:span><text:span text:style-name="T58">Add External Testers</text:span><text:span text:style-name="T23">. This will require the app to go through Beta App Review.</text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="_2tg0gs5dyul6"/><text:bookmark-start text:name="_Toc475369926"/><text:bookmark-start text:name="_Toc228353929"/>Building from Terminal<text:bookmark-end text:name="_Toc475369926"/><text:bookmark-end text:name="_Toc228353929"/></text:h>
   <text:p text:style-name="P24" loext:marker-style-name="T2"><text:span text:style-name="T2">Dictionary App Builder </text:span><text:bookmark-start text:name="OLE_LINK3"/><text:span text:style-name="T2">has a command line interface which allows you to create a new app and build it or load an existing app and build it. <text:s/></text:span></text:p>
   <text:h text:style-name="P31" text:outline-level="2"><text:bookmark-start text:name="_Toc228353930"/>Installing Command Line Interface<text:bookmark-end text:name="_Toc228353930"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T37"><text:span text:style-name="T18">Choose the </text:span><text:span text:style-name="T46">Tools</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T48"></text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T46">Install dab command in PATH</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T37">menu item to enable the use of the command line interface. <text:s/>You will be prompted to enter your login password to install the command.</text:span></text:p>
   <text:h text:style-name="P31" text:outline-level="2"><text:bookmark-start text:name="_Toc228353931"/>Command Line Interface Options<text:bookmark-end text:name="_Toc228353931"/></text:h>
   <text:p text:style-name="P24" loext:marker-style-name="T2"><text:bookmark-start text:name="OLE_LINK1"/><text:span text:style-name="T2">Run the following command to run the Dictionary App Builder application followed by a series of options described below.</text:span><text:bookmark-end text:name="OLE_LINK1"/><text:span text:style-name="T2"> <text:s/>The command is:</text:span></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T2"><text:span text:style-name="T2">dab</text:span><text:bookmark-end text:name="OLE_LINK3"/><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P116" loext:marker-style-name="T2"><text:span text:style-name="T2">The available parameters are:</text:span><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T2"><text:span text:style-name="T2"><text:s/></text:span><text:span text:style-name="T2"/></text:p>
   <table:table table:name="Table3" table:style-name="Table3">
    <table:table-column table:style-name="Table3.A"/>
    <table:table-column table:style-name="Table3.B"/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="P117" loext:marker-style-name="T2"><text:span text:style-name="T59">Option</text:span><text:span text:style-name="T59"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B1" office:value-type="string">
      <text:p text:style-name="P117" loext:marker-style-name="T2"><text:span text:style-name="T59">Description</text:span><text:span text:style-name="T59"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-new</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Create a new app project</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-load &lt;project&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Load an existing app project</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-build</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Build app project (use with either -new or -load)</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-no-save</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Do not save changes to app (use with -load)</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-resign</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Resign iOS Template App (use with either -new or -load)</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-?</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Show command line help</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-n &lt;app-name&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set app name.</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Enclose the name in &quot;double quotes&quot; if it contains spaces.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-p &lt;package-name&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set package name, e.g. com.myorg.language.appname</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-b &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Add book or bundle file. This could be a USFM file or a zipped set of USFM files. It could also be a Digital Bible Library text release bundle.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-i &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Include additional parameters file.</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-a &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set about box text, contained in text file.</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-f &lt;fontname&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set font name or filename, e.g. &quot;Charis SIL Compact&quot;, &quot;c:\fonts\myfont.ttf&quot;</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">The font name must be one of the items in the list of fonts in the New App wizard. For other fonts, specify the full path to the font filename.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-g</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Use Grandroid</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ic &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Add launcher icon (one or more .png files).</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Use the full path of the files and enclose them in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-l &lt;lang-code&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set language for menu items and settings, e.g. en, fr, es</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ft &lt;feature=value&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set a feature, e.g. book-select=grid</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-vc &lt;integer&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set version code, e.g. 1, 2, 3, or +1 to increment the current version code by 1.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-vn &lt;string&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set version name, e.g. 1.0, 2.1.4, or use +1, +0.1, +0.0.1 to increment the current value.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ks &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set keystore filename.</text:span><text:span text:style-name="T11"/></text:p>
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ksp &lt;password&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set keystore password</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ka &lt;alias&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set key alias</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-kap &lt;password&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set key alias password</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-fp &lt;folder=path&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set a folder path, e.g. &quot;app.builder=/Developer/Dictionary App Builder&quot;.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-ta &lt;target-api&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set Target API, e.g. 21 for Android 5.0, 22 for Android 5.1.</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P118" loext:marker-style-name="T11"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P118" loext:marker-style-name="T11"/>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-si &lt;signing identity&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set Signing Identity to use for iOS Resigning</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-pp &lt;provisioning profile&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set full path to provisioning profile for iOS resigning</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-bn &lt;integer&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set build number for ipa file, e.g. 1, 2, 3, or +1 to increment by 1</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T60">-vs &lt;string&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P65" loext:marker-style-name="T11"><text:span text:style-name="T11">Set version string for ipa file, e.g. 1.0, 2.1.4 or +1, +0.1, +0.0.1</text:span><text:span text:style-name="T11"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P24" loext:marker-style-name="T1"><text:span text:style-name="T61"><text:s/></text:span><text:span text:style-name="T61"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T1"><text:span text:style-name="T62">Examples:</text:span><text:span text:style-name="T62"/></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T63"><text:span text:style-name="T63">dab -load &quot;Mali&quot; -resign -bn &quot;5&quot; -vs &quot;2.3.2&quot; -si &quot;iPhone Distribution: Summer Institute of Linguistics, Inc (SIL) (4YF5X97M4H) &quot; -pp &quot;/Users/builder/Documents/MobileProvision/AdHoc_org.wycliffe.app.mali.mobileprovision&quot;</text:span><text:span text:style-name="T63"/></text:p>
   <text:p text:style-name="P101" loext:marker-style-name="T1"><text:bookmark-start text:name="OLE_LINK4"/></text:p>
   <text:p text:style-name="P24" loext:marker-style-name="T2"><text:span text:style-name="T2">Running the command line with no parameters will start the Dictionary App Builder UI from the command line.</text:span><text:bookmark-end text:name="OLE_LINK4"/><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P101" loext:marker-style-name="T1"/>
  </office:text>
 </office:body>
</office:document>