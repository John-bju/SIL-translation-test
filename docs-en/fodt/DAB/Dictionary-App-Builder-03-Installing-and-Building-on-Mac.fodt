         9fyYwHopbGkqfiV1GxPPn0eY+HF0mL05hAwRiSsGrg8jbhSIQazVNcUKQgRXDFwfX1svMFd2
         U4CHLalRoKkXsFHYrr8YNTM0itrRt1xDO8g5jpYgV5V/jTW9pL+AAsrYa3St8QAAAABJRU5E
         rkJggg==
        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T37"> button to the right of the </text:span><text:span text:style-name="T45">Devices</text:span><text:span text:style-name="T37"> header.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P209" loext:marker-style-name="T37">In the section <text:span text:style-name="T43">Register a Device</text:span>, enter a name of the device (such as “John Smith’s iPhone”) and its UDID (unique device identifier, a sequence of 40 letters and numbers). Press <text:span text:style-name="T43">Continue</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P209" loext:marker-style-name="T37"><text:span text:style-name="T37">On the next page, check that the device information is displayed correctly and click </text:span><text:span text:style-name="T45">Register</text:span><text:span text:style-name="T37"> to confirm.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P81" loext:marker-style-name="T37"><text:span text:style-name="T37">Note that you can register up to 100 devices of each type (e.g. up to 100 iPhones, 100 iPads) per year of your Apple Developer Program membership. You can remove devices that you no longer need at the beginning of the next membership year.</text:span><text:span text:style-name="T37"/></text:p>
   <text:p text:style-name="P46" loext:marker-style-name="T37"/>
   <text:p text:style-name="P60" loext:marker-style-name="T37"><text:span text:style-name="T37">To create a </text:span><text:span text:style-name="T60">provisioning profile</text:span><text:span text:style-name="T37">:</text:span></text:p>
   <text:list text:style-name="WWNum18">
    <text:list-item>
     <text:p text:style-name="P210" loext:marker-style-name="T37"><text:span text:style-name="T37">Select </text:span><text:span text:style-name="T45">Profiles</text:span><text:span text:style-name="T37"> on the left of the page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P210" loext:marker-style-name="T37"><text:span text:style-name="T37">Click the</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 33" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
