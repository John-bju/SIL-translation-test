    <text:list-item>
     <text:p text:style-name="P213" loext:marker-style-name="T37"><text:span text:style-name="T37">Select the </text:span><text:span text:style-name="T45">Signing Identity</text:span><text:span text:style-name="T37"> from the drop-down list of signing certificates which have been downloaded and installed to this system in the earlier steps.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P213" loext:marker-style-name="T37"><text:span text:style-name="T37">For the </text:span><text:span text:style-name="T45">Provisioning Profile </text:span><text:span text:style-name="T37">entry, enter or browse to the mobile provisioning file associated with the app that was downloaded in the earlier steps. <text:line-break/></text:span></text:p>
    </text:list-item>
   </text:list>
