   <text:p text:style-name="Standard" loext:marker-style-name="T10"><text:span text:style-name="T22">You can add App Store Connect users (normally users in your organization) to test the app. There is a link at the left for </text:span><text:span text:style-name="T26">Add External Testers</text:span><text:span text:style-name="T22">. This will require the app to go through Beta App Review.</text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark text:name="_2tg0gs5dyul6"/><text:bookmark-start text:name="_Toc228353929"/><text:bookmark-start text:name="_Toc475369926"/>Building from Terminal<text:bookmark-end text:name="_Toc228353929"/><text:bookmark-end text:name="_Toc475369926"/></text:h>
   <text:p text:style-name="P54" loext:marker-style-name="T2"><text:span text:style-name="T2">Dictionary App Builder </text:span><text:bookmark-start text:name="OLE_LINK3"/><text:span text:style-name="T2">has a command line interface which allows you to create a new app and build it or load an existing app and build it. <text:s/></text:span></text:p>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc228353930"/>Installing Command Line Interface<text:bookmark-end text:name="_Toc228353930"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T37">Choose the </text:span><text:span text:style-name="T45">Tools</text:span><text:span text:style-name="T37"> </text:span><text:span text:style-name="T42"></text:span><text:span text:style-name="T37"> </text:span><text:span text:style-name="T45">Install dab command in PATH</text:span><text:span text:style-name="T37"> </text:span><text:span text:style-name="T52">menu item to enable the use of the command line interface. <text:s/>You will be prompted to enter your login password to install the command.</text:span></text:p>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc228353931"/>Command Line Interface Options<text:bookmark-end text:name="_Toc228353931"/></text:h>
   <text:p text:style-name="P54" loext:marker-style-name="T2"><text:bookmark-start text:name="OLE_LINK1"/><text:span text:style-name="T2">Run the following command to run the Dictionary App Builder application followed by a series of options described below.</text:span><text:bookmark-end text:name="OLE_LINK1"/><text:span text:style-name="T2"> <text:s/>The command is:</text:span></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T2"><text:span text:style-name="T2">dab</text:span><text:bookmark-end text:name="OLE_LINK3"/><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P57" loext:marker-style-name="T2"><text:span text:style-name="T2">The available parameters are:</text:span><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T2"><text:span text:style-name="T2"><text:s/></text:span><text:span text:style-name="T2"/></text:p>
   <table:table table:name="Table3" table:style-name="Table3">
    <table:table-column table:style-name="Table3.A"/>
    <table:table-column table:style-name="Table3.B"/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="P75" loext:marker-style-name="T2"><text:span text:style-name="T16">Option</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B1" office:value-type="string">
      <text:p text:style-name="P75" loext:marker-style-name="T2"><text:span text:style-name="T16">Description</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-new</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Create a new app project</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-load &lt;project&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Load an existing app project</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-build</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Build app project (use with either -new or -load)</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-no-save</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Do not save changes to app (use with -load)</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-resign</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Resign iOS Template App (use with either -new or -load)</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-?</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Show command line help</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-n &lt;app-name&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set app name.</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Enclose the name in &quot;double quotes&quot; if it contains spaces.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-p &lt;package-name&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set package name, e.g. com.myorg.language.appname</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-b &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Add book or bundle file. This could be a USFM file or a zipped set of USFM files. It could also be a Digital Bible Library text release bundle.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-i &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Include additional parameters file.</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-a &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set about box text, contained in text file.</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-f &lt;fontname&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set font name or filename, e.g. &quot;Charis SIL Compact&quot;, &quot;c:\fonts\myfont.ttf&quot;</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">The font name must be one of the items in the list of fonts in the New App wizard. For other fonts, specify the full path to the font filename.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-g</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Use Grandroid</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ic &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Add launcher icon (one or more .png files).</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Use the full path of the files and enclose them in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-l &lt;lang-code&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set language for menu items and settings, e.g. en, fr, es</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ft &lt;feature=value&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set a feature, e.g. book-select=grid</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-vc &lt;integer&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set version code, e.g. 1, 2, 3, or +1 to increment the current version code by 1.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-vn &lt;string&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set version name, e.g. 1.0, 2.1.4, or use +1, +0.1, +0.0.1 to increment the current value.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ks &lt;filename&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set keystore filename.</text:span><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Use the full path of the file and enclose it in &quot;double quotes&quot; if there is a space in the path.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ksp &lt;password&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set keystore password</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ka &lt;alias&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set key alias</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-kap &lt;password&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set key alias password</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-fp &lt;folder=path&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set a folder path, e.g. &quot;app.builder=/Developer/Dictionary App Builder&quot;.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-ta &lt;target-api&gt;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set Target API, e.g. 21 for Android 5.0, 22 for Android 5.1.</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P21" loext:marker-style-name="T4"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P21" loext:marker-style-name="T4"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-si &lt;signing identity&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set Signing Identity to use for iOS Resigning</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-pp &lt;provisioning profile&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set full path to provisioning profile for iOS resigning</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-bn &lt;integer&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set build number for ipa file, e.g. 1, 2, 3, or +1 to increment by 1</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T17">-vs &lt;string&gt;</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T4"><text:span text:style-name="T4">Set version string for ipa file, e.g. 1.0, 2.1.4 or +1, +0.1, +0.0.1</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P54" loext:marker-style-name="T1"><text:span text:style-name="T65"><text:s/></text:span><text:span text:style-name="T65"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T1"><text:span text:style-name="T15">Examples:</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T58"><text:span text:style-name="T58">dab -load &quot;Mali&quot; -resign -bn &quot;5&quot; -vs &quot;2.3.2&quot; -si &quot;iPhone Distribution: Summer Institute of Linguistics, Inc (SIL) (4YF5X97M4H) &quot; -pp &quot;/Users/builder/Documents/MobileProvision/AdHoc_org.wycliffe.app.mali.mobileprovision&quot;</text:span><text:span text:style-name="T58"/></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T1"><text:bookmark-start text:name="OLE_LINK4"/></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T2"><text:span text:style-name="T2">Running the command line with no parameters will start the Dictionary App Builder UI from the command line.</text:span><text:bookmark-end text:name="OLE_LINK4"/><text:span text:style-name="T2"/></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T1"/>
  </office:text>
 </office:body>
</office:document>