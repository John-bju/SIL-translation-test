   <text:p text:style-name="P30" loext:marker-style-name="T18"/>
   <text:p text:style-name="P30" loext:marker-style-name="T18"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum28">
    <text:list-item>
     <text:p text:style-name="P191" loext:marker-style-name="T18"><text:span text:style-name="T18">Follow the instructions on each page of the </text:span><text:span text:style-name="T24">Install Android SDK</text:span><text:span text:style-name="T18"> wizard to download each of the Android SDK packages and install them.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P31" loext:marker-style-name="T18"/>
   <text:p text:style-name="P79" loext:marker-style-name="T18"><text:span text:style-name="T18">When you are asked to specify a target folder, a good place is:</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P79" loext:marker-style-name="T18"><text:span text:style-name="T18"><text:s text:c="8"/></text:span><text:span text:style-name="T23">/Users/</text:span><text:span text:style-name="T20">your-name</text:span><text:span text:style-name="T23">/Android-SDK</text:span><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P32" loext:marker-style-name="T18"/>
   <text:p text:style-name="P86" loext:marker-style-name="T18"><text:span text:style-name="T18">Four packages will be downloaded and installed:</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">Command line tools, </text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">Build Tools, </text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">Platform Tools, and </text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P115" loext:marker-style-name="T18"><text:span text:style-name="T18">Platform API.</text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P31" loext:marker-style-name="T18"/>
   <text:p text:style-name="P77" loext:marker-style-name="T18"><text:span text:style-name="T18">If the installation was successful, you will see the version numbers displayed in green.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P4" loext:marker-style-name="T43"><draw:frame draw:style-name="fr1" draw:name="Image2" text:anchor-type="as-char" svg:width="5.25in" svg:height="3.3165in" draw:z-index="0"><draw:image draw:mime-type="image/png">
