      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="P50" loext:marker-style-name="T49"><text:span text:style-name="T49">Android SDK Folder</text:span><text:span text:style-name="T49"/></text:p>
      </table:table-cell>
