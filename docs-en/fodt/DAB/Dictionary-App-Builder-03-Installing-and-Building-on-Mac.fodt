     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353901" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">1.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Introduction<text:span text:style-name="T35"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353902" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">2.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Installing Dictionary App Builder<text:span text:style-name="T35"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353903" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">3.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Installing Prerequisites for Android<text:span text:style-name="T35"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353904" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.1.<text:span text:style-name="T31"><text:tab/></text:span>Java Development Kit (JDK)<text:span text:style-name="T35"><text:tab/>6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353905" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T18">3.2.</text:span><text:span text:style-name="T31"><text:tab/></text:span><text:span text:style-name="T18">Installing Android Software Development Kit (SDK)</text:span><text:span text:style-name="T35"><text:tab/>7</text:span></text:a></text:p>
     <text:p text:style-name="P34" loext:marker-style-name="T32"><text:a xlink:type="simple" xlink:href="#_Toc228353906" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T21">3.2.1.</text:span><text:span text:style-name="T32"><text:tab/></text:span><text:span text:style-name="T18">Downloading the Android SDK packages from the internet</text:span><text:span text:style-name="T35"><text:tab/>7</text:span></text:a></text:p>
     <text:p text:style-name="P34" loext:marker-style-name="T32"><text:a xlink:type="simple" xlink:href="#_Toc228353907" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T21">3.2.2.</text:span><text:span text:style-name="T32"><text:tab/></text:span><text:span text:style-name="T18">Copying the Android SDK files from someone else</text:span><text:span text:style-name="T35"><text:tab/>10</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353908" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">4.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Installing Prerequisites for iOS<text:span text:style-name="T35"><text:tab/>10</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353909" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.1.<text:span text:style-name="T31"><text:tab/></text:span>Install Xcode<text:span text:style-name="T35"><text:tab/>11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353910" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.2.<text:span text:style-name="T31"><text:tab/></text:span>Verify Xcode Installation<text:span text:style-name="T35"><text:tab/>11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353911" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.3.<text:span text:style-name="T31"><text:tab/></text:span>Install Transporter<text:span text:style-name="T35"><text:tab/>11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353912" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">5.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Testing App in iOS Simulator<text:span text:style-name="T35"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353913" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.1.<text:span text:style-name="T31"><text:tab/></text:span>Run the iOS Simulator<text:span text:style-name="T35"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353914" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.2.<text:span text:style-name="T31"><text:tab/></text:span>Installing Additional Simulators<text:span text:style-name="T35"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353915" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.3.<text:span text:style-name="T31"><text:tab/></text:span>Manually Installing Apps Into The Simulator<text:span text:style-name="T35"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353916" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">6.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Creating iOS Certificates and Provisioning Profiles<text:span text:style-name="T35"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353917" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.1.<text:span text:style-name="T31"><text:tab/></text:span>Enroll in the Apple Developer Program<text:span text:style-name="T35"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353918" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.2.<text:span text:style-name="T31"><text:tab/></text:span>Create Signing Certificate<text:span text:style-name="T35"><text:tab/>14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353919" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>6.3.<text:span text:style-name="T31"><text:tab/></text:span>Create Provisioning Profile<text:span text:style-name="T35"><text:tab/>15</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353920" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">7.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Building an iOS App<text:span text:style-name="T35"><text:tab/>16</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353921" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">8.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Testing an iOS App<text:span text:style-name="T35"><text:tab/>20</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353922" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">9.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Using Xcode to Test an iOS App<text:span text:style-name="T35"><text:tab/>20</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353923" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">10.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Using DeployGate to Test an iOS App<text:span text:style-name="T35"><text:tab/>21</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353924" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">10.1.<text:span text:style-name="T31"><text:tab/></text:span>Creating a DeployGate Account<text:span text:style-name="T35"><text:tab/>21</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353925" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">10.2.<text:span text:style-name="T31"><text:tab/></text:span>Uploading Your First App<text:span text:style-name="T35"><text:tab/>21</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353926" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">10.3.<text:span text:style-name="T31"><text:tab/></text:span>Registering a Device<text:span text:style-name="T35"><text:tab/>23</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353927" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">11.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Uploading an iOS App to Apple App Store<text:span text:style-name="T35"><text:tab/>29</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353928" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">12.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Using Test Flight to Test an iOS App<text:span text:style-name="T35"><text:tab/>30</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T30"><text:a xlink:type="simple" xlink:href="#_Toc228353929" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T34">13.</text:span><text:span text:style-name="T30"><text:tab/></text:span>Building from Terminal<text:span text:style-name="T35"><text:tab/>31</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353930" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">13.1.<text:span text:style-name="T31"><text:tab/></text:span>Installing Command Line Interface<text:span text:style-name="T35"><text:tab/>31</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T31"><text:a xlink:type="simple" xlink:href="#_Toc228353931" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">13.2.<text:span text:style-name="T31"><text:tab/></text:span>Command Line Interface Options<text:span text:style-name="T35"><text:tab/>31</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P16" loext:marker-style-name="T1"/>
   <text:h text:style-name="P35" text:outline-level="1"><text:bookmark text:name="_ib23mk4syx17"/><text:bookmark-start text:name="_Toc228353901"/><text:bookmark-start text:name="_Toc475369911"/>Introduction<text:bookmark-end text:name="_Toc228353901"/><text:bookmark-end text:name="_Toc475369911"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T37"><text:span text:style-name="T37">This document provides information on how to install Dictionary App Builder and build apps on an Apple macOS system. It is possible to build an Android app using DAB on Windows, Linux or Mac, but if you want to build an iOS app for the iPhone or iPad, you will need to build it using a Mac computer.</text:span><text:span text:style-name="T37"/></text:p>
   <text:p text:style-name="P44" loext:marker-style-name="T37"/>
   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A"/>
    <table:table-column table:style-name="Table1.B" table:number-columns-repeated="2"/>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P50" loext:marker-style-name="T38"><text:span text:style-name="T38">App Builder</text:span></text:p>
      <text:p text:style-name="P50" loext:marker-style-name="T38"><text:span text:style-name="T38">Platform</text:span><text:span text:style-name="T38"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P51" loext:marker-style-name="T38"><text:span text:style-name="T38">Build</text:span><text:span text:style-name="T38"/></text:p>
      <text:p text:style-name="P51" loext:marker-style-name="T38"><text:span text:style-name="T38">Android Apps</text:span><text:span text:style-name="T38"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P51" loext:marker-style-name="T38"><text:span text:style-name="T38">Build</text:span><text:span text:style-name="T38"/></text:p>
      <text:p text:style-name="P51" loext:marker-style-name="T38"><text:span text:style-name="T38">iOS Apps</text:span><text:span text:style-name="T38"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P50" loext:marker-style-name="T39"><text:span text:style-name="T39">Windows</text:span><text:span text:style-name="T39"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52" loext:marker-style-name="T39"><text:span text:style-name="T40"></text:span><text:span text:style-name="T41"/></text:p>
     </table:table-cell>
