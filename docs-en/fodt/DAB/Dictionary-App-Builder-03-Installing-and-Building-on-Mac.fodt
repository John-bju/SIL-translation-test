      </draw:frame><text:span text:style-name="T37"> button to the right of the </text:span><text:span text:style-name="T45">Identifiers</text:span><text:span text:style-name="T37"> header.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:span text:style-name="T37">Select </text:span><text:span text:style-name="T45">App IDs</text:span><text:span text:style-name="T37"> and click the </text:span><text:span text:style-name="T45">Continue</text:span><text:span text:style-name="T37"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:span text:style-name="T37">Select </text:span><text:span text:style-name="T45">App</text:span><text:span text:style-name="T37"> and clock the </text:span><text:span text:style-name="T45">Continue</text:span><text:span text:style-name="T37"> button</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:bookmark-start text:name="OLE_LINK22"/><text:bookmark-start text:name="OLE_LINK21"/><text:bookmark-start text:name="OLE_LINK20"/><text:bookmark-start text:name="OLE_LINK23"/><text:span text:style-name="T37">Enter a</text:span><text:span text:style-name="T45"> Description</text:span><text:span text:style-name="T37"> of your choice.<text:line-break/>It can be the </text:span><text:span text:style-name="T45">App Name</text:span><text:span text:style-name="T37"> from the </text:span><text:span text:style-name="T45">App</text:span><text:span text:style-name="T37"> </text:span><text:span text:style-name="T42"></text:span><text:span text:style-name="T51"> </text:span><text:span text:style-name="T45">Package</text:span><text:span text:style-name="T37"> page of Dictionary App Builder.</text:span><text:bookmark-end text:name="OLE_LINK22"/><text:bookmark-end text:name="OLE_LINK23"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:bookmark-start text:name="OLE_LINK24"/><text:bookmark-start text:name="OLE_LINK25"/><text:span text:style-name="T37">For Bundle ID, choose </text:span><text:span text:style-name="T45">Explicit </text:span><text:span text:style-name="T37">and enter your app package name from the </text:span><text:span text:style-name="T45">App</text:span><text:span text:style-name="T37"> </text:span><text:bookmark-start text:name="OLE_LINK19"/><text:bookmark-start text:name="OLE_LINK18"/><text:span text:style-name="T42"></text:span><text:span text:style-name="T51"> </text:span><text:span text:style-name="T45">Package</text:span><text:span text:style-name="T37"> page of Dictionary App Builder.</text:span><text:bookmark-end text:name="OLE_LINK24"/><text:bookmark-end text:name="OLE_LINK25"/><text:bookmark-end text:name="OLE_LINK19"/><text:bookmark-end text:name="OLE_LINK18"/><text:bookmark-end text:name="OLE_LINK21"/><text:bookmark-end text:name="OLE_LINK20"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:soft-page-break/><text:span text:style-name="T37">Leave all the App Services unchecked. None are needed in the app. </text:span><text:span text:style-name="T37"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P207" loext:marker-style-name="T37"><text:span text:style-name="T37">Click the </text:span><text:span text:style-name="T45">Continue</text:span><text:span text:style-name="T37"> button.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P44" loext:marker-style-name="T37"/>
   <text:p text:style-name="P60" loext:marker-style-name="T37"><text:span text:style-name="T37">To register a </text:span><text:span text:style-name="T60">device</text:span><text:span text:style-name="T37"> (i.e. a specific iPhone or iPad for testing):</text:span></text:p>
   <text:list text:style-name="WWNum17">
    <text:list-item>
     <text:p text:style-name="P209" loext:marker-style-name="T37"><text:span text:style-name="T37">Select </text:span><text:span text:style-name="T45">Devices</text:span><text:span text:style-name="T37"> on the left of the page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
