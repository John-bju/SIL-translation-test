     </table:table-cell>
     <table:table-cell table:style-name="Table2.B11" office:value-type="string">
      <text:p text:style-name="P20" loext:marker-style-name="T36"><text:span text:style-name="T36">No</text:span><text:span text:style-name="T36"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table2.1">
     <table:table-cell table:style-name="Table2.A12" office:value-type="string">
      <text:p text:style-name="P20" loext:marker-style-name="T36"><text:span text:style-name="T36">system-images</text:span><text:span text:style-name="T36"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.B12" office:value-type="string">
      <text:p text:style-name="P20" loext:marker-style-name="T36"><text:span text:style-name="T36">No, unless you want to use an emulator</text:span><text:span text:style-name="T36"/></text:p>
     </table:table-cell>
