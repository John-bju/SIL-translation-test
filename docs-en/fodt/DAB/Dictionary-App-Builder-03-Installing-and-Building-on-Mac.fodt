   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc228353915"/>Manually Installing Apps Into The Simulator<text:bookmark-end text:name="_Toc228353915"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T13"><text:span text:style-name="T13">If there is some problem with launching the simulator from the </text:span><text:span text:style-name="T14">Run iOS Simulator</text:span><text:span text:style-name="T13"> dialog, you can manually install the app by dragging the built app from the Simulator output folder (found in ~/App Builder/Dictionary Apps/Sim Output) onto the Simulator. <text:s/></text:span></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T13"><text:span text:style-name="T13">To start the Simulator, launch </text:span><text:span text:style-name="T14">Xcode</text:span><text:span text:style-name="T13"> and from the </text:span><text:span text:style-name="T14">Xcode</text:span><text:span text:style-name="T13"> menu select </text:span><text:span text:style-name="T14">Open Developer Tool</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T42"></text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T14">Simulator</text:span><text:span text:style-name="T13">. <text:s/>You will still need to rebuild the app from the </text:span><text:span text:style-name="T14">Run iOS Simulator</text:span><text:span text:style-name="T13"> dialog.</text:span></text:p>
   <text:p text:style-name="P22" loext:marker-style-name="T13"/>
   <text:p text:style-name="P22" loext:marker-style-name="T13"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="_Toc228353916"/><text:soft-page-break/>Creating iOS Certificates and Provisioning<text:bookmark-end text:name="_Toc475369919"/> Profiles<text:bookmark-end text:name="_Toc228353916"/></text:h>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc228353917"/><text:bookmark-start text:name="OLE_LINK11"/>Enroll in the Apple Developer Program<text:bookmark-end text:name="_Toc228353917"/><text:bookmark-end text:name="OLE_LINK11"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T37"><text:span text:style-name="T37">To build iOS apps and distribute them through the Apple App Store, you will need to be enrolled in the Apple Developer Program. You can do this as either (i) an individual, or (ii) an organisation. The cost is USD $99 per year.</text:span><text:span text:style-name="T37"/></text:p>
   <text:p text:style-name="P54" loext:marker-style-name="T37"><text:span text:style-name="T37">To enroll:</text:span><text:span text:style-name="T37"/></text:p>
   <text:list text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P124" loext:marker-style-name="T37"><text:bookmark-start text:name="OLE_LINK10"/><text:span text:style-name="T37">Go to </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/programs/enroll/" text:style-name="ListLabel_20_400" text:visited-style-name="ListLabel_20_400"><text:span text:style-name="T59">https://developer.apple.com/programs/enroll/</text:span></text:a><text:bookmark-end text:name="OLE_LINK10"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P125" loext:marker-style-name="T37"><text:span text:style-name="T37">Press the </text:span><text:span text:style-name="T45">Start Your Enrollment</text:span><text:span text:style-name="T37"> button to start.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P45" loext:marker-style-name="T37"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc228353918"/>Create Signing Certificate<text:bookmark-end text:name="_Toc228353918"/></text:h>
   <text:p text:style-name="P92" loext:marker-style-name="T37"><text:span text:style-name="T37">When you create an iOS app, it needs to be signed with a certificate. </text:span><text:span text:style-name="T37"/></text:p>
   <text:p text:style-name="P44" loext:marker-style-name="T37"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T37"><text:span text:style-name="T37">To create a certificate:</text:span><text:span text:style-name="T37"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P203" loext:marker-style-name="T37"><text:span text:style-name="T37">Go to the </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T37">Apple Developer</text:span></text:span></text:a><text:span text:style-name="T37"> website and log in to your account if you are not already.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P203" loext:marker-style-name="T37"><text:span text:style-name="T37">Select </text:span><text:span text:style-name="T45">Certificates, Identifiers &amp; Profiles</text:span><text:span text:style-name="T37">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P203" loext:marker-style-name="T37"><text:span text:style-name="T37">Click the</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 12" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
