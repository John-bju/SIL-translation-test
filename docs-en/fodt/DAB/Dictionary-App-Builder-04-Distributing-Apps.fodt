   <text:h text:style-name="P12" text:outline-level="1" loext:marker-style-name="T4"><text:bookmark-start text:name="_Toc78983169"/><text:span text:style-name="T4">Introduction</text:span><text:bookmark-end text:name="_Toc78983169"/><text:span text:style-name="T4"/></text:h>
   <text:list text:style-name="WWNum32">
    <text:list-item>
     <text:list>
      <text:list-item text:start-value="1">
       <text:h text:style-name="P13" text:outline-level="2" text:restart-numbering="true" text:start-value="1"><text:bookmark-start text:name="_Toc78982272"/><text:bookmark-start text:name="_Toc78983170"/><text:bookmark-start text:name="_Toc78982838"/>Distribution options for Android apps<text:bookmark-end text:name="_Toc78982272"/><text:bookmark-end text:name="_Toc78983170"/><text:bookmark-end text:name="_Toc78982838"/></text:h>
