     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140703" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">1.</text:span><text:span text:style-name="T20"><text:tab/></text:span><text:span text:style-name="T4">Introduction</text:span><text:span text:style-name="T27"><text:tab/>4</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140704" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">2.</text:span><text:span text:style-name="T20"><text:tab/></text:span><text:span text:style-name="T4">Windows Installation</text:span><text:span text:style-name="T27"><text:tab/>4</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140705" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.1.<text:span text:style-name="T21"><text:tab/></text:span>Installing Scripture App Builder<text:span text:style-name="T27"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140706" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.2.<text:span text:style-name="T21"><text:tab/></text:span>Installing the Java Development Kit (JDK)<text:span text:style-name="T27"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140707" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">2.2.1.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Installing the JDK using the Install JDK wizard</text:span><text:span text:style-name="T27"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140708" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">2.2.2.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Installing the JDK from the Azul website</text:span><text:span text:style-name="T27"><text:tab/>5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140709" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.3.<text:span text:style-name="T21"><text:tab/></text:span>Installing the Android Software Development Kit (SDK)<text:span text:style-name="T27"><text:tab/>7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140710" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">2.3.1.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Downloading the Android SDK packages from the internet</text:span><text:span text:style-name="T27"><text:tab/>7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140711" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">2.3.2.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Copying the Android SDK files from someone else</text:span><text:span text:style-name="T27"><text:tab/>8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140712" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.4.<text:span text:style-name="T21"><text:tab/></text:span>Installing aeneas for audio-text synchronization<text:span text:style-name="T27"><text:tab/>9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140713" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">3.</text:span><text:span text:style-name="T20"><text:tab/></text:span><text:span text:style-name="T4">Linux Installation</text:span><text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140714" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.1.<text:span text:style-name="T21"><text:tab/></text:span>Flathub<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140715" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.<text:span text:style-name="T21"><text:tab/></text:span>SIL repository for Ubuntu<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140716" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>3.2.1.<text:span text:style-name="T26"><text:tab/></text:span>Add SIL repository for Ubuntu<text:span text:style-name="T27"><text:tab/>12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140717" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.2.<text:span text:style-name="T26"><text:tab/></text:span>Installing all packages from the Internet<text:span text:style-name="T27"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140718" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.3.<text:span text:style-name="T26"><text:tab/></text:span>Downloading the Android SDK files prior to package installation<text:span text:style-name="T27"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140719" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">3.2.4.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Downloading the Android SDK files</text:span><text:span text:style-name="T27"><text:tab/>13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140720" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">3.2.5.</text:span><text:span text:style-name="T26"><text:tab/></text:span><text:span text:style-name="T4">Provide zip files during the package install</text:span><text:span text:style-name="T27"><text:tab/>14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140721" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.6.<text:span text:style-name="T26"><text:tab/></text:span>Installing without Android SDK<text:span text:style-name="T27"><text:tab/>14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Toc227140722" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.7.<text:span text:style-name="T26"><text:tab/></text:span>Automating Android SDK installation<text:span text:style-name="T27"><text:tab/>14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140723" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T4">4.</text:span><text:span text:style-name="T20"><text:tab/></text:span><text:span text:style-name="T4">How to build your first app</text:span><text:span text:style-name="T27"><text:tab/>15</text:span></text:a></text:p>
