     <table:table-cell table:style-name="Table1.B12" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T33"><text:span text:style-name="T33">No, unless you want to use an emulator</text:span><text:span text:style-name="T33"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A13" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T33"><text:span text:style-name="T33">temp</text:span><text:span text:style-name="T33"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B13" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T33"><text:span text:style-name="T33">No</text:span><text:span text:style-name="T33"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P11" loext:marker-style-name="T4"/>
   <text:p text:style-name="P11" loext:marker-style-name="T4"/>
   <text:h text:style-name="P32" text:outline-level="2"><text:bookmark-start text:name="_Toc227140712"/><text:bookmark-start text:name="_Toc44921079"/>Install<text:bookmark-end text:name="_Toc44921079"/>ing aeneas for audio-text synchronization<text:bookmark-end text:name="_Toc227140712"/></text:h>
   <text:p text:style-name="P55" loext:marker-style-name="T22"><text:span text:style-name="T22">Scripture App Builder uses a tool called </text:span><text:span text:style-name="T25">aeneas</text:span><text:span text:style-name="T22"> to synchronise text and audio.</text:span></text:p>
   <text:p text:style-name="P56" loext:marker-style-name="T22"><text:span text:style-name="T22">To set up </text:span><text:span text:style-name="T24">aeneas</text:span><text:span text:style-name="T22"> on Windows, there are several programs and modules to download and install: FFmpeg, eSpeak, Python and aeneas. These are installed with a single setup program.</text:span></text:p>
   <text:list text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P81" loext:marker-style-name="T19"><text:span text:style-name="T19">Go to the </text:span><text:span text:style-name="T23">Download</text:span><text:span text:style-name="T19"> page on the Scripture App Builder website </text:span><text:a xlink:type="simple" xlink:href="http://software.sil.org/scriptureappbuilder/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T19">http://software.sil.org/scriptureappbuilder/download/</text:span></text:span></text:a><text:span text:style-name="T19"> and download the latest aeneas setup program for Windows. You will find it under the heading </text:span><text:span text:style-name="T23">Audio Synchronization Tools</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P82" loext:marker-style-name="T19"><text:span text:style-name="T19">The filename will be something like </text:span><text:span text:style-name="T23">aeneas-windows-setup-1.7.3.exe</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P57" loext:marker-style-name="T19"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P81" loext:marker-style-name="T19"><text:span text:style-name="T19">Double-click the file you have downloaded to start the installation wizard.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P58" loext:marker-style-name="T19"/>
   <text:p text:style-name="P6" loext:marker-style-name="T19"/>
   <text:p text:style-name="P58" loext:marker-style-name="T19"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P83" loext:marker-style-name="T19"><text:span text:style-name="T19">Follow the instructions in the wizard. You can accept all the defaults. </text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P57" loext:marker-style-name="T19"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P81" loext:marker-style-name="T19"><text:soft-page-break/><text:span text:style-name="T19">On the </text:span><text:span text:style-name="T23">Select Components</text:span><text:span text:style-name="T19"> page, you need the </text:span><text:span text:style-name="T23">Full Installation</text:span><text:span text:style-name="T19"> which should be selected by default.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P11" loext:marker-style-name="T4"/>
