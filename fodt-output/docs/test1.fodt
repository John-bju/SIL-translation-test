    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A12" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T33"><text:span text:style-name="T33">system-images</text:span><text:span text:style-name="T33"/></text:p>
