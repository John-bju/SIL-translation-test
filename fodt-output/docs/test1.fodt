     <table:table-cell table:style-name="Table1.A11" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T33"><text:span text:style-name="T33">sources</text:span><text:span text:style-name="T33"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B11" office:value-type="string">
