   <text:p text:style-name="P69" loext:marker-style-name="T33"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P71" loext:marker-style-name="T33"><text:span text:style-name="T33">Follow the instructions in the wizard. You can accept all the defaults. </text:span><text:span text:style-name="T33"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P67" loext:marker-style-name="T33"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P68" loext:marker-style-name="T33"><text:span text:style-name="T33">On the </text:span><text:span text:style-name="T34">Select Components</text:span><text:span text:style-name="T33"> page, you need the </text:span><text:span text:style-name="T34">Full Installation</text:span><text:span text:style-name="T33"> which should be selected by default.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T4"/>
