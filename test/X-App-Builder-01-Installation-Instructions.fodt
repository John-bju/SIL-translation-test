   <text:p text:style-name="P7" loext:marker-style-name="T4"/>
   <text:p text:style-name="P7" loext:marker-style-name="T4"/>
   <text:h text:style-name="P11" text:outline-level="1" loext:marker-style-name="T4"><text:bookmark-start text:name="_Toc227140703"/><text:span text:style-name="T4">Introduction</text:span><text:bookmark-end text:name="_Toc227140703"/><text:span text:style-name="T4"/></text:h>
   <text:p text:style-name="P12" loext:marker-style-name="T4"/>
   <text:p text:style-name="P12" loext:marker-style-name="T4"/>
   <text:h text:style-name="P13" text:outline-level="2"><text:s/><text:bookmark-start text:name="_Toc227140705 Copy 1"/>Scripture App Builde<text:bookmark-end text:name="_Toc227140705 Copy 1"/><text:span text:style-name="T15">r</text:span></text:h>
   <text:p text:style-name="P7" loext:marker-style-name="T4">Scripture App Builder does what its name suggests: it helps you to build customized Scripture apps for smartphones and tablets.<text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">You specify the Scripture files to use, the app name, the fonts, the colours, the about box information, the audio and the icons. Scripture App Builder will package everything together and build the customized app for you. You then install it on your mobile device, send it to others by Bluetooth or Wi-Fi transfer app, share it on microSD memory cards and publish it to app stores on the Internet.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T4"/>
