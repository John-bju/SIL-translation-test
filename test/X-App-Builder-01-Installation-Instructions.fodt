      <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Word documents</text:span></text:p>
      <text:p text:style-name="P3" loext:marker-style-name="T19"><text:span text:style-name="T19">or Bloom books</text:span></text:p>
