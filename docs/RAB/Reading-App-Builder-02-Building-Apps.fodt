     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P147" loext:marker-style-name="T3"><text:span text:style-name="T3">Line of a chorus (more indentation)</text:span><text:span text:style-name="T3"/></text:p>
