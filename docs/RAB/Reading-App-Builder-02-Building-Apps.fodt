    </table:table-row>
    <table:table-row table:style-name="Table4.3">
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">s</text:span><text:span text:style-name="T3"/></text:p>
