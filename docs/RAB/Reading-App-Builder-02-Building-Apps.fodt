     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123779" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.<text:span text:style-name="T10"><text:tab/></text:span>Registration Screen<text:span text:style-name="T50"><text:tab/>53</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123780" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">17.1.</text:span><text:span text:style-name="T11"><text:tab/></text:span><text:span text:style-name="T3">Setting up the Registration Screen in Reading App Builder</text:span><text:span text:style-name="T50"><text:tab/>54</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123781" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">17.2.</text:span><text:span text:style-name="T11"><text:tab/></text:span><text:span text:style-name="T3">Setting up the database in the Google Firebase console</text:span><text:span text:style-name="T50"><text:tab/>54</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123782" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T41">18.</text:span><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T41">EPUB</text:span><text:span text:style-name="T50"><text:tab/>57</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123783" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T41">19.</text:span><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T41">Publishing and Distribution</text:span><text:span text:style-name="T50"><text:tab/>59</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P41" loext:marker-style-name="T41"/>
   <text:h text:style-name="P55" text:outline-level="1" loext:marker-style-name="T41"><text:bookmark-start text:name="_Toc172123722"/><text:span text:style-name="T41">Preparing content for your app</text:span><text:bookmark-end text:name="_Toc172123722"/><text:span text:style-name="T41"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T41"><text:span text:style-name="T41">Before you build an app with Reading App Builder (RAB), you need to get your content (text, images and audio) into formats that RAB can handle.</text:span><text:span text:style-name="T41"/></text:p>
   <text:p text:style-name="P41" loext:marker-style-name="T41"/>
   <text:h text:style-name="P76" text:outline-level="2" loext:marker-style-name="T41"><text:bookmark-start text:name="_Toc172123723"/><text:span text:style-name="T41">Preparing text</text:span><text:bookmark-end text:name="_Toc172123723"/><text:span text:style-name="T41"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T41"><text:span text:style-name="T41">The text needs to be in one of the following formats:</text:span><text:span text:style-name="T41"/></text:p>
   <text:p text:style-name="P41" loext:marker-style-name="T41"/>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P250" loext:marker-style-name="T43"><text:span text:style-name="T43">Word document (.docx)</text:span><text:span text:style-name="T43"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P77" loext:marker-style-name="T41"><text:span text:style-name="T41">RAB can import text and images from Microsoft Word (.docx) documents. This is the recommended format for text and is likely to be used by most users of RAB.</text:span><text:span text:style-name="T41"/></text:p>
   <text:p text:style-name="P77" loext:marker-style-name="T41"><text:span text:style-name="T41">When Word documents are displayed in the app, basic formatting will be preserved such as character styles (bold, italic, underline), numbered lists, bullet points, hyperlinks and simple tables. </text:span><text:span text:style-name="T41"/></text:p>
   <text:p text:style-name="P77" loext:marker-style-name="T41"><text:span text:style-name="T41">To define separate chapters or pages, insert page breaks using CTRL+Enter.<text:line-break/></text:span><text:span text:style-name="T41"/></text:p>
   <text:p text:style-name="P42" loext:marker-style-name="T41"/>
   <text:list xml:id="list172253250312722" text:continue-numbering="true" text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P250" loext:marker-style-name="T43"><text:span text:style-name="T43">Bloom books (.bloompub)</text:span><text:span text:style-name="T43"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P77" loext:marker-style-name="T12"><text:span text:style-name="T41">RAB can create apps with books created with Bloom. </text:span><text:span text:style-name="T12">It uses an embedded Bloom Player, as used in the Bloom Reader app.</text:span></text:p>
   <text:p text:style-name="P78" loext:marker-style-name="T12"><text:span text:style-name="T12">To create a Bloom Reader file for use in RAB:</text:span><text:span text:style-name="T12"/></text:p>
   <text:list text:style-name="WWNum49">
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:span text:style-name="T12">Open the Bloom book in </text:span><text:span text:style-name="T15">Bloom</text:span><text:span text:style-name="T12">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:span text:style-name="T12">Select the </text:span><text:span text:style-name="T15">Publish</text:span><text:span text:style-name="T12"> tab at the top of the Bloom screen.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:span text:style-name="T12">Select </text:span><text:span text:style-name="T15">Bloom Reader</text:span><text:span text:style-name="T12"> on the left of the screen.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:soft-page-break/><text:span text:style-name="T12">Select the option </text:span><text:span text:style-name="T15">Save Bloom Reader File</text:span><text:span text:style-name="T12">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:span text:style-name="T12">Click the </text:span><text:span text:style-name="T15">Save</text:span><text:span text:style-name="T12"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P256" loext:marker-style-name="T12"><text:span text:style-name="T12">Save the Bloom book to your computer as a </text:span><text:span text:style-name="T15">.bloompub</text:span><text:span text:style-name="T12"> file. This is the file that you will need in Reading App Builder.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P80" loext:marker-style-name="T12"><draw:frame text:anchor-type="as-char" draw:z-index="80" draw:name="Shape3" draw:style-name="gr2" draw:text-style-name="P394" svg:width="5.9862in" svg:height="5.3059in">
