   <text:p text:style-name="P95" loext:marker-style-name="T51"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum48">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P190" loext:marker-style-name="T51"><text:span text:style-name="T51">Now return to the Configuration menu of your phone. Look for the Developer Options menu item. You might see </text:span><text:span text:style-name="T57">Developer Options</text:span><text:span text:style-name="T51"> above the </text:span><text:span text:style-name="T57">About Phone</text:span><text:span text:style-name="T51"> menu item. If you do not see it here, it could be in </text:span><text:span text:style-name="T57">System</text:span><text:span text:style-name="T51"> settings, under </text:span><text:span text:style-name="T57">Advanced</text:span><text:span text:style-name="T51">. Different phones place Developer Options in different places, so look around your Configuration menu until you find it.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P6" loext:marker-style-name="T51"><draw:custom-shape text:anchor-type="char" draw:z-index="98" draw:name="Shape5" draw:style-name="gr1" draw:text-style-name="P393" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.45138888888889in 2.88541666666667in)">
