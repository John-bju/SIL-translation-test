    <text:index-body>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123722" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T41">1.</text:span><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T41">Preparing content for your app</text:span><text:span text:style-name="T50"><text:tab/>6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123723" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.1.<text:span text:style-name="T11"><text:tab/></text:span>Preparing text<text:span text:style-name="T50"><text:tab/>6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123724" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.2.<text:span text:style-name="T11"><text:tab/></text:span>Preparing images<text:span text:style-name="T50"><text:tab/>8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123725" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.3.<text:span text:style-name="T11"><text:tab/></text:span>Preparing audio<text:span text:style-name="T50"><text:tab/>8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123726" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T41">2.</text:span><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T41">How to build your first app</text:span><text:span text:style-name="T50"><text:tab/>8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123727" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.<text:span text:style-name="T10"><text:tab/></text:span>Installing the app on your phone<text:span text:style-name="T50"><text:tab/>11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc172123728" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T41">4.</text:span><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T41">App Creation Basics</text:span><text:span text:style-name="T50"><text:tab/>15</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123729" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.1.<text:span text:style-name="T11"><text:tab/></text:span>How should I choose the app package name?<text:span text:style-name="T50"><text:tab/>15</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123730" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.2.<text:span text:style-name="T11"><text:tab/></text:span>Do I have to create a new keystore for each app, or can I reuse the same keystore for several of my apps?<text:span text:style-name="T50"><text:tab/>16</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc172123731" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.3.<text:span text:style-name="T11"><text:tab/></text:span>I don’t like the name “Reading App”. Have you thought of calling the app something else?<text:span text:style-name="T50"><text:tab/>16</text:span></text:a></text:p>
