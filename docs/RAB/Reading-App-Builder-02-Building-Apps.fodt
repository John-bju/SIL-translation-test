   <text:p text:style-name="Standard" loext:marker-style-name="T47"><text:span text:style-name="T47">You can choose to associate a single audio file with the whole picture story book, or one audio file per page.</text:span><text:span text:style-name="T47"/></text:p>
   <text:p text:style-name="P52" loext:marker-style-name="T47"/>
   <text:p text:style-name="P52" loext:marker-style-name="T47"/>
   <text:h text:style-name="P76" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc172123755"/><text:span text:style-name="T3">How do I define a picture story book?</text:span><text:bookmark-end text:name="_Toc172123755"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">Picture story books can be defined in one of three formats:</text:span><text:span text:style-name="T22"/></text:p>
   <text:list xml:id="list2600565477" text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P328" loext:marker-style-name="T22"><text:span text:style-name="T22">Microsoft Word (.docx) documents,</text:span><text:span text:style-name="T22"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P328" loext:marker-style-name="T22"><text:span text:style-name="T22">Bloom books, or </text:span><text:span text:style-name="T22"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P328" loext:marker-style-name="T22"><text:span text:style-name="T22">Text files using standard format markers (SFM).</text:span><text:span text:style-name="T22"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P23" loext:marker-style-name="T22"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:soft-page-break/><text:span text:style-name="T22">See </text:span><text:span text:style-name="T22"><text:bookmark-ref text:reference-format="number" text:ref-name="_Ref459720727">12.2</text:bookmark-ref></text:span><text:span text:style-name="T22"><text:s/>and </text:span><text:span text:style-name="T22"><text:bookmark-ref text:reference-format="number" text:ref-name="_Ref459720737">12.3</text:bookmark-ref></text:span><text:span text:style-name="T22"><text:s/>for a description of these formats.<text:line-break/></text:span></text:p>
   <text:h text:style-name="P76" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc172123756"/><text:bookmark-start text:name="_Ref459720727"/><text:span text:style-name="T3">What do picture story books in Word documents look like?</text:span><text:bookmark-end text:name="_Toc172123756"/><text:bookmark-end text:name="_Ref459720727"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">To create a Microsoft Word document to define a picture story book:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P329" loext:marker-style-name="T3"><text:span text:style-name="T3">Start with a new blank document in Word.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P330" loext:marker-style-name="T3"><text:span text:style-name="T3">Insert a picture at the top of the first page. </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P331" loext:marker-style-name="T3"><text:span text:style-name="T3">Add the story text for this page below the image.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P80" loext:marker-style-name="T3"><draw:frame draw:style-name="fr4" draw:name="Object1" text:anchor-type="as-char" svg:width="5.9791in" svg:height="4.639in" draw:z-index="0"><draw:object-ole>
