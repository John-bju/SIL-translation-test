   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P347" loext:marker-style-name="T28"><text:span text:style-name="T28">Type the style name into the dialog box and press OK.</text:span><text:span text:style-name="T28"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P86" loext:marker-style-name="T3"><text:span text:style-name="T3">Do this for c, s, q1 and q2.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:list xml:id="list172253779460210" text:continue-list="list172253981111140" text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P343" loext:marker-style-name="T3"><text:span text:style-name="T3">Apply the above styles to all the chapter numbers, song titles and the lines of the song lyrics. </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P86" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">To apply a style:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P348" loext:marker-style-name="T3"><text:span text:style-name="T3">Select the line/paragraph to which you want to apply the style.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P348" loext:marker-style-name="T3"><text:span text:style-name="T3">Click on the down arrow to the right of the styles ribbon.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
