    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P330" loext:marker-style-name="T3"><text:span text:style-name="T3">Insert a page break after the text using </text:span><text:span text:style-name="T13">CTRL+Enter</text:span><text:span text:style-name="T3">, or </text:span><text:span text:style-name="T13">Insert</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T61"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T13">Page Break</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P330" loext:marker-style-name="T3"><text:span text:style-name="T3">Continue adding additional pages in this way.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P330" loext:marker-style-name="T3"><text:span text:style-name="T3">Save the document in </text:span><text:span text:style-name="T13">.docx</text:span><text:span text:style-name="T3"> format.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P17" loext:marker-style-name="T3"/>
   <text:p text:style-name="P17" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">You can add images to the document in .jpeg, .jpg, .png, .tif or .gif formats and Microsoft Word will convert them automatically to the format recognised by Reading App Builder.</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="P17" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pictures are not compressed within the app at present, so if you have large image files it is best to resize them. You can do this either before adding them to the document or within Word itself:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P334" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Select one of the images in Word.<text:line-break/></text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P333" loext:marker-style-name="T3"><text:span text:style-name="T3">Click </text:span><text:span text:style-name="T13">Compress Pictures</text:span><text:span text:style-name="T3"> on the picture format ribbon or toolbar.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P32" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P333" loext:marker-style-name="T3"><text:span text:style-name="T3">Select </text:span><text:span text:style-name="T13">All Pictures in document</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P333" loext:marker-style-name="T3"><text:span text:style-name="T3">Select the resolution as </text:span><text:span text:style-name="T13">Web/Screen</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P17" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T26"><draw:frame text:anchor-type="as-char" draw:z-index="104" draw:name="Shape18" draw:style-name="gr2" draw:text-style-name="P394" svg:width="2.2921in" svg:height="3.0488in">
