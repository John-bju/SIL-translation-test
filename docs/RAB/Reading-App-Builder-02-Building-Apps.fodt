   <text:list text:continue-numbering="true" text:style-name="WWNum48">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P190" loext:marker-style-name="T51"><text:span text:style-name="T51">Tap on </text:span><text:span text:style-name="T57">Developer Options</text:span><text:span text:style-name="T51"> and ensure that it is turned on.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P190" loext:marker-style-name="T51"><text:span text:style-name="T51">Scroll down the Developer Options page and find </text:span><text:span text:style-name="T57">USB Debugging</text:span><text:span text:style-name="T51">. Enable this setting. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
