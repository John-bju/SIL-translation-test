     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P147" loext:marker-style-name="T3"><text:span text:style-name="T3">Song title</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table4.4">
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">q1</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P147" loext:marker-style-name="T3"><text:span text:style-name="T3">Line of the song</text:span><text:span text:style-name="T3"/></text:p>
