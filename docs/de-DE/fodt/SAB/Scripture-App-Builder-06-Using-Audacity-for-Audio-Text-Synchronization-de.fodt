      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">22.858863 22.858863 3b</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">25.613723 25.613723 4a</text:span><text:span text:style-name="T26"/></text:p>
