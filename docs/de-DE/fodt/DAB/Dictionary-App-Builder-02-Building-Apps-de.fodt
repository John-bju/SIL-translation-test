   <text:p text:style-name="P83" loext:marker-style-name="T29"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum24">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P27" loext:marker-style-name="T29"><text:span text:style-name="T29">Now return to the Configuration menu of your phone. Look for the Developer Options menu item. You might see </text:span><text:span text:style-name="T34">Developer Options</text:span><text:span text:style-name="T29"> above the </text:span><text:span text:style-name="T34">About Phone</text:span><text:span text:style-name="T29"> menu item. If you do not see it here, it could be in </text:span><text:span text:style-name="T34">System</text:span><text:span text:style-name="T29"> settings, under </text:span><text:span text:style-name="T34">Advanced</text:span><text:span text:style-name="T29">. Different phones place Developer Options in different places, so look around your Configuration menu until you find it.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T29"><draw:custom-shape text:anchor-type="char" draw:z-index="4" draw:name="Shape3" draw:style-name="gr2" draw:text-style-name="P122" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.45138888888889in 2.88541666666667in)">
