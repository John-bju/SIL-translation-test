      <text:list-item>
       <text:p text:style-name="P27" loext:marker-style-name="T29"><text:soft-page-break/><text:span text:style-name="T29">Tap on </text:span><text:span text:style-name="T34">Developer Options</text:span><text:span text:style-name="T29"> and ensure that it is turned on.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P27" loext:marker-style-name="T29"><text:span text:style-name="T29">Scroll down the Developer Options page and find </text:span><text:span text:style-name="T34">USB Debugging</text:span><text:span text:style-name="T29">. Enable this setting. </text:span></text:p>
      </text:list-item>
