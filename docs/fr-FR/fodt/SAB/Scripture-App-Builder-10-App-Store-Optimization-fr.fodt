     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc77935149" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">1.</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T3">Introduction</text:span><text:span text:style-name="T16"> 4</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc77935150" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">2.</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T3">Comment améliorer la découverte?</text:span><text:span text:style-name="T16"> 4</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935151" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.1.<text:span text:style-name="T14"> </text:span>Make the most of the app name/title<text:span text:style-name="T16"> 6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935152" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.2.<text:span text:style-name="T14"> </text:span>Inclure beaucoup de mots-clés dans la description<text:span text:style-name="T16"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935153" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>2.3.<text:span text:style-name="T14"> </text:span>Use the language (or languages) that people are most likely to search with<text:span text:style-name="T16"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935154" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.4.<text:span text:style-name="T14"> </text:span>Translate your app store page into different languages<text:span text:style-name="T16"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T10"><text:a xlink:type="simple" xlink:href="#_Toc77935155" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T3">Comment améliorer le taux de conversion ?</text:span><text:span text:style-name="T16"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935156" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.1.<text:span text:style-name="T14"> </text:span>How can we improve on-metadata factors to optimise the conversion rate?<text:span text:style-name="T16"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935157" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.1.1.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Icône d&apos;application</text:span><text:span text:style-name="T16"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935158" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.1.2.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Description</text:span><text:span text:style-name="T16"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935159" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.1.3.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Captures d&apos;écran</text:span><text:span text:style-name="T16"> 10</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T11"><text:a xlink:type="simple" xlink:href="#_Toc77935160" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>3.2.<text:span text:style-name="T14"> </text:span>How can we influence off-metadata factors to optimise the conversion rate?<text:span text:style-name="T16"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935161" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.1.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Nombre d’installations</text:span><text:span text:style-name="T16"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935162" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.2.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Évaluations</text:span><text:span text:style-name="T16"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T12"><text:a xlink:type="simple" xlink:href="#_Toc77935163" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.3.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T3">Revues</text:span><text:span text:style-name="T16"> 13</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:h text:style-name="P5" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc77935149"/><text:span text:style-name="T3">Introduction</text:span><text:bookmark-end text:name="_Toc77935149"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous avez construit une application géniale, mais les gens peuvent-ils la trouver, et veulent-ils l&apos;installer?</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">When we talk about </text:span><text:span text:style-name="T6">App Store Optimization (ASO)</text:span><text:span text:style-name="T3">, we focus on two things: discoverability and conversion.</text:span></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P7" loext:marker-style-name="T3"><text:span text:style-name="T6">Découverte</text:span><text:span text:style-name="T3"> - il est plus facile pour les utilisateurs de trouver votre application sur l&apos;app store. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P7" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T6">Conversion</text:span><text:span text:style-name="T3"> - augmentation de la probabilité qu&apos;un utilisateur installe et essaye votre application une fois qu&apos;elle l&apos;a trouvée.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">En d&apos;autres termes, nous ne voulons pas seulement créer des applications : nous voulons que les gens trouvent les applications, les installent et les utilisent. </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Nous allons commencer par nous pencher sur le domaine de la découverte.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"><text:s/></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc77935150"/><text:span text:style-name="T3">Comment améliorer la découverte?</text:span><text:bookmark-end text:name="_Toc77935150"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Comment les utilisateurs trouveront-ils votre application sur Google Play ou sur l&apos;App Store d&apos;Apple ? Il peut y avoir plusieurs voies :</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P8" loext:marker-style-name="T3"><text:span text:style-name="T6">Recherche</text:span><text:span text:style-name="T3"> dans l&apos;app store, par exemple en tapant des mots-clés dans la zone de recherche de l&apos;application Google Play, comme « Minyanka Bible».</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">En cliquant sur une </text:span><text:span text:style-name="T6">annonçant</text:span><text:span text:style-name="T3"> d&apos;une campagne de marketing que vous avez payée, e. . en utilisant Google Ads ou Facebook Ads.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Links from </text:span><text:span text:style-name="T6">other websites</text:span><text:span text:style-name="T3">, such as language community forums.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Liens pour </text:span><text:span text:style-name="T6">applications liées</text:span><text:span text:style-name="T3">, e.g. vous regardez la page magasin d&apos;une application de dictionnaire et vous voyez qu&apos;il y a aussi une application biblique disponible pour la même langue, ou une application intéressante du même développeur.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Recommendations from </text:span><text:span text:style-name="T6">friends</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P36" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Le premier d&apos;entre eux, la recherche à l&apos;aide de mots-clés dans l&apos;app store est susceptible d&apos;être l&apos;une des principales sources de nouveaux utilisateurs. Que pouvons-nous faire pour augmenter la probabilité que quelqu&apos;un dans votre public cible trouve votre application lors de la recherche dans le magasin ? Nous devons d&apos;abord réfléchir aux mots-clés qu&apos;ils pourraient taper dans la barre de recherche, et deuxièmement nous devons nous assurer que tant de ces mots-clés apparaissent sur la page magasin de notre application.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="P43" loext:marker-style-name="T3"><text:span text:style-name="T3">Si votre application est dans </text:span><text:span text:style-name="T6">Google Play</text:span><text:span text:style-name="T3">, les éléments suivants de la page de votre magasin d&apos;applications sont indexés pour les mots-clés :</text:span></text:p>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">le nom de l&apos;application/titre</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">la description courte (affichée sur la page d&apos;accueil de l&apos;application)</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">la description longue (affichée lorsque l&apos;utilisateur clique sur « À propos de cette application»)</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">the app package name (not shown when viewing apps on a phone, but visible in the browser address bar when viewing on a computer)</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">le nom du développeur</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="P32" loext:marker-style-name="T3"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="43" draw:name="Text Box 2" draw:style-name="gr9" draw:text-style-name="P48" svg:width="1.0512in" svg:height="0.5059in" svg:x="4.978in" svg:y="1.9075in">
     <text:p text:style-name="P4" loext:marker-style-name="T17"><text:span text:style-name="T17">Nom du développeur</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
