   <text:p text:style-name="P3" loext:marker-style-name="T7"><text:span text:style-name="T7">Éditeur d&apos;applications bibliques : Optimisation de l&apos;App Store</text:span><text:span text:style-name="T7"/></text:p>
   <text:p text:style-name="P37" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><text:span text:style-name="T3">©️ 2021, SIL International</text:span><text:span text:style-name="T3"/></text:p>
