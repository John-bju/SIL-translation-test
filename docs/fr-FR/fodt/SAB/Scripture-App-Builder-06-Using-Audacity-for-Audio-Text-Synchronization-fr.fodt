    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P31" loext:marker-style-name="T3"/>
   <text:p text:style-name="P65" loext:marker-style-name="T3"><text:span text:style-name="T3">ou comme ceci :</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P26" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr3" draw:name="Frame3" text:anchor-type="as-char" svg:width="4.6252in" svg:height="2.9898in" draw:z-index="0">
     <draw:text-box>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">3.1886823.1886821</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">7.4150847.415084 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">12.93409112.934091 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">16.74660316.7466032</text:span><text:span text:style-name="T26"/></text:p>
