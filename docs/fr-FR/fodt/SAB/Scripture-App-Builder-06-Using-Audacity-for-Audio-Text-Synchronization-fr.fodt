   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list xml:id="list164750263384114" text:continue-list="list4003500379" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P7" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235212"/><text:span text:style-name="T3">Démarrer</text:span><text:bookmark-end text:name="_Toc500235212"/><text:span text:style-name="T3"/></text:h>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P12" text:outline-level="2"><text:bookmark-start text:name="_Toc500235213"/>Listes de phrases<text:bookmark-end text:name="_Toc500235213"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">To help you identify when to mark a timing break, we recommend you create </text:span><text:span text:style-name="T23">Phrase Lists</text:span><text:span text:style-name="T22">. Ils arrangeront les phrases ligne par ligne pour vous.</text:span></text:p>
   <text:p text:style-name="P50" loext:marker-style-name="T22"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">To create phrase lists for each of the chapters in your app:</text:span><text:span text:style-name="T22"/></text:p>
   <text:list text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P72" loext:marker-style-name="T22"><text:span text:style-name="T22">Lancez </text:span><text:span text:style-name="T24">Scripture App Builder</text:span><text:span text:style-name="T22">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P71" loext:marker-style-name="T22"><text:span text:style-name="T22">Accédez à la page </text:span><text:span text:style-name="T24">Collection de livres</text:span><text:span text:style-name="T22"> pour votre application.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P71" loext:marker-style-name="T22"><text:span text:style-name="T22">Allez dans l&apos;onglet </text:span><text:span text:style-name="T24">Synchronisation Audio</text:span><text:span text:style-name="T22"> .</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P71" loext:marker-style-name="T22"><text:soft-page-break/><text:span text:style-name="T22">Cliquez sur </text:span><text:span text:style-name="T24">Créez des listes de phrases</text:span><text:span text:style-name="T22"> et suivez les instructions dans l&apos;assistant.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P50" loext:marker-style-name="T22"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">Un ensemble de documents Word (.docx), de fichiers séparés par des virgules (.csv) ou de fichiers séparés par des tabulations, sera créé, un pour chaque chapitre.</text:span><text:span text:style-name="T22"/></text:p>
   <text:p text:style-name="P50" loext:marker-style-name="T22"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">Un document de liste de phrases ressemble à ce qui suit :</text:span><text:span text:style-name="T22"/></text:p>
   <text:p text:style-name="P50" loext:marker-style-name="T22"/>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Frame5" text:anchor-type="as-char" svg:width="5.5543in" draw:z-index="0">
     <draw:text-box fo:min-height="5.2209in">
      <text:p text:style-name="P4">Matiyu 2</text:p>
      <text:p text:style-name="style0">(Matthieu 2)</text:p>
      <text:p text:style-name="style0"/>
      <table:table table:name="Table1" table:style-name="Table1">
       <table:table-column table:style-name="Table1.A"/>
       <table:table-column table:style-name="Table1.B"/>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">1</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Isa hayandi Betelehem,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Žude gandaa ra,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">kokoyoo kaŋ se i ga nee Herod zamanoo ra.</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Handaray bayraykoyniyaŋ ne ka hun waynahunay ka kaa Žerizalem,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">2</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">je n&apos;arrive pas à :</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">«Man Alyahuudey kokoyoo kaŋ hayandi?</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Ir dii nga handaraa waynahunay.</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Ir kaa ka sujudʼa se.»</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">3</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">Ka&lt;unk&gt; kokoyoo Hérode maa woo,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">a zalba,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T30"><text:span text:style-name="T30">de </text:span><text:span text:style-name="T29">Žerizalem kul zalbʼa bande.</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">4</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">A na jamaa sargari juwalkey jineborey nda Citaaboo baykey marga hala i ma nga bayrandi nongoo kaŋ ra Almasihu ga hima ka hayandi.</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">5</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">I nee a se:</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">«Betelehem kaŋ goo Žude,</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table1.1">
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="P103" loext:marker-style-name="T29"/>
        </table:table-cell>
        <table:table-cell table:style-name="Table1.A1" office:value-type="string">
         <text:p text:style-name="style0" loext:marker-style-name="T29"><text:span text:style-name="T29">zama hayaa ne kaŋ annaboo nʼa hantum:</text:span><text:span text:style-name="T29"/></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
      <text:p text:style-name="Frame_20_contents"/>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Chaque ligne du document de liste de phrases représente une phrase de chronométrage distincte qui devra être marquée.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">You can define which characters are recognised as phrase ending characters in the </text:span><text:span text:style-name="T7">Features</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T35"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Audio</text:span><text:span text:style-name="T3"> page of Scripture App Builder. Par défaut, il est : un point d&apos;arrêt complet (.), un point d&apos;interrogation (?), un point d&apos;exclamation (!), un point virgule (:) et une virgule (,).</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-list="list164750263384114" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2"><text:bookmark-start text:name="_Toc500235214"/><text:span text:style-name="T22">Installer</text:span> Audacity<text:bookmark-end text:name="_Toc500235214"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Installez le programme d&apos;édition sonore </text:span><text:span text:style-name="T7">Audacity</text:span><text:span text:style-name="T3"> si vous ne l&apos;avez pas déjà. Veuillez consulter </text:span><text:span text:style-name="T7">Annexe : Comment installer Audacity</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P16" loext:marker-style-name="T3"><draw:frame draw:style-name="fr5" draw:name="Image3" text:anchor-type="as-char" svg:width="3.5138in" svg:height="1.389in" draw:z-index="0"><draw:image xlink:href="SAB06/3.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/jpeg"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list xml:id="list164749370621879" text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P10" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235215"/><text:span text:style-name="T3">Produire des fichiers de Timing</text:span><text:bookmark-end text:name="_Toc500235215"/><text:span text:style-name="T3"/></text:h>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P32" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P66" loext:marker-style-name="T3"><text:span text:style-name="T3">Lancez Audacity.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P32" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P66" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Open the MP3 file using </text:span><text:span text:style-name="T7">File</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T35"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Open</text:span><text:span text:style-name="T3"> on the main menu.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Si le fichier est stéréo avec deux pistes, il peut être utile de le réduire en mono pour ce processus afin qu&apos;il ne prenne pas autant de place sur votre écran. Faites cela avec </text:span><text:span text:style-name="T7">Piste </text:span><text:span text:style-name="T7">Piste stéréo à Mono</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Zoom deux fois pour qu&apos;il soit plus facile de voir les écarts entre les formes d&apos;ondes audio.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image4" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.3555in" draw:z-index="0"><draw:image xlink:href="SAB06/4.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P75" loext:marker-style-name="T3"><text:span text:style-name="T3">Ayez le texte de l&apos;Écriture ou la Liste de Phrase ouverte sur le chapitre que vous écouterez. </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P78" loext:marker-style-name="T4"><text:span text:style-name="T4">Vous pouvez afficher le texte dans une autre fenêtre (i.e. demander à l&apos;Audacity de prendre la partie gauche de l&apos;écran et le texte de l&apos;Écriture à droite, ou avoir les écrans disposés en haut et en bas de l&apos;écran), mais cela peut être gênant car vous devrez faire défiler le texte de temps en temps, puis cliquer dans la fenêtre Audacity pour lui donner un nouveau focus. Pendant que vous faites cela, vous pourriez perdre votre place et manquer une pause de verset. Ce qui peut mieux fonctionner, c&apos;est si vous avez un texte imprimé devant vous ou si le texte est déjà sur un smartphone ou une tablette. Ensuite, vous pouvez vous concentrer plus complètement sur le texte et éviter la complication de basculer entre les fenêtres.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Déplacez le curseur juste avant le début du premier verset (c&apos;est-à-dire après tout titre ou titre de chapitre). </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P76" loext:marker-style-name="T3"><text:span text:style-name="T3">Placez le premier marqueur d&apos;étiquette en utilisant </text:span><text:span text:style-name="T7">CTRL-B</text:span><text:span text:style-name="T3"> Une trace d&apos;étiquette sera créée.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P79" loext:marker-style-name="T4"><text:span text:style-name="T4">If you are using a Mac, the shortcut to use is </text:span><text:span text:style-name="T6">Command B</text:span><text:span text:style-name="T4">.</text:span></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image5" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.3555in" draw:z-index="0"><draw:image xlink:href="SAB06/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P76" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Tapez le numéro « 1 » dans ce premier label. Cela indique que « le verset 1 commence ici ».</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P36" loext:marker-style-name="T3"/>
   <text:p text:style-name="P80" loext:marker-style-name="T4"><text:span text:style-name="T4">Le curseur devrait déjà être dans l&apos;étiquette, vous devez donc appuyer sur la touche « 1 » après avoir appuyé sur CTRL+B ci-dessus.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P21" loext:marker-style-name="T4"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Appuyez sur « Jouer » pour commencer à écouter l&apos;audio. Au fur et à mesure que vous écoutez, placez une étiquette à chaque saut de timing (phrase ou niveau de verset) en utilisant </text:span><text:span text:style-name="T7">CTRL-M</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P81" loext:marker-style-name="T4"><text:span text:style-name="T4">Vous n&apos;avez pas vraiment besoin de regarder Audacity pour cela. Il suffit de suivre le texte de près et de continuer à appuyer sur CTRL-M lors des pauses de verset.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P82" loext:marker-style-name="T36"/>
   <text:p text:style-name="P80" loext:marker-style-name="T4"><text:span text:style-name="T4">If you are using a Mac, the shortcut to use is </text:span><text:span text:style-name="T6">Command </text:span><text:span text:style-name="T4">. – qui est Commandement et période (.) ensemble.</text:span></text:p>
   <text:p text:style-name="P22" loext:marker-style-name="T4"/>
   <table:table table:name="Table2" table:style-name="Table2">
    <table:table-column table:style-name="Table2.A"/>
    <table:table-column table:style-name="Table2.B"/>
    <table:table-column table:style-name="Table2.C"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table2.1">
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="P23" loext:marker-style-name="T6"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T7"><text:span text:style-name="T7">Windows</text:span><text:span text:style-name="T7"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T7"><text:span text:style-name="T7">Mac</text:span><text:span text:style-name="T7"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table2.1">
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Ajouter une étiquette à la sélection</text:span><text:span text:style-name="T3"/></text:p>
      <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">(à la position du curseur en pause)</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T3"><text:span text:style-name="T3">CTRL-B</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T3"><text:span text:style-name="T3">Commande B</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table2.1">
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Ajouter une étiquette à la position de lecture</text:span><text:span text:style-name="T3"/></text:p>
      <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">(at current position when playing audio)</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T4"><text:span text:style-name="T3">CTRL-M</text:span><text:span text:style-name="T4"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="P3" loext:marker-style-name="T3"><text:span text:style-name="T3">Commande .</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P17" loext:marker-style-name="T4"><text:span text:style-name="T4">Mappages de clés par défaut pour ajouter des étiquettes</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P22" loext:marker-style-name="T4"/>
   <text:p text:style-name="P81" loext:marker-style-name="T4"><text:span text:style-name="T6">Utilisation A:</text:span><text:span text:style-name="T4"> Au lieu d&apos;appuyer sur deux touches ensemble (CTRL-M) pour ajouter une étiquette, il est plus facile de réaffecter la liaison de la clé à une seule clé, comme F1. Voir Section 4 : Conseils d&apos;utilisation pour plus de détails sur la façon de procéder.</text:span></text:p>
   <text:p text:style-name="P37" loext:marker-style-name="T3"/>
   <text:p text:style-name="P37" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Lorsque vous commencez un nouveau verset, tapez le numéro de verset dans l&apos;étiquette pendant que l&apos;audio est toujours en cours de lecture. </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P81" loext:marker-style-name="T4"><text:span text:style-name="T4">Si vous êtes rapide, vous trouverez qu&apos;il n&apos;est pas nécessaire d&apos;arrêter l&apos;audio pour cela. Le curseur est déjà dans le nouveau libellé, donc tout ce que vous avez à faire est de taper les nombres. Si vous manquez de taper un numéro de verset, vous pouvez toujours y revenir à la fin.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image6" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.3555in" draw:z-index="0"><draw:image xlink:href="SAB06/6.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P83" loext:marker-style-name="T3"><text:span text:style-name="T3">Si vous perdez votre chemin, arrêtez la lecture, refaites quelques secondes et appuyez à nouveau. </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P84" loext:marker-style-name="T31"/>
   <text:p text:style-name="P83" loext:marker-style-name="T3"><text:span text:style-name="T3">To delete a label you have placed by accident, press the </text:span><text:span text:style-name="T7">DELETE</text:span><text:span text:style-name="T3"> key when the label is selected.</text:span></text:p>
   <text:p text:style-name="P38" loext:marker-style-name="T3"/>
   <text:p text:style-name="P38" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Lorsque vous avez fini de placer des étiquettes pour tout le chapitre, retournez à chaque étiquette : </text:span><text:span text:style-name="T3"/></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P77" loext:marker-style-name="T3"><text:span text:style-name="T3">Déplacez-le légèrement si vous avez manqué le milieu de la section vide entre les versets. Faites cela en faisant glisser le cercle au milieu du marqueur.</text:span><text:span text:style-name="T3"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P77" loext:marker-style-name="T3"><text:span text:style-name="T3">Tapez les numéros de verset dans les étiquettes qui viennent au début des versets (si vous ne l&apos;avez pas fait auparavant) :</text:span><text:span text:style-name="T3"/></text:p>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P77" loext:marker-style-name="T3"><text:span text:style-name="T3">&quot;1&quot; pour l&apos;étiquette avant le premier verset, </text:span><text:span text:style-name="T3"/></text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P77" loext:marker-style-name="T3"><text:span text:style-name="T3">&quot;2&quot; pour l&apos;étiquette avant le deuxième verset, </text:span><text:span text:style-name="T3"/></text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P77" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">&quot;6-7&quot; pour les versets pondérés, etc.<text:line-break/></text:span><text:span text:style-name="T3"/></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P16" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image7" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.3555in" draw:z-index="0"><draw:image xlink:href="SAB06/7.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T3"/>
   <text:p text:style-name="P81" loext:marker-style-name="T4"><text:span text:style-name="T4">Une autre façon d&apos;ajouter des légendes d&apos;étiquette est via </text:span><text:span text:style-name="T6">Tracks </text:span><text:span text:style-name="T35">&lt;unk&gt;</text:span><text:span text:style-name="T6"> Modifier les étiquettes...</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T4">C&apos;est un moyen plus facile d&apos;ajouter des numéros de verset rapidement. Vous pouvez également supprimer les étiquettes indésirables ici.<text:line-break/>   </text:span></text:p>
   <text:p text:style-name="P3" loext:marker-style-name="T4"><draw:frame draw:style-name="fr6" draw:name="Image8" text:anchor-type="as-char" svg:width="5.9846in" svg:height="2.7744in" draw:z-index="0"><draw:image xlink:href="SAB06/8.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P20" loext:marker-style-name="T4"/>
   <text:p text:style-name="P81" loext:marker-style-name="T3"><text:span text:style-name="T3">Pendant ce processus, vous serez en mesure de voir si vous avez manqué un verset quelque part ou si vous avez ajouté un marqueur indésirable qui doit être supprimé.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P37" loext:marker-style-name="T3"/>
   <text:p text:style-name="P22" loext:marker-style-name="T4"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P74" loext:marker-style-name="T3"><text:span text:style-name="T3">Exporter la trace du label vers un fichier texte en utilisant </text:span><text:span text:style-name="T7">Fichier </text:span><text:span text:style-name="T7">Exporter des étiquettes...</text:span><text:span text:style-name="T3">Choisissez un nom tel que LANG-GEN-01.txt (pour Genesis chapitre 1), LANG-GEN-02.txt (pour Genesis chapitre 2), etc., où LANG est le nom de la langue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P76" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Ouvrir le fichier de synchronisation dans un éditeur de texte tel que Notepad. Vous devriez voir quelque chose comme ça :</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr3" draw:name="Frame6" text:anchor-type="as-char" svg:width="4.6252in" svg:height="2.9898in" draw:z-index="0">
     <draw:text-box>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">3.1886823.1886821</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">7.4150847.415084 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">12.93409112.934091 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">16.74660316.7466032</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">19.82961519.829615 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">20.90579620.905796 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">21.88401821.8840183</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">22.85886322.858863 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">25.61372325.6137234</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">27.10850827.108508 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">30.19283230.192832 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">31.38858731.388587 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">32.68398932.6839895</text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">36.44002736.440027 </text:span><text:span text:style-name="T26"/></text:p>
      <text:p text:style-name="P5" loext:marker-style-name="T26"><text:span text:style-name="T26">38.297624 38.297624 </text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P76" loext:marker-style-name="T3"><text:span text:style-name="T3">The three columns are </text:span><text:span text:style-name="T4">From</text:span><text:span text:style-name="T3">, </text:span><text:span text:style-name="T4">To</text:span><text:span text:style-name="T3"> and </text:span><text:span text:style-name="T4">Label</text:span><text:span text:style-name="T3">. Assurez-vous que tous les numéros de verset sont présents. Si vous avez manqué un numéro de verset quelque part, corrigez-le dans le fichier texte ou dans Audacity et exportez à nouveau.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Le fichier de timing est maintenant prêt à être utilisé dans une application.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:s/></text:p>
   <text:list xml:id="list164750875268630" text:continue-list="list164749370621879" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P8" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235216"/><text:span text:style-name="T3">Assistant</text:span><text:bookmark-end text:name="_Toc500235216"/><text:span text:style-name="T3"/></text:h>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Si vous utilisez Audacity sous Windows, il y a un utilitaire utile qui facilitera considérablement le marquage des étiquettes. Il s&apos;appelle </text:span><text:span text:style-name="T8">Timing Labels Assistant (TLA)</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P61" loext:marker-style-name="T3"><text:span text:style-name="T3">TLA est construit avec </text:span><text:a xlink:type="simple" xlink:href="http://www.autohotkey.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T3">AutoHotKey</text:span></text:span></text:a><text:span text:style-name="T3"> pour simuler des traits de touches dans Windows. Il vous permet de spécifier un fichier de phrases et d&apos;insérer le nom de l&apos;étiquette (1a, 2b, etc.). pour vous automatiquement lorsque vous appuyez sur la touche pour ajouter l&apos;étiquette suivante.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous pouvez le trouver ici : </text:span><text:a xlink:type="simple" xlink:href="https://github.com/indiamcq/timing-labels-assistant" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://github.com/indiamcq/timing-labels-assistant</text:span></text:a> </text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Téléchargez le fichier zip, </text:span><text:span text:style-name="T8">Timing-Labels-Assistant_v1.2.29. ip</text:span><text:span text:style-name="T3"> (ou une version plus récente), et décompressez-le dans un dossier accessible en écriture sur votre ordinateur (c&apos;est-à-dire pas dans les fichiers programmes). L&apos;exécutable principal TLA est appelé </text:span><text:span text:style-name="T8">Timing-Labels-Assistant.exe</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">To use TLA:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum21">
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Run the </text:span><text:span text:style-name="T8">Create Phrase Lists </text:span><text:span text:style-name="T3">wizard within Scripture App Builder to create a set of tab-delimited .phrases files for the book chapters you want to synchronize. C’est la 3ème option dans le choix des types de fichiers.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Ouvrir </text:span><text:span text:style-name="T8">Audacity</text:span><text:span text:style-name="T3"> avec le fichier audio à synchroniser et zoomer sur la forme d&apos;onde 2-3 fois.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Lancez </text:span><text:span text:style-name="T8">Timing-Labels-Assistant.exe</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Choisissez le fichier .phrases correspondant au fichier audio que vous avez ouvert dans Audacity. Il sera ouvert pour vous dans Notepad.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Arrangez Notepad sur le côté de votre fenêtre Audacity pour que vous puissiez voir les deux.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Commencer à lire l&apos;audio.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Appuyez sur la touche </text:span><text:span text:style-name="T8">TAB</text:span><text:span text:style-name="T3"> ou la touche </text:span><text:span text:style-name="T8">+</text:span><text:span text:style-name="T3"> sur le clavier numérique pour placer un marqueur. (Ce qui est beaucoup plus simple que d&apos;appuyer sur CTRL+M). Les marqueurs apparaîtront dans l&apos;ordre dans lequel ils se trouvent dans le fichier .phrases.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P86" loext:marker-style-name="T3"><text:span text:style-name="T3">If markers do not appear when you press TAB or +, check that CTRL+M is still associated with the command </text:span><text:span text:style-name="T7">Add Label at Playback Position</text:span><text:span text:style-name="T10">. Voir la section 5.2 pour plus de détails.</text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum21">
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous entendrez un bip quand la liste des marqueurs arrivera à sa fin.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">To restart from a given label:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P87" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Cliquez sur l&apos;icône dans la barre des tâches et sélectionnez </text:span><text:span text:style-name="T8">Redémarrez le timing à l&apos;étiquette…</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T3"><text:span text:style-name="T3">Entrez le libellé à partir duquel vous voulez commencer, par ex. 3b.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P88" loext:marker-style-name="T3"><text:span text:style-name="T3">Appuyez sur </text:span><text:span text:style-name="T8">OK</text:span><text:span text:style-name="T3"> et continuez à partir de l&apos;étape 6 ci-dessus.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour quitter :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P87" loext:marker-style-name="T3"><text:span text:style-name="T3">Cliquez sur l&apos;icône dans la barre des tâches et sélectionnez </text:span><text:span text:style-name="T8">Quitter</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list164750560468603" text:continue-list="list164750875268630" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P9" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235217"/><text:span text:style-name="T3">Conseils d&apos;utilisation</text:span><text:bookmark-end text:name="_Toc500235217"/><text:span text:style-name="T3"/></text:h>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235218"/><text:span text:style-name="T3">Conseil #1 : Changer la liaison clavier de la barre d’espacement</text:span><text:bookmark-end text:name="_Toc500235218"/><text:span text:style-name="T3"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Par défaut, la barre d’espacement est assignée à lecture/arrêt. C&apos;est bien, mais le problème est que si vous arrêtez quelque part, puis recommencez à nouveau, la lecture retourne à la position de départ originale plutôt que de jouer à partir de l&apos;endroit où vous vous êtes arrêté. </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour modifier ceci :</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P89" loext:marker-style-name="T3"><text:span text:style-name="T3">Aller à </text:span><text:span text:style-name="T7">Modifier</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Préférences</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Clavier</text:span><text:span text:style-name="T3">.<text:line-break/></text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P89" loext:marker-style-name="T3"><text:span text:style-name="T3">Sélectionnez la ligne </text:span><text:span text:style-name="T7">Jouer/Arrêt et définissez le curseur</text:span><text:span text:style-name="T3">. Pour le trouver rapidement, tapez « play/stop» dans le champ de recherche en haut.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P81" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous recherchez la ligne qui se termine par «…» et « Curseur» plutôt que simplement « Jouer/arrêter». </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T3"><draw:frame draw:style-name="fr5" draw:name="Image9" text:anchor-type="as-char" svg:width="5.7346in" svg:height="3.6134in" draw:z-index="0"><draw:image xlink:href="SAB06/9.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P89" loext:marker-style-name="T3"><text:span text:style-name="T3">Changer la liaison de la touche pour cette ligne à Space (plutôt que Maj + A).</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P89" loext:marker-style-name="T3"><text:span text:style-name="T3">Presser </text:span><text:span text:style-name="T7">Définir</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P27" loext:marker-style-name="T3"/>
   <text:p text:style-name="P26" loext:marker-style-name="T3"/>
   <text:p text:style-name="P26" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P90" loext:marker-style-name="T3"><text:span text:style-name="T3">On vous demandera si vous voulez effectuer le changement. Cliquez sur </text:span><text:span text:style-name="T7">OK</text:span><text:span text:style-name="T3"> pour faire ceci.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P35" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T3"><draw:frame draw:style-name="fr5" draw:name="Image10" text:anchor-type="as-char" svg:width="3.9791in" svg:height="2.7398in" draw:z-index="0"><draw:image xlink:href="SAB06/10.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P89" loext:marker-style-name="T3"><text:span text:style-name="T3">Cliquez sur </text:span><text:span text:style-name="T7">OK</text:span><text:span text:style-name="T3"> pour enregistrer les modifications dans les Préférences.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="P34" loext:marker-style-name="T3"><text:s/></text:p>
   <text:list xml:id="list164750241644890" text:continue-list="list164750560468603" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235219"/><text:span text:style-name="T3">Conseil #2 : Changer la liaison clavier pour ajouter une étiquette</text:span><text:bookmark-end text:name="_Toc500235219"/><text:span text:style-name="T3"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Au lieu d&apos;appuyer sur deux touches ensemble (</text:span><text:span text:style-name="T7">CTRL-M</text:span><text:span text:style-name="T3">pour ajouter une étiquette, il est plus facile de réaffecter la liaison de la clé à une seule clé, comme </text:span><text:span text:style-name="T7">F1</text:span><text:span text:style-name="T3">. Ensuite, vous avez une main libre pour taper les étiquettes.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T11">NOTE</text:span><text:span text:style-name="T3">: Ce conseil n&apos;est utile que si vous êtes </text:span><text:span text:style-name="T11">pas</text:span><text:span text:style-name="T3"> en utilisant </text:span><text:span text:style-name="T5">Assistant d&apos;étiquettes de chronométrage (TLA)</text:span><text:span text:style-name="T3">. Si vous utilisez TLA, vous devez conserver CTRL-M comme combinaison de clés pour ajouter une étiquette.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P67" loext:marker-style-name="T3"><text:span text:style-name="T3">To change the keyboard binding for adding a label:</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T7"><text:span text:style-name="T3">Aller à </text:span><text:span text:style-name="T7">Modifier</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Préférences</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Clavier</text:span><text:span text:style-name="T3">.<text:line-break/></text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T3"><text:span text:style-name="T3">Sélectionnez la ligne </text:span><text:span text:style-name="T7">Ajouter une étiquette à la position de lecture</text:span><text:span text:style-name="T3">. Pour le trouver rapidement, tapez « ajouter une étiquette» dans le champ de recherche en haut.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image11" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.7709in" draw:z-index="0"><draw:image xlink:href="SAB06/11.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T3"><text:span text:style-name="T3">Tapez la clé que vous voulez utiliser au lieu de </text:span><text:span text:style-name="T7">CTRL-M</text:span><text:span text:style-name="T3">, comme </text:span><text:span text:style-name="T7">F1</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Presser </text:span><text:span text:style-name="T7">Définir</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image12" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.7709in" draw:z-index="0"><draw:image xlink:href="SAB06/12.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P26" loext:marker-style-name="T3"/>
   <text:p text:style-name="P26" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T3"><text:span text:style-name="T3">Si le raccourci clavier que vous avez choisi est déjà utilisé pour une autre fonction, on vous demandera si vous voulez effectuer le changement. Cliquez sur </text:span><text:span text:style-name="T7">OK</text:span><text:span text:style-name="T3"> pour faire ceci.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:p text:style-name="P18" loext:marker-style-name="T3"><draw:frame draw:style-name="fr5" draw:name="Image13" text:anchor-type="as-char" svg:width="3.9063in" svg:height="2.7398in" draw:z-index="0"><draw:image xlink:href="SAB06/13.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:p text:style-name="P34" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P91" loext:marker-style-name="T3"><text:span text:style-name="T3">Cliquez sur </text:span><text:span text:style-name="T7">OK</text:span><text:span text:style-name="T3"> pour enregistrer les modifications dans les Préférences.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:s/></text:p>
   <text:list text:continue-list="list164750241644890" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P9" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235220"/><text:span text:style-name="T3">FAQ</text:span><text:bookmark-end text:name="_Toc500235220"/><text:span text:style-name="T3"/></text:h>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235221"/><text:span text:style-name="T3">Comment puis-je changer les caractères de ponctuation qui sont reconnus comme des marques de fin de phrase ?</text:span><text:bookmark-end text:name="_Toc500235221"/><text:span text:style-name="T3"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">You can define which characters are recognised as phrase ending characters in the </text:span><text:span text:style-name="T7">Features</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T35"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Audio</text:span><text:span text:style-name="T3"> page of Scripture App Builder. </text:span></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous pouvez ajouter des caractères Unicode ici en utilisant le format \uABCD où ABCD est le point de code hexadécimal Unicode, e. . \u061F pour un point d&apos;interrogation arabe, \u1362 pour un arrêt complet éthiopien.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:list xml:id="list164750800182349" text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235222"/><text:span text:style-name="T3">Comment puis-je obtenir que l&apos;application mette en surbrillance du texte dans les chapitres sans aucun numéro de verset ?</text:span><text:bookmark-end text:name="_Toc500235222"/><text:span text:style-name="T3"> </text:span></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P41" loext:marker-style-name="T7"/>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Si vous avez un texte non biblique comme un livre de chansons ou un autre livre de lecture, vous n&apos;aurez normalement pas de numéros de verset. Pour mettre en évidence les phrases et les lignes, indiquez la première phrase ou la première ligne comme « a », la seconde comme « b », la troisième comme « c », etc.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P67" loext:marker-style-name="T6"><text:soft-page-break/><text:span text:style-name="T6">Exemple :</text:span><text:span text:style-name="T6"/></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"><draw:frame draw:style-name="fr2" draw:name="Frame7" text:anchor-type="char" svg:x="0.25in" svg:y="0.2154in" svg:width="4.8752in" draw:z-index="0">
     <draw:text-box fo:min-height="1.2118in">
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\c 10</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\s An Fa Ala, Dubatigi</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="P6" loext:marker-style-name="T27"/>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\q An Fa Ala, Dubatigi,</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\q An bɛ barika da i ye,</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\q Ka i tanu, ka i bato,</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\q I ka kan ni bonya ye.</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\b</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\q2 Kuma duman kɛ ne da la,</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\q2 Ka ne Kisibaa ko fɔ.</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\q2 Aleluya! Aleluya!</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"><text:span text:style-name="T28">\q2 Yesu ye ne kunmabɔ.</text:span><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T28"/>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"><text:s/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"><text:soft-page-break/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Dans cette chanson, étiquetez l&apos;audio comme suit :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list xml:id="list2510712340" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">An Fa Ala, Dubatigi, </text:span><text:span text:style-name="T32">(étiqueté « a »)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Une b&lt;unk&gt; barika de i ye, </text:span><text:span text:style-name="T32">(étiquetée comme &quot;b&quot;)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Ka i tanu, ka i bato, </text:span><text:span text:style-name="T32">(étiqueté &quot;c&quot;)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">I ka kan ni bonya ye.</text:span><text:span text:style-name="T32"> (étiqueté « d »)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92"><text:span text:style-name="T28">Kuma duman k&lt;unk&gt; ne da la, </text:span><text:span text:style-name="T34">(étiqueté &quot;e&quot;)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T28">Ka ne Kisibaa ko fɔ. </text:span><text:span text:style-name="T32">(étiqueté « f »)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Aleluya! </text:span><text:span text:style-name="T32">(étiqueté &quot;g&quot;)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T27">Aleluya! </text:span><text:span text:style-name="T32">(étiqueté &quot;h&quot;)</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Yesu ye ne kunmabɔ. </text:span><text:span text:style-name="T32">(étiqueté « i »)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Notez que le « Aleluya ! Aleluya!” la ligne est divisée en deux en raison du point d&apos;exclamation de fin de phrase au milieu.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour un chapitre plus long, vous allez bientôt manquer de lettres de l&apos;alphabet. Lorsque vous arrivez à “z”, l’étiquette suivante que vous devez utiliser est “aa”, puis “ab”, “ac”, “ad”, etc. Lorsque vous arrivez à “az”, l’étiquette suivante que vous devez utiliser est “ba”, puis “bb”, “bc”, “bd”, etc. En d&apos;autres termes, cela suit une convention de nommage similaire aux noms de colonnes dans une feuille de calcul.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:list xml:id="list164749992793540" text:continue-list="list164750800182349" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235223"/><text:span text:style-name="T3">Puis-je faire séparer l&apos;application par des virgules pour certains versets et pas pour d&apos;autres ?</text:span><text:bookmark-end text:name="_Toc500235223"/><text:span text:style-name="T3"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous pouvez utiliser le niveau de phrase en surbrillance pour scinder certains versets et la plupart du temps pourrait être suffisante pour se diviser sur des arrêts ou des périodes complètes, points d&apos;interrogation et points d&apos;exclamation. Mais dans quelques versets, il serait bon que l&apos;application puisse se diviser par des virgules. </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">For those verses where you would like the app to split on commas, simply add a comma at the end of the first phrase level label for the verse, e.g. “3</text:span><text:span text:style-name="T37">,</text:span><text:span text:style-name="T3">” or “6</text:span><text:span text:style-name="T37">,</text:span><text:span text:style-name="T3">” etc. L&apos;application divisera ensuite ce verset par des virgules ainsi que les autres caractères de fin de phrase que vous avez définis.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T6"><draw:frame draw:style-name="fr2" draw:name="Frame8" text:anchor-type="char" svg:x="0.25in" svg:y="0.3256in" svg:width="5.3701in" svg:height="1.2965in" draw:z-index="2">
     <draw:text-box>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\v 1 Yesu ya se Zhude fiige ki ni, Bɛtilɛhɛmu ni, saannaa Hɛrɔdi caŋa ɲii ni. Wu nizexhɔgɔ ki na, a wɔrɔɔ cɛvɛɛ pii di ba na yìri Kilɛ-nɔhɔ na, na nɔ Zheruzalɛmu ni.</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="P6" loext:marker-style-name="T27"/>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T27"><text:span text:style-name="T27">\v 2 A pʼi yegeŋɛ pye na: «Yawutuu wo saan we wʼa se nimɛ ge, mii wu wa wɛ? Wèe ya wu wɔrɔ ɲa, na wèe yaha Kilɛ-nɔhɔ ke na, na ba di ba wu pɛlɛ.»</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:span text:style-name="T6">Exemple :</text:span><text:span text:style-name="T6"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">In this chapter, verse 1 can be split into two sections, split by the “.” in the middle:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:continue-list="list2510712340" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Yesu ya se Zhude fiige ki ni, Bɛtilɛhɛmu ni, saannaa Hɛrɔdi caŋa ɲii ni. </text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Wu nizexhɔgɔ ki na, a wɔrɔɔ cɛvɛɛ pii di ba na yìri Kilɛ-nɔhɔ na, na nɔ Zheruzalɛmu ni.</text:span><text:span text:style-name="T32"> </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Or, alternatively, it can be split into six sections, split by both “.” and “,”:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T4"><text:span text:style-name="T27">Yesu ya se Zhude fiige ki ni, </text:span><text:span text:style-name="T32">(labelled as “1,”) </text:span><text:span text:style-name="T33">– notice the comma after 1a here</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">Bɛtilɛhɛmu ni, </text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">saannaa Hɛrɔdi caŋa ɲii ni. </text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T27">Wu nizexhɔgɔ ki na, </text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">a wɔrɔɔ cɛvɛɛ pii di ba na yìri Kilɛ-nɔhɔ na, </text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T3"><text:span text:style-name="T27">na nɔ Zheruzalɛmu ni.</text:span><text:span text:style-name="T27"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P28" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Unless the comma has been added to the normal phrase-ending characters in </text:span><text:span text:style-name="T7">Features</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T35"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T7">Audio, </text:span><text:span text:style-name="T3">verse 2 will revert to being treated as a whole (labelled as “2”) or split into three with the normal characters. Il peut être divisé en six sections si vous commencez par l&apos;étiquette « 2 ».</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:list text:continue-list="list164749992793540" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235224"/><text:span text:style-name="T3">Comment puis-je l&apos;obtenir pour mettre en surbrillance les rubriques de la section?</text:span><text:bookmark-end text:name="_Toc500235224"/><text:span text:style-name="T3"> </text:span></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P41" loext:marker-style-name="T7"/>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Dans certains fichiers audio, les en-têtes de section sont lus par le narrateur ainsi que par les versets. Pour les inclure dans la mise en évidence, utilisez les étiquettes &apos;s1&apos;, &apos;s2&apos;, &apos;s3&apos;, etc. où ‘s1’ est le titre de la première section, ‘s2’ est le deuxième titre de la section, et ainsi de suite. </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Notez que les « s » sont des minuscules et qu’il n’y a pas d’espace entre les « s » et le nombre.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Utilisez cette même méthode pour d&apos;autres types d&apos;en-têtes, par ex. utiliser « d » comme préfixe pour les titres \d, « sp» comme préfixe pour les titres \sp, « is » pour \is, etc.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour </text:span><text:span text:style-name="T7">les titres de section dans les livres d&apos;images</text:span><text:span text:style-name="T3">, ajouter le numéro de page avant l&apos;étiquette, e. . 1s1, 1s2, 1s3 pour les en-têtes de section sur la première page ; 2s1, 2s2, etc. pour les en-têtes de section sur la deuxième page.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235225"/><text:span text:style-name="T3">Comment puis-je définir la mise en surbrillance texte-audio pour les introductions de livres ?</text:span><text:bookmark-end text:name="_Toc500235225"/><text:span text:style-name="T3"> </text:span></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P41" loext:marker-style-name="T7"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Les introductions de livres n&apos;ont pas de numéros de verset, donc utilisez la procédure décrite dans la FAQ 2 et 3 ci-dessus, i. . - en utilisant la mise en évidence au niveau de la phrase avec « a », « b », « c », « c », etc.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Les sous-titres dans les introductions sont étiquetés comme décrit dans la FAQ 4 ci-dessus, c&apos;est-à-dire « is1 », « is2 », etc.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Dans l&apos;onglet Audio pour les livres dans le constructeur d&apos;applications bibliques, les fichiers audio et temporel pour les introductions doivent être marqués comme le chapitre « 0 ».</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><draw:frame draw:style-name="fr5" draw:name="Image14" text:anchor-type="as-char" svg:width="5.7291in" svg:height="3.2291in" draw:z-index="0"><draw:image xlink:href="SAB06/14.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P40" loext:marker-style-name="T7"/>
   <text:list xml:id="list164750539033988" text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235226"/><text:span text:style-name="T3">Il y a des parties de l’audio où je ne veux aucun texte mis en évidence. Comment puis-je désactiver la mise en surbrillance pendant quelques instants entre les versets?</text:span><text:bookmark-end text:name="_Toc500235226"/><text:span text:style-name="T3"/></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P41" loext:marker-style-name="T7"><text:s/></text:p>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous pouvez désactiver la mise en surbrillance du texte lors des interludes musicaux ou des effets sonores. Pour ce faire, il faut donner une plage aux étiquettes, plutôt que de se situer à un seul point.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Here is an example:</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><draw:frame draw:style-name="fr6" draw:name="Image15" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.3555in" draw:z-index="0"><draw:image xlink:href="SAB06/15.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Dans le fichier de timing ci-dessus :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T3"><text:span text:style-name="T3">La mise en surbrillance du verset 4 commencera à la 4 étiquette et se terminera au début de l&apos;étiquette 5 (comme d&apos;habitude).</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T3"><text:span text:style-name="T3">Le surlignement du verset 5 commencera au point initial de la gamme de 5 étiquettes et se poursuivra jusqu&apos;à la fin de la gamme des 5 étiquettes.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T3"><text:span text:style-name="T3">Rien ne sera mis en évidence entre la fin de la plage de 5 étiquettes et l&apos;étiquette 6.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P93" loext:marker-style-name="T3"><text:span text:style-name="T3">La mise en surbrillance du verset 6 commencera sur l&apos;étiquette.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour créer une plage d&apos;étiquettes, faites glisser la partie &lt; ou &gt; du marqueur d&apos;étiquette.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:s/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:list text:continue-list="list164750539033988" text:style-name="WWNum13">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P11" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235227"/><text:span text:style-name="T3">Je voudrais donner à quelqu’un d’autre la tâche de créer des fichiers de timing. Y a-t-il un moyen de les tester sans avoir besoin de savoir comment construire l&apos;application ?</text:span><text:bookmark-end text:name="_Toc500235227"/><text:span text:style-name="T3"> </text:span></text:h>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P33" loext:marker-style-name="T3"/>
   <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Oui, si vous avez choisi la Distribution Audio par dossier externe ou téléchargement, les fichiers MP3 seront dans un dossier de la carte SD. L&apos;application cherchera un fichier de chronométrage correspondant dans ce dossier si elle n&apos;a pas déjà de fichier de chronométrage à l&apos;intérieur de l&apos;APK.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Le nom du fichier de timing dans ce cas devrait être le même que le fichier mp3, mais avec le </text:span><text:span text:style-name="T7">. extension xt</text:span><text:span text:style-name="T3"> plutôt que </text:span><text:span text:style-name="T7">.mp3</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">So, for example, if you have a file such as </text:span><text:span text:style-name="T7">MYK_MAT_01.mp3</text:span><text:span text:style-name="T3"> in the folder, you can put the file </text:span><text:span text:style-name="T7">MYK_MAT_01.txt</text:span><text:span text:style-name="T3"> in the same place and the app should recognise it. </text:span></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">En utilisant cette méthode, d&apos;autres peuvent travailler à fournir des fichiers de synchronisation pour l&apos;application et à les tester, sans avoir à reconstruire l&apos;application. Une fois que les fichiers de chronométrage fonctionnent, vous pouvez reconstruire l&apos;application et les empaqueter à l&apos;intérieur de l&apos;apk. Ils sont très petits, donc ne devraient pas augmenter la taille de l&apos;apk de manière significative.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:p text:style-name="P25" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:h text:style-name="P9" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc500235228"/><text:span text:style-name="T3">Annexe – Comment installer Audacity</text:span><text:bookmark-end text:name="_Toc500235228"/><text:span text:style-name="T3"/></text:h>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
   <text:list text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P94" loext:marker-style-name="T12"><text:span text:style-name="T12">Download the latest Audacity installation program from the Audacity website: <text:line-break/><text:line-break/> </text:span><text:a xlink:type="simple" xlink:href="http://www.audacityteam.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T9">http://www.audacityteam.org</text:span></text:span></text:a></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P43" loext:marker-style-name="T12"/>
   <text:p text:style-name="P69" loext:marker-style-name="T12"><text:span text:style-name="T12">For version 2.2.0, the filename is </text:span><text:span text:style-name="T9">audacity-win-2.2.0.exe</text:span><text:span text:style-name="T13">. Sa taille est de 19 Mo.</text:span></text:p>
   <text:p text:style-name="P98" loext:marker-style-name="T13"><text:span text:style-name="T13">Il se peut qu&apos;une version plus récente que la 2.2.0 soit disponible. Si c&apos;est le cas, téléchargez cette nouvelle version à la place.</text:span><text:span text:style-name="T13"/></text:p>
   <text:p text:style-name="P45" loext:marker-style-name="T12"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P96" loext:marker-style-name="T12"><text:span text:style-name="T12">Double-cliquez sur </text:span><text:span text:style-name="T9">audacity-win-2.0.exe </text:span><text:span text:style-name="T12">pour démarrer l&apos;installation.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P46" loext:marker-style-name="T12"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P94" loext:marker-style-name="T12"><text:span text:style-name="T12">Sélectionnez l&apos;anglais comme langue à utiliser :<text:line-break/></text:span><text:span text:style-name="T12"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P19" loext:marker-style-name="T12"><draw:frame draw:style-name="fr5" draw:name="Image16" text:anchor-type="as-char" svg:width="3.1146in" svg:height="1.5835in" draw:z-index="0"><draw:image xlink:href="SAB06/16.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P44" loext:marker-style-name="T12"><text:soft-page-break/></text:p>
   <text:p text:style-name="P99" loext:marker-style-name="T12"><text:span text:style-name="T12">L&apos;Assistant d&apos;installation s&apos;ouvre :</text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T14"><draw:frame draw:style-name="fr5" draw:name="Image17" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/17.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P42" loext:marker-style-name="T9"><text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P96" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez </text:span><text:span text:style-name="T12">pour continuer.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P100" loext:marker-style-name="T12"><text:span text:style-name="T12">A page of licence information will appear:</text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"><text:span text:style-name="T14"><draw:frame draw:style-name="fr5" draw:name="Image18" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/18.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     </draw:frame></text:span><text:span text:style-name="T14"><text:s/><text:line-break/> </text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P95" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez </text:span><text:span text:style-name="T12">pour continuer.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P102" loext:marker-style-name="T12"><text:span text:style-name="T12">You will see the page </text:span><text:span text:style-name="T9">Select Destination Location</text:span><text:span text:style-name="T12">:</text:span></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"><text:span text:style-name="T14"><draw:frame draw:style-name="fr5" draw:name="Image19" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/19.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     </draw:frame></text:span><text:span text:style-name="T14"><text:s/><text:line-break/> </text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P95" loext:marker-style-name="T12"><text:span text:style-name="T12">L&apos;emplacement suggéré dans lequel installer</text:span><text:alphabetical-index-mark text:string-value=" " text:key1="install"/><text:span text:style-name="T12"> L&apos;Audacity est normalement correct, donc cliquez sur </text:span><text:span text:style-name="T9">Prochaine</text:span><text:span text:style-name="T12">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P102" loext:marker-style-name="T12"><text:soft-page-break/><text:span text:style-name="T12">You’ll see the </text:span><text:span text:style-name="T9">Select Additional Tasks</text:span><text:span text:style-name="T12"> page:<text:line-break/></text:span></text:p>
   <text:p text:style-name="P3" loext:marker-style-name="T12"><draw:frame draw:style-name="fr5" draw:name="Image20" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/20.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P97" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez </text:span><text:span text:style-name="T12">pour continuer.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P102" loext:marker-style-name="T12"><text:span text:style-name="T12">Vous verrez alors la page </text:span><text:span text:style-name="T9">Prêt à installer</text:span><text:span text:style-name="T12"> :<text:line-break/></text:span></text:p>
   <text:p text:style-name="P3" loext:marker-style-name="T9"><text:span text:style-name="T14"><draw:frame draw:style-name="fr5" draw:name="Image21" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/21.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     </draw:frame></text:span><text:span text:style-name="T14"><text:s/><text:line-break/> </text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P95" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez sur </text:span><text:span text:style-name="T9">Installez</text:span><text:span text:style-name="T12"> pour commencer l&apos;installation.<text:line-break/></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P16" loext:marker-style-name="T12"><text:s/><draw:frame draw:style-name="fr5" draw:name="Image22" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/22.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P101" loext:marker-style-name="T12"><text:span text:style-name="T12">When the installation is complete, you will see a page of information:<text:line-break/></text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T12"><text:span text:style-name="T14"><draw:frame draw:style-name="fr5" draw:name="Image23" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/23.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     </draw:frame></text:span><text:span text:style-name="T14"><text:s/><text:line-break/> </text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P95" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez </text:span><text:span text:style-name="T12">pour continuer.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P47" loext:marker-style-name="T12"/>
   <text:p text:style-name="P70" loext:marker-style-name="T12"><text:soft-page-break/><text:span text:style-name="T12">You will then see the final page of the Setup Wizard:</text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image24" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0311in" draw:z-index="0"><draw:image xlink:href="SAB06/24.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P42" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P95" loext:marker-style-name="T12"><text:span text:style-name="T12">Cliquez sur </text:span><text:span text:style-name="T9">Terminez</text:span><text:span text:style-name="T12"> pour fermer l&apos;Assistant d&apos;installation et lancer Audacity.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P47" loext:marker-style-name="T12"/>
   <text:p text:style-name="P70" loext:marker-style-name="T12"><text:span text:style-name="T12">L&apos;authentification est maintenant prête à être utilisée.</text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T3"/>
  </office:text>
 </office:body>
</office:document>