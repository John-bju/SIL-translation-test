    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr2" draw:name="Picture 14" text:anchor-type="as-char" svg:width="5.978in" svg:height="2.5673in" draw:z-index="0"><draw:image xlink:href="SAB07/19.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P43" loext:marker-style-name="T3"/>
   <text:p text:style-name="P57" loext:marker-style-name="T28"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="3" draw:name="Text Box 2" draw:style-name="gr8" draw:text-style-name="P87" svg:width="1.3732in" svg:height="0.7094in" svg:x="1.3508in" svg:y="0.028in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T3"><text:span text:style-name="T3">Position actuelle dans le fichier audio pendant la lecture.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="9" draw:name="Text Box 2" draw:style-name="gr8" draw:text-style-name="P87" svg:width="1.3732in" svg:height="0.5059in" svg:x="1.352in" svg:y="0.028in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T3"><text:span text:style-name="T3">Position actuelle dans le fichier audio.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P57" loext:marker-style-name="T28"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="10" draw:name="Text Box 2" draw:style-name="gr8" draw:text-style-name="P87" svg:width="1.3732in" svg:height="0.5059in" svg:x="3.5752in" svg:y="0.0484in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T3"><text:span text:style-name="T3">Pause de la phrase dans le fichier de timing.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P57" loext:marker-style-name="T28"><text:s/></text:p>
   <text:p text:style-name="P57" loext:marker-style-name="T28"/>
   <text:p text:style-name="P57" loext:marker-style-name="T28"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T28"><text:span text:style-name="T28">From the </text:span><text:span text:style-name="T32">Preview Audio</text:span><text:span text:style-name="T28"> viewer, you can play, pause or stop the audio. Une barre verticale qui se déplace affichera la position actuelle dans le fichier audio. Le texte synchronisé sera affiché en bas de la visionneuse lorsque chaque phrase sera lue. Les lignes vertes verticales montrent les sauts de phrase, chacune avec le numéro de verset et de phrase (par exemple 1a, 1b).</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T28"><text:soft-page-break/><text:span text:style-name="T28">Vous pouvez cliquer et faire glisser une ligne de saut de phrase pour ajuster sa position. Utilisez les commandes de zoom pour un positionnement plus précis. Lorsque vous êtes satisfait, fermez la fenêtre de visualisation en utilisant la boîte de fermeture (X) dans le coin supérieur droit. Vous serez invité à enregistrer les modifications dans le fichier de synchronisation sous-jacent.</text:span><text:span text:style-name="T28"/></text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc217376509"/>Ajuster les fichiers de chronométrage à l&apos;aide de la visionneuse Fine Tune Timings<text:bookmark-end text:name="_Toc217376509"/></text:h>
   <text:p text:style-name="P59" loext:marker-style-name="T3"><text:span text:style-name="T3">To fine tune a generated timing file using the browser-based timings viewer:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P27" loext:marker-style-name="T3"><text:span text:style-name="T3">Select a row on the </text:span><text:span text:style-name="T8">Audio Files</text:span><text:span text:style-name="T3"> page, right-click, and select </text:span><text:span text:style-name="T7">Fine Tune Timings</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P85" loext:marker-style-name="T3"><text:span text:style-name="T3">Une page devrait s&apos;ouvrir dans votre navigateur par défaut, ce qui ressemble à ceci :</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T3"><draw:frame draw:style-name="fr2" draw:name="Image 1" text:anchor-type="as-char" svg:width="5.4957in" svg:height="4.4165in" draw:z-index="0"><draw:image xlink:href="SAB07/20.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><text:span text:style-name="T3"><text:line-break/> </text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T3"><text:span text:style-name="T3">Cliquez sur la première ligne de la table pour démarrer la lecture audio. La ligne surlignera en jaune. Vérifiez si l&apos;audio correspond au texte de la phrase en surbrillance.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Dès que vous entendez le premier mot ou deux de la ligne sélectionnée, il semble que le texte et l&apos;audio correspondent exactement, cliquez sur la ligne suivante.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P25" loext:marker-style-name="T28"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T3"><text:span text:style-name="T3">Continuez à cliquer sur chaque ligne pour écouter suffisamment de temps pour déterminer si le chronométrage a été placé au bon endroit, i. . - pas trop tôt et pas trop tard.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P19" loext:marker-style-name="T3"/>
   <text:p text:style-name="P29" loext:marker-style-name="T3"><text:span text:style-name="T3">You can also use the </text:span><text:span text:style-name="T8">N</text:span><text:span text:style-name="T3"> keyboard shortcut to move to the next row.</text:span></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T3"/>
   <text:list xml:id="list164746974611936" text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T3"><text:span text:style-name="T3">If you hear that the timing for a row needs to be fine-tuned, you can move it backwards or forwards by increments:</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:list text:style-name="WWNum41">
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:span text:style-name="T3">cliquez sur le bouton plus (+) pour avancer le temps de début de 0,1 seconde</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">cliquez sur le double plus (++) pour avancer de 1 seconde</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:span text:style-name="T3">cliquez sur le triple-plus (+++) pour avancer de 10 secondes</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:span text:style-name="T3">cliquez sur le bouton moins (–) pour remonter le temps de début de 0,1 seconde</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:span text:style-name="T3">cliquez sur le double-moins (– –) pour revenir en arrière de 1 seconde</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P30" loext:marker-style-name="T3"><text:span text:style-name="T3">cliquez sur le triple-moins (</text:span><text:span text:style-name="T9">– –</text:span><text:span text:style-name="T3">pour remonter de 10 secondes</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P31" loext:marker-style-name="T3"><draw:custom-shape text:anchor-type="char" style:rel-width="40%" style:rel-height="20%" draw:z-index="67" draw:name="Text Box 2" draw:style-name="gr4" draw:text-style-name="P86" svg:width="2.3823in" svg:height="0.7094in" svg:x="3.5736in" svg:y="4.0193in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T3"><text:span text:style-name="T3">Ajuster l&apos;heure de début du chronométrage actuellement sélectionné en utilisant les boutons plus et moins.</text:span></text:p>
