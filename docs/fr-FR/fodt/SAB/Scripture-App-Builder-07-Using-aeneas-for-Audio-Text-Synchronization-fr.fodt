   <text:p text:style-name="P48" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc217376510"/>Raccourcis clavier lorsque vous effectuez un réglage précis dans votre navigateur<text:bookmark-end text:name="_Toc217376510"/></text:h>
   <text:p text:style-name="P60" loext:marker-style-name="T3"><text:span text:style-name="T3">The following keyboard shortcuts are available in the Fine Tuning interface:</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P48" loext:marker-style-name="T3"/>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-column table:style-name="Table10.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P72" loext:marker-style-name="T8"><text:span text:style-name="T8">Clé</text:span><text:span text:style-name="T8"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P70" loext:marker-style-name="T8"><text:span text:style-name="T8">Action</text:span><text:span text:style-name="T8"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A2" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">Barre d’espacement</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B2" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Démarrer/Pause audio</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A3" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">T</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B3" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Enregistrer le fichier de timing</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A4" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">N</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B4" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Start playing from the next row</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A5" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">P</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B5" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Commencez à jouer à partir de la ligne précédente</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A6" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">B</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B6" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Définit l&apos;heure de début de la phrase pour être à la position audio actuelle</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A7" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">A (ou Q)</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B7" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Déplacez l&apos;heure de début de la ligne actuelle en arrière de 1 sec</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A8" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">S</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B8" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Déplacez l&apos;heure de début de la ligne actuelle de 0,1 seconde</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A9" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">D</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B9" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Avancer l&apos;heure de début de la ligne actuelle de 0,1 seconde</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A10" office:value-type="string">
      <text:p text:style-name="P73" loext:marker-style-name="T3"><text:span text:style-name="T3">F</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B10" office:value-type="string">
      <text:p text:style-name="P71" loext:marker-style-name="T3"><text:span text:style-name="T3">Avancer l&apos;heure de début de la ligne courante de 1 sec</text:span><text:span text:style-name="T3"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P50" loext:marker-style-name="T3"/>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc217376511"/>Envoi d&apos;une optimisation des fichiers aux autres<text:bookmark-end text:name="_Toc217376511"/></text:h>
   <text:p text:style-name="P61" loext:marker-style-name="T3"><text:span text:style-name="T3">Si vous voulez bien affiner vos réglages, cela peut prendre beaucoup de temps à vous écouter. Vous pourriez avoir des amis et des collègues qui sont prêts à vous y aider. Il est possible de leur envoyer les fichiers Fine Tuning pour travailler sans qu&apos;ils aient besoin d&apos;installer Scripture App Builder.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P61" loext:marker-style-name="T3"><text:span text:style-name="T3">To do this:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum35">
    <text:list-item>
     <text:p text:style-name="P32" loext:marker-style-name="T3"><text:span text:style-name="T3">Sélectionnez un ou plusieurs livres ou une collection de livres dans le menu de gauche. Faites un clic droit et sélectionnez </text:span><text:span text:style-name="T7">Réglage fin des Timings</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T3"><text:span text:style-name="T3">In the Fine Tuning wizard, choose </text:span><text:span text:style-name="T8">The files will be sent to others to help with the fine tuning</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T3"><text:span text:style-name="T3">On the next page, </text:span><text:span text:style-name="T8">Audio Files</text:span><text:span text:style-name="T3">, choose to copy the audio files (if you have a good internet connection) or choose not to copy them (if your internet connection is limited and you will tell your friends where they can download the audio files).</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">On the next page, </text:span><text:span text:style-name="T8">Zip Files</text:span><text:span text:style-name="T3">, choose to zip the fine tuning files together to send to your friends.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T3"><text:span text:style-name="T3">On the next page, </text:span><text:span text:style-name="T8">Output Folder</text:span><text:span text:style-name="T3">, choose where you would like the files to be created, then click </text:span><text:span text:style-name="T8">Create Files</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T3"><text:span text:style-name="T3">Envoyez les fichiers à vos amis, demandez-leur de les décompresser sur leur ordinateur et de leur expliquer comment ils peuvent travailler sur les timings. Ils peuvent ouvrir le fichier html pour chaque chapitre et qui chargera la page Fine Tune Timings dans leur navigateur. Ils n&apos;ont pas besoin d&apos;avoir installé SAB ou RAB. Une fois terminé, ils devraient enregistrer les timings et vous renvoyer les fichiers de synchronisation modifiés.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P21" loext:marker-style-name="T3"><text:bookmark-end text:name="_Hlk44919204"/></text:p>
   <table:table table:name="Table11" table:style-name="Table11">
    <table:table-column table:style-name="Table11.A"/>
    <table:table-column table:style-name="Table11.B"/>
    <table:table-row table:style-name="Table11.1">
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="P69" loext:marker-style-name="T51"><text:span text:style-name="T45">&lt;unk&gt;</text:span><text:span text:style-name="T51"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.B1" office:value-type="string">
      <text:p text:style-name="P69" loext:marker-style-name="T30"><text:span text:style-name="T30">Il y a actuellement un groupe de bénévoles appelés SAB Assist qui peuvent fouiller la mise au point de projets — même de toutes les bibles. Contactez </text:span><text:a xlink:type="simple" xlink:href="mailto:andrew_shafe@sil.org" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T30">andrew_shafe@sil.org</text:span></text:span></text:a><text:span text:style-name="T30"> pour plus de détails.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P58" loext:marker-style-name="T28"/>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc217376512"/>Affiner les fichiers de chronométrage en utilisant Audacity<text:bookmark-end text:name="_Toc217376512"/></text:h>
   <text:p text:style-name="P59" loext:marker-style-name="T3"><text:span text:style-name="T3">Au lieu d&apos;utiliser la visionneuse Fine Tune Timings, vous pouvez faire des corrections dans Audacity. Pour faire ceci :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P34" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Ouvrez le fichier MP3 audio dans Audacity.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P35" loext:marker-style-name="T3"><text:span text:style-name="T3">Import the timing file, by selecting </text:span><text:span text:style-name="T7">File</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T46"></text:span><text:span text:style-name="T17"> </text:span><text:span text:style-name="T7">Import</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T46"></text:span><text:span text:style-name="T17"> </text:span><text:span text:style-name="T16">Labels…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P35" loext:marker-style-name="T3"><text:span text:style-name="T17">Zoomez sur la forme d&apos;onde.</text:span><text:span text:style-name="T17"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P35" loext:marker-style-name="T3"><text:span text:style-name="T17">Ajustez la position de toutes les étiquettes qui ne sont pas au bon endroit.</text:span><text:span text:style-name="T17"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P35" loext:marker-style-name="T3"><text:span text:style-name="T17">Export the modified labels track, using </text:span><text:span text:style-name="T16">File</text:span><text:span text:style-name="T17"> &gt; </text:span><text:span text:style-name="T16">Export Labels…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P35" loext:marker-style-name="T3"><text:span text:style-name="T17">Testez à nouveau la synchronisation dans le constructeur d&apos;applications bibliques à l&apos;aide de l&apos;utilitaire </text:span><text:span text:style-name="T16">Export vers HTML</text:span><text:span text:style-name="T17"> (voir ci-dessus) pour voir si les problèmes de timing ont été résolus.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P47" loext:marker-style-name="T3"/>
   <text:p text:style-name="P43" loext:marker-style-name="T3"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc217376513"/><text:soft-page-break/><text:span text:style-name="T3">Ajout de voix à eSpeak</text:span><text:bookmark-end text:name="_Toc217376513"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">En utilisant des remplacements de caractères dans </text:span><text:span text:style-name="T8">Synchroniser à l&apos;aide de l&apos;assistant</text:span><text:span text:style-name="T3"> vous trouverez que vous pouvez obtenir de bons résultats de synchronisation pour de nombreuses langues en utilisant les voix eSpeak existantes.</text:span></text:p>
   <text:p text:style-name="P43" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Adding a new voice in eSpeak is not easy, but if you would like to try, please follow the instructions here: </text:span><text:a xlink:type="simple" xlink:href="http://espeak.sourceforge.net/add_language.html" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T3">http://espeak.sourceforge.net/add_language.html</text:span></text:span></text:a><text:span text:style-name="T3"> </text:span></text:p>
  </office:text>
 </office:body>
</office:document>