      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="2" draw:name="Shape14" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (-0.309621409303795) translate (0.399305555555556in 0.436111111111111in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr5" draw:name="Image7" text:anchor-type="as-char" svg:width="4.2382in" svg:height="3.2689in" draw:z-index="0"><draw:image xlink:href="SAB08/11.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T9"/>
   <text:p text:style-name="P18" loext:marker-style-name="T9"/>
   <text:p text:style-name="P18" loext:marker-style-name="T9"><draw:frame draw:style-name="fr2" draw:name="Frame7" text:anchor-type="char" svg:x="4.3646in" svg:y="0.0311in" svg:width="1.75in" svg:height="0.5in" draw:z-index="71">
     <draw:text-box>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T19"><text:span text:style-name="T19">Niveau de microphone d&apos;entrée</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s/><draw:frame draw:style-name="fr2" draw:name="Frame8" text:anchor-type="char" svg:x="0.1252in" svg:y="0.0626in" svg:width="1.75in" svg:height="0.5in" draw:z-index="10">
     <draw:text-box>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T17"><text:span text:style-name="T17">Taille de la police : rendre le texte plus petit ou plus grand</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s text:c="2"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Utilisez les boutons de taille de police en bas à gauche de l&apos;écran pour ajuster la taille du texte afin qu&apos;il soit facile à lire.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">The top left button is a </text:span><text:span text:style-name="T10">Save</text:span><text:span text:style-name="T9"> button, but it does nothing. Vos enregistrements sont enregistrés automatiquement. Cliquer sur le bouton Enregistrer vous rappellera cela.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024691"/><text:span text:style-name="T9">Choisissez le projet Paratext</text:span><text:bookmark-end text:name="_Toc459024691"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Lorsque vous démarrez HearThis pour la première fois, il vous sera demandé de sélectionner un projet Paratext.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><text:soft-page-break/><draw:frame draw:style-name="fr5" draw:name="Image8" text:anchor-type="as-char" svg:width="4.1634in" svg:height="3.2756in" draw:z-index="0"><draw:image xlink:href="SAB08/8.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">If you are already on the main HearThis screen, click the </text:span><text:span text:style-name="T10">Choose Paratext Project</text:span><text:span text:style-name="T9"> button at the top left of the screen to select the project you want to record.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024692"/><text:span text:style-name="T9">Choisissez le livre et le chapitre pour enregistrer</text:span><text:bookmark-end text:name="_Toc459024692"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Vous pouvez sélectionner le livre et le chapitre à enregistrer en cliquant sur les cases bleues ou grises appropriées en haut de l&apos;écran.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><draw:frame draw:style-name="fr2" draw:name="Frame9" text:anchor-type="char" svg:x="2.448in" svg:y="0.0654in" svg:width="1.75in" svg:height="0.3138in" draw:z-index="76">
     <draw:text-box>
      <text:p text:style-name="P3" loext:marker-style-name="T19"><text:span text:style-name="T19">Livres</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="72" draw:name="Shape17" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (-2.2162190841824) translate (3.26319444444444in 0.23125in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:s/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="73" draw:name="Shape18" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (1.03759824031063) translate (2.1875in 1.67013888888889in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr4" draw:name="Image9" text:anchor-type="as-char" svg:width="5.9846in" svg:height="1.4366in" draw:z-index="0"><draw:image xlink:href="SAB08/9.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T9"/>
   <text:p text:style-name="P18" loext:marker-style-name="T9"><draw:frame draw:style-name="fr2" draw:name="Frame10" text:anchor-type="char" svg:x="1.5in" svg:y="0.0854in" svg:width="1.75in" svg:height="0.3138in" draw:z-index="77">
     <draw:text-box>
      <text:p text:style-name="P3" loext:marker-style-name="T17"><text:span text:style-name="T17">Chapitres</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:soft-page-break/><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">L&apos;ensemble de cases supérieur représente les livres de la Bible, avec les livres de l&apos;Ancien Testament sur la première ligne de boîtes et les livres du Nouveau Testament sur la deuxième ligne de boîtes. Genesis est la première boîte de la première ligne et l&apos;Apocalypse est la dernière case de la deuxième ligne.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Le deuxième ensemble de boîtes représente les chapitres du livre sélectionné. Si le livre a une introduction, c&apos;est la première boîte. Puis vient le chapitre 1, 2, 3, etc.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024693"/><text:span text:style-name="T9">Choisissez les parties du texte que vous voulez enregistrer</text:span><text:bookmark-end text:name="_Toc459024693"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Avant de commencer à enregistrer, vous devez décider quelles parties du texte vous voulez enregistrer. Par exemple, Certaines personnes aiment enregistrer les titres de section dans un texte biblique mais d&apos;autres préfèrent les omettre et lire les versets.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Les titres de section sont très utiles dans un texte imprimé, mais il y a certains cas où ils pourraient être moins utiles dans un enregistrement audio. Par exemple :</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P38" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">where section headings are complete phrases that might sound like they are part of the Scripture text, yet out of order;</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P38" loext:marker-style-name="T9"><text:span text:style-name="T9">où les rubriques de section donnent la ligne de punch de l’histoire avant que l’histoire ne soit racontée, par exemple « Jésus calme la tempête ». Vous voudrez peut-être que de nouveaux auditeurs soient attirés dans le drame de cette histoire sans savoir déjà comment elle se termine.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9"><text:line-break/> </text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">To choose the markers to include or omit:</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P39" loext:marker-style-name="T9"><text:span text:style-name="T9">Cliquez sur le bouton </text:span><text:span text:style-name="T10">Paramètres</text:span><text:span text:style-name="T9"> en haut à droite de l&apos;écran HearThis (celui avec l&apos;icône de la broche).</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P20" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P39" loext:marker-style-name="T9"><text:span text:style-name="T9">Vérifiez les styles que vous voulez </text:span><text:span text:style-name="T11">omettez</text:span><text:span text:style-name="T9"> de l&apos;enregistrement.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P27" loext:marker-style-name="T9"><text:span text:style-name="T9">Par exemple, dans l’écran ci-dessous, nous avons coché “s – Heading” ce qui signifie qu’il ne faut pas enregistrer les en-têtes de section.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="74" draw:name="Shape20" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (0.445058959258554) translate (0.71875in 2.08125in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:span text:style-name="T22">3</text:span><text:span text:style-name="T22"><draw:frame draw:style-name="fr5" draw:name="Image10" text:anchor-type="as-char" svg:width="4.052in" svg:height="4.1252in" draw:z-index="0"><draw:image xlink:href="SAB08/10.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     </draw:frame></text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P39" loext:marker-style-name="T9"><text:span text:style-name="T9">Cliquez sur </text:span><text:span text:style-name="T10">OK</text:span><text:span text:style-name="T9"> pour enregistrer les paramètres sélectionnés.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024694"/><text:span text:style-name="T9">Recording the selected chapter</text:span><text:bookmark-end text:name="_Toc459024694"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">The phrases you need to record are displayed in the bottom half of the screen:</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum6">
    <text:list-item>
     <text:p text:style-name="P40" loext:marker-style-name="T9"><text:span text:style-name="T9">La phrase courante à enregistrer est affichée en Jaune.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P40" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Les phrases affichées en WHITE vous montrent le contexte de la phrase courante, c&apos;est-à-dire les phrases qui viennent avant et après.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><draw:frame draw:style-name="fr4" draw:name="Image11" text:anchor-type="as-char" svg:width="5.9846in" svg:height="4.6165in" draw:z-index="0"><draw:image xlink:href="SAB08/11.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T18"><text:span text:style-name="T18">Le texte en jaune est la phrase courante à enregistrer.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Pour commencer à enregistrer la phrase jaune actuelle, soit :</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P41" loext:marker-style-name="T9"><text:span text:style-name="T9">appuyez et maintenez la barre ESACE, ou</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P41" loext:marker-style-name="T9"><text:span text:style-name="T9">cliquez sur le bouton d&apos;enregistrement et maintenez le bouton de la souris enfoncé.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><text:s/><draw:frame draw:style-name="fr5" draw:name="Image12" text:anchor-type="as-char" svg:width="1.6244in" svg:height="0.7398in" draw:z-index="0"><draw:image xlink:href="SAB08/12.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">Le bouton Arrondi est le bouton Enregistrer. Appuyez et maintenez-le enfoncé pour enregistrer.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Au démarrage de l’enregistrement, le bouton rond tournera d’abord ROUGE et, après une seconde, il tournera VERTE. </text:span><text:span text:style-name="T11">Ne parlez pas jusqu&apos;à ce que vous voyez le VERT, sinon la première partie de ce que vous dites sera coupée</text:span><text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image13" text:anchor-type="as-char" svg:width="1.5252in" svg:height="0.6945in" draw:z-index="0"><draw:image xlink:href="SAB08/13.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">Le bouton Enregistrer devient rouge lorsque vous appuyez pour la première fois.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T9"/>
   <text:p text:style-name="P10" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image14" text:anchor-type="as-char" svg:width="1.6846in" svg:height="0.7665in" draw:z-index="0"><draw:image xlink:href="SAB08/14.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T18"><text:span text:style-name="T18">Après une seconde enfoncé le bouton, il devient vert indiquant que vous pouvez commencer à parler.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Lorsque vous avez fini de parler, relâchez la barre d&apos;espace ou le bouton de la souris. Essayez de le faire aussi discrètement que possible pour ne pas avoir de clic dans l’enregistrement.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Pour écouter la phrase que vous venez d&apos;enregistrer, soit</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P42" loext:marker-style-name="T9"><text:span text:style-name="T9">cliquez sur le bouton JOUER, ou</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P42" loext:marker-style-name="T9"><text:span text:style-name="T9">appuyez sur le . clé (période)</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Aimez-vous ce que vous avez enregistré ? </text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P43" loext:marker-style-name="T9"><text:span text:style-name="T9">If </text:span><text:span text:style-name="T11">yes</text:span><text:span text:style-name="T9">, continue to the next phrase by clicking the Right arrow or using the right arrow key.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P43" loext:marker-style-name="T9"><text:span text:style-name="T9">Si </text:span><text:span text:style-name="T11">pas de</text:span><text:span text:style-name="T9">, réenregistrez la même phrase en cliquant à nouveau sur le bouton d&apos;enregistrement. Votre enregistrement précédent de cette phrase sera supprimé.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Suivez ces étapes pour chaque phrase du chapitre. </text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Vous n’avez pas besoin d’écouter chaque phase après l’enregistrement, sauf si vous le souhaitez. Écouter une phrase enregistrée peut être utile si vous ne savez pas si vous avez été suffisamment parlant ou si vous avez prononcé tous les mots avec la bonne expression.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Au fur et à mesure que vous enregistrez chaque verset, vous verrez une petite ligne horizontale bleue apparaître le sélecteur de verset. Pour revenir à un verset, cliquez sur l&apos;une de ces lignes bleues.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="77" draw:name="Shape26" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (1.03759824031063) translate (0.727083333333333in 0.979166666666667in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:soft-page-break/><text:s/><draw:frame draw:style-name="fr2" draw:name="Frame11" text:anchor-type="char" svg:x="0.0008in" svg:y="1.0244in" svg:width="1.75in" svg:height="0.3138in" draw:z-index="79">
     <draw:text-box>
      <text:p text:style-name="P3" loext:marker-style-name="T17"><text:span text:style-name="T17">Versets déjà enregistrés</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Image15" text:anchor-type="as-char" svg:width="5.9846in" svg:height="0.6146in" draw:z-index="0"><draw:image xlink:href="SAB08/15.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024695"/><text:span text:style-name="T9">Publication audio pour utilisation dans le constructeur d&apos;applications bibliques</text:span><text:bookmark-end text:name="_Toc459024695"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">HearThis enregistre chaque phrase dans un fichier séparé. Pour que votre enregistrement soit utilisable par le constructeur d&apos;applications bibliques, vous devez « publier » l&apos;enregistrement. Dans le processus de publication, HearThis fera deux choses:</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P44" loext:marker-style-name="T9"><text:span text:style-name="T9">Il concaténera toutes les phrases enregistrées ensemble dans des fichiers audio MP3 séparés pour chaque chapitre.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P45" loext:marker-style-name="T9"><text:span text:style-name="T9">Il créera des fichiers chronométrés pour chaque chapitre, les fichiers dont le constructeur d&apos;applications bibliques a besoin pour la synchronisation du texte audio.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">To publish your recorded audio files for Scripture App Builder:</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:span text:style-name="T9">Cliquez sur le bouton </text:span><text:span text:style-name="T10">Publier</text:span><text:span text:style-name="T9"> en haut à droite de l&apos;écran HearThis .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:s/></text:p>
   <text:p text:style-name="P27" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">La fenêtre Publier les fichiers sonores apparaîtra.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"/>
   <text:p text:style-name="P16" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="71" draw:name="Shape28" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (-2.78083309720257) translate (5.92291666666667in 0.773611111111111in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="69" draw:name="Shape29" draw:style-name="gr2" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (0.565661210571362) translate (0.0625in 1.45486111111111in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr4" draw:name="Image16" text:anchor-type="as-char" svg:width="5.9846in" svg:height="4.7807in" draw:z-index="0"><draw:image xlink:href="SAB08/16.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">For Audio Format, choose </text:span><text:span text:style-name="T10">Scripture App Builder</text:span><text:span text:style-name="T9">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P20" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:span text:style-name="T9">For Verse Index Format, choose </text:span><text:span text:style-name="T10">Audacity Label File (Scripture App Builder)</text:span><text:span text:style-name="T9"> and check the box </text:span><text:span text:style-name="T10">Include labels for phrase-level clips</text:span><text:span text:style-name="T9">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:span text:style-name="T9">Cliquez sur le bouton </text:span><text:span text:style-name="T10">Publiez</text:span><text:span text:style-name="T9"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P27" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">HearThis travaillera à relier les clips audio enregistrés et à produire les fichiers chronométrés pour la synchronisation du texte audio.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:span text:style-name="T9">Lorsque le processus est terminé, vous devriez voir « Terminé » dans la boîte de message et un lien vers les fichiers de sortie dans le dossier Destination. Cliquez sur le lien Destination pour voir les fichiers.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="68" draw:name="Shape31" draw:style-name="gr1" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (0.594808209079668) translate (0.172222222222222in 2.58680555555556in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:mirror-horizontal="false" draw:mirror-vertical="false" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr5" draw:name="Image17" text:anchor-type="as-char" svg:width="4.9374in" svg:height="3.9445in" draw:z-index="0"><draw:image xlink:href="SAB08/17.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P46" loext:marker-style-name="T9"><text:span text:style-name="T9">Utilisez l&apos;explorateur Windows pour regarder dans les dossiers de sortie. Vous devriez voir deux fichiers pour chaque chapitre : </text:span><text:span text:style-name="T9"/></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P47" loext:marker-style-name="T9"><text:span text:style-name="T9">le </text:span><text:span text:style-name="T10">fichier audio MP3</text:span><text:span text:style-name="T9">, avec un nom tel que XYZ-GEN-001. p3, où XYZ est le code du projet Paratext et GEN est le code du livre de la Bible, dans ce cas Genesis.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P47" loext:marker-style-name="T9"><text:span text:style-name="T9">le fichier de timing </text:span><text:span text:style-name="T10">correspondant</text:span><text:span text:style-name="T9">, avec un nom tel que XYZ-GEN-001.txt.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P29" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Ce sont les fichiers que vous devez ajouter à votre projet d&apos;application dans le constructeur d&apos;applications Scripture. Voir les sections suivantes pour plus de détails.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P17" loext:marker-style-name="T9"/>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024696"/><text:span text:style-name="T9">Écoutez votre audio et faites n&apos;importe quelle modification si nécessaire</text:span><text:bookmark-end text:name="_Toc459024696"/><text:span text:style-name="T9"/></text:h>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024697"/><text:span text:style-name="T9">Écoute des erreurs</text:span><text:bookmark-end text:name="_Toc459024697"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:span text:style-name="T9">Après que HearThis ait généré les fichiers audio pour chaque chapitre, C&apos;est une bonne idée de les jouer et d&apos;écouter attentivement pour vérifier qu&apos;il n&apos;y a pas de problèmes. La meilleure façon de le faire est de porter des écouteurs pour que vous puissiez capturer tous les sons indésirables que vous ne pourrez peut-être pas entendre à travers les haut-parleurs de votre ordinateur.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:span text:style-name="T9">To play an MP3 audio file on your computer:</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P49" loext:marker-style-name="T9"><text:span text:style-name="T9">Sélectionnez le fichier que vous voulez lire dans l&apos;explorateur Windows.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P49" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Double-cliquez dessus pour le lire avec votre lecteur multimédia par défaut.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:span text:style-name="T9">Il arrive souvent que vous trouviez quelques petites modifications que vous devez faire avant de pouvoir mettre l&apos;audio à la disposition des autres.</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P50" loext:marker-style-name="T9"><text:span text:style-name="T9">If the edits are </text:span><text:span text:style-name="T10">errors in reading to correct</text:span><text:span text:style-name="T9">, it is probably best to go back to HearThis, find the phrase which was read incorrectly and re-record it. Après cela, suivez le processus dans la section 5 (Publication de l&apos;audio à utiliser dans le générateur d&apos;applications bibliques) pour produire les fichiers MP3 à nouveau.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P50" loext:marker-style-name="T9"><text:span text:style-name="T9">If the edits are </text:span><text:span text:style-name="T10">short background noises</text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T10">to remove</text:span><text:span text:style-name="T9"> or if you want to </text:span><text:span text:style-name="T10">make pauses between phrases longer or shorter </text:span><text:span text:style-name="T9">you might be able to make these changes in the Audacity audio editing program without re-recording anything. Mais si vous entendez de courtes bruits de fond en même temps que quelqu&apos;un parle (comme l&apos;écorcement des chiens, Il serait préférable de retourner à HearThis et de recenser les sections affectées.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T9"><text:s/></text:p>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024698"/><text:soft-page-break/><text:span text:style-name="T9">Édition de fichiers audio en utilisant Audacity</text:span><text:bookmark-end text:name="_Toc459024698"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:span text:style-name="T9">To edit files generated by HearThis in Audacity:</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T9">Lancez </text:span><text:span text:style-name="T10">Audacity</text:span><text:span text:style-name="T9">. Si vous ne l&apos;avez pas déjà installé sur votre ordinateur, vous pouvez le télécharger ici :</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P33" loext:marker-style-name="T9"><text:a xlink:type="simple" xlink:href="http://www.audacityteam.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://www.audacityteam.org</text:span></text:a> <text:span text:style-name="T9"><text:line-break/></text:span></text:p>
   <text:p text:style-name="P33" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image18" text:anchor-type="as-char" svg:width="1.7701in" svg:height="0.7in" draw:z-index="0"><draw:image xlink:href="SAB08/18.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/jpeg"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P23" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Sélectionner </text:span><text:span text:style-name="T10">Fichier</text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T10">Ouvrir…</text:span><text:span text:style-name="T9"> dans le menu principal et trouvez le fichier audio MP3 que vous voulez modifier. Cliquez sur </text:span><text:span text:style-name="T10">Ouvrez</text:span><text:span text:style-name="T9"> lorsque vous avez sélectionné le nom du fichier.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P29" loext:marker-style-name="T9"><text:span text:style-name="T9">Le fichier audio sera chargé dans Audacity.</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T9">Sélectionnez </text:span><text:span text:style-name="T10">Fichier</text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T10">Importer des étiquettes…</text:span><text:span text:style-name="T9"> et sélectionnez et importez le fichier de timing correspondant (.txt). Par exemple, si vous éditez XYZ-GEN-001.mp3, vous voulez importer le fichier d&apos;étiquettes XYZ-GEN-001.txt.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P29" loext:marker-style-name="T9"><text:span text:style-name="T9">Il est important que vous modifiiez ensemble le fichier MP3 et son fichier texte de synchronisation correspondant. Dans le cas contraire, le fichier de chronométrage ne sera plus synchronisé avec les modifications apportées à l&apos;audio.</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T9">Assurez-vous que </text:span><text:span text:style-name="T10">Tracks</text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T23">&lt;unk&gt;</text:span><text:span text:style-name="T7"> </text:span><text:span text:style-name="T10">Tracks de Verrouillage synchronisé</text:span><text:span text:style-name="T9"> est sélectionné. Cela permettra de s&apos;assurer que les pistes audio et d&apos;étiquette sont verrouillées ensemble et que lorsque vous supprimez une section de la piste audio, une section correspondante est supprimée de l&apos;étiquette. Ou lorsque vous ajoutez une section à la piste audio, une section correspondante est ajoutée à l&apos;étiquette.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T9">Faites les modifications dont vous avez besoin, par exemple supprimer les clics, ajuster la longueur des pauses, etc.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P21" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P31" loext:marker-style-name="T9"><text:span text:style-name="T9">When you have finished editing remember to export both the audio and timings files:</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T9">Export the audio file, using </text:span><text:span text:style-name="T10">File</text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T23"></text:span><text:span text:style-name="T7"> </text:span><text:span text:style-name="T5">Export Audio…</text:span><text:span text:style-name="T7">, en choisissant de sauvegarder sous le type </text:span><text:span text:style-name="T5">Fichiers MP3</text:span><text:span text:style-name="T7">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T9"><text:span text:style-name="T7">Export the timing labels file, using </text:span><text:span text:style-name="T5">File</text:span><text:span text:style-name="T7"> </text:span><text:span text:style-name="T23"></text:span><text:span text:style-name="T7"> </text:span><text:span text:style-name="T5">Export Labels…</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">If you are new to Audacity, a free manual for beginners can be found here:<text:line-break/></text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P48" loext:marker-style-name="T12"><text:span text:style-name="T12">How to do Recording on your Computer: A Beginner&apos;s Guide to Audacity</text:span><text:span text:style-name="T12"/></text:p>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:a xlink:type="simple" xlink:href="http://www.scripture-engagement.org/content/how-do-recording-your-computer" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T9">http://www.scripture-engagement.org/content/how-do-recording-your-computer</text:span></text:span></text:a><text:span text:style-name="T9"> </text:span></text:p>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024699"/><text:span text:style-name="T9">En utilisant les fichiers générés par HearThis dans le constructeur d&apos;applications bibliques</text:span><text:bookmark-end text:name="_Toc459024699"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P48" loext:marker-style-name="T9"><text:span text:style-name="T9">To use the audio MP3 and timing files from HearThis to build an app in Scripture App Builder, do the following:<text:line-break/></text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P52" loext:marker-style-name="T9"><text:span text:style-name="T9">Créez un nouveau projet d&apos;application dans Scripture App Builder ou ouvrez un projet d&apos;application existant.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P53" loext:marker-style-name="T9"><text:span text:style-name="T9">Assurez-vous que le projet contient les livres bibliques dont vous avez besoin.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P53" loext:marker-style-name="T9"><text:span text:style-name="T9">Go to the </text:span><text:span text:style-name="T10">Audio Files</text:span><text:span text:style-name="T9"> page of the book collection.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P53" loext:marker-style-name="T9"><text:soft-page-break/><text:span text:style-name="T9">Cliquez sur </text:span><text:span text:style-name="T10">Ajouter un Audio…</text:span><text:span text:style-name="T9"> et sélectionnez tous les fichiers de synchronisation audio </text:span><text:span text:style-name="T11">et</text:span><text:span text:style-name="T9"> à partir de la sortie HearThe, i. . le MP3 et les fichiers TXT.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P11" loext:marker-style-name="T9"><draw:frame draw:style-name="fr4" draw:name="Image19" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.7673in" draw:z-index="0"><draw:image xlink:href="SAB08/19.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P19" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P53" loext:marker-style-name="T9"><text:span text:style-name="T9">Go to the </text:span><text:span text:style-name="T10">Audio Distribution</text:span><text:span text:style-name="T9"> page of the book collection and choose the method of distributing the audio. La valeur par défaut est « Paquet à l&apos;intérieur du fichier APK ».</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P24" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P54" loext:marker-style-name="T9"><text:span text:style-name="T9">Go to the </text:span><text:span text:style-name="T10">Features </text:span><text:span text:style-name="T23"></text:span><text:span text:style-name="T9"> </text:span><text:span text:style-name="T10">Audio page</text:span><text:span text:style-name="T9"> and specify the phrase-ending characters to correspond to the phrase-ending characters HearThis used. <text:line-break/><text:line-break/></text:span><text:span text:style-name="T11">Important :</text:span><text:span text:style-name="T9"> Par défaut HearThis utilise des caractères de fin de phrase (arrêt complet / période , point d&apos;exclamation), mais il ne divise pas les phrases par des virgules au milieu des phrases. Vous devrez donc supprimer la virgule si elle vous la voyez sur la page des fonctionnalités SAB - sinon votre texte et votre audio ne seront pas synchronisés correctement.<text:line-break/></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T9"><text:soft-page-break/><draw:frame draw:style-name="fr3" draw:name="Image20" text:anchor-type="as-char" svg:y="-2.1902in" svg:width="5.9799in" svg:height="3.7701in" draw:z-index="0"><draw:image xlink:href="SAB08/20.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="79" draw:name="Shape 1" draw:style-name="gr1" draw:text-style-name="P56" svg:width="0.6252in" svg:height="0.2504in" draw:transform="rotate (-2.78083309720257) translate (5.53611111111111in 1.76111111111111in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P55" loext:marker-style-name="T9"><text:span text:style-name="T9">Construisez votre application et essayez-la !</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
   <text:p text:style-name="P22" loext:marker-style-name="T9"/>
  </office:text>
 </office:body>
</office:document>