     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024683" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">1.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Introduction à HearThis</text:span><text:span text:style-name="T20"> 3</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024684" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">2.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Installation de HearThis</text:span><text:span text:style-name="T20"> 3</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024685" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">3.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Configuration de votre microphone et de votre environnement d&apos;enregistrement</text:span><text:span text:style-name="T20"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024686" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>3.1.<text:span text:style-name="T16"> </text:span>Prepare your room to be a recording studio<text:span text:style-name="T20"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024687" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.<text:span text:style-name="T16"> </text:span>Choisissez un bon microphone<text:span text:style-name="T20"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024688" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.3.<text:span text:style-name="T16"> </text:span>Set up the microphone to be the recording device on your computer<text:span text:style-name="T20"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024689" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">4.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Enregistrement audio avec HearThis</text:span><text:span text:style-name="T20"> 6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024690" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.1.<text:span text:style-name="T16"> </text:span>L&apos;écran de coeur<text:span text:style-name="T20"> 6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024691" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.2.<text:span text:style-name="T16"> </text:span>Choisissez le projet Paratext<text:span text:style-name="T20"> 6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024692" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>4.3.<text:span text:style-name="T16"> </text:span>Choose the book and chapter to record<text:span text:style-name="T20"> 7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024693" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.4.<text:span text:style-name="T16"> </text:span>Choose the parts of the text you want to record<text:span text:style-name="T20"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024694" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.5.<text:span text:style-name="T16"> </text:span>Recording the selected chapter<text:span text:style-name="T20"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024695" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">5.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Publication audio pour utilisation dans le constructeur d&apos;applications bibliques</text:span><text:span text:style-name="T20"> 11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024696" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">6.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Écoutez votre audio et faites n&apos;importe quelle modification si nécessaire</text:span><text:span text:style-name="T20"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024697" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.1.<text:span text:style-name="T16"> </text:span>Écoute des erreurs<text:span text:style-name="T20"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc459024698" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>6.2.<text:span text:style-name="T16"> </text:span>Édition de fichiers audio en utilisant Audacity<text:span text:style-name="T20"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc459024699" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T9">7.</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T9">Utilisation des fichiers générés par HearThis dans le constructeur d&apos;applications bibliques</text:span><text:span text:style-name="T20"> 15</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024683"/><text:span text:style-name="T9">Introduction à HearThis</text:span><text:bookmark-end text:name="_Toc459024683"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9"><text:line-break/>HearThis offre une alternative pour les communautés désireuses de traduire du texte biblique sous forme audio. Il est conçu pour faciliter l&apos;enregistrement de la Bible !</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image3" text:anchor-type="as-char" svg:width="2.0673in" svg:height="0.8071in" draw:z-index="0"><draw:image xlink:href="SAB08/3.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">HearThis trouve automatiquement vos traductions Paratext et vous guide à travers l&apos;enregistrement, un peu à la fois. Pas un grand lecteur? Besoin de le relire ? Il vous suffit d&apos;appuyer sur le bouton d&apos;enregistrement et de réessayer. Puis cliquez sur la flèche, et voyez la chose suivante que vous devez lire.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">HearThis peut produire tous les fichiers nécessaires pour ajouter de l&apos;audio lors de l&apos;utilisation de Scripture App Builder – y compris les fichiers de synchronisation de texte audio.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:h text:style-name="P5" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024684"/><text:span text:style-name="T9">Installer HearThis</text:span><text:bookmark-end text:name="_Toc459024684"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">To install HearThis on your computer, do the following:</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P26" loext:marker-style-name="T9"><text:span text:style-name="T9">Go to the HearThis website, </text:span><text:a xlink:type="simple" xlink:href="http://software.sil.org/hearthis" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://software.sil.org/hearthis</text:span></text:a><text:span text:style-name="T9">, select the </text:span><text:span text:style-name="T10">Download</text:span><text:span text:style-name="T9"> page, and download HearThis.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P16" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P27" loext:marker-style-name="T9"><text:span text:style-name="T9">Le nom de fichier est de la forme : </text:span><text:span text:style-name="T10">HearThisInstaller-1.x.msi</text:span><text:span text:style-name="T9"> </text:span></text:p>
   <text:p text:style-name="P30" loext:marker-style-name="T9"><text:span text:style-name="T9"><text:line-break/> </text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P26" loext:marker-style-name="T9"><text:span text:style-name="T9">Double-cliquez sur l&apos;installateur après avoir téléchargé et suivez les instructions de l&apos;assistant d&apos;installation.</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:s/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><draw:frame draw:style-name="fr5" draw:name="Image4" text:anchor-type="as-char" svg:width="5.198in" svg:height="4.0417in" draw:z-index="0"><draw:image xlink:href="SAB08/4.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum8">
    <text:list-item>
     <text:p text:style-name="P26" loext:marker-style-name="T9"><text:span text:style-name="T9">To enable HearThis to write its output as MP3 files, you need to install an additional plug-in called </text:span><text:span text:style-name="T10">Lame</text:span><text:span text:style-name="T9">. (Si vous utilisez l&apos;éditeur de son Audacity, il est possible que vous ayez déjà installé Lame.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P32" loext:marker-style-name="T6"><text:span text:style-name="T7">Download the latest Lame installation program from the Lame website: <text:line-break/><text:line-break/> </text:span><text:a xlink:type="simple" xlink:href="http://lame.buanzo.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T6">http://lame.buanzo.org</text:span></text:span></text:a><text:span text:style-name="T6"> </text:span></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T7"><text:span text:style-name="T7"><text:line-break/>Rechercher le fichier sous le sous-titre </text:span><text:span text:style-name="T6">« POUR TÉLÉCHARGER Lame et FFmpeg pour Windows»</text:span><text:span text:style-name="T7">.</text:span></text:p>
   <text:p text:style-name="P34" loext:marker-style-name="T7"><text:soft-page-break/><text:span text:style-name="T7">The filename to download will be called something like:</text:span><text:span text:style-name="T7"/></text:p>
   <text:p text:style-name="P35" loext:marker-style-name="T6"><text:span text:style-name="T21">Lame_v3.99.3_for_Windows.exe</text:span><text:span text:style-name="T6"/></text:p>
   <text:p text:style-name="P36" loext:marker-style-name="T6"><draw:frame draw:style-name="fr5" draw:name="Image5" text:anchor-type="as-char" svg:width="2.6146in" svg:height="0.7083in" draw:z-index="0"><draw:image xlink:href="SAB08/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P28" loext:marker-style-name="T8"><text:span text:style-name="T8">Il se peut qu&apos;une version plus récente que 3.99.3 soit disponible. Si c&apos;est le cas, téléchargez cette nouvelle version à la place. Ce devrait être un téléchargement rapide car le fichier est petit (environ 500 Ko).</text:span><text:span text:style-name="T8"/></text:p>
   <text:p text:style-name="P37" loext:marker-style-name="T8"><text:span text:style-name="T7">Double-cliquez sur ce fichier .exe téléchargé pour démarrer l&apos;installation et suivez les instructions de l&apos;Assistant d&apos;installation.</text:span><text:span text:style-name="T8"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024685"/><text:span text:style-name="T9">Configuration de votre microphone et de votre environnement d&apos;enregistrement</text:span><text:bookmark-end text:name="_Toc459024685"/><text:span text:style-name="T9"/></text:h>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024686"/><text:span text:style-name="T9">Préparez votre salle à être un studio d&apos;enregistrement</text:span><text:bookmark-end text:name="_Toc459024686"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Choisissez un endroit où enregistrer qui est calme et où vous recevrez quelques interruptions. Pour amortir l&apos;écho dans un petit bureau, vous pouvez placer des matelas et des couvertures en mousse autour de la pièce.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Éteignez tous les ventilateurs ou tous les appareils de climatisation bruyants. Gardez à l&apos;écart des réfrigérateurs ou des horloges. Évitez de taper vos pieds ou de vous balancer d&apos;un côté à l&apos;autre sur une chaise grisante!</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024687"/><text:soft-page-break/><text:span text:style-name="T9">Choisissez un bon microphone</text:span><text:bookmark-end text:name="_Toc459024687"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">HearThis fonctionnera avec n&apos;importe quel microphone, qu&apos;il s&apos;agisse du microphone intégré dans votre ordinateur portable, d&apos;un micro casque ou d&apos;un microphone externe de qualité professionnelle.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T9">Pour un enregistrement de bonne qualité, vous voudrez réduire le bruit de fond. Pour cette raison, il est préférable de ne pas utiliser le microphone interne de votre ordinateur. Il absorbe trop de bruit informatique. </text:span><text:span text:style-name="T3">If you are going to do serious recording work, it is worth investing in a good microphone. En général, plus vous dépensez sur un microphone, plus la qualité de l&apos;enregistrement audio est élevée. </text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Ne tenez pas le microphone dans votre main. Au lieu de cela, mettez-le sur un stand ou utilisez un micro casque de bonne qualité.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><text:soft-page-break/></text:p>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024688"/><text:span text:style-name="T9">Configurez le microphone pour qu&apos;il soit le périphérique d&apos;enregistrement de votre ordinateur</text:span><text:bookmark-end text:name="_Toc459024688"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Connectez le microphone à votre ordinateur et assurez-vous qu&apos;il est sélectionné comme le périphérique d&apos;enregistrement principal. Si vous ne le faites pas correctement, il se peut que votre ordinateur utilise toujours le microphone interne plutôt que celui externe.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">To modify the recording device to use, right-click on the Speaker/Volume icon at the bottom right of your computer screen and select </text:span><text:span text:style-name="T10">Recording devices</text:span><text:span text:style-name="T9">. Ici vous pouvez activer et désactiver les appareils.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P7" loext:marker-style-name="T9"><text:soft-page-break/><draw:frame draw:style-name="fr4" draw:name="Image6" text:anchor-type="as-char" svg:width="2.9583in" svg:height="2.4929in" draw:z-index="0"><draw:image xlink:href="SAB08/6.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P4" text:outline-level="1" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024689"/><text:span text:style-name="T9">Enregistrement audio avec HearThis</text:span><text:bookmark-end text:name="_Toc459024689"/><text:span text:style-name="T9"/></text:h>
   <text:h text:style-name="P6" text:outline-level="2" loext:marker-style-name="T9"><text:bookmark-start text:name="_Toc459024690"/><text:span text:style-name="T9">L&apos;écran de coeur</text:span><text:bookmark-end text:name="_Toc459024690"/><text:span text:style-name="T9"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">L&apos;écran principal HearThis vous présente toutes les commandes dont vous avez besoin pour sélectionner des livres et des chapitres et pour enregistrer des phrases.</text:span><text:span text:style-name="T9"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T9"/>
   <text:p text:style-name="P15" loext:marker-style-name="T9"><draw:custom-shape text:anchor-type="char" draw:z-index="1" draw:name="Shape6" draw:style-name="gr3" draw:text-style-name="P57" svg:width="1.7504in" svg:height="0.3142in" svg:x="3.75in" svg:y="0.098in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T17"><text:span text:style-name="T17">Publier des fichiers sonores</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="mso-spt202" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr2" draw:name="Frame2" text:anchor-type="char" svg:x="0.6252in" svg:y="0.1602in" svg:width="1.75in" svg:height="0.3138in" draw:z-index="8">
     <draw:text-box>
      <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T19"><text:span text:style-name="T17">Choisissez </text:span><text:span text:style-name="T19">Projet Paratext</text:span></text:p>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
