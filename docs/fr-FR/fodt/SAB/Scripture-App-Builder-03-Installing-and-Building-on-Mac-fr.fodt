     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354164" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">18.<text:span text:style-name="T22"> </text:span>Liens profonds pour iOS<text:span text:style-name="T27"> 52</text:span></text:a></text:p>
