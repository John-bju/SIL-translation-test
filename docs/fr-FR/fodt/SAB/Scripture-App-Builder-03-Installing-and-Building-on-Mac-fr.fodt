     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354159" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.1.<text:span text:style-name="T23"> </text:span>Ajout d&apos;une application iOS<text:span text:style-name="T27"> 44</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354160" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.2.<text:span text:style-name="T23"> </text:span>Configuration iOS pour Firebase en SAB<text:span text:style-name="T27"> 48</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354161" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.3.<text:span text:style-name="T23"> </text:span>Prise en charge des fonctionnalités de sécurité dans l&apos;application iOS<text:span text:style-name="T27"> 49</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354162" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>17.4.<text:span text:style-name="T23"> </text:span>Messagerie Firebase<text:span text:style-name="T27"> 49</text:span></text:a></text:p>
