     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354156" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">16.1.<text:span text:style-name="T23"> </text:span>Installation de l&apos;interface de ligne de commande<text:span text:style-name="T27"> 42</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354157" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">16.2.<text:span text:style-name="T23"> </text:span>Options d&apos;interface de ligne de commande<text:span text:style-name="T27"> 42</text:span></text:a></text:p>
