     <table:table-cell table:style-name="Table107.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T201"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T202"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table107.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">A</text:span><text:span text:style-name="T16">s que vous appliquez les styles, la touche F4 peut être utile pour répéter votre action précédente.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P247" loext:marker-style-name="T39"/>
   <text:p text:style-name="P21" loext:marker-style-name="T39"><text:span text:style-name="T39">Toutes les chansons sont contenues dans un seul document Word.</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:continue-list="list164754286240724" text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P491" loext:marker-style-name="T16"><text:span text:style-name="T16">Enregistrer le document au format </text:span><text:span text:style-name="T23">.docx</text:span><text:span text:style-name="T16"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P67" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_What_do_song_1"/><text:bookmark-start text:name="_Toc233871340"/><text:span text:style-name="T39">À quoi ressemblent les livres de chansons au format SFM ?</text:span><text:bookmark-end text:name="_Toc233871340"/><text:bookmark text:name="Section_Song_Books_SFM"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">Commencez avec un identifiant de votre choix (en utilisant seulement </text:span><text:span text:style-name="T23">caractères alphanumériques ou des traits de soulignement</text:span><text:span text:style-name="T16">) :</text:span></text:p>
   <text:p text:style-name="P204" loext:marker-style-name="T16"/>
   <text:p text:style-name="P342" loext:marker-style-name="T156"><text:span text:style-name="T156">\id SONGBOOK1<text:line-break/></text:span><text:span text:style-name="T156"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">et un titre :<text:line-break/></text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P21" loext:marker-style-name="T156"><text:span text:style-name="T156">\toc2 Notre livre de chansons</text:span><text:span text:style-name="T156"/></text:p>
   <text:p text:style-name="P358" loext:marker-style-name="T155"/>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:soft-page-break/><text:span text:style-name="T16">Chaque chanson commence avec le marqueur </text:span><text:span text:style-name="T24">\c</text:span><text:span text:style-name="T16"> et le numéro de la chanson :</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P21" loext:marker-style-name="T155"><text:span text:style-name="T156">\c 1</text:span><text:span text:style-name="T156"/></text:p>
   <text:p text:style-name="P228" loext:marker-style-name="T39"/>
   <text:p text:style-name="P228" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T40">Le marqueur </text:span><text:span text:style-name="T52">\q</text:span><text:span text:style-name="T40"> (ou </text:span><text:span text:style-name="T52">\q1</text:span><text:span text:style-name="T40">)</text:span><text:span text:style-name="T52"> </text:span><text:span text:style-name="T39">est utilisé pour la ligne des paroles de la chanson et </text:span><text:span text:style-name="T52">\q2</text:span><text:span text:style-name="T39"> pour les lignes en retrait, comme pour un choeur. </text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Utiliser </text:span><text:span text:style-name="T52">\b</text:span><text:span text:style-name="T39"> pour des lignes vides entre les versets.</text:span></text:p>
   <text:p text:style-name="P228" loext:marker-style-name="T39"/>
   <text:p text:style-name="P3" loext:marker-style-name="T152"><draw:custom-shape text:anchor-type="as-char" draw:z-index="279" draw:name="Text Box 140" draw:style-name="gr7" draw:text-style-name="P521" svg:width="4.5004in" svg:height="4.5524in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\id BAT</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\toc2 Batoli Betiw</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="P40" loext:marker-style-name="T173"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T165"><text:span text:style-name="T165">\c 1</text:span><text:span text:style-name="T165"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\s Ala Tanu! Aleluya!</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="P40" loext:marker-style-name="T173"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\q An k&apos;Ala tanu</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Ala Denkɛ ko la,</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q O sara ka kunun</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Ka ɲɛnamaya.</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\b</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q2 Ala Tanu! Aleluya!</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q2 Ala Tanu! Amiina!</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q2 Ala Tanu! Aleluya!</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q2 Yesu bɛ na tun.</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\b</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q An bɛɛ tununna</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Dibi Fanga dɛ la,</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Bari Matigi nana,</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q A ye an bɛɛ tila.</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\b</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q A y&apos;an kunmabɔ</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q A y&apos;an bɛɛ hɔrɔnya,</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\q A y&apos;a ni à un k&lt;unk&gt; n&lt;unk&gt;</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\q K&apos;an dusu jɛya.</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\b</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q Yesu mana na,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q A na kɛ Masa ye,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q A na diɲɛ bɛɛ mara,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"><text:span text:style-name="T173">\q Ka Sitanɛ tiɲɛ.</text:span><text:span text:style-name="T173"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T173"/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P356" loext:marker-style-name="T152"/>
   <text:p text:style-name="P3" loext:marker-style-name="T152"><draw:custom-shape text:anchor-type="as-char" draw:z-index="283" draw:name="Text Box 139" draw:style-name="gr4" draw:text-style-name="P521" svg:width="4.5004in" svg:height="2.7106in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T166"><text:span text:style-name="T166">\c 2</text:span><text:span text:style-name="T166"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\s An Fa Ala, Dubatigi</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="P41" loext:marker-style-name="T176"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q An Fa Ala, Dubatigi,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q An bɛ barika da i ye,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q Ka i tanu, ka i bato,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q I ka kan ni bonya ye.</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\b</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q2 Kuma duman kɛ ne da la,</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T176"><text:span text:style-name="T176">\q2 Ka ne Kisibaa ko fɔ.</text:span><text:span text:style-name="T176"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T177"><text:span text:style-name="T177">\q2 Aleluya! Aleluya!</text:span><text:span text:style-name="T177"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T177"><text:span text:style-name="T177">\q2 Yesu ye ne kunmabɔ.</text:span><text:span text:style-name="T177"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\b</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Ne bɛ Ala sira taama,</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T178"><text:span text:style-name="T178">\q An Matigi barika la.</text:span><text:span text:style-name="T178"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T178"><text:span text:style-name="T178">\q Ne y’a dɔn ko Ala sɔnna</text:span><text:span text:style-name="T178"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"><text:span text:style-name="T175">\q Ne ka taa sankolo la</text:span><text:span text:style-name="T175"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T175"/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous êtes habitué à utiliser Paratext, ces codes SFM sont familiers puisqu&apos;ils sont la façon dont vous marquez la poésie dans telle que les psaumes. Pour une liste de marqueurs de poésie, voir </text:span><text:a xlink:type="simple" xlink:href="#_Poetry_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Styles de poésie</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Toutes les chansons sont contenues dans un seul fichier.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">The SFM songbook file must be a </text:span><text:span text:style-name="T52">plain text file</text:span><text:span text:style-name="T39">. Si vous avez des caractères Unicode, les fichiers texte doivent utiliser l&apos;encodage </text:span><text:span text:style-name="T52">UTF-8</text:span><text:span text:style-name="T39">. Pour créer un fichier texte dans Windows, utilisez </text:span><text:span text:style-name="T52">Notepad</text:span><text:span text:style-name="T39">. Pour créer un fichier texte sur un Mac, utilisez </text:span><text:span text:style-name="T52">TextEdit</text:span><text:span text:style-name="T39">, en se rappelant de choisir les fichiers texte bruts dans les préférences, sinon le type de fichier par défaut est RTF (qui contient beaucoup de codes de formatage supplémentaires).</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table108" table:style-name="Table108">
    <table:table-column table:style-name="Table108.A"/>
    <table:table-column table:style-name="Table108.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table108.1">
     <table:table-cell table:style-name="Table108.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table108.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T141"><text:span text:style-name="T90">Lorsque vous ajoutez votre livre à l&apos;application, cliquez sur le livre dans l&apos;arborescence du projet et sélectionnez l&apos;onglet Livre. Assurez-vous que le sélecteur de type livre est réglé sur </text:span><text:span text:style-name="T95">Livre de Chansons</text:span><text:span text:style-name="T90">. Si c&apos;est le cas, SAB affichera automatiquement un index de chansons composé de 2 menus de contenu, l&apos;une est listée par titre de chanson et l&apos;autre par numéro de chanson. </text:span><text:span text:style-name="T141">You can preview them under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Song_Index" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T142">Song Index</text:span></text:span></text:a><text:span text:style-name="T141"> tab.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <table:table table:name="Table109" table:style-name="Table109">
    <table:table-column table:style-name="Table109.A"/>
    <table:table-column table:style-name="Table109.B"/>
    <table:table-row table:style-name="Table109.1">
     <table:table-cell table:style-name="Table109.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table109.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">If you do not see a </text:span><text:a xlink:type="simple" xlink:href="#_The_Song_Index" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Song Index</text:span></text:span></text:a><text:span text:style-name="T39"> tab for the song book, make sure the </text:span><text:span text:style-name="T52">Book Type</text:span><text:span text:style-name="T39"> is set to </text:span><text:span text:style-name="T52">Song Book</text:span><text:span text:style-name="T39">. Si vous essayez d&apos;ajouter une image dans votre livre de chansons en utilisant un marqueur </text:span><text:span text:style-name="T52">\img</text:span><text:span text:style-name="T39"> SAB changera votre type de livre de chansons en livre d&apos;images. À la place, utilisez les marqueurs </text:span><text:span text:style-name="T52">\fig &lt;image filename&gt; \fig*</text:span><text:span text:style-name="T39"> .</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P356" loext:marker-style-name="T152"/>
   <text:h text:style-name="P66" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871341"/><text:span text:style-name="T39">Comment associer l&apos;audio à chaque chanson ?</text:span><text:bookmark-end text:name="_Toc233871341"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Un fichier audio distinct et un fichier de chronométrage correspondant doivent être créés pour chaque chanson.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Les étiquettes de chronométrage sont de la forme :</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P485" loext:marker-style-name="T39"><text:span text:style-name="T190"><text:line-break/></text:span><text:span text:style-name="T39">a - 1ère ligne de la chanson<text:line-break/>b - 2ème ligne de la chanson<text:line-break/>c - 3ème ligne de la chanson </text:span></text:p>
   <text:p text:style-name="P485" loext:marker-style-name="T39"><text:span text:style-name="T39">d - 4ème ligne de la chanson, etc. <text:line-break/></text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">To help with the creation of the timing files, generate phrase lists on the </text:span><text:span text:style-name="T23">Audio Synchronization</text:span><text:span text:style-name="T16"> page for the book.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Il est peu probable que la synchronisation automatique fonctionne pour les morceaux, vous devrez donc utiliser la méthode de marquage manuelle en utilisant l&apos;Assistant Audacity et Timing Labels. Veuillez consulter le document </text:span><text:span text:style-name="T7">Utilisation d&apos;Audacity pour la synchronisation du texte audio</text:span><text:span text:style-name="T16"> pour obtenir des instructions.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <table:table table:name="Table110" table:style-name="Table110">
    <table:table-column table:style-name="Table110.A"/>
    <table:table-column table:style-name="Table110.B"/>
    <table:table-row table:style-name="Table110.1">
     <table:table-cell table:style-name="Table110.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T203"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T204"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table110.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Si le texte de votre chanson correspond exactement aux paroles de la chanson, y compris à toutes les répétitions, vous pouvez créer des fichiers de synchronisation automatiquement à l&apos;aide d&apos;aeneas. Il devient plus difficile s&apos;il y a des introductions musicales ou des conclusions pour les chansons, et surtout s&apos;il y a un ou plusieurs interludes musicaux pendant la chanson.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P399" loext:marker-style-name="T195"><text:soft-page-break/></text:p>
   <text:h text:style-name="P47" text:outline-level="1"><text:bookmark text:name="_User_Accounts"/><text:bookmark-start text:name="_Hlk16004026"/><text:bookmark-start text:name="_Toc233871342"/>Écran d&apos;enregistrement<text:bookmark-end text:name="_Toc233871342"/></text:h>
   <text:p text:style-name="P10"><text:s/></text:p>
   <text:p text:style-name="P10">Vous pouvez définir un écran d&apos;enregistrement à afficher lorsqu&apos;un utilisateur lance l&apos;application pour la première fois. Cela vous permet de collecter des informations de contact, par exemple pour connecter des personnes avec des groupes de discussion de lecture/écoute de la Bible.</text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Picture 170" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="SAB02/92.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 169" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="SAB02/93.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 168" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="SAB02/94.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P16">Pour configurer un écran d&apos;inscription, vous devez faire un travail de configuration en deux endroits :</text:p>
   <text:list text:continue-list="list2556762045" text:style-name="WWNum50">
    <text:list-item>
     <text:p text:style-name="P394">dans le constructeur d&apos;applications bibliques, et</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P393">dans la console Google Firebase.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark-start text:name="_Toc233871343"/>Mise en place de l&apos;écran d&apos;inscription<text:bookmark-end text:name="_Toc233871343"/></text:h>
   <text:p text:style-name="P15">Pour configurer l&apos;écran d&apos;enregistrement dans le constructeur d&apos;application:</text:p>
   <text:list text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P496">Allez à la page <text:span text:style-name="T55">App</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Security</text:span><text:span text:style-name="T16"> page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P496">Sélectionnez <text:span text:style-name="T55">Exiger que chaque utilisateur s&apos;inscrive avec ses détails lorsqu&apos;il utilise l&apos;application</text:span> pour la première fois.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P496">Cliquez sur le bouton <text:span text:style-name="T55">Configurer l&apos;inscription</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P496">Suivez les instructions dans chacun des onglets dans la boîte de dialogue Configurer les inscriptions :</text:p>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Écran d’inscription :</text:span> spécifiez le titre et le texte à afficher sur l’écran d’inscription.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Détails de l&apos;utilisateur :</text:span> spécifiez les champs d&apos;entrée (tels que nom, numéro de téléphone, adresse e-mail), que vous demanderez à l&apos;utilisateur de fournir. Vous pouvez spécifier lesquels sont requis et ceux qui sont optionnels.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:soft-page-break/><text:span text:style-name="T55">Ignorer l&apos;inscription:</text:span> choisissez si vous voulez que l&apos;utilisateur soit en mesure de passer le processus d&apos;inscription. S&apos;ils n&apos;appuient pas sur le bouton Ignorer, indiquez quand vous voulez que l&apos;application leur demande à nouveau.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Inscription terminée :</text:span> spécifiez le titre et le texte à afficher sur l&apos;écran qui est affiché à l&apos;utilisateur après avoir été enregistré avec succès.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Image :</text:span> spécifiez une image à afficher en haut de l&apos;écran, comme le logo de votre organisation ou l&apos;icône de l&apos;application.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Base de données :</text:span> choisir si les données utilisateur seront stockées dans un chemin spécifique à l&apos;application dans la base de données (ce qui est utile si vous utilisez la même base de données pour plusieurs applications), ou au niveau supérieur de la base de données (ce qui est bien si vous n&apos;avez qu&apos;une seule application). Vous trouverez plus d&apos;informations sur la configuration de votre base de données dans la section suivante.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P497"><text:span text:style-name="T55">Styles :</text:span> vous pouvez ajuster le style des écrans en ajustant les déclarations de style.</text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P18"><text:line-break/>Use the <text:span text:style-name="T55">Test</text:span> buttons on the <text:span text:style-name="T55">Registration Screen</text:span> and <text:span text:style-name="T55">Registration Completed</text:span> tabs to preview the screens in a browser.<text:line-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P496">Cliquez sur <text:span text:style-name="T55">OK</text:span> lorsque vous avez terminé dans la boîte de dialogue.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark-start text:name="_Toc233871344"/>Mise en place de la base de données dans la console Google Firebase<text:bookmark-end text:name="_Toc233871344"/></text:h>
   <text:p text:style-name="P15">Pour configurer la base de données, qui contiendra les informations des utilisateurs enregistrés, vous devez ajouter Firebase à votre application, créer une base de données, configurer des règles d&apos;authentification et de configuration.</text:p>
   <text:p text:style-name="P396" loext:marker-style-name="T98"><text:span text:style-name="T98">Ajouter Firebase à votre application</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="P15">Suivez les instructions pour configurer un projet Firebase, décrit dans la section ci-dessus sur <text:a xlink:type="simple" xlink:href="#_Firebase_Analytics" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Analytiques Firebase</text:span></text:a>.</text:p>
   <text:p text:style-name="P15"/>
   <text:p text:style-name="P25" loext:marker-style-name="T98"><text:span text:style-name="T98">Créer une base de données</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="Standard">Pour créer une base de données:</text:p>
   <text:list text:style-name="WWNum60">
    <text:list-item>
     <text:p text:style-name="P498">Dans votre console de projet Firebase, sélectionnez <text:span text:style-name="T55">Base de données en temps réel</text:span> dans le menu à gauche de l&apos;écran (option ci-dessous Firestore Database).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P498">Cliquer sur le bouton <text:span text:style-name="T55">Créer une base de données</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P498">Sur la première page de <text:span text:style-name="T55">Configurer la base de données</text:span>, choisissez où vous souhaitez que les données soient stockées, puis cliquez sur .</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P498">Sur la deuxième page de <text:span text:style-name="T55">Configurer la base de données</text:span>, choisissez <text:span text:style-name="T55">Démarrer en mode verrouillé</text:span>, et cliquez sur <text:span text:style-name="T55">Activer</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P390" loext:marker-style-name="T98"><text:span text:style-name="T98">Configurer l&apos;authentification</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="P26">Pour configurer l&apos;authentification :</text:p>
   <text:list text:style-name="WWNum61">
    <text:list-item>
     <text:p text:style-name="P499">In your Firebase project console, select <text:span text:style-name="T51">Authentication</text:span> from the menu on the left of the screen.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P499">Sélectionnez l&apos;onglet <text:span text:style-name="T51">méthode de connexion</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P499"><text:span text:style-name="T194">Cliquez sur </text:span><text:span text:style-name="T51">Email/Mot de passe</text:span><text:span text:style-name="T194"> et activez cette méthode d&apos;authentification. T</text:span>son est utilisé lors de la visualisation des utilisateurs enregistrés dans un navigateur web</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P499"><text:span text:style-name="T194">Cliquez sur </text:span><text:span text:style-name="T51">Enregistrez</text:span><text:span text:style-name="T194"> pour confirmer vos modifications et retourner à l&apos;onglet de la méthode de connexion.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P499"><text:span text:style-name="T194">Cliquez sur </text:span><text:span text:style-name="T51">Anonyme</text:span><text:span text:style-name="T194"> (au bas de la liste des fournisseurs de connexion de connexion) et activez cette méthode d&apos;authentification.</text:span> Ceci est utilisé lors de l&apos;inscription de l&apos;utilisateur dans l&apos;application.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P499"><text:span text:style-name="T194">Cliquez sur </text:span><text:span text:style-name="T51">Enregistrez</text:span><text:span text:style-name="T194"> pour confirmer vos modifications et retourner à l&apos;onglet de la méthode de connexion.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P26"/>
   <text:p text:style-name="P399" loext:marker-style-name="T195"/>
   <text:p text:style-name="P390" loext:marker-style-name="T98"><text:span text:style-name="T98">Configurer les règles</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="Standard">Les règles sont requises pour indiquer à Firebase qui aura les droits d&apos;accès pour lire et écrire dans la base de données. Pour configurer les règles de la base de données : </text:p>
   <text:list text:style-name="WWNum62">
    <text:list-item>
     <text:p text:style-name="P500">Dans votre console de projet Firebase, sélectionnez <text:span text:style-name="T55">Base de données en temps réel</text:span> dans le menu à gauche de l&apos;écran.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P500">Sélectionnez l&apos;onglet <text:span text:style-name="T51">Règles</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P500">Les règles que vous spécifiez dépendront du chemin que vous avez choisi dans l&apos;onglet <text:span text:style-name="T55">Base de données</text:span> dans la configuration d&apos;enregistrement.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P13">Si vous avez choisi de stocker les informations utilisateur dans un <text:span text:style-name="T55">emplacement spécifique à l&apos;application</text:span>, par exemple « /apps/your-app-package-name/users/», les règles doivent être les suivantes :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:soft-page-break/><text:span text:style-name="T179">{</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;rules&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;apps&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$package&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179"><text:s/>&quot;$uid&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.read&quot;: false,</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P14">Si vous avez choisi de stocker les informations utilisateur au niveau <text:span text:style-name="T55">supérieur de la base de données</text:span>, e. . « /users/», les règles doivent être les suivantes :</text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">{</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;rules&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:soft-page-break/><text:span text:style-name="T179">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$uid&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.read&quot;: false,</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179"><text:s/>}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P17">Ces règles donnent un accès en écriture uniquement à l&apos;utilisateur qui fait l&apos;enregistrement. Personne n&apos;aura accès en lecture (sauf pour vous lorsque vous consultez la base de données depuis la console Firebase). <text:bookmark-end text:name="_Hlk16004026"/></text:p>
   <text:p text:style-name="P17"/>
   <table:table table:name="Table111" table:style-name="Table111">
    <table:table-column table:style-name="Table111.A"/>
    <table:table-column table:style-name="Table111.B"/>
    <table:table-row table:style-name="Table111.1">
     <table:table-cell table:style-name="Table111.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T201"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T202"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table111.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T141"><text:span text:style-name="T5">Assurez-vous de copier exactement les règles. Un moyen facile d&apos;obtenir les règles dont vous avez besoin est de cliquer sur le bouton </text:span><text:span text:style-name="T14">Règles de base de données</text:span><text:span text:style-name="T5"> dans l&apos;onglet Base de données. Cela vous donnera les règles que vous pouvez copier.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P359" loext:marker-style-name="T157"/>
   <table:table table:name="Table112" table:style-name="Table112">
    <table:table-column table:style-name="Table112.A"/>
    <table:table-column table:style-name="Table112.B"/>
    <table:table-row table:style-name="Table112.1">
     <table:table-cell table:style-name="Table112.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T127"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T127"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table112.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T5">If you are also using </text:span><text:a xlink:type="simple" xlink:href="#_User_Accounts" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T14">User Accounts</text:span></text:span></text:a><text:span text:style-name="T5"> in this app, you will need to combine the database rules for the registered users (Registration screen) with the rules for the signed up users (User Accounts). Veuillez consulter la FAQ </text:span><text:span text:style-name="T14">Règles</text:span><text:span text:style-name="T5">, pour plus de détails</text:span><text:span text:style-name="T90">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P356" loext:marker-style-name="T152"/>
   <text:p text:style-name="P356" loext:marker-style-name="T152"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum62">
    <text:list-item>
     <text:p text:style-name="P500" loext:marker-style-name="T194"><text:span text:style-name="T194">Cliquez </text:span><text:span text:style-name="T51">Publiez</text:span><text:span text:style-name="T194"> pour </text:span>confirmer<text:span text:style-name="T194"> vos modifications.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P356" loext:marker-style-name="T152"/>
   <text:p text:style-name="P356" loext:marker-style-name="T152"><text:soft-page-break/></text:p>
   <text:p text:style-name="P390" loext:marker-style-name="T98"><text:span text:style-name="T98">Règles FAQ</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T98"><text:span text:style-name="T98">Q. Si nous avons également activé les comptes utilisateur pour cette application, quelles règles devons-nous utiliser ?</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="P29">If you are using both <text:span text:style-name="T93">User Accounts</text:span> and a <text:span text:style-name="T93">Registration Screen</text:span>, you need to combine the rules as follows:</text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">{</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;rules&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;apps&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179"><text:s/>&quot;$package&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$uid&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.read&quot;: false,</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">},</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;authentifié-utilisateurs&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$uid&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.read&quot;: &quot;$uid == auth.uid&quot;,</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:soft-page-break/><text:span text:style-name="T179">&quot;.write&quot;: &quot;$uid == auth.uid &quot;</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Les règles ci-dessus supposent que vous voulez stocker les informations de l&apos;utilisateur dans un emplacement spécifique à l&apos;application. Si vous avez choisi l’emplacement de niveau supérieur, vous devez supprimer les éléments « apps» et «$package» ci-dessus.<text:line-break/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P10" loext:marker-style-name="T98"><text:span text:style-name="T98">Q. Si nous voulons qu&apos;un administrateur ait un accès en lecture aux utilisateurs enregistrés pour s&apos;afficher dans un navigateur Web, quelle règle utilisons-nous?</text:span><text:span text:style-name="T98"/></text:p>
   <text:p text:style-name="P29">Si vous voulez donner à un administrateur un accès en lecture aux données, pour être affiché dans un navigateur web (Voir <text:span text:style-name="T51">Configurer l&apos;inscription</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span> <text:span text:style-name="T51">Informations utilisateur</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span> <text:span text:style-name="T51">Voir les données</text:span>), voici la règle à utiliser:</text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">{</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;rules&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;apps&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$package&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;$uid&quot;: {</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.read&quot;: &quot;(auth != null) &amp;&amp; (auth.token.email == &apos;me@abcd.com&apos;)&quot;,</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:soft-page-break/><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P321" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="P318" loext:marker-style-name="T179"><text:span text:style-name="T179">}</text:span><text:span text:style-name="T179"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P32">(où me@abcd.com est un utilisateur ajouté sur la page <text:span text:style-name="T51">Authentification </text:span>)</text:p>
   <text:p text:style-name="P32"/>
   <text:p text:style-name="Standard">Les règles ci-dessus supposent que vous voulez stocker les informations de l&apos;utilisateur dans un emplacement spécifique à l&apos;application. Si vous avez choisi l’emplacement de niveau supérieur, vous devez supprimer les éléments « apps» et «$package» ci-dessus.</text:p>
   <text:p text:style-name="P356" loext:marker-style-name="T152"><text:s/></text:p>
   <text:h text:style-name="P47" text:outline-level="1"><text:bookmark text:name="_Progressive_Web_App"/><text:bookmark text:name="_Progressive_Web_Apps"/><text:bookmark-start text:name="_Toc233871345"/>Applications Web progressives<text:bookmark-end text:name="_Toc233871345"/></text:h>
   <text:p text:style-name="Standard">En plus de créer une application pour smartphone, vous pouvez créer deux types distincts de <text:a xlink:type="simple" xlink:href="https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Application Web Progressive</text:span></text:a> (PWA). Le premier type (Static PWA) utilise la sortie HTML statique « Générer le HTML » du constructeur d&apos;applications bibliques utilisé à l&apos;origine pour tester la synchronisation texte/audio. Le deuxième type (Modern PWA) est une application web moderne qui reproduit de nombreuses fonctionnalités de l&apos;application smartphone.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Pour qu&apos;un PWA soit installable, il doit être publié sur un serveur web qui sert les fichiers en utilisant HTTPS.</text:p>
   <text:h text:style-name="P64" text:outline-level="2"><text:bookmark-start text:name="_Toc233871346"/>Pourquoi souhaiterais-je une application Web progressive?<text:bookmark-end text:name="_Toc233871346"/></text:h>
   <text:p text:style-name="Standard">Au lieu d&apos;être distribué via le Google Play Store ou l&apos;Apple App Store, les PWA sont publiés en tant que sites Web. Ils peuvent être installés à partir du navigateur sur toutes les plateformes, y compris sur mobile (iOS et Android) ainsi que sur ordinateur de bureau (Windows, Mac, Linux). </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc233871347"/>Quelle application Web Progressive Devrais-je utiliser?<text:bookmark-end text:name="_Toc233871347"/></text:h>
   <text:p text:style-name="Standard">Le PWA statique utilise le code Java de l&apos;application smartphone pour générer le HTML à partir des fichiers USFM/USX afin que le HTML corresponde étroitement à l&apos;écran dans l&apos;application smartphone. Cependant, il est limité à une seule collection de livres et à un seul emplacement audio, la navigation livre/chapitre/verset est simple, et il y a des fonctionnalités minimales d&apos;application implémentées. Lorsqu&apos;il est utilisé comme PWA, il peut prendre beaucoup de temps pour que tous les fichiers HTML statiques soient téléchargés par le navigateur. Cela peut prendre un certain temps avant d&apos;être ajouté à l&apos;écran d&apos;accueil de l&apos;appareil et utilisé hors ligne. </text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard">Le PWA Moderne est une implémentation correcte d&apos;une application web avec le support de plusieurs collections de livres, toutes les sources audio (y compris le streaming depuis la FCBH BibleBrain), et de nombreuses fonctionnalités de l&apos;application smartphone. Elle n&apos;est pas encore complète, mais elle sera améliorée au fil du temps. Il utilise une bibliothèque JavaScript séparée pour lire les fichiers USFM/USX et afficher le contenu en HTML. Il peut y avoir des différences dans la sortie HTML qui seront également améliorées. En raison de la conception du PWA moderne, le téléchargement sera beaucoup plus rapide et sera disponible rapidement pour être ajouté à l&apos;écran d&apos;accueil de l&apos;appareil et utilisé hors ligne. </text:p>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark-start text:name="_Toc233871348"/>Audio en PWA<text:bookmark-end text:name="_Toc233871348"/></text:h>
   <text:p text:style-name="Standard">Si votre projet utilise le format audio WebM (Ogg Opus) pour certains ou tous les fichiers audio, ce format n&apos;est pas pris en charge par Safari sur iOS et certaines anciennes versions de macOS (il fonctionne avec Safari 16. ou plus tard). Les deux PWAs tomberont en format audio MP3 et CAF si WebM n&apos;est pas pris en charge. Si vous voulez que le PWA fonctionne avec Safari sur macOS ou iOS, assurez-vous d&apos;inclure un fichier MP3 ou CAF pour chaque fichier WebM avec le même nom de fichier de base (e. . mat1.mp3 ou mat1.caf avec mat1.webm). Rappelez-vous que tous les navigateurs sur iOS utilisent le composant de navigateur Web Safari en interne, donc cela affecte tous les navigateurs sur iOS. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Lorsque vous utilisez une source audio FCBH Bible Brain avec la PWA moderne, si vous utilisez un ID de fichier pour l&apos;audio WebM, il aura « -opus16 » à la fin (e. FRENGWEBN2DA-opus16). Comme cela ne fonctionnera pas sur iOS, le PWA moderne tentera d&apos;utiliser l&apos;équivalent MP3.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark-start text:name="_Toc233871349"/>Construire un PWA statique<text:bookmark-end text:name="_Toc233871349"/></text:h>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871350"/>Installation des pré-requis pour le PWA statique sous Windows<text:bookmark-end text:name="_Toc233871350"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T4">Afin de créer les fichiers nécessaires à un PWA,<text:span text:style-name="T4"> vous devez avoir 2 composants installés sur votre ordinateur :</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"><text:s/></text:p>
   <text:list text:style-name="WWNum55">
    <text:list-item>
     <text:p text:style-name="P501" loext:marker-style-name="T25"><text:span text:style-name="T25">Node.js</text:span><text:span text:style-name="T25"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P501" loext:marker-style-name="T25"><text:span text:style-name="T25">Workbox-cli</text:span><text:span text:style-name="T25"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Voici plus de détails sur l&apos;installation de ces deux composants.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Aller à la page de téléchargement de Node.js :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P32" loext:marker-style-name="T169"><text:a xlink:type="simple" xlink:href="https://nodejs.org/en/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://nodejs.org/en/download/</text:span></text:a><text:span text:style-name="T169"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T4"><text:span text:style-name="T4">Il y a beaucoup de fichiers téléchargés sur cette page. Vous recherchez le fichier correspondant au type de système d&apos;exploitation de votre ordinateur. Il est plus facile de télécharger le fichier msi (installateur de paquets) que le fichier zip.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P263" loext:marker-style-name="T50"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><draw:frame draw:style-name="fr6" draw:name="Image14" text:anchor-type="as-char" svg:width="5.9783in" svg:height="3.1382in" draw:z-index="0"><draw:image xlink:href="SAB02/95.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Une capture d&apos;écran d&apos;un téléphone cellulaire







Description générée automatiquement</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Lorsque le fichier a été téléchargé, exécutez-le pour installer Node.js sur votre ordinateur.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Après avoir installé Node.js, lancez une invite de commande. Cliquez sur l&apos;icône Windows (démarrer) et tapez l&apos;invite de commande </text:span><text:span text:style-name="T4">et appuyez sur Entrée. Collez cette commande et appuyez sur entrée:</text:span></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Command_20_Line">npm install workbox-cli -global</text:p>
   <text:p text:style-name="P354" loext:marker-style-name="T181"/>
   <text:p text:style-name="Standard">Une fois cette commande terminée, vous avez les outils nécessaires pour exporter les fichiers PWA. Fermer SAB s&apos;il est ouvert et le redémarrer.</text:p>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:p text:style-name="Standard">Parfois, il peut y avoir des problèmes d&apos;installation de workbox-cli. Si cela se produit, vous ne pourrez pas cocher la case <text:span text:style-name="T55">Include Progressive Web App files</text:span> mentionnée ci-dessous. Pour corriger ce problème, vider le cache npm en exécutant la commande suivante :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Command_20_Line">npm cache clean -force</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Puis ré-exécutez la commande d&apos;installation ci-dessus. </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871351"/>Installation des pré-requis pour le PWA statique sous Linux<text:bookmark-end text:name="_Toc233871351"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:soft-page-break/>Afin de créer les fichiers nécessaires à un PWA,<text:span text:style-name="T4"> vous devez avoir 2 composants installés sur votre ordinateur :</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:list text:style-name="WWNum56">
    <text:list-item>
     <text:p text:style-name="P503" loext:marker-style-name="T25"><text:span text:style-name="T25">Node.js</text:span><text:span text:style-name="T25"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P503" loext:marker-style-name="T25"><text:span text:style-name="T25">Workbox-cli</text:span><text:span text:style-name="T25"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Voici plus de détails sur l&apos;installation de ces deux composants.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><text:span text:style-name="T205">Tout d&apos;abord, trouvez la version la plus récente de la version stable à long terme (LTS) de Node.js. Aller à:</text:span><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T169"><text:a xlink:type="simple" xlink:href="https://nodejs.org/en/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://nodejs.org/en/download/</text:span></text:a></text:p>
   <text:p text:style-name="P504" loext:marker-style-name="T205"/>
   <text:p text:style-name="P25" loext:marker-style-name="T205"><text:span text:style-name="T205">Et trouvez la ligne en haut de la page qui commence « Dernière version de LTS : ».</text:span><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><draw:custom-shape text:anchor-type="char" draw:z-index="284" draw:name="AutoShape 8" draw:style-name="gr3" draw:text-style-name="P521" svg:width="0.6335in" svg:height="0.2504in" draw:transform="rotate (-3.14159265358979) translate (0.254861111111111in 0.48125in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f14 ?f13 ?f7" draw:text-areas="?f12 ?f8 ?f13 ?f9" draw:type="ooxml-leftArrow" draw:modifiers="50000 91667" draw:enhanced-path="M 0 ?f7 L ?f5 0 ?f5 ?f8 ?f13 ?f8 ?f13 ?f9 ?f5 ?f9 ?f5 ?f14 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="0+?f4 -0"/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +0-?f11 "/>
      <draw:equation draw:name="f13" draw:formula="logwidth"/>
      <draw:equation draw:name="f14" draw:formula="logheight"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="?f13 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><draw:frame draw:style-name="fr5" draw:name="Image15" text:anchor-type="as-char" svg:width="5.9846in" svg:height="0.4654in" draw:z-index="0"><draw:image xlink:href="SAB02/96.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
     <svg:desc>A screenshot of a cell phone

Description automatically generated</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T205"><text:span text:style-name="T205">Prenez note du nombre avant le premier point, car c&apos;est la version majeure que vous voulez installer. </text:span><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="P504" loext:marker-style-name="T205"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><text:span text:style-name="T205">Suivez les instructions sur :</text:span> </text:p>
   <text:p text:style-name="P504" loext:marker-style-name="T205"/>
   <text:p text:style-name="P21" loext:marker-style-name="T206"><text:a xlink:type="simple" xlink:href="https://github.com/nodesource/distributions" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T206">https://github.com/nodesource/distributions</text:span></text:span></text:a><text:span text:style-name="T206"/></text:p>
   <text:p text:style-name="P21"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><text:soft-page-break/><text:span text:style-name="T205">pour installer cette version majeure pour votre distribution Linux.</text:span><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="P504" loext:marker-style-name="T205"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T205"><text:span text:style-name="T205">Once you have Node.js installed, open a Terminal window and run the following command:</text:span><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="Command_20_Line">sudo npm install workbox-cli -global</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Une fois cette commande terminée, vous avez les outils nécessaires pour exporter les fichiers PWA. Fermer SAB s&apos;il est ouvert et le redémarrer.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Parfois, il peut y avoir des problèmes d&apos;installation de workbox-cli. Si cela se produit, vous ne pourrez pas cocher la case <text:span text:style-name="T55">Include Progressive Web App files</text:span> mentionnée ci-dessous. Pour corriger ce problème, vider le cache npm en exécutant la commande suivante :</text:p>
   <text:p text:style-name="Command_20_Line">npm cache clean -force</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Puis ré-exécutez la commande d&apos;installation ci-dessus. </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871352"/>Comment exporter des fichiers PWA statiques ?<text:bookmark-end text:name="_Toc233871352"/></text:h>
   <text:p text:style-name="Standard">Pour exporter les fichiers PWA, vous devez d&apos;abord configurer les paramètres PWA. Dans SAB, faites un clic droit sur la collection que vous souhaitez exporter et sélectionnez <text:span text:style-name="T55">Exporter vers les paramètres HTML</text:span>. Dans la fenêtre résultante, sélectionnez l&apos;onglet <text:span text:style-name="T55">Application Web Progressive</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Dans cet onglet, cochez la case à cocher <text:span text:style-name="T55">Inclure les fichiers des applications Web progressives</text:span>. S&apos;il est grisé, assurez-vous que vous avez installé Node.js et Workbox-cli, puis voyez la note ci-dessus sur le nettoyage du cache npm. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Entrez un <text:span text:style-name="T55">Name</text:span> et <text:span text:style-name="T55">Short Name</text:span>. Cliquez sur <text:span text:style-name="T55">OK</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><text:soft-page-break/>Faites un clic droit sur la collection à nouveau et sélectionnez <text:span text:style-name="T55">Exporter vers HTML</text:span>. </text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les fichiers PWA générés seront enregistrés dans le dossier de sortie HTML par défaut. Voir </text:span><text:span text:style-name="T52">Outils</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Paramètres…</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Dossiers par défaut</text:span><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871353"/>Comment ajouter de l&apos;audio à ma PWA statique ?<text:bookmark-end text:name="_Toc233871353"/></text:h>
   <text:p text:style-name="Standard">Puisque les PWAs sont installés sur des périphériques via Internet, ils ne peuvent pas se fier aux fichiers audio stockés localement sur votre machine. Vous devrez héberger des fichiers audio via un serveur HTTPS afin que le PWA puisse les télécharger depuis n&apos;importe quel périphérique. HTTPS est préféré à HTTP car certains périphériques rejetteront les téléchargements HTTP.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Si vous voulez que votre PWA dispose de capacités audio, faites un clic droit sur la collection que vous souhaitez exporter en tant que PWA. Sélectionnez <text:span text:style-name="T55">Exporter vers les paramètres HTML. </text:span>In the resulting window, you should be on the <text:span text:style-name="T55">Audio Files</text:span> tab. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Sélectionnez le <text:span text:style-name="T55">Utilisez le chemin suivant vers les fichiers, par ex. une adresse URL </text:span>bouton de menu et entrez l&apos;URL à partir de laquelle vos fichiers audio peuvent être téléchargés.</text:p>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark text:name="_Building_a_Modern"/><text:bookmark-start text:name="_Toc233871354"/>Construire un PWA moderne<text:bookmark-end text:name="_Toc233871354"/></text:h>
   <text:p text:style-name="Standard">Scripture App Builder inclut tous les logiciels pour construire un PWA moderne. Il n&apos;y a pas de prérequis additionnels.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871355"/>Configuration pour PWA Moderne<text:bookmark-end text:name="_Toc233871355"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16">Un PWA moderne utilise la configuration existante de l&apos;application smartphone. Il y a une exigence supplémentaire de préciser la langue des collections de livres. Allez à <text:span text:style-name="T55">Livres</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Nom de la collection de livres</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Langue</text:span><text:span text:style-name="T16"> page et spécifiez le </text:span><text:span text:style-name="T24">Langue Code</text:span><text:span text:style-name="T16">.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard"><text:span text:style-name="T16">If the PWA will be published to a subdirectory of a web server (e.g. </text:span><text:a xlink:type="simple" xlink:href="https://example.com/bible" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://example.com/bible</text:span></text:span></text:a><text:span text:style-name="T16"> instead of </text:span><text:a xlink:type="simple" xlink:href="https://example.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://example.com</text:span></text:span></text:a><text:span text:style-name="T16">), go to the </text:span><text:span text:style-name="T24">Publishing</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Web App (PWA)</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Subdirectory</text:span><text:span text:style-name="T16"> page and specify the subdirectory (e.g. /bible).</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871356"/>Comment puis-je construire une PWA Moderne?<text:bookmark-end text:name="_Toc233871356"/></text:h>
   <text:p text:style-name="Standard">Construire un PWA Moderne est comme construire une application pour smartphone. Cliquez sur le bouton <text:span text:style-name="T55">Build PWA </text:span>sur la barre d&apos;outils en haut de l&apos;écran. Si quelque chose n&apos;est pas configuré correctement pour que la compilation fonctionne, vous serez notifié. Une fenêtre de compilation apparaîtra. Attendez que le PWA soit compilé. Quand il se termine avec succès, aller à <text:span text:style-name="T55">Fichier</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Voir le dossier de sortie PWA</text:span><text:span text:style-name="T16"> pour trouver les fichiers de sortie de la compilation PWA.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871357"/>Comment puis-je tester une PWA moderne?<text:bookmark-end text:name="_Toc233871357"/></text:h>
   <text:p text:style-name="Standard">Avec le PWA statique, vous pouvez ouvrir les fichiers HTML statiques depuis votre ordinateur. Avec le PWA moderne, vous avez besoin d&apos;un serveur web pour l&apos;exécuter. Pour visualiser le PWA Moderne, cliquez sur le bouton <text:span text:style-name="T55">Exécuter PWA</text:span> sur la barre d’outils en haut de l’écran. Une fenêtre de compilation apparaîtra. Une fois la compilation terminée, une fenêtre de terminal et une fenêtre de navigateur apparaîtront. Le terminal exécutera le PWA sur un serveur web local. La fenêtre de terminal affichera les URL du serveur web local. Si votre smartphone est sur le même réseau que votre ordinateur, vous pouvez tester le PWA sur votre smartphone en ouvrant un navigateur Web sur votre smartphone et en saisissant l&apos;URL de l&apos;entrée libellée <text:span text:style-name="T55">Network</text:span> (e. . <text:a xlink:type="simple" xlink:href="http://172.23.87.150:4173/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://172.23.87.150:4173</text:span></text:a> dans la capture d&apos;écran à gauche). S&apos;il y a plusieurs entrées <text:span text:style-name="T55">Réseau</text:span> (par ex. Windows exécutant Windows Subsystem pour Linux à droite), puis commencez à les essayer en haut de la liste (e. . <text:a xlink:type="simple" xlink:href="http://192.168.4.34:4173/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://192.168.4.34:4173</text:span></text:a>). </text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr4" draw:name="Image16" text:anchor-type="as-char" svg:width="2.6717in" svg:height="1.6583in" draw:z-index="0"><draw:image xlink:href="SAB02/97.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
     <svg:desc>A computer screen shot of a computer program

Description automatically generated</svg:desc>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Image17" text:anchor-type="as-char" svg:width="2.8189in" svg:height="1.6862in" draw:z-index="0"><draw:image xlink:href="SAB02/98.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
    </draw:frame></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Assurez-vous de fermer la fenêtre du terminal lorsque vous avez fini de tester le PWA.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871358"/>Comment puis-je publier une PWA Moderne?<text:bookmark-end text:name="_Toc233871358"/></text:h>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Pour publier un PWA moderne, copiez les fichiers du <text:span text:style-name="T55">PWA Output Folder</text:span> sur un serveur web connecté à Internet. Pour que le PWA puisse être installé sur un smartphone ou un ordinateur de bureau, le serveur web doit servir les fichiers en utilisant HTTPS. L&apos;installation de PWA fonctionne avec les navigateurs de support. Voir <text:a xlink:type="simple" xlink:href="https://web.dev/learn/pwa/installation/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://web.dev/learn/pwa/installation/</text:span></text:a> pour plus de détails.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P47" text:outline-level="1"><text:bookmark-start text:name="_Toc233871359"/>Édition et distribution<text:bookmark-end text:name="_Toc233871359"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39"><text:line-break/>Avant de distribuer votre application, veuillez utiliser la liste de contrôle </text:span><text:span text:style-name="T90">de publication d&apos;applications</text:span><text:span text:style-name="T39"> (disponible via le menu Aide dans SAB ou sur le site web SAB) pour vérifier qu&apos;elle est prête à être publiée.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les applications construites avec le constructeur d&apos;applications bibliques peuvent être publiées sur le Google Play Store, distribuées par carte mémoire, partagé par Bluetooth ou transfert Wi-Fi, téléversé sur des sites Web ou envoyé par courriel. Pour plus d&apos;informations, veuillez consulter le manuel utilisateur </text:span><text:span text:style-name="T90">Distributing Apps</text:span><text:span text:style-name="T39"> (disponible via le menu Aide dans SAB ou sur le site web SAB).</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P48" text:outline-level="1"><text:bookmark text:name="_Appendix_1:_How"/><text:bookmark-start text:name="_Toc233871360"/>Annexe 1 : comment SAB stocke vos fichiers de données de projet<text:bookmark-end text:name="_Toc233871360"/></text:h>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table113" table:style-name="Table113">
    <table:table-column table:style-name="Table113.A"/>
    <table:table-column table:style-name="Table113.B"/>
    <table:table-row table:style-name="Table113.1">
     <table:table-cell table:style-name="Table113.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table113.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Lorsque vous sélectionnez un fichier source à charger dans votre application, SAB en fera une copie dans le dossier de données du projet. Cependant, il maintiendra le lien vers le fichier source. Si vous mettez à jour le fichier source, vous devrez sélectionner le fichier dans l&apos;arborescence du projet, cliquez dessus avec le bouton droit de la souris et sélectionnez </text:span><text:span text:style-name="T95">Update from Source</text:span><text:span text:style-name="T90">. Ceci copiera le fichier mis à jour dans le dossier de données du projet.</text:span></text:p>
      <text:p text:style-name="P276" loext:marker-style-name="T90"/>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Alternatively, select the file, select the </text:span><text:span text:style-name="T95">Book File</text:span><text:span text:style-name="T90"> tab in the configuration area and click the </text:span><text:span text:style-name="T95">Update From Source</text:span><text:span text:style-name="T90"> button.</text:span></text:p>
      <text:p text:style-name="P293" loext:marker-style-name="T146"/>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Dans le cadre du processus d&apos;installation, SAB crée un certain nombre de dossiers pour ses fichiers de données. Par défaut, ceux-ci sont dans une hiérarchie sous votre dossier </text:span><text:span text:style-name="T52">Documents</text:span><text:span text:style-name="T39">. Ce qui suit est une explication des différents dossiers du niveau supérieur vers le bas :</text:span></text:p>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark-start text:name="_Toc233871361"/>Répertoires de données SAB à usage général<text:bookmark-end text:name="_Toc233871361"/></text:h>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Constructeurs d&apos;applications :</text:span><text:span text:style-name="T39"> ce dossier contient les dossiers de haut niveau pour les différents constructeurs d&apos;applications installés i.e. Applications bibliques, lectures d&apos;applications, etc.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Applications bibliques :</text:span><text:span text:style-name="T39"> ce dossier contient tous les sous-dossiers liés aux fichiers de données de Scripture App Builder.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">sortie APK :</text:span><text:span text:style-name="T39"> ce dossier est l&apos;endroit où SAB place vos fichiers APK compilés (les fichiers d&apos;installation de l&apos;application qui doivent être copiés sur un téléphone). You can open this folder by selecting </text:span><text:span text:style-name="T52">File</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T71"></text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">View APK Output Folder</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list xml:id="list164754822936603" text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Projets d&apos;application :</text:span><text:span text:style-name="T39"> SAB stocke vos projets d&apos;application dans ce dossier, avec les sous-dossiers nommés d&apos;après chaque projet. If you have a project selected in the Tree View, you can view its project folder by selecting </text:span><text:span text:style-name="T52">File</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T71"></text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">View Project Folder</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <table:table table:name="Table114" table:style-name="Table114">
    <table:table-column table:style-name="Table114.A"/>
    <table:table-column table:style-name="Table114.B"/>
    <table:table-row table:style-name="Table114.1">
     <table:table-cell table:style-name="Table114.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table114.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Si vous voulez partager votre projet d&apos;application avec quelqu&apos;un d&apos;autre (i.e. quelqu&apos;un qui peut vous aider à tester et à trouver des problèmes avec votre application), vous devrez leur donner votre dossier de projet et tout ce qu&apos;il contient. Ils peuvent le copier dans leur propre dossier de projets d&apos;applications, l&apos;ouvrir dans SAB et utiliser le leur, stockage temporaire de clés pour construire, exécuter et tester votre projet. Si des fichiers audio sont nécessaires pour votre application et qu&apos;ils ne sont pas stockés dans le sous-dossier audio de votre projet, vous devrez les copier séparément.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-list="list164751238405116" text:style-name="WWNum37">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P128" loext:marker-style-name="T39"><text:span text:style-name="T52">&lt;group names&gt;:</text:span><text:span text:style-name="T39"> Si vous avez créé un groupe pour vos fichiers de projet, le dossier de groupe sera à ce niveau.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P248" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum37">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P128" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T52">&lt;project names&gt;:</text:span><text:span text:style-name="T39"> Les dossiers de votre projet seront soit à ce niveau soit sous le dossier &lt;group name&gt; s&apos;il y a lieu.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P249" loext:marker-style-name="T39"><text:s/></text:p>
   <text:list text:continue-list="list164754822936603" text:style-name="WWNum81">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">&lt;project name&gt;.appDef</text:span><text:span text:style-name="T39">: Par exemple, </text:span><text:span text:style-name="T52">My_NT_Bible_App.appDef</text:span><text:span text:style-name="T39">. Ceci est le fichier de définition de votre projet – le fichier qui stocke la plupart des attributs du projet.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P91" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">&lt;project name&gt;_données</text:span><text:span text:style-name="T39">: Par exemple : </text:span><text:span text:style-name="T52">My_NT_Bible_App_data</text:span><text:span text:style-name="T39">. Ceci est le dossier de données parent du projet. Tous les éléments de données du projet sont dans des sous-répertoires en dessous.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Audio :</text:span><text:span text:style-name="T39"> Tous les fichiers audio convertis dans SAB sont placés ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Sortie Epub :</text:span><text:span text:style-name="T39"> Tous les fichiers Epub créés sont placés ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Sortie HTML :</text:span><text:span text:style-name="T39"> Si vous utilisez la fonction Export vers HTML, les fichiers de sortie iront ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Sortie IPA </text:span><text:span text:style-name="T39">(Mac seulement)</text:span><text:span text:style-name="T52">:</text:span><text:span text:style-name="T39"> Si vous construisez des applications pour iOS, les fichiers de sortie seront placés ici. You can open this folder by selecting </text:span><text:span text:style-name="T52">File</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T71"></text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">View IPA Output Folder</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T39"><text:span text:style-name="T52">Phrases :</text:span><text:span text:style-name="T39"> Les fichiers de la liste de phrases générés dans le cadre du processus de synchronisation texte / audio vont ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum81">
    <text:list-item>
     <text:p text:style-name="P177" loext:marker-style-name="T90"><text:span text:style-name="T52">Sortie PWA :</text:span><text:span text:style-name="T39"> La sortie de la fonction Build PWA est placée ici</text:span><text:span text:style-name="T90">. You can open this folder by selecting </text:span><text:span text:style-name="T95">File</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T76"></text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T95">View PWA Output Folder</text:span><text:span text:style-name="T90">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:h text:style-name="P63" text:outline-level="2"><text:bookmark text:name="_Project-specific_data_folders"/><text:bookmark-start text:name="_Toc233871362"/>Dossiers de données spécifiques au projet<text:bookmark-end text:name="_Toc233871362"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard">Les dossiers du projet SAB ont le fichier de définition du projet (<text:span text:style-name="T51">&lt;project-name&gt;.appDef</text:span>) et un dossier de données parent <text:span text:style-name="T51">(&lt;project-name_data</text:span>). Voici les explications des différents sous-dossiers de données du projet:</text:p>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:list text:style-name="WWNum88">
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">À propos de</text:span>: plusieurs fichiers texte incluant le texte de la zone À propos de la boîte À Propos, la notification d&apos;expiration et la notification « audio non trouvée ».</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Audio</text:span>: les fichiers audio de votre application. Celles-ci sont copiées ici à partir de votre dossier audio source si vous avez sélectionné <text:span text:style-name="T51">Copier des fichiers vers le dossier de données </text:span>dans la section <text:span text:style-name="T51">Fichiers Audio</text:span> de la section <text:span text:style-name="T51">Outils</text:span> <text:span text:style-name="T71">&lt;unk&gt;</text:span> <text:span text:style-name="T51">Paramètres</text:span> <text:span text:style-name="T71">&lt;unk&gt;</text:span> <text:span text:style-name="T51">Fichiers</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Books</text:span>: SAB stores your book files here in folders named after each book collection’s ID.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Contenu</text:span>: le Contenu <text:span text:style-name="T51">. ml</text:span> fichier qui décrit la structure et les données du menu de votre contenu, et un sous-dossier <text:span text:style-name="T51">images</text:span> pour les images du menu de contenu.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Firebase</text:span>: si votre projet utilise Firebase, le fichier <text:span text:style-name="T51">google-services.json </text:span>est placé ici.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Fontes</text:span>: les fichiers de police inclus dans votre application</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Images</text:span>: la plupart des images associées à votre application dans leurs sous-dossiers respectifs, y compris les illustrations, arrière-plans, bordures, menus, filigranes et toutes les tailles de fichiers d&apos;icônes.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Plans</text:span>: reading plan text files and their images.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Publier</text:span>: toutes les données du Google Play Store listant dans ses différents sous-dossiers et fichiers json associés.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Timings</text:span>: fichiers de synchronisation audio</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Versets</text:span>: le fichier verses.txt décrivant les versets du jour</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P178"><text:span text:style-name="T51">Vidéo</text:span>: MP4s inclus dans votre application et images vidéo immobiles.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_Using_SAB_with"/><text:bookmark-start text:name="_Toc233871363"/>Utiliser SAB avec des fichiers Paratext<text:bookmark-end text:name="_Toc233871363"/></text:h>
   <text:p text:style-name="P265" loext:marker-style-name="T39"><text:span text:style-name="T39">If you use Send/Receive in Paratext 9 under Windows, your latest SFM Scripture files are normally found in the following folder: </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P265" loext:marker-style-name="T39"><text:span text:style-name="T52">C:\My Paratext 9 Projets\&lt;project ID&gt;</text:span><text:span text:style-name="T39">. </text:span></text:p>
   <text:p text:style-name="P233" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:p text:style-name="P265" loext:marker-style-name="T90"><text:span text:style-name="T39">Vous pouvez maintenant sélectionner des livres à partir de votre dossier Paratext dans le cadre de l&apos;assistant Nouvelle application. Cependant, vous pouvez également les ajouter directement à partir de là ultérieurement. Avec l&apos;une ou l&apos;autre des méthodes, SAB les copiera dans le dossier de données de votre projet (sous le sous-dossier </text:span><text:span text:style-name="T52">Livres\&lt;Collection ID&gt;</text:span><text:span text:style-name="T39">. Si vous faites un Envoyer/Recevoir et recevez des mises à jour, vous devrez faire un clic droit sur les livres mis à jour dans la vue de l&apos;arborescence du projet SAB (sous le nom de la collection du livre) et sélectionner </text:span><text:span text:style-name="T52">Mettre à jour à partir de la source</text:span><text:span text:style-name="T39">. Alternativement, sélectionnez le fichier, sélectionnez l&apos;onglet </text:span><text:span text:style-name="T52">Book File</text:span><text:span text:style-name="T39"> dans la zone de configuration et cliquez sur le bouton </text:span><text:span text:style-name="T52">Update From Source</text:span><text:span text:style-name="T39"> bouton</text:span><text:span text:style-name="T90">.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:p text:style-name="P505" loext:marker-style-name="T207"><text:bookmark text:name="_Appendix_2:_App"/></text:p>
   <text:h text:style-name="P48" text:outline-level="1"><text:bookmark text:name="_Appendix_2:_Useful"/><text:bookmark-start text:name="_Toc233871364"/>Annexe 2 : Marqueurs SFM utiles du constructeur d&apos;applications<text:bookmark-end text:name="_Toc233871364"/></text:h>
   <text:h text:style-name="P64" text:outline-level="2"><text:bookmark-start text:name="_Toc233871365"/>Titres<text:bookmark-end text:name="_Toc233871365"/></text:h>
   <text:list text:style-name="WWNum83">
    <text:list-item>
     <text:p text:style-name="P506" loext:marker-style-name="T128"><text:span text:style-name="T113">\id</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">un identifiant interne unique pour le livre, non visible pour l&apos;utilisateur. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P507" loext:marker-style-name="T128"><text:span text:style-name="T113">\h</text:span><text:span text:style-name="T128"> ou </text:span><text:span text:style-name="T113">\toc2</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">le libellé qui apparaît dans le menu de sélection de la liste de livres</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P507" loext:marker-style-name="T128"><text:span text:style-name="T113">\toc3</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">l&apos;abréviation qui apparaît dans le menu de sélection de la grille de livre</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P507" loext:marker-style-name="T128"><text:span text:style-name="T113">\rem</text:span><text:span text:style-name="T115"> </text:span><text:span text:style-name="T128">Non affiché. Ligne de commentaire pour votre utilisation</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P64" text:outline-level="2"><text:bookmark-start text:name="_Toc233871366"/>Pages et chapitres<text:bookmark-end text:name="_Toc233871366"/></text:h>
   <text:list text:style-name="WWNum84">
    <text:list-item>
     <text:p text:style-name="P508" loext:marker-style-name="T128"><text:span text:style-name="T113">\c</text:span><text:span text:style-name="T128"> ou </text:span><text:span text:style-name="T113">\page</text:span><text:span text:style-name="T115"> </text:span><text:span text:style-name="T128">Utilisé pour séparer le matériau en différents chapitres ou pages</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P64" text:outline-level="2"><text:bookmark-start text:name="_Toc233871367"/>Paragraphes<text:bookmark-end text:name="_Toc233871367"/></text:h>
   <text:list text:style-name="WWNum85">
    <text:list-item>
     <text:p text:style-name="P509" loext:marker-style-name="T128"><text:span text:style-name="T113">\s1</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">en-tête de section ou pour les chansons un titre de chanson</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\b</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">une ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\p</text:span><text:span text:style-name="T128"> a paragraph with indented first line</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\pi</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">un paragraphe indenté à la première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\pc</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">un paragraphe centré </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\pmr</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">paragraphe droit aligné, utilisé pour les accords dans les livres de chansons</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\m</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">un paragraphe sans indentation de première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\mi</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">un paragraphe indenté sans indentation de première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\q1</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">utilisé dans les chansons pour le verset de la chanson, indenté avec la première ligne suspendue l&apos;indentation</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P510" loext:marker-style-name="T128"><text:span text:style-name="T113">\q2</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">utilisé dans les chansons pour le choeur de chansons, plus indenté avec la première ligne l&apos;indentation</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_Media"/><text:bookmark-start text:name="_Toc233871368"/><text:soft-page-break/>Médias<text:bookmark-end text:name="_Toc233871368"/></text:h>
   <text:list text:style-name="WWNum86">
    <text:list-item>
     <text:p text:style-name="P511" loext:marker-style-name="T128"><text:span text:style-name="T113">\video</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">ID vidéo</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P512" loext:marker-style-name="T128"><text:span text:style-name="T113">\img</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">Nom du fichier de l&apos;image pour aller en haut de la page (défilements de texte indépendants) – utilisé pour les livres d&apos;histoires</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P512" loext:marker-style-name="T128"><text:span text:style-name="T113">\fig filename.jpg\fig*</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">Utilisé pour l&apos;insertion d&apos;image en ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P512" loext:marker-style-name="T128"><text:span text:style-name="T113">\fig |filename.jpg||Légende ici|\fig*</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">Utilisé pour une image en ligne avec la légende.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P512" loext:marker-style-name="T128"><text:span text:style-name="T113">\fig DESC|FILE|SIZE|LOC|COPY|CAP|REF\fig*</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">Full spécification de référence USFM.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_Links_to_other"/><text:bookmark-start text:name="_Toc233871369"/>Liens vers d&apos;autres livres ou fichiers audio.<text:bookmark-end text:name="_Toc233871369"/></text:h>
   <text:p text:style-name="P361" loext:marker-style-name="T128"><text:span text:style-name="T113">[Texte Hyperlien](emplacement du lien)</text:span><text:span text:style-name="T114"> </text:span><text:span text:style-name="T128">utilisé pour les hyperliens internes ou externes.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871370"/>Exemples<text:bookmark-end text:name="_Toc233871370"/></text:h>
   <text:p text:style-name="P363" loext:marker-style-name="T129"><text:span text:style-name="T129">To link to a website: </text:span><text:span text:style-name="T129"/></text:p>
   <text:p text:style-name="P361" loext:marker-style-name="T129"><text:span text:style-name="T113">[cette page](</text:span><text:a xlink:type="simple" xlink:href="https://github.com/SILAsiaPub/AppBuilder-workaround/edit/master/RAB-cheat-sheet.md" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T129">https://github.com/SILAsiaPub/AppBuilder-workaround/edit/master/RAB-cheat-sheet. d</text:span></text:span></text:a><text:span text:style-name="T113">) </text:span><text:span text:style-name="T128">– cela montre un lien « cette page » qui lien vers le site web spécifié</text:span></text:p>
   <text:p text:style-name="P363" loext:marker-style-name="T129"><text:span text:style-name="T129">To link to a book chapter in the current collection: </text:span><text:span text:style-name="T129"/></text:p>
   <text:p text:style-name="P361" loext:marker-style-name="T128"><text:span text:style-name="T113">[aller au Book Id B001 chapter 2 dans l&apos;application](B001.2) </text:span><text:span text:style-name="T128">– l&apos;ID du livre est B001</text:span></text:p>
   <text:p text:style-name="P363" loext:marker-style-name="T129"><text:span text:style-name="T129">To link to a book chapter in a different collection: </text:span><text:span text:style-name="T129"/></text:p>
   <text:p text:style-name="P361" loext:marker-style-name="T128"><text:span text:style-name="T113">[aller à la collection C03 et réserver MAT Chapitre 1](C03.MAT.1 </text:span><text:span text:style-name="T128">– l&apos;ID de la collection est C03 et l&apos;ID du livre est MAT</text:span></text:p>
   <text:p text:style-name="P363" loext:marker-style-name="T129"><text:span text:style-name="T129">To tap on a link to play a sound: </text:span><text:span text:style-name="T129"/></text:p>
   <text:p text:style-name="P361" loext:marker-style-name="T128"><text:span text:style-name="T113">[Jouer le son](audioclip.mp3) </text:span><text:span text:style-name="T129">-- </text:span><text:span text:style-name="T128">Appuyez sur </text:span><text:span text:style-name="T130">Jouez le son</text:span><text:span text:style-name="T128"> pour jouer le clip </text:span></text:p>
   <text:p text:style-name="P363" loext:marker-style-name="T129"><text:span text:style-name="T129">To tap on an image to play a sound: </text:span><text:span text:style-name="T129"/></text:p>
   <text:p text:style-name="P361" loext:marker-style-name="T128"><text:span text:style-name="T113">[\fig image.jpg \fig*](audioclip.mp3) </text:span><text:span text:style-name="T128">Appuyez sur l&apos;image jpg pour jouer un son </text:span></text:p>
   <text:p text:style-name="P513" loext:marker-style-name="T131"><text:soft-page-break/></text:p>
