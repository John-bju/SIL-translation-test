     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871394" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.22.<text:span text:style-name="T124"> </text:span>Annotations Styles<text:span text:style-name="T135"> 203</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871395" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.23.<text:span text:style-name="T124"> </text:span>History Styles<text:span text:style-name="T135"> 203</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871396" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.24.<text:span text:style-name="T124"> </text:span>Downloads Styles<text:span text:style-name="T135"> 204</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871397" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23,25.<text:span text:style-name="T124"> </text:span>Style de Plan de Lecture<text:span text:style-name="T135"> 204</text:span></text:a></text:p>
