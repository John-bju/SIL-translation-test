     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871392" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.20.<text:span text:style-name="T124"> </text:span>Style de mise en page<text:span text:style-name="T135"> 202</text:span></text:a></text:p>
