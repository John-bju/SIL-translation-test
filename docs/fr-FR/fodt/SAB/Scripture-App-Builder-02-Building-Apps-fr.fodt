   <text:list text:continue-numbering="true" text:style-name="WWNum18">
    <text:list-item>
     <text:p text:style-name="P347" loext:marker-style-name="T39"><text:span text:style-name="T39">Marquer les mots dans le </text:span><text:span text:style-name="T52">texte principal</text:span><text:span text:style-name="T39"> avec </text:span><text:span text:style-name="T170">\w</text:span><text:span text:style-name="T39"> ….. </text:span><text:span text:style-name="T170">\w*</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P230" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="278" draw:name="Text Box 162" draw:style-name="gr8" draw:text-style-name="P522" svg:width="5.3335in" svg:height="1.9669in" svg:x="0.6075in" svg:y="0.1508in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\c 1</text:span></text:span><text:span text:style-name="T37"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\s Yesu Kirisa nɔhɔ tayirige sɛmɛ</text:span></text:span><text:span text:style-name="T37"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\r(Luka 3:23-38)</text:span></text:span><text:span text:style-name="T37"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\p</text:span></text:span><text:span text:style-name="T37"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\v 1 Yesu Kirisa nɔhɔ tayirige sɛmɛ wʼa we. Yesu ya foro saannaa </text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T171">\w Dawuda\w*</text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T37">shi ni, Dawuda dʼa foro </text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T171">\w Ibirayima\w*</text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T37">shi ni.</text:span></text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\li1</text:span></text:span><text:span text:style-name="T37"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T37"><text:span text:style-name="markerplain"><text:span text:style-name="T37">\v 2 Ibirayima wʼa </text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T171">\w Ishaaga\w*</text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T37">se.</text:span></text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T36"><text:span text:style-name="markerplain"><text:span text:style-name="T36">\li2 Ishaaga di </text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T172">\w Yakuba\w*</text:span></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T36">se.</text:span></text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T36"><text:span text:style-name="markerplain"><text:span text:style-name="T36">\li2 Yakuba di Zhuda ni wu ceboronamaa se.</text:span></text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Si la forme du glossaire est différente de la forme du mot dans le texte, utilisez le caractère de barre verticale | pour spécifier le formulaire du glossaire.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P348" loext:marker-style-name="T39"><text:span text:style-name="T39">par exemple où « ange» se trouve dans le fichier de glossaire :</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P350" loext:marker-style-name="T16"><text:span text:style-name="T16">\v 5 Vous les avez rendus un peu plus bas que </text:span><text:span text:style-name="T23">\w </text:span><text:span text:style-name="T24">angels|angel\w*</text:span><text:span text:style-name="T16"> et vous les avez couronnés de gloire et d&apos;honneur.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T16"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871062"/><text:span text:style-name="T39">Puis-je construire une application à partir de la ligne de commande ?</text:span><text:bookmark-end text:name="_Toc233871062"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Oui, Scripture App Builder possède une interface en ligne de commande qui vous permet de créer une nouvelle application et de la construire, ou charger une application existante et la construire.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">L&apos;outil en ligne de commande est nommé </text:span><text:span text:style-name="T52">sab</text:span><text:span text:style-name="T39"> et peut être trouvé dans le dossier Fichiers de programme, généralement c:\Program Files\SIL\Scripture App Builder.</text:span></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:p text:style-name="P298" loext:marker-style-name="T39"><text:span text:style-name="T52">sab</text:span><text:span text:style-name="T39"> prend les paramètres suivants :</text:span></text:p>
   <text:p text:style-name="P294" loext:marker-style-name="T147"/>
   <table:table table:name="Table20" table:style-name="Table20">
    <table:table-column table:style-name="Table20.A"/>
    <table:table-column table:style-name="Table20.B"/>
