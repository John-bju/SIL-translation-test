     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871400" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.28.<text:span text:style-name="T124"> </text:span>Style<text:span text:style-name="T135"> 207</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871401" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.29.<text:span text:style-name="T124"> </text:span>Paramètres Styles<text:span text:style-name="T135"> 207</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871402" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>23,30.<text:span text:style-name="T124"> </text:span>Style de boîte de message<text:span text:style-name="T135"> 209</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871403" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.31.<text:span text:style-name="T124"> </text:span>Styles d&apos;écran d&apos;intégration<text:span text:style-name="T135"> 209</text:span></text:a></text:p>
     <text:p text:style-name="P37" loext:marker-style-name="T119"><text:a xlink:type="simple" xlink:href="#_Toc233871404" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.32.<text:span text:style-name="T124"> </text:span>Styles des comptes utilisateurs<text:span text:style-name="T135"> 209</text:span></text:a></text:p>
