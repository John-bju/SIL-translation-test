    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum57">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Appuyez sur </text:span><text:span text:style-name="T53">Options développeur</text:span><text:span text:style-name="T39"> et assurez-vous qu&apos;il est activé.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Faites défiler vers le bas la page Options du développeur et trouvez </text:span><text:span text:style-name="T53">USB Debugging</text:span><text:span text:style-name="T39">. Activer ce paramètre. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P100" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" draw:z-index="276" draw:name="AutoShape 160" draw:style-name="gr6" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.76388888888889in 1.17777777777778in)">
