      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="1" draw:name="AutoShape 158" draw:style-name="gr14" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (0.678409480250196) translate (3.35972222222222in 0.695138888888889in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr8" draw:name="Picture 207" text:anchor-type="as-char" svg:width="3.3752in" svg:height="0.5043in" draw:z-index="0"><draw:image xlink:href="SAB02/65.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="2" draw:name="Text Box 157" draw:style-name="gr18" draw:text-style-name="P523" svg:width="1.1504in" svg:height="0.3024in" svg:x="4.3472in" svg:y="0.1925in">
     <text:p text:style-name="P6">Enregistrer l&apos;image</text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="3" draw:name="Text Box 156" draw:style-name="gr18" draw:text-style-name="P523" svg:width="1.1504in" svg:height="0.3024in" svg:x="2.8264in" svg:y="0.1602in">
     <text:p text:style-name="P6">Partager l&apos;image</text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Voir <text:a xlink:type="simple" xlink:href="#_Verse_on_Image" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">sous</text:span></text:a> pour le partage de l&apos;image en tant que vidéo. </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_Verse_on_Image"/><text:bookmark-start text:name="_Toc233871244"/>Le verset <text:span text:style-name="T89">sur l&apos;onglet</text:span> de l&apos;image<text:bookmark-end text:name="_Toc233871244"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To activate the Verse on Image function in your app, check the box </text:span><text:span text:style-name="T52">Include the ‘Verse on Image’ editor in the app</text:span><text:span text:style-name="T39">. </text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P30">Si vous avez des fichiers audio et chronométrage pour le verset sélectionné, Il est possible de <text:span text:style-name="T194">partager l&apos;image en tant que vidéo</text:span> avec le texte et l&apos;audio combinés. Pour activer cette option, allez à l&apos;onglet <text:span text:style-name="T52">Verset sur l&apos;image</text:span><text:span text:style-name="T39"> et cochez la case </text:span><text:span text:style-name="T52">Autoriser l&apos;enregistrement en tant que vidéo, en peignant le texte et l&apos;audio. </text:span>This will require the image processing library, <text:span text:style-name="T51">FFmpeg</text:span>, to be included within the app.</text:p>
   <text:p text:style-name="P30"/>
   <table:table table:name="Table74" table:style-name="Table74">
    <table:table-column table:style-name="Table74.A"/>
    <table:table-column table:style-name="Table74.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table74.1">
     <table:table-cell table:style-name="Table74.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table74.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">La bibliothèque FFmpeg va ajouter environ 52 Mo à votre APK par défaut. Vous pouvez réduire la taille de l&apos;APK en créant des fichiers APK séparés pour chaque architecture du téléphone, avec seulement les parties respectives de la bibliothèque dans chaque partie. See the Multiple APKs section under </text:span><text:span text:style-name="T95">App</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T76"></text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T95">APK</text:span><text:span text:style-name="T90">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P30"><text:s/></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_Configuring_Verse_on"/><text:bookmark-start text:name="_Toc233871245"/>The <text:span text:style-name="T89">Backgrounds</text:span> tab<text:bookmark-end text:name="_Toc233871245"/></text:h>
   <text:p text:style-name="Standard">Les utilisateurs peuvent soit utiliser l&apos;un des arrière-plans inclus dans l&apos;application, soit choisir leur propre arrière-plan dans leur galerie d&apos;images du téléphone. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Dans le cadre de votre stratégie d&apos;engagement des Écritures essayez d&apos;inclure un ensemble d&apos;arrière-plans dans votre application qui peuvent attirer les utilisateurs et leur demander de partager des versets avec d&apos;autres. </text:p>
   <text:p text:style-name="Standard">. </text:p>
   <text:p text:style-name="Standard">SAB fournit plusieurs images par défaut, mais vous pouvez en ajouter d&apos;autres de plusieurs façons :</text:p>
   <text:p text:style-name="Standard">Utilisez le bouton <text:span text:style-name="T51">Ajouter une image</text:span>… pour ajouter des images que vous fournissez. Il peut s&apos;agir de photos que vous, amis ou collègues avez prises, ou celles d&apos;un site Web. Assurez-vous simplement que vous avez les droits pour utiliser les images. L&apos;onglet <text:span text:style-name="T51">Arrière-plans</text:span> a des liens vers plusieurs sites qui fournissent des images gratuites, bien que vous devriez toujours donner du crédit dans votre boîte À Propos.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Vous pouvez également ajouter des images à partir de la galerie SAB en utilisant <text:span text:style-name="T51">Choisissez dans la galerie… </text:span>Faites attention à <text:span text:style-name="T51">Taille de fichier</text:span> des images, car votre application augmentera sa taille avec chacune.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table75" table:style-name="Table75">
    <table:table-column table:style-name="Table75.A"/>
    <table:table-column table:style-name="Table75.B"/>
    <table:table-row table:style-name="Table75.1">
     <table:table-cell table:style-name="Table75.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table75.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Essayez de choisir des images qui sont relativement simples avec une zone centrale non encombrée afin que le texte superposé puisse être facilement lu. </text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">We recommend using the <text:span text:style-name="T51">Crop each image to make it square</text:span> and <text:span text:style-name="T51">Resize the image files to reduce the app size</text:span> checkboxes. Choisissez une largeur maximale qui reflète une résolution d&apos;écran moyenne de vos téléphones cibles, par exemple 720 - 1024 pixels.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T40">Vous pouvez également fournir un choix de polices pour les utilisateurs à appliquer au texte dans leurs images. Pour cela, allez dans l&apos;onglet <text:span text:style-name="T55">Apparence</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T55">Fontes</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Fichiers de Polices</text:span><text:span text:style-name="T40"> .</text:span></text:p>
   <text:p text:style-name="P243" loext:marker-style-name="T40"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Définition de la zone de texte</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/><text:span text:style-name="T40">Once you have added a background to the list, you can double-click on it to access the </text:span><text:span text:style-name="T52">View Image</text:span><text:span text:style-name="T40"> dialog box. Ici vous pouvez voir les détails de l&apos;image, ou cliquez sur l&apos;onglet </text:span><text:span text:style-name="T52">Zone de texte</text:span><text:span text:style-name="T40"> pour définir une zone prédéfinie dans laquelle le texte du verset apparaîtra.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871246"/>The <text:span text:style-name="T89">Watermarks</text:span> tab<text:bookmark-end text:name="_Toc233871246"/></text:h>
   <text:p text:style-name="Standard">Utilisez l&apos;onglet filigrane pour spécifier une petite image PNG qui sera placée sur tous les verset des images d&apos;image. Vous pouvez l&apos;utiliser pour &quot;marquer&quot; vos images afin que les gens les associent à votre application, nous espérons créer un intérêt pour l&apos;installation de l&apos;application elle-même et accéder à la Parole de Dieu.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P47" text:outline-level="1"><text:bookmark-start text:name="_Toc233871247"/>Le menu du projet <text:span text:style-name="T89">Média</text:span><text:bookmark-end text:name="_Toc233871247"/></text:h>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_Audio_1"/><text:bookmark-start text:name="_Toc233871248"/>Audio<text:bookmark-end text:name="_Toc233871248"/></text:h>
   <text:p text:style-name="Standard">L&apos;audio est une partie critique de n&apos;importe quelle application, car il est possible que de nombreux utilisateurs ne possèdent pas de solides compétences en lecture, en particulier dans leur propre langue.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Voici quelques questions que vous pouvez poser au sujet de l&apos;audio. Cliquez sur chacun pour accéder à la section correspondante :</text:p>
   <text:list text:style-name="WWNum98">
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_can_I_3" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment associer des fichiers audio avec le texte ?</text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_can_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment puis-je réduire la taille de mes fichiers audio ?</text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_do_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment créer les fichiers de synchronisation audio pour la synchronisation du texte audio ?</text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_The_File_Source" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment distribuer les fichiers audio avec mon application ?</text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_are_the" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Comment les fichiers de timing sont-ils distribués pour l&apos;application ?</text:span></text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_can_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Comment puis-je utiliser des clips audio dans l&apos;application ?</text:span></text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P146"><text:a xlink:type="simple" xlink:href="#_How_can_I_4" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Comment puis-je créer des sous-titres à partir de fichiers texte et chronométrage ?</text:span></text:span></text:a></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P3"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_The_File_Source"/><text:bookmark-start text:name="_Toc233871249"/>The <text:span text:style-name="T89">File Source</text:span> tab<text:bookmark-end text:name="_Toc233871249"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><text:soft-page-break/><text:span text:style-name="T16">Utilisez l&apos;onglet Source du fichier pour spécifier comment les fichiers audio sont accédés et distribués avec votre application. Il y a quatre façons d&apos;inclure les fichiers audio dans votre application : actifs, dossier externe, téléchargement internet ou téléchargement FCBH. Vous pouvez utiliser un seul fichier </text:span><text:span text:style-name="T23">source</text:span><text:span text:style-name="T16"> pour tous les fichiers dans une application ou vous pouvez combiner deux ou plusieurs sources dans une application. Vous pouvez spécifier une source de fichier pour chaque fichier audio (mais pas le clip audio) et donc les spécifier dans un chapitre par chapitre / page par page.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T16"/>
   <table:table table:name="Table76" table:style-name="Table76">
    <table:table-column table:style-name="Table76.A"/>
    <table:table-column table:style-name="Table76.B"/>
    <table:table-row table:style-name="Table76.1">
     <table:table-cell table:style-name="Table76.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table76.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Pour décider si l&apos;audio doit être inclus dans l&apos;APK ou via une autre source de fichiers, il est important de tenir compte des besoins des utilisateurs et de leur accès à Internet. Vous pouvez envisager de mettre un seul livre audio dans l’APK (ou même un simple ensemble de chapitres) et de faire le reste disponible en téléchargement. Si vous faites cela, pensez à ouvrir l&apos;application dans un livre et un chapitre avec de l&apos;audio, et assurez-vous que la barre d&apos;outils audio s&apos;affiche.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">To open the app at a specific book, go to </text:span><text:span text:style-name="T95">Navigation</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T95">Book Navigation</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T95">Navigation</text:span><text:span text:style-name="T90"> and look for the </text:span><text:span text:style-name="T95">First Book and Chapter</text:span><text:span text:style-name="T90"> fields.</text:span></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Pour faire apparaître la barre d&apos;outils audio par défaut, aller à </text:span><text:span text:style-name="T95">Media</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T11">Audio</text:span><text:span text:style-name="T6"> </text:span><text:span text:style-name="T11">Audio Toolbar</text:span><text:span text:style-name="T6"> et sélectionner </text:span><text:span text:style-name="T11">Afficher la barre d&apos;outils audio lorsque l&apos;application est lancée</text:span><text:span text:style-name="T6">. SAB masquera automatiquement la barre d&apos;outils pour les chapitres ou les pages sans audio.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P16" loext:marker-style-name="T16"><text:span text:style-name="T16">Pour spécifier la(s) source(s) de fichier dans le constructeur d&apos;applications bibliques, vous devez faire deux choses:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum17">
    <text:list-item>
     <text:p text:style-name="P442" loext:marker-style-name="T16"><text:span text:style-name="T16">Définissez les sources de fichiers disponibles sous l&apos;onglet File Source. Vous pouvez modifier, ajouter et supprimer des sources de fichiers ici.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P443" loext:marker-style-name="T16"><text:span text:style-name="T16">Go to the </text:span><text:span text:style-name="T23">Audio Files</text:span><text:span text:style-name="T16"> tab for a book or book collection, and after adding audio, assign a file source for each file. Pour modifier la source d&apos;un fichier ou d&apos;un fichier, sélectionnez les lignes que vous souhaitez modifier. faites un clic droit sur la sélection et choisissez </text:span><text:span text:style-name="T23">Changer la source</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><text:span text:style-name="T16">Les sections suivantes décrivent les différents types de fichiers sources :</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><text:span text:style-name="T16"><text:line-break/></text:span><text:span text:style-name="T24">1. Actifs</text:span><text:span text:style-name="T16"><text:line-break/>Les fichiers audio seront empaquetés dans le fichier APK pour l&apos;application. C&apos;est la méthode la plus simple pour quelques fichiers (par exemple un livre) et ne nécessite aucune autorisation. Mais faites attention à ce que l&apos;APK deviendra très grand si vous avez plusieurs livres d&apos;audio. La taille maximale d&apos;une application qui peut être installée depuis le Google Play Store est de 200 Mo.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><text:span text:style-name="T16"><text:line-break/></text:span><text:span text:style-name="T24">2. Dossier externe<text:line-break/></text:span><text:span text:style-name="T16">Aucun fichier audio n&apos;est empaqueté dans l&apos;application, donc l&apos;APK est petit. L&apos;application va chercher dans un dossier spécifié pour trouver les fichiers audio dont elle a besoin. Si vous distribuez l&apos;application via une carte mémoire, vous incluez le dossier des fichiers audio sur la carte mémoire avec l&apos;APK. Cette méthode nécessite la permission &quot;Lire le stockage externe&quot; mais pas d&apos;accès à Internet.<text:line-break/><text:line-break/>Vous pouvez placer les fichiers audio dans des sous-dossiers et sous-dossiers dans le dossier spécifié, en utilisant les noms de dossier que vous avez choisis. <text:line-break/><text:line-break/>Par exemple, Voici quelques noms de dossier possibles :<text:line-break/><text:line-break/>\Bible Files<text:line-break/>\1 Old Testament<text:line-break/>\01 Genesis<text:line-break/>\02 Exodus<text:line-break/>\2 New Testament<text:line-break/>\01 Matthew<text:line-break/>\02 Mark<text:line-break/><text:line-break/>ou<text:line-break/> \NT Mamara<text:line-break/>\01 Macoo<text:line-break/>\02 Marika<text:line-break/>\03 Luka<text:line-break/>\04 Yohana<text:line-break/></text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Il n&apos;est pas nécessaire d&apos;utiliser 01, 02, etc. dans les noms de dossiers, mais ceux-ci peuvent être utiles si les dossiers sont listés par ordre alphabétique.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Vous pouvez également placer tous les fichiers audio dans un seul dossier sans utiliser de sous-dossiers.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si l&apos;application ne trouve pas de fichiers audio dans le dossier spécifié ou ses sous-dossiers, il effectuera également une recherche dans les autres dossiers de l&apos;appareil pour voir s&apos;il peut les trouver là. Par exemple, si le nom du dossier spécifié est « Audio 123» mais que les fichiers sont situés dans le dossier « Audio 456» à la place, l&apos;application devrait les trouver. Une fois qu&apos;il a trouvé un dossier avec un fichier audio nécessaire, il en gardera une note pour qu&apos;il sache où regarder la prochaine fois.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P333" loext:marker-style-name="T6"><text:span text:style-name="T24">3. Internet Download<text:line-break/></text:span><text:span text:style-name="T16">Comme la méthode 2, aucun fichier audio n&apos;est empaqueté dans l&apos;application, donc l&apos;APK est petit. L&apos;application va chercher dans un dossier de carte SD spécifié pour trouver les fichiers audio dont elle a besoin. S&apos;il ne les trouve pas là, il va chercher dans tous les autres dossiers du périphérique. Si elle ne peut toujours pas les trouver, l&apos;application peut télécharger les fichiers un par un quand elle en a besoin à partir du site Web de votre choix. Cette méthode nécessite les autorisations &apos;Read external storage&apos;, &apos;Write external storage&apos;, &apos;Connection state&apos; et &apos;Internet&apos;.<text:line-break/></text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T11"><text:span text:style-name="T11">Nom du fichier audio</text:span><text:span text:style-name="T11"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Le téléchargement d&apos;Internet fonctionne mieux si vos noms de fichiers audio ne contiennent pas d&apos;espace. Un nom de fichier de la forme « LNG-MAT-01.mp3 » vaut mieux que « LNG MAT 01.mp3 ».</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T16"/>
   <text:p text:style-name="P15" loext:marker-style-name="T23"><text:soft-page-break/><text:span text:style-name="T11">Fichier audio hébergeant</text:span><text:span text:style-name="T11"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Les emplacements de stockage recommandés pour les fichiers sur Internet incluent :</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:continue-list="list2372207020" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T23"><text:span text:style-name="T52">A</text:span><text:span text:style-name="T23"> site web spécifique à la langue</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P18" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez un site Web spécifique à une langue pour rendre les ressources disponibles au téléchargement, vous pouvez placer les fichiers audio dans un dossier sur le site Web.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T16"><text:span text:style-name="T16">Par exemple, si votre site Web est appelé « www.ourlanguage.org », vous pouvez télécharger les fichiers audio dans un dossier appelé « audio ». L&apos;adresse http de vos fichiers audio serait alors : http://www.ourlanguage.org/audio </text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T16"><text:span text:style-name="T16">L&apos;administrateur de votre site web devrait être en mesure de vous aider à le faire.</text:span><text:span text:style-name="T16"/></text:p>
   <text:list xml:id="list164752472108773" text:continue-numbering="true" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P369" loext:marker-style-name="T23"><text:span text:style-name="T23">Services de stockage nuagique</text:span><text:span text:style-name="T23"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P13" loext:marker-style-name="T16"><text:span text:style-name="T16">Amazon S3 (Simple Storage Service): </text:span><text:a xlink:type="simple" xlink:href="http://aws.amazon.com/s3/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">http://aws.文.com/s3/</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T16"><text:span text:style-name="T16">Backblaze B2 Cloud Storage: </text:span><text:a xlink:type="simple" xlink:href="https://www.backblaze.com/b2/cloud-storage.html" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://www.backblaze.com/b2/cloud-storage.html</text:span></text:span></text:a><text:span text:style-name="T16"> </text:span></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T16"><text:span text:style-name="T16">Google Cloud Storage: </text:span><text:a xlink:type="simple" xlink:href="https://cloud.google.com/storage/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://cloud.google.com/storage/</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P202" loext:marker-style-name="T16"/>
   <text:p text:style-name="P329" loext:marker-style-name="T16"><text:span text:style-name="T16">Ces services de stockage cloud sont conçus pour un stockage en ligne rapide, fiable et sécurisé. Une fois que vous avez créé un compte, vous créez un &apos;secket&apos; dans lequel placer vos fichiers audio. Lorsque vous ajoutez les fichiers, vous devez les rendre publiques et prendre note du lien d&apos;adresse Web à utiliser pour y accéder. . http://s3.amazonaws.com/yourbucketname</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P329" loext:marker-style-name="T16"><text:span text:style-name="T16">Vous obtiendrez quelques mois de stockage gratuit avant qu&apos;il y ait une charge en fonction de la bande passante utilisée, i. . Combien de Mo d&apos;utilisateurs audio téléchargent. Il serait peut-être plus facile d&apos;organiser ce type de stockage dans le cloud à un niveau organisationnel plutôt que de créer un nouveau compte pour chaque langue.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P298" loext:marker-style-name="T13"><text:span text:style-name="T24">4. Cerveau biblique FCBH</text:span><text:span text:style-name="T13"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si les fichiers audio que votre application utilise proviennent de Faith vient en écoutant (FCBH), il n&apos;est pas nécessaire de les télécharger sur Internet. Ils sont déjà en ligne et peuvent être consultés via </text:span><text:a xlink:type="simple" xlink:href="https://biblebrain.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Brain biblique</text:span></text:span></text:a><text:span text:style-name="T16">. C&apos;est le serveur utilisé par l&apos;application </text:span><text:a xlink:type="simple" xlink:href="http://bible.is/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Bible.is</text:span></text:span></text:a><text:span text:style-name="T16"> et l&apos;application Bible.is mobile Jetez un coup d&apos;oeil sur le site de Bible.is pour voir si la langue qui vous intéresse est déjà disponible.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez des enregistrements d&apos;Écritures non-FCBH, ceux que vous avez enregistrés en interne avec l&apos;aide des techniciens de votre propre organisation, La FCBH est disposée à envisager d&apos;héberger ces fichiers aussi dans Bible Brain. Cela vaut par exemple pour les enregistrements de bonne qualité de livres bibliques complets – mais pas pour les portions d’histoires bibliques ou les supports d’enseignement. Pour enquêter sur cette option, veuillez communiquer avec votre représentant de la FCBH de votre région. </text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">For your app to be able to download files from Bible Brain, you will need to register with FCBH and provide the app with your Bible Brain </text:span><text:span text:style-name="T24">API key</text:span><text:span text:style-name="T16">, received on registration, and the </text:span><text:span text:style-name="T24">Fileset ID</text:span><text:span text:style-name="T16"> of the audio files. Cette méthode nécessite les autorisations &apos;Read external storage&apos;, &apos;Write external storage&apos;, &apos;Connection state&apos; et &apos;Internet&apos;.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Lors de la construction de votre application, vous devrez avoir téléchargé les fichiers audio FCBH sur votre ordinateur et les ajouter à la page Fichiers Audio. C&apos;est ainsi que SAB peut voir les noms de fichiers et vous permettre de créer des fichiers de chronométrage correspondants pour la synchronisation texte-audio. Les fichiers sont utilisés pour le processus de construction de l&apos;application et ne seront pas empaquetés dans le fichier APK.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T11"><text:span text:style-name="T11">Obtenir une clé API</text:span><text:span text:style-name="T11"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">La clé de l&apos;API Brain de la Bible est une chaîne alpha-numérique de 32 caractères.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P296" loext:marker-style-name="T149"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">To get a key, you need to register with FCBH:</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T47"/>
   <text:list text:style-name="WWNum6">
    <text:list-item>
     <text:p text:style-name="P444" loext:marker-style-name="T16"><text:span text:style-name="T16">Aller à </text:span><text:a xlink:type="simple" xlink:href="https://biblebrain.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://biblebrain.com</text:span></text:span></text:a><text:span text:style-name="T16"> </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P445" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur </text:span><text:span text:style-name="T23">obtenez votre clé API</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P445" loext:marker-style-name="T16"><text:span text:style-name="T16">On the </text:span><text:span text:style-name="T24">Request Your API Key</text:span><text:span text:style-name="T16"> form, fill in your details, mentioning that you are building apps with </text:span><text:span text:style-name="T6">Scripture App Builder</text:span><text:span text:style-name="T16"> and click </text:span><text:span text:style-name="T23">Submit</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T11"><text:span text:style-name="T11">Getting the Fileset ID</text:span><text:span text:style-name="T11"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">After you get your API key from FCBH, you will need to look for the </text:span><text:span text:style-name="T24">Fileset ID</text:span><text:span text:style-name="T16"> for the audio files you need.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><text:span text:style-name="T16">L&apos;identifiant du fichier est une chaîne de 10 caractères qui identifie de manière unique l&apos;ensemble des fichiers audio d&apos;une langue. “MYKWBTN2DA” (pour le Minyanka NT), “TPIPNGN2DA” (pour le Tok Pisin NT).</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P25" loext:marker-style-name="T16"><text:span text:style-name="T16">To find the Fileset ID for a language and Bible translation:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum71">
    <text:list-item>
     <text:p text:style-name="P148" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Allez sur la page </text:span><text:span text:style-name="T53">Téléchargement MP3 FCBH</text:span><text:span text:style-name="T39"> :</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:a xlink:type="simple" xlink:href="https://www.faithcomesbyhearing.com/audio-bible-resources/mp3-downloads" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">https://www.faithcomesbyhearing.com/audio-bible-resources/mp3-downloads</text:span></text:span></text:a><text:span text:style-name="T39"> </text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum71">
    <text:list-item>
     <text:p text:style-name="P147" loext:marker-style-name="T16"><text:span text:style-name="T39">Entrez la </text:span><text:span text:style-name="T53">langue</text:span><text:span text:style-name="T39"> et sélectionnez une </text:span><text:span text:style-name="T53">version</text:span><text:span text:style-name="T39">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P149" loext:marker-style-name="T16"><text:span text:style-name="T39">Regardez l&apos;URL dans la barre d&apos;adresse de votre navigateur Web. Les 10 derniers caractères sont l&apos;ID du fichier.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="P25" loext:marker-style-name="T16"><text:span text:style-name="T16"><text:line-break/>Voici une méthode alternative pour trouver l&apos;ID du Fileset :</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P446" loext:marker-style-name="T16"><text:span text:style-name="T16">Rendez-vous sur la page </text:span><text:span text:style-name="T23">Brain </text:span><text:span text:style-name="T17">du site Web de la FCBH en utilisant </text:span><text:a xlink:type="simple" xlink:href="https://biblebrain.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://biblebrain.</text:span></text:span></text:a><text:span text:style-name="T17"> et cliquez sur le bouton </text:span><text:span text:style-name="T23">Developer Docs</text:span><text:span text:style-name="T17">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P447" loext:marker-style-name="T16"><text:span text:style-name="T16">Go to the </text:span><text:span text:style-name="T23">Available Content</text:span><text:span text:style-name="T16"> page. Vous pouvez le trouver dans le menu à gauche de l&apos;écran.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P447" loext:marker-style-name="T16"><text:span text:style-name="T16">Entrez la langue ou le nom du pays pour filtrer les résultats de la recherche.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P447" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur le nom de la langue en rouge pour accéder à la page de langue du site Web Bible.is. </text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P447" loext:marker-style-name="T16"><text:span text:style-name="T16">Take a look at the URL in the address bar to find the </text:span><text:span text:style-name="T24">first six characters</text:span><text:span text:style-name="T16"> of the Fileset ID. Cela inclura le code de langue et la version, p. ex.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P350" loext:marker-style-name="T16"><text:span text:style-name="T16">MYKWBT – Minyanka (Wycliffe Bible Translators)<text:line-break/>BBOBSM – Konabere (Bible Society of Mali)</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list xml:id="list2521854012" text:style-name="WWNum67">
    <text:list-item>
     <text:p text:style-name="P151" loext:marker-style-name="T39"><text:span text:style-name="T39">The </text:span><text:span text:style-name="T53">seventh</text:span><text:span text:style-name="T39"> character of the Fileset ID is the </text:span><text:span text:style-name="T53">collection type</text:span><text:span text:style-name="T39">:</text:span><text:span text:style-name="T39"><text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body>
         <text:p text:style-name="Footnote">https://www.faithcomesbyhearing.com/bible-brain/core-concepts</text:p></text:note-body></text:note></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list92929251" text:style-name="WWNum68">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">C</text:span><text:span text:style-name="T39"> - Complète (tous les livres et chapitres des deux testaments)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">N</text:span><text:span text:style-name="T39"> - Nouveau Testament (tous les livres et chapitres)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">O</text:span><text:span text:style-name="T39"> - Ancien Testament (tous les livres et chapitres)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">P</text:span><text:span text:style-name="T39"> - Partielle (ensemble de livres ou de chapitres incomplets)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T53">S</text:span><text:span text:style-name="T39"> - Histoire (Contenu lié aux ibles, non une traduction formelle, non généralement organisée par livre ou chapitre)<text:line-break/></text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list164753833986768" text:continue-list="list2521854012" text:style-name="WWNum67">
    <text:list-item>
     <text:p text:style-name="P151" loext:marker-style-name="T39"><text:span text:style-name="T39">The </text:span><text:span text:style-name="T53">eighth</text:span><text:span text:style-name="T39"> character of the Fileset ID is the </text:span><text:span text:style-name="T53">drama type</text:span><text:span text:style-name="T39">:</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:list text:continue-list="list92929251" text:style-name="WWNum68">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">1</text:span><text:span text:style-name="T39"> - « non-drame », généralement multi-voix sans musique de fond, mais parfois une seule voix</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P152" loext:marker-style-name="T39"><text:span text:style-name="T53">2</text:span><text:span text:style-name="T39"> - « dramatique », ce qui signifie qu&apos;il est multi-voix avec de la musique de fond.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list text:continue-list="list164753833986768" text:style-name="WWNum67">
    <text:list-item>
     <text:p text:style-name="P150" loext:marker-style-name="T39"><text:span text:style-name="T39">The </text:span><text:span text:style-name="T53">ninth and tenth</text:span><text:span text:style-name="T39"> characters are the </text:span><text:span text:style-name="T53">media type</text:span><text:span text:style-name="T39">, which will be “</text:span><text:span text:style-name="T53">DA</text:span><text:span text:style-name="T39">” for digital audio.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:span text:style-name="T39">L&apos;identifiant combiné du fichier aura 10 caractères, par exemple:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P134" loext:marker-style-name="T16"/>
   <text:list text:style-name="WWNum69">
    <text:list-item>
     <text:p text:style-name="P153" loext:marker-style-name="T199"><text:span text:style-name="T199">MYKWBTN2DA – Minyanka, Wycliffe, Nouveau Testament, Drama, Audio</text:span><text:span text:style-name="T199"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P153" loext:marker-style-name="T39"><text:span text:style-name="T16">BBOBSMN1DA – Konabere, Société biblique du Mali, NT, Non-Drama, Audio<text:line-break/></text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T11"><text:span text:style-name="T39"><text:line-break/><text:line-break/></text:span><text:span text:style-name="T11">Configurer votre application pour utiliser la clé API et l&apos;ID de fichier</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Once you have an </text:span><text:span text:style-name="T53">API Key</text:span><text:span text:style-name="T39"> and a </text:span><text:span text:style-name="T53">Fileset ID</text:span><text:span text:style-name="T39">:</text:span></text:p>
   <text:list text:style-name="WWNum70">
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">Go to </text:span><text:span text:style-name="T23">Media </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T53">Audio</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T78"></text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T53">File Source</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T53">Ajouter un fichier source</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez &quot;FCBH Bible Brain&quot; comme </text:span><text:span text:style-name="T53">Source</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">Entrez votre clé API et votre identifiant de fichier dans les champs fournis.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Image11" text:anchor-type="as-char" svg:width="5.9846in" svg:height="3.4598in" draw:z-index="0"><draw:image xlink:href="SAB02/66.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum70">
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur le bouton </text:span><text:span text:style-name="T53">Tester</text:span><text:span text:style-name="T39"> pour vérifier que la clé API et l&apos;identifiant du fichier sont valides et qu&apos;ils permettront à votre application d&apos;accéder aux fichiers audio requis.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P154" loext:marker-style-name="T39"><text:span text:style-name="T39">You can modify the </text:span><text:span text:style-name="T53">Access Method</text:span><text:span text:style-name="T39"> to specify whether app users will be able to download and/or stream the audio files. Vous pourriez trouver que seul le streaming est autorisé pour certains identifiants de fichiers, en raison de restrictions de licence.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P89" loext:marker-style-name="T39"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871250"/>The <text:span text:style-name="T89">Audio Files</text:span> tab<text:bookmark-end text:name="_Toc233871250"/></text:h>
   <text:p text:style-name="Standard">Si vous avez une collection de livres uniques, des fichiers audio peuvent être ajoutés ici, mais il est préférable de les ajouter sous l&apos;onglet d&apos;une collection de livres ou d&apos;un livre <text:span text:style-name="T51">Fichiers Audio</text:span>. Dès qu&apos;un deuxième livre est ajouté, les fichiers audio ne seront plus listés ici. Pour plus de détails sur comment ajouter des fichiers, voir <text:a xlink:type="simple" xlink:href="#_How_can_I_3" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment puis-je associer des fichiers audio avec le texte ?</text:span></text:a></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_The_Audio_Toolbar"/><text:bookmark-start text:name="_Toc233871251"/>The <text:span text:style-name="T89">Audio Toolbar</text:span> tab<text:bookmark-end text:name="_Toc233871251"/></text:h>
   <text:p text:style-name="Standard">La barre d&apos;outils audio apparaît automatiquement en bas d&apos;une page de livre qui contient de l&apos;audio. Utilisez les paramètres ici pour spécifier comment la barre d&apos;outils apparaît.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">We recommend enabling <text:span text:style-name="T51">Show audio toolbar when the app is launched</text:span> (to make it clear to the user that there is audio), and the setting <text:span text:style-name="T51">Allow the user to turn off/on the audio toolbar</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Utilisez les options <text:span text:style-name="T51">Play Button Style</text:span> et <text:span text:style-name="T51">Size</text:span> pour spécifier à quoi ressemble la barre d&apos;outils.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Utilisez les boutons <text:span text:style-name="T51">Mode Répéter</text:span> et <text:span text:style-name="T51">Répéter les boutons A Audio</text:span> sélectionnés pour activer ces fonctionnalités qui peuvent aider les utilisateurs à mémoriser les Écritures ou simplement à écouter un passage plusieurs fois.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871252"/>The <text:span text:style-name="T89">Audio Settings</text:span> tab<text:bookmark-end text:name="_Toc233871252"/></text:h>
   <text:p text:style-name="Standard">L&apos;onglet Paramètres Audio contient un groupe varié de fonctions audio que vous pouvez activer ou désactiver.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Surligner la phrase actuelle lors de la lecture de l&apos;audio…</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>Si votre audio a des fichiers chronométrés, cocher cette case mettra en évidence l&apos;audio lorsqu&apos;il sera lu. Cette option est activée par défaut. You can specify if the user can turn this feature off under <text:a xlink:type="simple" xlink:href="#_The_Settings_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Navigation Drawer </text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"> Settings</text:span></text:a>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">At the end of a chapter/page…continue playing audio</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cette option est activée par défaut. Décochez la case si vous voulez que l&apos;audio s&apos;arrête à la fin d&apos;un chapitre ou d&apos;une page.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">At the end of a book…continue playing audio</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cette option n&apos;est pas activée par défaut. Cochez la case pour l&apos;activer.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Pause audio if the phone receives an incoming call</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cette option est activée par défaut et est une courtoisie pour l&apos;utilisateur. Ne décochez pas si vous n&apos;avez pas une raison spécifique de désactiver ceci.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Méthode d&apos;accès</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Comme l&apos;indique l&apos;option, cela fournit le choix par défaut pour le cas où un utilisateur a la possibilité de télécharger ou de diffuser de l&apos;audio. L&apos;utilisateur peut modifier cela dans les paramètres de l&apos;application .</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T55"><text:span text:style-name="T55">Minuterie Audio et Vitesse</text:span><text:span text:style-name="T55"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T41"><text:span text:style-name="T41">Il y a deux éléments qui sont automatiquement ajoutés à la barre d&apos;outils audio sur le côté droit sous les trois points verticaux : </text:span><text:span text:style-name="T54">Vitesse Audio</text:span><text:span text:style-name="T41"> et </text:span><text:span text:style-name="T54">Timer</text:span><text:span text:style-name="T41">. Vous n&apos;avez rien à ajouter à votre application pour les rendre disponibles (à part avoir de l&apos;audio dans la collection de livres actifs). Les utilisateurs peuvent utiliser la </text:span><text:span text:style-name="T54">Vitesse Audio</text:span><text:span text:style-name="T41"> pour ajuster la vitesse de l&apos;audio enregistrée (ça fait un bon travail !). Les utilisateurs peuvent définir le</text:span><text:span text:style-name="T54">udio Timer</text:span><text:span text:style-name="T41"> pour écouter l&apos;audio enregistré pendant un certain nombre de minutes. Le menu à trois points affichera le temps restant en cours.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table77" table:style-name="Table77">
    <table:table-column table:style-name="Table77.A"/>
    <table:table-column table:style-name="Table77.B"/>
    <table:table-row table:style-name="Table77.1">
     <table:table-cell table:style-name="Table77.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table77.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T41"><text:span text:style-name="T41">Pour les livres Audiouniquement, l’icône de minuterie apparaîtra sur la ligne inférieure de la barre d’outils audio, à côté de l’icône de vitesse de lecture.</text:span><text:span text:style-name="T41"/></text:p>
      <text:p text:style-name="P264" loext:marker-style-name="T44"/>
      <text:p text:style-name="P269" loext:marker-style-name="T41"><text:span text:style-name="T41">Pour désactiver une minuterie en cours d&apos;exécution, appuyez sur le bouton du menu, sélectionnez « Minuterie » et choisissez « Désactivé ».</text:span><text:span text:style-name="T41"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Image12" text:anchor-type="as-char" svg:width="2.4091in" svg:height="1.4138in" draw:z-index="0"><draw:image xlink:href="SAB02/67.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_The_Audio_Synchronization_1"/><text:bookmark-start text:name="_Toc233871253"/><text:soft-page-break/>The <text:span text:style-name="T89">Audio Synchronization</text:span> tab<text:bookmark-end text:name="_Toc233871253"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet </text:span><text:span text:style-name="T26">Synchronisation Audio</text:span><text:span text:style-name="T18"> vous permet de configurer les paramètres de création de fichiers de chronométrage afin de mettre en surbrillance le texte tel qu&apos;il est lu et/ou créer des vidéos de diaporama.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier des marqueurs globaux de fin de phrase pour séparer vos fichiers texte en phrases discrètes pour les mettre en surbrillance. Ces paramètres s&apos;appliquent à toutes les collections de livres sauf s&apos;ils sont remplacés au niveau de la collection du livre.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">To actually create audio timing files, go to the </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Audio Synchronization</text:span></text:span></text:a><text:span text:style-name="T18"> tab under the appropriate book collection.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871254"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Clips Audio</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871254"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T4">L&apos;onglet </text:span><text:span text:style-name="T22">Audio Clips</text:span><text:span text:style-name="T4"> est similaire à l&apos;onglet </text:span><text:span text:style-name="T22">Fichiers Audio</text:span><text:span text:style-name="T4"> , mais permet d&apos;ajouter des fichiers audio courts qui sont associés à des actions, y compris des éléments de quiz et des effets sonores, et des titres dans le menu Contenus. Pour plus d&apos;informations sur l&apos;ajout de clips audio, voir </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T22">Comment puis-je utiliser des clips audio dans l&apos;application?</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P220" loext:marker-style-name="T22"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T22"/></text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871255"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Télécharge</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871255"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">L&apos;onglet </text:span><text:span text:style-name="T22">Téléchargements</text:span><text:span text:style-name="T4"> vous permet de spécifier plusieurs paramètres concernant le téléchargement de l&apos;audio.</text:span></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">Gestionnaire de téléchargement</text:span><text:span text:style-name="T22"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Le gestionnaire de téléchargement permet aux utilisateurs de gérer en même temps le téléchargement de l&apos;audio pour plusieurs livres. Cela facilite grandement les utilisateurs qui ont un accès à Internet occasionnel et souhaitent obtenir une quantité de son à la fois, plutôt que de chapitre par chapitre.</text:span><text:span text:style-name="T4"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Sélectionnez </text:span><text:span text:style-name="T22">Utilisez</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T22">Gestionnaire de téléchargement dans cette application</text:span><text:span text:style-name="T4"> pour permettre à cette fonctionnalité d&apos;apparaître dans le menu de navigation.</text:span></text:p>
   <text:p text:style-name="P219" loext:marker-style-name="T4"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T22"><text:span text:style-name="T22">Emplacements de stockage Android</text:span><text:span text:style-name="T22"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T4"><text:span text:style-name="T4">Pour les appareils exécutant </text:span><text:span text:style-name="T22">Android 9 ou inférieur à</text:span><text:span text:style-name="T4">, utilisez les options suivantes pour spécifier comment les fichiers audio sont gérés :</text:span></text:p>
   <text:p text:style-name="P220" loext:marker-style-name="T22"/>
   <text:p text:style-name="P17" loext:marker-style-name="T51"><text:soft-page-break/><text:span text:style-name="T51">Rechercher dans tous les dossiers de l&apos;appareil…</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="P17">Si les fichiers audio peuvent être téléchargés en utilisant un <text:a xlink:type="simple" xlink:href="#_The_File_Source" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">spécifié Source de fichier</text:span></text:a>, le dossier de téléchargement est spécifié sur la page Modifier le fichier source de la Source du fichier. Si SAB ne peut pas y trouver le fichier audio, activer cette option (qui est activée par défaut) cherchera dans l&apos;ensemble du téléphone le fichier audio. </text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table78" table:style-name="Table78">
    <table:table-column table:style-name="Table78.A"/>
    <table:table-column table:style-name="Table78.B"/>
    <table:table-row table:style-name="Table78.1">
     <table:table-cell table:style-name="Table78.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table78.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Un utilisateur peut éventuellement déplacer des fichiers audio sur son téléphone. Si vous voulez vous assurer qu&apos;un utilisateur n&apos;a pas à télécharger à nouveau un fichier audio, activez la fonction Rechercher dans tous les dossiers. Cependant, lorsqu&apos;un utilisateur joue de l&apos;audio pour un chapitre sans audio téléchargé, SAB effectuera d&apos;abord une recherche sur l&apos;ensemble du téléphone avant de proposer de le télécharger. Cela peut prendre beaucoup de temps (minutes), il est donc préférable dans la plupart des cas de décocher cette option.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P448" loext:marker-style-name="T51"><text:span text:style-name="T51">Écrire un fichier .nomedia…</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="P17">Normalement, l&apos;audio téléchargé peut être trouvé par le lecteur multimédia d&apos;un téléphone et lu en dehors de l&apos;application. Il peut toutefois arriver que des problèmes de sécurité permettent de mieux dissimuler l&apos;audio. Si c&apos;est le cas, cochez la case pour écrire le fichier <text:span text:style-name="T51">.nomedia</text:span>.</text:p>
   <text:p text:style-name="P220" loext:marker-style-name="T22"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T22"/></text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:bookmark text:name="_How_can_I_3"/><text:span text:style-name="T39">pour les appareils fonctionnant sur </text:span><text:span text:style-name="T52">Android 10</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">et plus</text:span><text:span text:style-name="T39">, vous pouvez spécifier où sont stockés les fichiers audio téléchargés. Voir le texte de cet onglet dans SAB pour plus de détails sur les options.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_How_can_I_5"/><text:bookmark-start text:name="_Toc233871256"/>Comment puis-je associer des fichiers audio avec le texte?<text:bookmark-end text:name="_Toc233871256"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Scripture App Builder vous permet d&apos;utiliser deux types différents de fichiers audio :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list xml:id="list352446667" text:style-name="WWNum24">
    <text:list-item>
     <text:p text:style-name="P449" loext:marker-style-name="T39"><text:span text:style-name="T52">Les fichiers audio qui correspondent à une page de texte dans l&apos;application</text:span><text:span text:style-name="T39">, e. L’enregistrement audio d’un chapitre de la Bible ou du texte dans un livre d’histoires d’images. Celles-ci peuvent être liées aux fichiers de chronométrage pour permettre la mise en évidence synchronisée du texte lors de la lecture de l&apos;audio.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P450" loext:marker-style-name="T39"><text:span text:style-name="T52">de courts clips audio</text:span><text:span text:style-name="T39"> qui sont joués lorsque l&apos;utilisateur clique sur un mot, une phrase ou une image liés dans l&apos;application.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Le premier de ces types de fichiers est le plus courant dans les applications SAB et les instructions de cette section y font référence. </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Rendez-vous ici pour plus d&apos;informations sur l&apos;utilisation de clips audio</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To associate audio with pages of text in your app, you will need </text:span><text:span text:style-name="T200">one audio file per chapter or page</text:span><text:span text:style-name="T39">. Par exemple, si vous avez un livre « Matthew » avec 28 chapitres, vous aurez besoin de 28 fichiers audio, un pour chaque chapitre. </text:span></text:p>
   <text:p text:style-name="P426" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour Matthew chapitre 1 </text:span><text:span text:style-name="T71">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Bible-MAT-01.mp3</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Pour Matthew chapitre 2 </text:span><text:span text:style-name="T71">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Bible-MAT-02.mp3</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour Matthew chapitre 3 </text:span><text:span text:style-name="T71">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Bible-MAT-03.mp3</text:span><text:span text:style-name="T39">, etc.</text:span></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous avez plusieurs fichiers audio par chapitre ou plusieurs chapitres dans un seul fichier audio, vous devrez concaténer ou séparer vos fichiers pour créer des fichiers d&apos;un chapitre chacun avant que SAB puisse les utiliser. Cela pourrait être fait en utilisant </text:span><text:a xlink:type="simple" xlink:href="https://www.audacityteam.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Audacity</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour les livres d’histoires d’images, vous pouvez choisir si vous avez un fichier audio par page, ou un seul fichier audio pour l’ensemble du livre. Nous vous recommandons normalement d&apos;avoir un fichier par page.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P336" loext:marker-style-name="T39"><text:span text:style-name="T39">To add audio files:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P451" loext:marker-style-name="T39"><text:span text:style-name="T39">Allez dans l&apos;onglet </text:span><text:span text:style-name="T52">Fichiers Audio</text:span><text:span text:style-name="T39"> pour le livre, ou l&apos;onglet </text:span><text:span text:style-name="T53">Fichiers Audio</text:span><text:span text:style-name="T39"> pour la collection du livre. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P452" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Ajouter des fichiers audio…</text:span><text:span text:style-name="T39"> pour sélectionner les fichiers audio que vous avez déjà. Sinon, cliquez sur </text:span><text:span text:style-name="T52">Ajouter de la FCBH…</text:span><text:span text:style-name="T39"> pour spécifier les fichiers audio à télécharger à partir du serveur biblique du FCHB. Vous aurez besoin d&apos;une clé API pour faire cela. Cette clé est spécifiée sous </text:span><text:span text:style-name="T52">Média &gt; Audio &gt; Fichier Source</text:span><text:span text:style-name="T39"> lors de l&apos;ajout d&apos;une source à partir du cerveau biblique FCBH.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P452" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez les fichiers audio à ajouter.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB essaiera de faire correspondre les fichiers audio aux chapitres dans le(s) livre(s), vous devriez donc utiliser des noms de fichiers audio qui vous permettront de savoir quel fichier correspond à quel livre et chapitre.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table79" table:style-name="Table79">
    <table:table-column table:style-name="Table79.A"/>
    <table:table-column table:style-name="Table79.B"/>
    <table:table-row table:style-name="Table79.1">
     <table:table-cell table:style-name="Table79.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table79.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Placez les numéros de page ou de chapitre à la fin ou au début du nom de fichier et utilisez un zéro de début pour les nombres inférieurs à 10. Par ex. </text:span><text:span text:style-name="T95">John_chapter_01.mp3</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les fichiers de timing optionnels peuvent être ajoutés sur la même page : un fichier de chronométrage par fichier audio.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_How_can_I_1"/><text:bookmark-start text:name="_Toc233871257"/>Comment puis-je réduire la taille de mes fichiers audio?<text:bookmark-end text:name="_Toc233871257"/></text:h>
   <text:p text:style-name="Standard">Il est possible de réduire la taille des fichiers audio en utilisant divers outils (par exemple Audacity ou Scripture App Builder) pour les compresser. Il faut toutefois veiller à ce que la qualité des dossiers ne soit pas mise à mal. Comme les fichiers audio seront généralement joués sur un téléphone, vous pouvez probablement au moins convertir les fichiers de la stéréo en mono (de 2 canaux à 1). Vous pouvez également expérimenter la réduction de la fréquence et de la profondeur de bits des fichiers, puis les lire à travers un haut-parleur de téléphone ou sur votre ordinateur pour vérifier la qualité. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><text:soft-page-break/>Scripture App Builder possède quelques outils simples et intégrés de compression de fichiers audio et peut convertir vos fichiers audio en différents formats. Pour cela, sélectionnez un ou plusieurs de vos fichiers audio dans SAB, faites un clic droit sur la sélection et choisissez <text:span text:style-name="T51">Convertir les fichiers audio…</text:span> Choisissez le format et les paramètres de qualité que vous désirez, confirmez le dossier de sortie et cliquez sur <text:span text:style-name="T51">Créer des fichiers</text:span>. Par défaut, les fichiers audio convertis seront placés dans un sous-dossier <text:span text:style-name="T51">Audio</text:span> dans votre dossier <text:span text:style-name="T51">Applications bibliques</text:span>. Si vous voulez utiliser ces fichiers convertis, vous devrez supprimer vos fichiers d&apos;origine dans SAB puis ajouter les nouveaux.</text:p>
   <text:h text:style-name="P80" text:outline-level="3"><text:bookmark text:name="_How_do_I_1"/><text:bookmark-start text:name="_Toc233871258"/>Comment créer les fichiers de chronométrage audio pour la synchronisation du texte audio ?<text:bookmark-end text:name="_Toc233871258"/></text:h>
   <text:p text:style-name="P238" loext:marker-style-name="T39"/>
   <text:p text:style-name="P20" loext:marker-style-name="T39"><text:span text:style-name="T39">Les fichiers de timing indiquent à l&apos;application quand commencer à mettre en surbrillance chaque verset ou chaque phrase.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P333" loext:marker-style-name="T39"><text:span text:style-name="T39">There are three ways of creating these files:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P453" loext:marker-style-name="T39"><text:span text:style-name="T39">Create the timing files manually using the </text:span><text:span text:style-name="T53">Audacity</text:span><text:span text:style-name="T39"> audio editing program. Pour des instructions, veuillez vous référer au document </text:span><text:span text:style-name="T92">en utilisant Audacity pour la synchronisation de texte audio</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P454" loext:marker-style-name="T39"><text:span text:style-name="T39">Automatiser la création des fichiers de timing en utilisant </text:span><text:span text:style-name="T53">aéneas</text:span><text:span text:style-name="T39"> Pour obtenir des instructions, veuillez vous référer au document </text:span><text:span text:style-name="T92">utilisant aeneas pour la synchronisation du texte audio</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P454" loext:marker-style-name="T39"><text:span text:style-name="T39">Utilisez </text:span><text:span text:style-name="T53">HearThis</text:span><text:span text:style-name="T39"> pour enregistrer l&apos;audio. Lorsque vous exportez les fichiers MP3, il est possible d&apos;exporter un ensemble de fichiers de synchronisation en même temps. Pour obtenir des instructions, veuillez vous référer au document </text:span><text:span text:style-name="T92">Using HearThis for Audio Recording</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"><draw:frame draw:style-name="fr2" draw:name="Frame20" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="43" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table80" table:style-name="Table80">
       <table:table-column table:style-name="Table80.A" table:number-columns-repeated="2"/>
       <table:table-row table:style-name="Table80.1">
        <table:table-cell table:style-name="Table80.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table80.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster ce style…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table80.1">
        <table:table-cell table:style-name="Table80.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Couleur de surbrillance du texte lors de la lecture de l&apos;audio</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table80.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">surlignage</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P81" text:outline-level="3"><text:bookmark text:name="_How_do_I_2"/><text:bookmark text:name="_How_are_the"/><text:bookmark-start text:name="_Toc233871259"/>Comment les fichiers de chronométrage sont-ils distribués pour l&apos;application ?<text:bookmark-end text:name="_Toc233871259"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">If you have timing files for audio-text synchronization, they are always packaged in the app assets whatever the audio source setting chosen in </text:span><text:span text:style-name="T16"><text:bookmark-ref text:reference-format="number" text:ref-name="_Ref459712795">Error! Reference source not found.</text:bookmark-ref></text:span><text:span text:style-name="T16"><text:s/>above. Ils ne sont téléchargés de nulle part.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si les fichiers de chronométrage ne sont pas disponibles lorsque l&apos;application est compilée et sont ensuite créés par quelqu&apos;un qui ne construit pas l&apos;application (comme un bénévole), elles peuvent être placées dans le dossier externe pour être testées. Pour plus de détails, voir la section 6. dans le document </text:span><text:span text:style-name="T7">en utilisant Audacity pour la synchronisation Audio-Text</text:span><text:span text:style-name="T16">, qui répond à la question </text:span><text:span text:style-name="T7">« Je voudrais donner à quelqu&apos;un d&apos;autre la tâche de créer des fichiers de timing. Y a-t-il un moyen de les tester sans avoir besoin de savoir comment construire l&apos;application?»</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <text:h text:style-name="P81" text:outline-level="3"><text:bookmark text:name="_How_can_I"/><text:bookmark-start text:name="_Toc233871260"/><text:bookmark-start text:name="_Ref459717627"/>Comment puis-je utiliser des clips audio dans l&apos;application ?<text:bookmark-end text:name="_Toc233871260"/><text:bookmark-end text:name="_Ref459717627"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les clips audio sont de courts fichiers audio qui sont joués lorsque l&apos;utilisateur clique sur un mot, une phrase ou une image liés dans l&apos;application. Les clips audio sont utilisés comme effets sonores dans les questionnaires, sous forme d&apos;invite audio dans un menu de contenu et peut être défini comme des sons à jouer quand une image ou une phrase de texte est tapée.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To include an audio clip in your app:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum25">
    <text:list-item>
     <text:p text:style-name="P455" loext:marker-style-name="T39"><text:span text:style-name="T39">Aller à </text:span><text:span text:style-name="T52">Média </text:span><text:span text:style-name="T73">&lt;unk&gt;</text:span><text:span text:style-name="T52"> Audio </text:span><text:span text:style-name="T73">&lt;unk&gt;</text:span><text:span text:style-name="T23"> Clips Audio</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P456" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T16">Cliquez sur </text:span><text:span text:style-name="T23">Ajouter des Clips Audio…</text:span><text:span text:style-name="T16"> et sélectionnez le fichier audio que vous souhaitez ajouter.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P456" loext:marker-style-name="T39"><text:span text:style-name="T16">Ajouter un hyperlien vers ce fichier audio dans votre texte.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P348" loext:marker-style-name="T16"><text:span text:style-name="T16">Vous pouvez le faire en utilisant le format markdown avec [] et (), e.g.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P348" loext:marker-style-name="T39"><text:span text:style-name="T39">[Cliquez moi pour entendre ce mot](word1.mp3)</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P457" loext:marker-style-name="T39"><text:span text:style-name="T39">[image \fig avec son \fig*](image_sound.mp3)</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P349" loext:marker-style-name="T39"><text:span text:style-name="T39">ou si votre texte est dans un document Word, sélectionnez un mot ou une phrase, cliquez avec le bouton droit, </text:span><text:span text:style-name="T52">Hyperlien…</text:span><text:span text:style-name="T39"> et entrez le nom du fichier audio comme adresse vers laquelle vous devez vous connecter.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P3" loext:marker-style-name="T19"><draw:frame draw:style-name="fr4" draw:name="Picture 236" text:anchor-type="as-char" svg:width="5.0264in" svg:height="2.6126in" draw:z-index="0"><draw:image xlink:href="SAB02/68.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P212" loext:marker-style-name="T19"/>
   <text:p text:style-name="P22" loext:marker-style-name="T19"><text:span text:style-name="T19">Les clips ajoutés ici peuvent être utilisés n&apos;importe où dans un fichier texte, ainsi que dans le menu Contenus.</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P17" loext:marker-style-name="T19"><text:span text:style-name="T19">Spécifiez le nom du fichier audio sans chemin, par exemple « word1.mp3 » plutôt que « C:\My clips\word1.mp3 ».</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P213" loext:marker-style-name="T19"/>
   <text:p text:style-name="P213" loext:marker-style-name="T19"><draw:frame draw:style-name="fr2" draw:name="Frame21" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="42" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table81" table:style-name="Table81">
       <table:table-column table:style-name="Table81.A" table:number-columns-repeated="2"/>
       <table:table-row table:style-name="Table81.1">
        <table:table-cell table:style-name="Table81.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table81.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster ce style…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table81.1">
        <table:table-cell table:style-name="Table81.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Liens du clip audio</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table81.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">un lien audio</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P80" text:outline-level="3"><text:bookmark text:name="_How_can_I_4"/><text:bookmark-start text:name="_Toc233871261"/>Comment puis-je créer des sous-titres à partir de fichiers de texte et de chronométrage ?<text:bookmark-end text:name="_Toc233871261"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Si vous avez des fichiers texte et chronométrage pour la synchronisation audio, Scripture App Builder peut créer des fichiers de sous-titres pour vous. Celles-ci peuvent être de l&apos;un des quatre formats suivants :</text:span><text:span text:style-name="T19"/></text:p>
   <text:list text:continue-list="list164752472108773" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P155" loext:marker-style-name="T19"><text:span text:style-name="T19">Sous-titres SRT SubRip (.srt)</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P155" loext:marker-style-name="T19"><text:span text:style-name="T19">Sous-titres SAMI pour Windows Media Player (.smi)</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P155" loext:marker-style-name="T19"><text:span text:style-name="T19">WEBVTT Web Video Tracks (.vtt)</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P155" loext:marker-style-name="T19"><text:span text:style-name="T19">Adobe Encore Text Scripts (.txt)</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T19"><text:soft-page-break/><text:span text:style-name="T19">To create a subtitles file, go to the </text:span><text:span text:style-name="T28">Audio Files</text:span><text:span text:style-name="T19"> tab, right-click and select </text:span><text:span text:style-name="T28">Export Subtitles</text:span><text:span text:style-name="T19">.</text:span></text:p>
   <text:p text:style-name="P214" loext:marker-style-name="T19"/>
   <text:h text:style-name="P67" text:outline-level="2"><text:bookmark text:name="_Video"/><text:bookmark-start text:name="_Toc233871262"/>Vidéo<text:bookmark-end text:name="_Toc233871262"/></text:h>
   <text:p text:style-name="Standard">Les vidéos peuvent être très puissantes et s’engager du point de vue de l’Engagement des Écritures. Cependant, ils peuvent également augmenter considérablement la taille de votre application s&apos;ils sont inclus dans le fichier d&apos;installation de votre application. Il est donc recommandé d&apos;inclure dans la mesure du possible des liens vers des vidéos en ligne.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871263"/>The <text:span text:style-name="T89">Videos</text:span> tab<text:bookmark-end text:name="_Toc233871263"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">The app can handle two types of video:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list xml:id="list164754065111989" text:continue-list="list352446667" text:style-name="WWNum24">
    <text:list-item>
     <text:p text:style-name="P450" loext:marker-style-name="T39"><text:span text:style-name="T52">Les vidéos pour hors ligne utilisent</text:span><text:span text:style-name="T39">--MP4 fichiers qui peuvent être empaquetés dans les ressources de l&apos;application, distribué sur des cartes mémoires ou téléchargé à partir d&apos;Internet pour être utilisé et partagé hors ligne.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P449" loext:marker-style-name="T39"><text:span text:style-name="T52">Vidéos hébergées en ligne pour le streaming</text:span><text:span text:style-name="T39">, e.g. YouTube, Vimeo ou autre (MP4) en streaming de fichiers vidéo, et Jesus Film et LUMO (Gospel Films) clips vidéo.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Lorsqu&apos;il est ajouté à votre projet, les vidéos reçoivent un ID vidéo et peuvent ensuite être ajoutées à un ou plusieurs endroits dans vos fichiers de livre.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P215" loext:marker-style-name="T19"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">To add an </text:span><text:span text:style-name="T27">offline</text:span><text:span text:style-name="T19"> MP4 video file:</text:span></text:p>
   <text:list text:style-name="WWNum43">
    <text:list-item>
     <text:p text:style-name="P458" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Ajouter des vidéos…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P458" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez </text:span><text:span text:style-name="T27">Fichiers vidéo au format MP4</text:span><text:span text:style-name="T19">, et cliquez sur </text:span><text:span text:style-name="T19">Suivant.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P458" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Ajouter des vidéos…</text:span><text:span text:style-name="T19"> et sélectionnez les fichiers vidéo MP4 à ajouter.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P459" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Terminez</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P216" loext:marker-style-name="T19"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">To add a single </text:span><text:span text:style-name="T27">online</text:span><text:span text:style-name="T19"> video :</text:span></text:p>
   <text:list text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P460" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Ajouter des vidéos…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P460" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez </text:span><text:span text:style-name="T27">Vidéo de streaming en ligne, à partir de YouTube, Vimeo, etc.</text:span><text:span text:style-name="T19">, et cliquez sur </text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P460" loext:marker-style-name="T19"><text:soft-page-break/><text:span text:style-name="T19">Entrez l&apos;URL de la vidéo dans le champ Adresse en ligne, par exemple http://www.youtube.com/watch?v=ABcDEdGHiJ.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P460" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Terminez</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P215" loext:marker-style-name="T19"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">To add a series of online video clips from the Jesus Film (if available):</text:span><text:span text:style-name="T19"/></text:p>
   <text:list text:style-name="WWNum99">
    <text:list-item>
     <text:p text:style-name="P461" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Ajouter des vidéos…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P462" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez </text:span><text:span text:style-name="T27">Jésus clips</text:span><text:span text:style-name="T19">, et cliquez </text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P462" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez le </text:span><text:span text:style-name="T27">Pays</text:span><text:span text:style-name="T19"> puis la </text:span><text:span text:style-name="T27">Langue</text:span><text:span text:style-name="T19">. La mise à jour des listes peut prendre quelques secondes. Si le film Jésus a été doublé dans votre langue cible, il devrait être disponible dans la liste des langues.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P462" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez dans quelle collection de livres ajouter les clips. Note : la collection de livres devra avoir la disponibilité de tout l&apos;Évangile de Luc.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P462" loext:marker-style-name="T19"><text:span text:style-name="T19">Choisissez si vous voulez ajouter des titres sous chaque clip vidéo. Si oui, choisissez la liste des langues disponibles. Note : il s&apos;agira de langues de communication plus large.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P462" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Terminez</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P214" loext:marker-style-name="T19"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">To add a series of online video clips from Gospel (LUMO) Films by Faith Comes By Hearing (if available):</text:span><text:span text:style-name="T19"/></text:p>
   <text:list text:style-name="WWNum100">
    <text:list-item>
     <text:p text:style-name="P463" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Ajouter des vidéos…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P464" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez </text:span><text:span text:style-name="T27">Les clips du film Gospel de Faith vient en écoutant</text:span><text:span text:style-name="T19">et cliquez sur </text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P464" loext:marker-style-name="T19"><text:span text:style-name="T19">Entrez votre clé API. si vous avez déjà une clé API à partir de l’audio du serveur de cerveaux bibliques de FCBH, vous pouvez l’utiliser ici. Si vous n&apos;avez pas de clé, utilisez le lien fourni pour en demander une.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P464" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez le </text:span><text:span text:style-name="T27">Pays</text:span><text:span text:style-name="T19"> puis la </text:span><text:span text:style-name="T27">Langue</text:span><text:span text:style-name="T19">. La mise à jour des listes peut prendre quelques secondes. Si le film Gospel a été doublé dans votre langue cible, il devrait être disponible dans la liste des langues.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P464" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez dans quelle collection de livres ajouter les clips. Note : la collection de livres devra avoir le livre évangélique correspondant.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P464" loext:marker-style-name="T19"><text:span text:style-name="T19">Cliquez sur </text:span><text:span text:style-name="T27">Terminez</text:span><text:span text:style-name="T19">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P216" loext:marker-style-name="T19"/>
   <text:p text:style-name="P15" loext:marker-style-name="T19"><text:soft-page-break/><text:span text:style-name="T19">Once a video or list of videos have been added, they will appear in the table under the </text:span><text:span text:style-name="T27">Videos</text:span><text:span text:style-name="T19"> tab and each assigned a video ID. Double-cliquez sur une vidéo pour accéder à ses options de configuration </text:span><text:span text:style-name="T19">par exemple son emplacement, sa vignette et son titre. </text:span></text:p>
   <text:p text:style-name="P214" loext:marker-style-name="T19"/>
   <table:table table:name="Table82" table:style-name="Table82">
    <table:table-column table:style-name="Table82.A"/>
    <table:table-column table:style-name="Table82.B"/>
    <table:table-row table:style-name="Table82.1">
     <table:table-cell table:style-name="Table82.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table82.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T10">Pour spécifier le placement dans les options de configuration, le livre devra avoir des marqueurs de chapitre et de verset pour spécifier l&apos;emplacement. Si vous voulez placer une vidéo dans un livre sans marqueurs de chapitre et de verset, vous devrez éditer le fichier du livre et utiliser </text:span><text:a xlink:type="simple" xlink:href="#_Media" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T10">format markdown</text:span></text:span></text:a><text:span text:style-name="T10"> pour spécifier l&apos;emplacement.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P261" loext:marker-style-name="T48"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871264"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Paramètres vidéo</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871264"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T19"><text:span text:style-name="T19">Cet onglet vous permet de définir diverses options de configuration pour la lecture de vidéos dans votre application.</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P214" loext:marker-style-name="T19"><draw:frame draw:style-name="fr2" draw:name="Frame22" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="41" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table83" table:style-name="Table83">
       <table:table-column table:style-name="Table83.A" table:number-columns-repeated="2"/>
       <table:table-row table:style-name="Table83.1">
        <table:table-cell table:style-name="Table83.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table83.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster ce style…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table83.1">
        <table:table-cell table:style-name="Table83.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Bloc vidéo (arrière-plan autour de la vidéo)</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table83.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Bloc div.video</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table83.1">
        <table:table-cell table:style-name="Table83.A3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Titre de la vidéo (titre de la vidéo si ajouté)</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table83.B3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">span.video-title</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table83.1">
        <table:table-cell table:style-name="Table83.A4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Bloc titre de la vidéo (arrière-plan du titre)</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table83.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Titre div.video-</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P75" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871265"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Onglet</text:span><text:span text:style-name="T18"> Onglet</text:span><text:bookmark-end text:name="_Toc233871265"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T19"><text:span text:style-name="T19">Utilisez différentes sources de fichiers pour spécifier où une ressource particulière est accédée, soit intégrée dans l&apos;APK, soit téléchargée ou diffusée à partir d&apos;une source externe. Note that this tab mirrors the </text:span><text:a xlink:type="simple" xlink:href="#_The_File_Source" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T27">File Source</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T19"> tab</text:span></text:span></text:a><text:span text:style-name="T19"> under </text:span><text:span text:style-name="T27">Media</text:span><text:span text:style-name="T19"> </text:span><text:span text:style-name="T79"></text:span><text:span text:style-name="T19"> </text:span><text:span text:style-name="T27">Audio</text:span><text:span text:style-name="T19">. Voir cette section pour plus de détails. N&apos;oubliez pas qu&apos;il n&apos;est pas conseillé d&apos;inclure des fichiers vidéo dans votre fichier d&apos;installation APK, à moins qu&apos;ils ne soient relativement petits.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_How_do_I_3"/><text:bookmark-start text:name="_Toc233871266"/><text:span text:style-name="T18">Comment modifier l’emplacement et les options de configuration d’une vidéo ?</text:span><text:bookmark-end text:name="_Toc233871266"/><text:span text:style-name="T18"> </text:span></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Double-cliquez sur une vidéo dans la table </text:span><text:span text:style-name="T27">Vidéos</text:span><text:span text:style-name="T19"> pour accéder à sa boîte de dialogue </text:span><text:span text:style-name="T27">Modifier la vidéo</text:span><text:span text:style-name="T19">. Cette boîte de dialogue a trois onglets :</text:span></text:p>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T27"><text:span text:style-name="T27">Vidéo</text:span><text:span text:style-name="T27"/></text:p>
   <text:list text:style-name="WWNum102">
    <text:list-item>
     <text:p text:style-name="P156" loext:marker-style-name="T19"><text:span text:style-name="T19">ID vidéo : SAB assigne un ID vidéo unique à chaque vidéo. Vous pouvez le modifier ici.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P156" loext:marker-style-name="T19"><text:span text:style-name="T19">Titre: Utilisez le champ Titre pour afficher un titre sous la vignette d’une vidéo.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P156" loext:marker-style-name="T19"><text:span text:style-name="T19">Vidéo en ligne : Vous pouvez modifier l’URL de la vidéo ici.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P156" loext:marker-style-name="T19"><text:span text:style-name="T19">Vidéo hors ligne : Pour une vidéo hors ligne, mettez à jour le nom de fichier et la source de fichiers.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P211" loext:marker-style-name="T19"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T27"><text:span text:style-name="T27">Thumbnail</text:span><text:span text:style-name="T27"/></text:p>
   <text:list text:style-name="WWNum101">
    <text:list-item>
     <text:p text:style-name="P157" loext:marker-style-name="T19"><text:soft-page-break/><text:span text:style-name="T19">Sélectionnez Fichier : Choisissez une image jpg ou png à afficher en miniature.</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P157" loext:marker-style-name="T19"><text:span text:style-name="T19">Sélectionnez le cadre : Choisissez une image dans la vidéo (si un MP4 hors ligne).</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P157" loext:marker-style-name="T19"><text:span text:style-name="T19">Grab Online Image: SAB va essayer d&apos;obtenir une image du service vidéo (YouTube etc.)</text:span><text:span text:style-name="T19"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T27"><text:span text:style-name="T27">Placement</text:span><text:span text:style-name="T27"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Spécifie une position dans un chapitre de l&apos;Écriture -- avant ou après un verset donné ou en haut ou en bas d&apos;une page.</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Alternatively, you can place a video marker in a source book file:</text:span><text:span text:style-name="T19"/></text:p>
   <text:list text:continue-list="list164754065111989" text:style-name="WWNum24">
    <text:list-item>
     <text:p text:style-name="P449" loext:marker-style-name="T19"><text:span text:style-name="T27">Video markers in SFM book files</text:span><text:span text:style-name="T19">: Use the </text:span><text:span text:style-name="T111">\video</text:span><text:span text:style-name="T19"> marker, together with the ID of the video within an SFM book file, e.g.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P351" loext:marker-style-name="T34"><text:span text:style-name="T34">\s This is a sub heading<text:line-break/>\p Here is an example video to view:<text:line-break/></text:span><text:span text:style-name="T112">\video V1</text:span><text:span text:style-name="T34"><text:line-break/>\p Here is another video:<text:line-break/></text:span><text:span text:style-name="T112">\video V2</text:span></text:p>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:list text:style-name="WWNum44">
    <text:list-item>
     <text:p text:style-name="P465" loext:marker-style-name="T19"><text:span text:style-name="T27">Video markers in Word documents</text:span><text:span text:style-name="T19">: Use the word </text:span><text:span text:style-name="T111">VIDEO:</text:span><text:span text:style-name="T19">, together with the ID of the video within a book’s Word document, e.g.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P466" loext:marker-style-name="T34"><text:span text:style-name="T35">Ceci est un sous-titre<text:line-break/></text:span><text:span text:style-name="T34">Voici un exemple de vidéo à voir :<text:line-break/></text:span><text:span text:style-name="T112">VIDEO : V1</text:span></text:p>
   <text:p text:style-name="P466" loext:marker-style-name="T34"><text:span text:style-name="T34">Here is another video:<text:line-break/></text:span><text:span text:style-name="T112">VIDEO: V2</text:span></text:p>
   <text:p text:style-name="P345" loext:marker-style-name="T19"><text:span text:style-name="T19">Le </text:span><text:span text:style-name="T111">VIDEO :</text:span><text:span text:style-name="T19"> balise doit être au début d&apos;un nouveau paragraphe, et inclure un deux-points (:) avant l&apos;identifiant de la vidéo.</text:span></text:p>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871267"/>Comment puis-je réduire la taille d&apos;une vidéo que je veux empaqueter dans l&apos;application ?<text:bookmark-end text:name="_Toc233871267"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Si vous voulez inclure des fichiers vidéo MP4 dans l&apos;application, vous devez vous assurer qu&apos;ils sont aussi petits que possible, sinon votre application deviendra trop grande pour être publiée.</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T19"><text:span text:style-name="T19">Il ya quelques bons outils de compression vidéo en ligne qui peuvent réduire considérablement la taille d&apos;une vidéo sans perdre beaucoup de qualité. Un exemple est l&apos;outil vidéo de compression de Clideo, à </text:span><text:a xlink:type="simple" xlink:href="https://clideo.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T19">https://clideo.com</text:span></text:span></text:a><text:span text:style-name="T19">. </text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871268"/><text:span text:style-name="Heading_20_3_20_Char"><text:span text:style-name="T55">Comment puis-je créer des vidéos de diaporama en utilisant des fichiers audio</text:span></text:span> ?<text:bookmark-end text:name="_Toc233871268"/></text:h>
   <text:p text:style-name="Standard"><text:bookmark text:name="_How_do_I"/><text:soft-page-break/>Les vidéos diaporamas sont des vidéos créées à l&apos;aide d&apos;un ensemble d&apos;images fixes avec des fichiers audio provenant d&apos;un projet <text:span text:style-name="T93">Créateur d&apos;applications bibliques</text:span>. Pendant la lecture de l&apos;audio, les images vont faire un panoramique et/ou zoomer. Les sous-titres seront générés à partir du texte de l&apos;application.<text:line-break/></text:p>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Picture 16" text:anchor-type="as-char" svg:width="4.3598in" svg:height="2.4402in" draw:z-index="0"><draw:image xlink:href="SAB02/69.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Pour créer des vidéos de diaporama, veuillez consulter le manuel de documentation #12, « Créer des vidéos de diaporama ».</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T18"><text:bookmark text:name="_Illustrations"/><text:bookmark-start text:name="_Toc233871269"/><text:span text:style-name="T18">Illustrations</text:span><text:bookmark-end text:name="_Toc233871269"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Use the </text:span><text:span text:style-name="T26">Illustrations</text:span><text:span text:style-name="T18"> configuration screen to add images to your app. Notez que ce ne sont pas les images d&apos;interface spécifiques trouvées dans le menu Apparence &gt; Graphiques, mais plutôt des images qui sont disponibles dans les livres ou dans la boîte À Propos.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">There are several configuration options:</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Inclure et afficher les illustrations dans cette application</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Assurez-vous que cette case est cochée pour que les photos s&apos;affichent. Décochez la case si, pour une raison quelconque, vous voulez cacher temporairement toutes les images.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Permettre aux utilisateurs de voir les images en plein écran et de zoomer pour voir les détails</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Cochez cette case si vous voulez permettre aux utilisateurs de voir les images à une taille plus grande.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Redimensionner les fichiers image pour réduire la taille de l&apos;application</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard"><text:span text:style-name="T18">Ceci est recommandé pour garder la taille de votre application aussi petite que possible. </text:span>Choisissez une largeur maximale qui reflète une résolution d&apos;écran moyenne de vos téléphones cibles, par exemple 720 - 1024 pixels. Ceci s&apos;appliquera à toutes vos illustrations dans le tableau, sauf modification individuelle.</text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table84" table:style-name="Table84">
    <table:table-column table:style-name="Table84.A"/>
    <table:table-column table:style-name="Table84.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table84.1">
     <table:table-cell table:style-name="Table84.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table84.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Vous pouvez écraser les paramètres de taille et de zoom d&apos;une image spécifique en double-cliquant dessus dans la liste des images et en modifiant ses paramètres.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871270"/><text:span text:style-name="T18">Ajouter des illustrations / images</text:span><text:bookmark-end text:name="_Toc233871270"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez le bouton Ajouter une image… pour ajouter une ou plusieurs images. Celles-ci peuvent être au format JPEG, PNG ou GIF. Les images apparaîtront dans la table image avec une miniature, des dimensions, la taille du fichier la taille, le nom du fichier et les informations de placement. Notez que la taille du fichier est la taille de l&apos;image originale, pas la taille après SAB réduit la taille du fichier (si l&apos;option Redimensionner est sélectionnée).</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table85" table:style-name="Table85">
    <table:table-column table:style-name="Table85.A"/>
    <table:table-column table:style-name="Table85.B"/>
    <table:table-row table:style-name="Table85.1">
     <table:table-cell table:style-name="Table85.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table85.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Assurez-vous que les références à vos images utilisent un nom de fichier qui est exactement le même que celui de l&apos;image que vous ajoutez à SAB. Les noms de fichiers image sont CASE SENSITIVE.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">When an image is added, SAB copies the image into the </text:span><text:span text:style-name="T95">images\illustrations</text:span><text:span text:style-name="T90"> subfolder of the </text:span><text:a xlink:type="simple" xlink:href="#_Project-specific_data_folders" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">project’s data folder</text:span></text:span></text:a><text:span text:style-name="T90">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871271"/><text:span text:style-name="T18">Modifier une taille d&apos;image ou Placement</text:span><text:bookmark-end text:name="_Toc233871271"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Une fois qu&apos;une image a été ajoutée à la liste des tableaux Illustrations, double-cliquez dessus pour ouvrir la boîte de dialogue Image et Placements. Il y a quatre onglets :</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Image</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Un résumé du nom du fichier d&apos;image, des dimensions et de la taille du fichier (avant que le redimensionnement soit appliqué).</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Placement</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utiliser </text:span><text:span text:style-name="T26">Ajouter un placement…</text:span><text:span text:style-name="T18"> bouton ouvrir la boîte de dialogue </text:span><text:span text:style-name="T26">Ajouter un placement</text:span><text:span text:style-name="T18">. Vous pouvez spécifier un emplacement dans le livre, le chapitre et le verset de toute collection de livres. Une seule image peut avoir plusieurs placements (mais ne prend pas plus de place dans l&apos;application que la simple instance). Vous pouvez également spécifier une légende optionnelle.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table86" table:style-name="Table86">
    <table:table-column table:style-name="Table86.A"/>
    <table:table-column table:style-name="Table86.B"/>
    <table:table-row table:style-name="Table86.1">
     <table:table-cell table:style-name="Table86.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table86.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Si vous voulez placer une image dans un emplacement exact dans un livre non-biblique, vous devrez soit avoir des marqueurs de verset cachés dans le texte afin de pouvoir spécifier l&apos;emplacement du « verset » ou utilisez les marqueurs \img ou \fig…\fig* pour le localiser directement dans le fichier du livre sans utiliser la fonction Placement.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P276" loext:marker-style-name="T90"/>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If you want to add an image to the About box, see the section on </text:span><text:a xlink:type="simple" xlink:href="#_Which_formatting_codes" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">formatting codes</text:span></text:span></text:a><text:span text:style-name="T90"> in the About project menu.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T59">Zoom</text:span><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:soft-page-break/><text:span text:style-name="T138">Use the zoom settings to override the main zoom settings under the main </text:span><text:span text:style-name="T59">Illustrations</text:span><text:span text:style-name="T138"> tab.</text:span></text:p>
   <text:p text:style-name="P468" loext:marker-style-name="T138"><text:s/><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T59"><text:span text:style-name="T59">Redimensionnement</text:span><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Use the resize settings to override the main resize settings under the main </text:span><text:span text:style-name="T59">Illustrations</text:span><text:span text:style-name="T138"> tab.</text:span></text:p>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T138"><text:bookmark text:name="_Documents"/><text:bookmark-start text:name="_Toc233871272"/><text:span text:style-name="T138">Documents</text:span><text:bookmark-end text:name="_Toc233871272"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Vous pouvez ajouter des documents PDF à votre application. Celles-ci sont accessibles via le menu </text:span><text:a xlink:type="simple" xlink:href="#_Contents_Menu" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T138">Contents Menu</text:span></text:span></text:a><text:span text:style-name="T138"> ou </text:span><text:span text:style-name="T138">. Ajoutez le PDF ici, et il sera sélectionnable comme un élément à lier dans ces zones. Le PDF apparaîtra dans l&apos;application dans un visualiseur PDF qui peut être navigué et zoom avant ou arrière.</text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T59">L&apos;onglet </text:span><text:span text:style-name="T100">Document</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T138">To add a PDF document, click </text:span><text:span text:style-name="T59">Add Documents…</text:span></text:p>
   <text:p text:style-name="P310" loext:marker-style-name="T59"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T100">Visionneuse</text:span><text:span text:style-name="T59"> onglet</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Utilisez l&apos;onglet Visionneuse pour avoir une idée de la façon dont le PDF apparaîtra dans l&apos;application. </text:span><text:span text:style-name="T138"/></text:p>
   <text:h text:style-name="P68" text:outline-level="2"><text:bookmark-start text:name="_Toc233871273"/><text:bookmark-start text:name="_Hlk152685549"/>Radio<text:bookmark-end text:name="_Toc233871273"/></text:h>
   <text:p text:style-name="P16">Vous pouvez inclure des stations de radio Web (radio internet) dans votre application.</text:p>
   <text:p text:style-name="P31">Pour ajouter une station de radio web :</text:p>
   <text:list text:style-name="WWNum77">
    <text:list-item>
     <text:p text:style-name="P158">Allez sur <text:span text:style-name="T55">Média</text:span> <text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">Radio</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P159">Cliquez sur <text:span text:style-name="T55">Ajouter une station radio…</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P159">Entrez un ID unique pour la station (non vu par l&apos;utilisateur), un nom court, et l&apos;adresse web (URL) à partir de laquelle la station de radio est en streaming. Des exemples d&apos;URL peuvent être trouvés sur <text:a xlink:type="simple" xlink:href="https://streamurl.link/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://streamurl.link</text:span></text:a>. <text:line-break/><text:span text:style-name="T189"><text:line-break/></text:span>Cliquer <text:span text:style-name="T55">A Prochaine</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P159">Choisissez une image à afficher lors de la lecture de la station radio. Cela pourrait être le logo de la station de radio.<text:line-break/><text:span text:style-name="T189"><text:line-break/></text:span>Cliquez <text:span text:style-name="T55">A Prochaine</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P159"><text:soft-page-break/>Choisissez d&apos;ajouter un lien vers cette station à partir du menu Contenus.<text:line-break/><text:span text:style-name="T189"><text:line-break/></text:span>Cliquez <text:span text:style-name="T55">Terminez</text:span>.<text:line-break/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P158">Compiler l&apos;application pour tester les stations radio sur votre appareil. </text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15"><text:s/></text:p>
   <text:h text:style-name="P49" text:outline-level="1"><text:bookmark-start text:name="_Toc233871274"/>Le <text:span text:style-name="T89">Livres</text:span> menu projet<text:bookmark-end text:name="_Toc233871274"/><text:bookmark-end text:name="_Hlk152685549"/></text:h>
   <text:p text:style-name="Standard">Le menu projet <text:span text:style-name="T51">Livres</text:span> est l&apos;endroit où toutes vos collections de livres et livres individuels sont ajoutées et modifiées.</text:p>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_The_Book_Collections"/><text:bookmark-start text:name="_Toc233871275"/><text:span text:style-name="T90">Collections de livres</text:span><text:span text:style-name="T39"> onglet</text:span><text:bookmark-end text:name="_Toc233871275"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Une collection de livres est un ensemble de livres qui peuvent être regroupées logiquement. La plupart des applications simples ont une collection de livres unique (appelée </text:span><text:span text:style-name="T52">Collection Principale</text:span><text:span text:style-name="T39"> par défaut). Les livres qui se trouvent dans la même collection apparaissent dans la liste des livres de la barre de menus de votre application, à moins que vous ne les masquiez spécifiquement.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">L&apos;utilisation la plus courante pour plusieurs collections de livres est d&apos;avoir deux ou plusieurs traductions dans votre application. Pour des raisons pourquoi considérer ceci, voir </text:span><text:a xlink:type="simple" xlink:href="#_Why_and_how" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Pourquoi et comment dois-je ajouter plusieurs traductions à mon application ?</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous avez plusieurs collections de livres, vous pouvez permettre à l&apos;utilisateur de voir plus d&apos;un à la fois en les configurant sous l&apos;onglet Layouts.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871276"/>Ajout d&apos;une collection de livres<text:bookmark-end text:name="_Toc233871276"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez </text:span><text:span text:style-name="T52">Ajouter une collection de livres… </text:span><text:span text:style-name="T39">pour lancer l&apos;assistant Ajouter une collection de livres. Le processus d&apos;ajout d&apos;une collection de livres dépend du type de livres que vous souhaitez ajouter :</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P3" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647600" text:anchor-type="as-char" svg:width="4.4173in" svg:height="3.2165in" draw:z-index="0"><draw:image xlink:href="SAB02/70.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P8" loext:marker-style-name="T39"/>
   <text:list xml:id="list2636362779" text:style-name="WWNum114">
    <text:list-item>
     <text:p text:style-name="P160" loext:marker-style-name="T52"><text:span text:style-name="T52">Livres de Paratext, la Bibliothèque Biblique Numérique, les documents Word, Bloom ou les fichiers texte</text:span><text:span text:style-name="T52"/></text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list3594596705" text:style-name="WWNum115">
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez cette option sur l&apos;écran </text:span><text:span text:style-name="T52">Type de livre</text:span><text:span text:style-name="T39"> puis choisissez les fichiers spécifiques du livre en cliquant </text:span><text:span text:style-name="T52">Ajouter des livres…</text:span><text:span text:style-name="T39"> sur l&apos;écran </text:span><text:span text:style-name="T52">livre</text:span><text:span text:style-name="T39"> suivant.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">If the book names are capitalized, the next page of the wizard is titled </text:span><text:span text:style-name="T52">Book Names</text:span><text:span text:style-name="T39"> and will allow you to change them to uppercase and lowercase if desired.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P162" loext:marker-style-name="T39"><text:span text:style-name="T39">Choose the appropriate </text:span><text:span text:style-name="T52">Book Order</text:span><text:span text:style-name="T39">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Spécifiez la </text:span><text:span text:style-name="T52">langue</text:span><text:span text:style-name="T39"> pour cette collection. Cliquer sur </text:span><text:span text:style-name="T52">Sélectionner...</text:span><text:span text:style-name="T39"> pour choisir le code de langue dans une liste de langues. Si nécessaire, cochez la case pour spécifier des informations d&apos;identification supplémentaires, telles que le script, la région et la variante.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Sur la page </text:span><text:span text:style-name="T53">Nom de la collection de livres</text:span><text:span text:style-name="T39"> , entrez un nom et un nom abrégés pour la nouvelle collection de livres. Vous pouvez également ajouter une description optionnelle.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table87" table:style-name="Table87">
    <table:table-column table:style-name="Table87.A"/>
    <table:table-column table:style-name="Table87.B"/>
    <table:table-row table:style-name="Table87.1">
     <table:table-cell table:style-name="Table87.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table87.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Le nom court est celui qui apparaîtra en haut à droite de la page de visionneuse dans l&apos;application et sera tapé pour afficher la boîte de dialogue de configuration de la mise en page.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P276" loext:marker-style-name="T90"/>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If there is only one collection in an app, the default book collection name is </text:span><text:span text:style-name="T95">Main Collection</text:span><text:span text:style-name="T90">. Vous pouvez changer cela en cliquant sur </text:span><text:span text:style-name="T95">Collection Principale</text:span><text:span text:style-name="T90"> dans la vue arborescence du projet puis en changeant le </text:span><text:span text:style-name="T95">Nom de la collection de livres</text:span><text:span text:style-name="T90"> sous l’onglet </text:span><text:span text:style-name="T95">Collection de livres</text:span><text:span text:style-name="T90">. Si vous ajoutez une ou plusieurs autres collections, SAB vous demandera de changer le nom « Collection principale » si vous ne l&apos;avez pas déjà fait.</text:span></text:p>
      <text:p text:style-name="P276" loext:marker-style-name="T90"/>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">To add a description for the collection, add that on the collection’s </text:span><text:span text:style-name="T95">Details</text:span><text:span text:style-name="T90"> tab.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum116">
    <text:list-item>
     <text:p text:style-name="P163" loext:marker-style-name="T39"><text:span text:style-name="T39">Enter the specific </text:span><text:span text:style-name="T52">Copyright and Licensing</text:span><text:span text:style-name="T39"> information for this collection.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P163" loext:marker-style-name="T39"><text:span text:style-name="T39">Spécifiez le texte dans le </text:span><text:span text:style-name="T52">Page Pied de page</text:span><text:span text:style-name="T39"> si nécessaire. Certaines collections peuvent avoir une obligation de fournir une information spécifique sur les droits d&apos;auteur au bas de chaque page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P163" loext:marker-style-name="T39"><text:span text:style-name="T39">Spécifiez n&apos;importe quelle </text:span><text:span text:style-name="T52">Restrictions</text:span><text:span text:style-name="T39"> pour la visualisation de la collection.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P163" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Terminez</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list xml:id="list164753175268124" text:continue-list="list2636362779" text:style-name="WWNum114">
    <text:list-item>
     <text:p text:style-name="P160" loext:marker-style-name="T52"><text:span text:style-name="T52">Audio-only books</text:span><text:span text:style-name="T52"/></text:p>
    </text:list-item>
   </text:list>
   <text:list text:continue-list="list3594596705" text:style-name="WWNum115">
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Select this option on the </text:span><text:span text:style-name="T52">Book Type</text:span><text:span text:style-name="T39"> screen and then choose which type of audio-only books to add on the </text:span><text:span text:style-name="T52">Add Audio-only Books</text:span><text:span text:style-name="T39"> screen. Note that if you choose </text:span><text:span text:style-name="T52">Selected Bible Books</text:span><text:span text:style-name="T39"> you will next be asked which books to add.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T143"><text:span text:style-name="T143">Select an </text:span><text:span text:style-name="T144">image pour livres audio</text:span><text:span text:style-name="T143">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Choisissez la </text:span><text:span text:style-name="T52">langue</text:span><text:span text:style-name="T39"> pour cette collection. Cliquer sur </text:span><text:span text:style-name="T52">Sélectionner...</text:span><text:span text:style-name="T39"> pour choisir le code de langue dans une liste de langues. Si nécessaire, cochez la case pour spécifier des informations d&apos;identification supplémentaires, telles que le script, la région et la variante.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">On the </text:span><text:span text:style-name="T53">Book Collection Name</text:span><text:span text:style-name="T39"> page, enter a name and short name for the new book collection. Vous pouvez également ajouter une description optionnelle.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Enter the specific </text:span><text:span text:style-name="T52">Copyright and Licensing</text:span><text:span text:style-name="T39"> information for this collection.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Spécifiez le texte dans le </text:span><text:span text:style-name="T52">Page Pied de page</text:span><text:span text:style-name="T39"> si nécessaire. Certaines collections peuvent avoir une obligation de fournir une information spécifique sur les droits d&apos;auteur au bas de chaque page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Spécifiez n&apos;importe quelle </text:span><text:span text:style-name="T52">Restrictions</text:span><text:span text:style-name="T39"> pour la visualisation de la collection.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P161" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Terminez</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list xml:id="list164753175706169" text:continue-list="list164753175268124" text:style-name="WWNum114">
    <text:list-item>
     <text:p text:style-name="P160" loext:marker-style-name="T52"><text:span text:style-name="T52">Commonly used Bibles</text:span><text:span text:style-name="T52"/></text:p>
    </text:list-item>
   </text:list>
   <text:list text:style-name="WWNum117">
    <text:list-item>
     <text:p text:style-name="P164" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez cette option sur l&apos;écran </text:span><text:span text:style-name="T52">Type de livre</text:span><text:span text:style-name="T39"> puis choisissez quelle </text:span><text:span text:style-name="T52">Versions bibliques supplémentaires</text:span><text:span text:style-name="T39"> vous souhaitez ajouter. Notez la case à cocher en bas de l&apos;écran pour limiter les livres supplémentaires à ceux qui sont également dans la Collection Principale (la première collection de la liste).</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P164" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur Terminer.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P165" loext:marker-style-name="T39"><text:span text:style-name="T39"/></text:p>
   <text:list text:continue-list="list164753175706169" text:style-name="WWNum114">
    <text:list-item>
     <text:p text:style-name="P160" loext:marker-style-name="T52"><text:span text:style-name="T52">Livres de la plate-forme YouVersion </text:span><text:span text:style-name="T52"/></text:p>
    </text:list-item>
   </text:list>
   <text:list text:style-name="WWNum118">
    <text:list-item>
     <text:p text:style-name="P166" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez cette option sur l’écran </text:span><text:span text:style-name="T52">Book Type</text:span><text:span text:style-name="T39"> puis choisissez le nom de langue ou le code à rechercher sur l’écran </text:span><text:span text:style-name="T52">Langue YouVersion</text:span><text:span text:style-name="T39"> .</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P166" loext:marker-style-name="T39"><text:span text:style-name="T39">Choose the specific Bible to download on the </text:span><text:span text:style-name="T52">YouVersion Bible</text:span><text:span text:style-name="T39"> screen.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P166" loext:marker-style-name="T39"><text:span text:style-name="T39">Suivez les étapes sur la page </text:span><text:span text:style-name="T52">YouVersion App Key</text:span><text:span text:style-name="T39"> pour obtenir la permission pour la version de la Bible.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P166" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur Terminer.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P90" loext:marker-style-name="T39"/>
   <text:p text:style-name="P469" loext:marker-style-name="T39"><text:span text:style-name="T39">Configurer </text:span><text:span text:style-name="T52">Styles</text:span><text:span text:style-name="T39"> pour cette nouvelle collection de livres sur la page Styles de collection de livres.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Rendez-vous sur la page </text:span><text:span text:style-name="T52">À propos de</text:span><text:span text:style-name="T39"> et vérifiez que les informations de copyright et de licence de cette collection de livres s&apos;affichent correctement.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Une fois que vous aurez ajouté une nouvelle collection de livres, elle apparaîtra dans le tableau des collections de livres.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <table:table table:name="Table88" table:style-name="Table88">
    <table:table-column table:style-name="Table88.A"/>
    <table:table-column table:style-name="Table88.B"/>
    <table:table-row table:style-name="Table88.1">
     <table:table-cell table:style-name="Table88.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table88.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">Click and drag on a book collection in the table to change the order that it appears in the layout selector</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_Importing_a_Book"/><text:bookmark-start text:name="_Toc233871277"/>Importation d&apos;une collection de livres<text:bookmark-end text:name="_Toc233871277"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Les collections de livres peuvent être exportées d&apos;un projet et importées dans un autre. Ceci fournit un moyen facile de transférer une collection et tous ses paramètres. Par exemple, si vous décidez d&apos;inclure une certaine traduction comme le français Louis Segond dans plusieurs de vos applications, vous pouvez le configurer dans un projet, y compris ses informations sur les droits d&apos;auteur, les styles et les restrictions, puis l&apos;exporter pour l&apos;utiliser dans une autre application. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">To Import a book collection, click the </text:span><text:span text:style-name="T52">Import…</text:span><text:span text:style-name="T39"> bouton. Sélectionnez un fichier </text:span><text:span text:style-name="T52">.appBooks</text:span><text:span text:style-name="T39"> et cliquez sur </text:span><text:span text:style-name="T52">Ouvrir</text:span><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">To export a book collection, see </text:span><text:a xlink:type="simple" xlink:href="#_Export" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Export</text:span></text:span></text:a><text:span text:style-name="T39"> under the book collection context menu.</text:span></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:h text:style-name="P66" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871278"/><text:span text:style-name="T39">The </text:span><text:span text:style-name="T90">Layouts</text:span><text:span text:style-name="T39"> tab</text:span><text:bookmark-end text:name="_Toc233871278"/></text:h>
   <text:p text:style-name="P298" loext:marker-style-name="T39"><text:span text:style-name="T39">Plusieurs traductions peuvent être affichées dans l&apos;application dans l&apos;une des trois mises en page :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum28">
    <text:list-item>
     <text:p text:style-name="P470" loext:marker-style-name="T39"><text:span text:style-name="T52">Single Pane</text:span><text:span text:style-name="T39">: afficher une traduction à la fois de la même manière que dans une application avec une seule traduction.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P470" loext:marker-style-name="T39"><text:span text:style-name="T52">Two Pane</text:span><text:span text:style-name="T39">: view two translations at a time. En mode portrait, les traductions seront affichées l&apos;une sur l&apos;autre. En mode paysage, les traductions seront affichées côte à côte. L&apos;utilisateur peut faire glisser la ligne de séparateur vers le haut/bas ou vers la gauche/droite pour modifier la quantité d&apos;espace de l&apos;écran alloué à chaque traduction.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P470" loext:marker-style-name="T39"><text:span text:style-name="T52">Verset par verset</text:span><text:span text:style-name="T39">: afficher deux ou trois traductions à la fois, chacune étant affichée verset par verset, i. . verset 1 dans la traduction A, suivi par le verset 1 dans la traduction B, verset 2 dans la traduction A, verset 2 dans la traduction B, etc. Les différentes traductions seront affichées en différentes polices de couleurs. Pour des informations sur l&apos;ajustement des styles pour le texte de verset par verset, voir </text:span><text:a xlink:type="simple" xlink:href="#_Verse_by_Verse" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Annexe 3</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P241" loext:marker-style-name="T39"/>
   <text:p text:style-name="P191" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 235" text:anchor-type="as-char" svg:width="2.4453in" svg:height="4.3465in" draw:z-index="0"><draw:image xlink:href="SAB02/71.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 234" text:anchor-type="as-char" svg:width="2.4453in" svg:height="4.3465in" draw:z-index="0"><draw:image xlink:href="SAB02/72.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T90"><text:span text:style-name="T90">Mise en page Simple Panneau 2 Disposition Panneau (portrait)</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P374" loext:marker-style-name="T90"/>
   <text:p text:style-name="P191" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 233" text:anchor-type="as-char" svg:width="4.8929in" svg:height="2.7673in" draw:z-index="0"><draw:image xlink:href="SAB02/73.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P4" loext:marker-style-name="T39"><text:span text:style-name="T90">Deux Panneaux (paysage)</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P245" loext:marker-style-name="T39"/>
   <text:p text:style-name="P191" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 232" text:anchor-type="as-char" svg:width="2.4453in" svg:height="4.3465in" draw:z-index="0"><draw:image xlink:href="SAB02/74.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 231" text:anchor-type="as-char" svg:width="2.2909in" svg:height="4.3465in" draw:z-index="0"><draw:image xlink:href="SAB02/75.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T90"><text:span text:style-name="T90">Configuration de mise en page verset par verset</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P471" loext:marker-style-name="T39"><text:span text:style-name="T39">Within the app, you can choose to give the user the permission to configure these layouts on the </text:span><text:span text:style-name="T52">Select Language and</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Layout </text:span><text:span text:style-name="T39">screen. </text:span><text:bookmark text:name="_How_to_configure"/><text:bookmark text:name="_How_to_add"/><text:span text:style-name="T39">Pour configurer ce que l&apos;utilisateur va voir dans cet écran, choisissez quelles mises en page sont disponibles (panneau unique, deux panneaux, et verset par verset) et les collections de livres par défaut pour chaque type de mise en page. Pour plus d&apos;informations sur l&apos;ajustement des styles pour cet écran, voir </text:span><text:a xlink:type="simple" xlink:href="#_Layout_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Annexe 3</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P471" loext:marker-style-name="T39"><text:soft-page-break/><draw:frame draw:style-name="fr4" draw:name="Picture 230" text:anchor-type="as-char" svg:width="5.1665in" svg:height="3.5311in" draw:z-index="0"><draw:image xlink:href="SAB02/76.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <table:table table:name="Table89" table:style-name="Table89">
    <table:table-column table:style-name="Table89.A"/>
    <table:table-column table:style-name="Table89.B"/>
    <table:table-row table:style-name="Table89.1">
     <table:table-cell table:style-name="Table89.A1" office:value-type="string">
      <text:p text:style-name="P272" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table89.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Dans la vue Deux panneaux, si vous sélectionnez « Panneaux de liens », SAB tentera de montrer le même livre traduit dans le volet supérieur et inférieur. Pour ce faire, les deux collections de livres doivent avoir les mêmes livres avec les mêmes identifiants de livre. Les identifiants du livre sont généralement les identifiants standard, Paratext. </text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_The_Layout_Configuration"/><text:bookmark-start text:name="_Toc233871279"/>L&apos;onglet <text:span text:style-name="T89">Configuration</text:span> de la mise en page<text:bookmark-end text:name="_Toc233871279"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Use this tab’s settings to configure how the user gains access to the </text:span><text:span text:style-name="T52">Select Language and</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Layout </text:span><text:span text:style-name="T39">(layout configuration)</text:span><text:span text:style-name="T52"> </text:span><text:span text:style-name="T39">screen. Il y a 3 endroits auxquels un utilisateur peut accéder : </text:span></text:p>
   <text:list text:style-name="WWNum103">
    <text:list-item>
     <text:p text:style-name="P167" loext:marker-style-name="T39"><text:span text:style-name="T39">from a menu item in the navigation drawer</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P167" loext:marker-style-name="T39"><text:span text:style-name="T39">depuis une icône sur la barre d&apos;outils</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P167" loext:marker-style-name="T39"><text:span text:style-name="T39">pour appuyer sur </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">abréviation de la collection de livres</text:span></text:span></text:a><text:span text:style-name="T39"> en haut à droite du panneau. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Cochez ou décochez ces fonctionnalités en fonction des besoins de votre utilisateur.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Si plusieurs collections de livres (traductions) sont une fonctionnalité clé de votre application, vous pouvez cocher la case pour afficher l&apos;écran de configuration de la mise en page lorsque l&apos;application est lancée pour la première fois.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T138"><text:bookmark-start text:name="_Toc233871280"/><text:span text:style-name="T138">Le menu de contexte de la collection de livres</text:span><text:bookmark-end text:name="_Toc233871280"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">En cliquant sur </text:span><text:span text:style-name="T59">Livres</text:span><text:span text:style-name="T138"> élément de menu dans l&apos;arborescence du projet affiche le tableau des collections de livres (qui ne peut inclure que la </text:span><text:span text:style-name="T59">Collection Principale</text:span><text:span text:style-name="T138">).</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Faire un clic droit sur une collection dans le tableau fait apparaître le menu contextuel de la collection de livres.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P259" loext:marker-style-name="T46"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark-start text:name="_Toc233871281"/><text:span text:style-name="T138">Voir</text:span><text:bookmark-end text:name="_Toc233871281"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Select </text:span><text:span text:style-name="T59">View</text:span><text:span text:style-name="T138"> to open the book collection and display its </text:span><text:a xlink:type="simple" xlink:href="#_Configuring_a_book" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T138">configuration window</text:span></text:span></text:a><text:span text:style-name="T138"> with accompanying tabs.</text:span></text:p>
   <text:p text:style-name="P259" loext:marker-style-name="T46"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark-start text:name="_Toc233871282"/><text:span text:style-name="T138">Supprimer</text:span><text:bookmark-end text:name="_Toc233871282"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:soft-page-break/><text:span text:style-name="T138">Sélectionnez </text:span><text:span text:style-name="T59">Supprimez</text:span><text:span text:style-name="T138"> pour supprimer cette collection de livres de votre application. Note : cette option n&apos;est pas disponible si vous n&apos;avez qu&apos;une seule collection.</text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark text:name="_Export"/><text:bookmark-start text:name="_Toc233871283"/><text:span text:style-name="T138">Exporter</text:span><text:bookmark-end text:name="_Toc233871283"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Choisissez </text:span><text:span text:style-name="T59">Exporter</text:span><text:span text:style-name="T138"> pour enregistrer la collection de livres en </text:span><text:span text:style-name="T59">. ppBooks</text:span><text:span text:style-name="T138"> fichier qui peut être importé dans un autre projet en utilisant la fonction </text:span><text:a xlink:type="simple" xlink:href="#_Importing_a_Book" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T138">Importation</text:span></text:span></text:a><text:span text:style-name="T138"> .</text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:h text:style-name="P75" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark text:name="_Fine_Tuning_File"/><text:bookmark-start text:name="_Toc233871284"/><text:span text:style-name="T138">Optimisation du gestionnaire de fichiers…</text:span><text:bookmark-end text:name="_Toc233871284"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Default"><text:span text:style-name="T138">Vous pouvez afficher les informations de votre fichier de chronométrage à envoyer à d&apos;autres personnes qui peuvent aider à affiner les timings. Suivez l&apos;assistant puis publiez les fichiers zip résultants quelque part où ils peuvent être partagés. Voir la section 5.4 dans le document </text:span><text:span text:style-name="T94">Utilisation d&apos;aeneas pour la synchronisation Audio-Texte</text:span> dans le menu Aide <text:span text:style-name="T51">SAB</text:span>.</text:p>
   <text:p text:style-name="Default"><text:s/></text:p>
   <text:p text:style-name="Default" loext:marker-style-name="T138">Si vous avez besoin d&apos;aide pour affiner les délais, le groupe de bénévoles du SAB peut vous aider. Contactez Andrew Shafe (<text:a xlink:type="simple" xlink:href="mailto:Andrew_shafe@sil.org" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Andrew_shafe@sil.org</text:span></text:span></text:a>) pour plus de détails.</text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark-start text:name="_Toc233871285"/><text:span text:style-name="T138">Créer des vidéos de diaporama…</text:span><text:bookmark-end text:name="_Toc233871285"/><text:span text:style-name="T138"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">For more information on slideshow videos, see </text:span><text:a xlink:type="simple" xlink:href="#_How_do_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">How can I create slideshow videos using audio and timing files?</text:span></text:a> et <text:span text:style-name="T138">le document </text:span><text:span text:style-name="T100">Création des vidéos Diaporama</text:span><text:span text:style-name="T138"> sous le menu SAB </text:span><text:span text:style-name="T59">Aide</text:span><text:span text:style-name="T138"> Notez que vous aurez besoin de fichiers audio avec des informations de chronométrage pour créer les vidéos. </text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:h text:style-name="P66" text:outline-level="2" loext:marker-style-name="T18"><text:bookmark text:name="_Configuring_a_book"/><text:bookmark-start text:name="_Toc233871286"/><text:span text:style-name="T18">Configuration d&apos;une collection de livres</text:span><text:bookmark-end text:name="_Toc233871286"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">To configure a book collection, click on </text:span><text:span text:style-name="T26">Books</text:span><text:span text:style-name="T18"> and then double-click on the collection name in the table, or click on the collection name (</text:span><text:span text:style-name="T26">Main Collection</text:span><text:span text:style-name="T18"> by default) in the project tree view under </text:span><text:span text:style-name="T26">Books</text:span><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Book_Collection"/><text:bookmark-start text:name="_Toc233871287"/><text:span text:style-name="T9">Collection de livres</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871287"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet Collections de livres vous permet de visualiser et de modifier l&apos;ID et le nom de la collection et d&apos;ajouter ou de supprimer des livres de la collection.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">Id de la collection de livres</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Collections are by default named C01, C02… etc. SAB uses the collection ID to name the </text:span><text:a xlink:type="simple" xlink:href="#_Project-specific_data_folders" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">project data folder</text:span></text:span></text:a><text:span text:style-name="T18"> that holds SAB’s copy of the collection’s book files on your computer. Utilisez </text:span><text:span text:style-name="T26">Changer l&apos;id…</text:span><text:span text:style-name="T18"> pour entrer un nouvel ID de collection.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table90" table:style-name="Table90">
    <table:table-column table:style-name="Table90.A"/>
    <table:table-column table:style-name="Table90.B"/>
    <table:table-row table:style-name="Table90.1">
     <table:table-cell table:style-name="Table90.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table90.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">Si vous avez plus d&apos;une collection, vous pourriez envisager de donner à chaque collection un identifiant plus descriptif afin de pouvoir facilement indiquer quel dossier de données est pour quelle collection. Par ex. si vous avez une collection pour la langue Dioula (code de langue DYU) et une autre collection pour le français Louis Segond, donner à la première collection un ID de DYU et la seconde LSG.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T59">Nom de la collection de livres</text:span><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Donnez à la collection un nom clair pour que l&apos;utilisateur puisse facilement distinguer entre les collections si vous en avez plusieurs. Vous pouvez utiliser le nom de la langue ou le nom d&apos;une traduction particulière, surtout si vous avez plus d&apos;une collection dans une langue donnée. Les Français Louis Segond et le Français Semeur.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T59">Ajouter des livres…</text:span><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Utiliser </text:span><text:span text:style-name="T59">Ajouter des livres…</text:span><text:span text:style-name="T138"> pour ajouter un ou plusieurs livres à une collection. Ajouter des livres de cette façon ne demande pas de détails spécifiques pour le livre. Vous pouvez les ajouter plus tard en double-cliquant sur un livre dans la table des livres de collection. Si vous voulez un ou plusieurs livres seulement audio, utilisez </text:span><text:span text:style-name="T59">Ajouter à l&apos;aide de l&apos;assistant…</text:span><text:span text:style-name="T138"> bouton.</text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T59"><text:span text:style-name="T59">Ajouter en utilisant l&apos;assistant…</text:span><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Ceci est très similaire au bouton Ajouter des livres… sauf qu&apos;il demande d&apos;abord si vous voulez ajouter un livre texte ou un livre audio.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Une fois qu&apos;un livre ou un livre a été ajouté, ils apparaîtront dans le tableau du livre. Pour modifier les paramètres d&apos;un livre, double-cliquez dessus dans le tableau. Faites un clic droit sur le livre dans la table pour accéder à son menu contextuel. Voir le menu contextuel du livre.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Vous pouvez modifier l&apos;ordre des livres dans une collection en cliquant et en les faisant glisser dans le tableau du livre.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <table:table table:name="Table91" table:style-name="Table91">
    <table:table-column table:style-name="Table91.A"/>
    <table:table-column table:style-name="Table91.B"/>
    <table:table-row table:style-name="Table91.1">
     <table:table-cell table:style-name="Table91.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table91.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">De nombreuses options au niveau global de l&apos;application ont également un réglage correspondant au niveau de la collection de livres. Le paramètre de la collection de livres remplacera le paramètre global de cette collection seulement. De même, la plupart des paramètres de la collection de livres ont également des paramètres correspondants au niveau du livre. Ceux-ci n&apos;affecteront que le livre spécifique.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"><text:soft-page-break/></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871288"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Détails</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871288"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez l’onglet </text:span><text:span text:style-name="T26">Détails</text:span><text:span text:style-name="T18"> pour configurer comment la collection apparaît dans l’écran </text:span><text:span text:style-name="T26">Sélectionnez la langue et la mise en page</text:span><text:span text:style-name="T18">. </text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Description</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Entrez une description optionnelle. Cela apparaîtra sous les sélecteurs dans l&apos;écran </text:span><text:span text:style-name="T26">Sélectionnez la langue et la mise en page</text:span><text:span text:style-name="T18">. Par exemple, si la collection contient la version anglaise de la Bible, la description pourrait être « La nouvelle version internationale de la Bible en anglais ».</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Nom court</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Entrez un </text:span><text:span text:style-name="T26">nom abrégé</text:span><text:span text:style-name="T18"> pour la collection si désiré. Notez que cela devrait en effet être court – peut-être 10 caractères max. Le nom court est affiché en haut à droite de l&apos;écran de l&apos;application si l&apos;option correspondante est sélectionnée sous l&apos;onglet </text:span><text:a xlink:type="simple" xlink:href="#_The_Layout_Configuration" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Configuration</text:span></text:span></text:a><text:span text:style-name="T18"> de la collection de livres. Les utilisateurs peuvent appuyer sur le nom court pour afficher l&apos;écran </text:span><text:span text:style-name="T26">de l&apos;application Sélectionner la langue et la mise en page</text:span><text:span text:style-name="T18"> .</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Image</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier une image pour la collection si désiré. Cela apparaîtra à côté du nom de la collection de livres et de la description dans l’écran </text:span><text:span text:style-name="T26">Sélectionnez la langue et la mise en page</text:span><text:span text:style-name="T18"> de l’application. Choisissez une image qui sera significative même dans une très petite taille.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Language_tab"/><text:bookmark-start text:name="_Toc233871289"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Langue</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871289"/><text:span text:style-name="T18"> </text:span></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez définir un code de langue et un nom optionnels pour la collection de livres ici (avec des informations sur le script, la région ou la variante, si nécessaire). Ceci est nécessaire si vous allez construire un </text:span><text:a xlink:type="simple" xlink:href="#_Building_a_Modern" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Moderne PWA</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:h text:style-name="P79" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Copyright_&amp;"/><text:bookmark-start text:name="_Toc233871290"/><text:span text:style-name="T9">Copyright &amp; Licence</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871290"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T18">L&apos;onglet </text:span><text:span text:style-name="T26">Copyright &amp; Licensing</text:span><text:span text:style-name="T18"> fournit un moyen pratique de localiser les informations sur les droits d&apos;auteur pour une collection de livres spécifique. Il est extrêmement important d&apos;avoir les droits pour distribuer du texte, de l&apos;audio, des images et des vidéos dans votre application. </text:span><text:span text:style-name="T39">Si vous ne savez pas quoi mettre ici, veuillez demander conseil au service d&apos;édition de votre organisation. Ils voudront vous assurer que vous avez bien compris et ne pas vous contenter de deviner ce qu&apos;il faut inclure.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Utiliser </text:span><text:span text:style-name="T52">Aide de Copyright…</text:span><text:span text:style-name="T39"> pour vous aider à formuler vos informations sur le droit d&apos;auteur. Rappelez-vous que chaque ressource (texte, audio, etc.) aura besoin d&apos;une déclaration de copyright distincte.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Les informations provenant de ces onglets sont automatiquement propagées vers la boîte À propos à l&apos;aide de l&apos;identifiant de la collection du livre et d&apos;un code de mise en forme spécial. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">With an example book collection ID of FRA, there are four possible codes:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum104">
    <text:list-item>
     <text:p text:style-name="P168" loext:marker-style-name="T39"><text:span text:style-name="T52">%copyright-all:FRA% </text:span><text:span text:style-name="T39">-- This will display the combined information from the book collection text, audio and illustrations copyright tabs.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum104">
    <text:list-item>
     <text:p text:style-name="P168" loext:marker-style-name="T39"><text:span text:style-name="T52">%copyright-text:FRA% </text:span><text:span text:style-name="T39">-- This will display just the book collection text copyright information.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum104">
    <text:list-item>
     <text:p text:style-name="P168" loext:marker-style-name="T39"><text:span text:style-name="T52">%copyright-audio:FRA% </text:span><text:span text:style-name="T39">-- This will display just the book collection text copyright information.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum104">
    <text:list-item>
     <text:p text:style-name="P168" loext:marker-style-name="T18"><text:span text:style-name="T52">%copyright-illustrations:FRA% </text:span><text:span text:style-name="T39">-- This will display just the book collection text copyright information.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Placez l&apos;un de ces codes de formatage dans la zone de configuration de la boîte À propos pour que les informations correspondantes apparaissent.</text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Layouts_tab"/><text:bookmark-start text:name="_Toc233871291"/><text:span text:style-name="T18">The </text:span><text:span text:style-name="T9">Layouts</text:span><text:span text:style-name="T18"> tab</text:span><text:bookmark-end text:name="_Toc233871291"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr4" draw:name="Picture 20" text:anchor-type="as-char" svg:width="5.9791in" svg:height="3.7709in" draw:z-index="0"><draw:image xlink:href="SAB02/77.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet Mise en page fournit des détails spécifiques à la collection quant à la façon dont une collection apparaît dans l&apos;écran </text:span><text:span text:style-name="T26">Sélectionner la langue et la mise en page</text:span><text:span text:style-name="T18">. Il remplace les paramètres de l&apos;onglet Disposition sous le menu Livres pour cette collection spécifique.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Restrictions</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Certaines collections de livres peuvent avoir des règles de licence plus strictes qui les empêchent d&apos;être affichées dans un seul panneau, c&apos;est-à-dire par elles-mêmes. Il est très important de suivre les conditions de licence de toute collection que vous ajoutez (y compris obtenir l&apos;autorisation d&apos;utiliser la collection dans votre application), et activez ce paramètre si nécessaire.</text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871292"/><text:soft-page-break/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Partage</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871292"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">À l&apos;aide de l&apos;onglet Partage, vous pouvez désactiver ou sur des paramètres spécifiques qui affectent si et comment un utilisateur peut partager du texte de cette collection. Vérifiez les restrictions de licence de copyright pour votre collection pour savoir quels paramètres autoriser.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Partage de clips audio et vidéo</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Le partage de clips audio ou vidéo via les médias sociaux peut être un élément clé de l&apos;engagement des Écritures. Cependant, SAB devra ajouter une bibliothèque de code supplémentaire à ses données pour le permettre. Cette bibliothèque peut ajouter un peu de taille au fichier d&apos;installation de l&apos;application. Si vous prévoyez de distribuer un fichier APK, la taille totale supplémentaire sera dans la région de 52 Mo. Cependant, La création de lots d&apos;applications Android (AABs) - qui sont nécessaires à la publication sur le Google Play Store - signifiera que la taille supplémentaire qui en résultera pour chaque lot sera réduite (13Mo environ). </text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Styles_tab"/><text:bookmark-start text:name="_Toc233871293"/><text:span text:style-name="T9">Styles</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871293"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">The book collection </text:span><text:span text:style-name="T26">Styles</text:span><text:span text:style-name="T18"> tab is very similar to the </text:span><text:a xlink:type="simple" xlink:href="#_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T79"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18"> Styles</text:span></text:span></text:a><text:span text:style-name="T18"> menu, with a few exceptions. Tout d&apos;abord, définir un style ici remplacera le paramètre de style global pour cette collection spécifique. Vous pouvez donc personnaliser le style de chaque collection si vous le désirez.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Cet onglet permet également plus de personnalisation pour cette collection de livres spécifique :</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Police de texte </text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Spécifier quelle police est utilisée pour cette collection. The font must have been added in the </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Files" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T79"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18"> Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T79"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18"> Font Files</text:span></text:span></text:a><text:span text:style-name="T18"> tab.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Default Text Size</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Spécifiez une taille de texte par défaut pour cette collection. Certaines polices nécessitent une taille de texte par défaut plus grande pour la visibilité ou pour mieux correspondre à la taille de la police dans une autre collection.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table92" table:style-name="Table92">
    <table:table-column table:style-name="Table92.A"/>
    <table:table-column table:style-name="Table92.B"/>
    <table:table-row table:style-name="Table92.1">
     <table:table-cell table:style-name="Table92.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table92.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">Si vous avez plus d&apos;une collection, les voir côte à côte dans la vue à deux volets de votre application pour voir si leurs tailles de police sont similaires.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Hauteur de ligne par défaut</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">Ajuster la hauteur de ligne par défaut ici si nécessaire.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Direction du texte</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Définissez la </text:span><text:span text:style-name="T26">Direction du texte</text:span><text:span text:style-name="T18"> pour cette collection de livres. This will be independent of the overall text direction in the app, set under </text:span><text:a xlink:type="simple" xlink:href="#_The_Layout_Direction" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Interface </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Layout Direction</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Code de langue</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Définissez le code de langue pour cette collection, si désiré. Ceci est nécessaire si vous allez construire un </text:span><text:a xlink:type="simple" xlink:href="#_Building_a_Modern" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Moderne PWA</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Système numérique</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si la langue de la collection de livres a un système numérique unique, sélectionnez-le dans la liste des systèmes disponibles ici.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Numéros de verset</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier ici si cette collection utilise le numéro de verset de fin d&apos;Aya si vous le désirez.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Keyboard</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">If you have added a language-specific keyboard under </text:span><text:a xlink:type="simple" xlink:href="#_The_Keyboards_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Keyboards</text:span></text:span></text:a><text:span text:style-name="T18"> you will need to select it here to make it available for this collection.</text:span></text:p>
   <text:h text:style-name="P79" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Fonts_tab"/><text:bookmark-start text:name="_Toc233871294"/><text:span text:style-name="T9">Fontes</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871294"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Using the </text:span><text:span text:style-name="T26">Fonts</text:span><text:span text:style-name="T18"> tab you can either allow the user to select from any of the fonts you have provided under </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Files" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Font Files</text:span></text:span></text:a><text:span text:style-name="T18"> or you can restrict their choice for this collection. Ces polices sont celles qui seront disponibles sous la popup d’apparence de texte et de verset de l’éditeur d’images.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Footer_tab"/><text:bookmark-start text:name="_Toc233871295"/><text:soft-page-break/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Pied de page</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871295"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Il peut être utile d&apos;afficher un bloc de pied de page en bas de chaque chapitre de texte. </text:span><text:span text:style-name="T18">Chaque collection peut avoir un pied de page unique. </text:span><text:span text:style-name="T39">Ceci peut contenir des informations telles que: </text:span></text:p>
   <text:list text:style-name="WWNum75">
    <text:list-item>
     <text:p text:style-name="P169" loext:marker-style-name="T39"><text:span text:style-name="T39">The name of the Bible translation</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P169" loext:marker-style-name="T39"><text:span text:style-name="T39">Détails du droit d&apos;auteur et de la licence</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P169" loext:marker-style-name="T39"><text:span text:style-name="T39">Contact email addresses and phone numbers </text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P169" loext:marker-style-name="T39"><text:span text:style-name="T39">Liens vers le site Web pour plus de ressources ou pour commander des documents imprimés</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P169" loext:marker-style-name="T39"><text:span text:style-name="T39">Link to discussion groups on social media</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous pouvez également définir un pied de page spécifique au livre. Cliquez sur le livre dans l&apos;arborescence du projet puis sélectionnez l&apos;onglet </text:span><text:span text:style-name="T52">Fonctionnalités</text:span><text:span text:style-name="T39">. Définissez le sélecteur </text:span><text:span text:style-name="T52">de pied de page</text:span><text:span text:style-name="T39"> sur «</text:span><text:span text:style-name="T52">Utiliser le paramètre spécifique au livre</text:span><text:span text:style-name="T39">». Ceci activera un onglet </text:span><text:span text:style-name="T52">Pied de page</text:span><text:span text:style-name="T39"> pour le livre. Sélectionnez cet onglet et définissez le bloc de pied de page comme souhaité.</text:span></text:p>
   <text:p text:style-name="P228" loext:marker-style-name="T39"/>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">On the Footer tab explanatory text, you will find details of the formatting codes you can use, which are similar to those you can use on the About page (</text:span><text:a xlink:type="simple" xlink:href="#_Which_formatting_codes" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">see the About page section</text:span></text:span></text:a><text:span text:style-name="T39">). </text:span><text:span text:style-name="T18">Vous pouvez également définir la police, la taille du texte et la direction du texte.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><draw:frame draw:style-name="fr2" draw:name="Frame23" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="19" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table93" table:style-name="Table93">
       <table:table-column table:style-name="Table93.A" table:number-columns-repeated="2"/>
       <table:table-row table:style-name="Table93.1">
        <table:table-cell table:style-name="Table93.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster le style de texte…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table93.1">
        <table:table-cell table:style-name="Table93.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Pied de page (boite autour du pied de page)</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">div.footer</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table93.1">
        <table:table-cell table:style-name="Table93.A3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Texte de pied de page</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.B3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">span.footer</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table93.1">
        <table:table-cell table:style-name="Table93.A4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Ligne de pied de page</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">div.footer.line</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871296"/><text:span text:style-name="T18"><text:s/></text:span><text:span text:style-name="T9">Références bibliques</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871296"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Chaque collection peut avoir une façon unique de formater les références bibliques. Utilisez les champs fournis pour spécifier le formatage. Vous pouvez tester une référence pour vous assurer qu&apos;elle contient des liens vers le livre, le chapitre et le verset corrects.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez les cases à cocher fournies pour spécifier si vous voulez que les références bibliques dans les introductions et les glossaires deviennent des liens. </text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871297"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Liens</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871297"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Chaque collection peut avoir une façon unique de gérer les notes de bas de page et les références croisées. Utilisez les champs fournis pour spécifier si les liens apparaîtront et, le cas échéant, comment ils sont formatés. </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T29"><text:soft-page-break/><text:span text:style-name="T29">Notes de bas de page</text:span><text:span text:style-name="T29"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Indique si les notes de bas de page sont affichées et quel type d&apos;appel(s) utiliser.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T29"><text:span text:style-name="T29">Références croisées</text:span><text:span text:style-name="T29"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Spécifie si les références croisées sont affichées et quel type d&apos;appel(s) utiliser.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P221" loext:marker-style-name="T29"/>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_Resources"/><text:bookmark text:name="_The_Resources_tab"/><text:bookmark-start text:name="_Toc233871298"/><text:span text:style-name="T18">L&apos;onglet </text:span><text:span text:style-name="T9">Ressources</text:span><text:bookmark-end text:name="_Toc233871298"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">This tab only appears if you have defined some resources under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Bible_Engagement" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Engagement </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Resources </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Bible Engagement Resources</text:span></text:span></text:a><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">tab. Si tel est le cas, ils apparaîtront ici. Pour chaque ressource, vous pouvez choisir si elle est disponible dans cette collection et si elle est affichée par défaut.</text:span></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Study_Bible"/><text:bookmark-start text:name="_Toc233871299"/><text:span text:style-name="T18">La </text:span><text:span text:style-name="T9">Bible d&apos;étude</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871299"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Chaque collection peut avoir une façon unique de gérer le texte explicatif formaté par Paratext, les barres latérales et les notes de bas de page étendues. Utilisez les champs fournis pour spécifier si ceux-ci seront affichés et, dans l&apos;affirmative, comment ils sont formatés. Pour plus d&apos;informations sur la façon de formater et d&apos;inclure ces modèles, voir </text:span><text:a xlink:type="simple" xlink:href="#_Study_Bible_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Styles de la Bible d&apos;étude</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Book_Order"/><text:bookmark-start text:name="_Toc233871300"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Commande de livre</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871300"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Chaque collection peut avoir un livre unique commandé selon la tradition ecclésiastique pertinente. La valeur par défaut est Western Protestant, mais vous pouvez en sélectionner une dans la liste.</text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871301"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Versification</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871301"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Chaque collection de livres peut avoir un système de versification unique. Par exemple, les Bibles françaises incluent les entêtes de psaume en tant que versets. Vous pouvez importer un fichier de mappage de verset .vrs pour vous assurer que les bons versets sont mappés ensemble dans le double volet et le verset par mise en page de versets.</text:span><text:span text:style-name="T18"/></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871302"/><text:span text:style-name="T18"><text:s/></text:span><text:span text:style-name="T9">Fichiers Audio</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871302"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Spécifiez les fichiers audio de cette collection de livres sous l&apos;onglet </text:span><text:span text:style-name="T26">Fichiers Audio</text:span><text:span text:style-name="T18">. Vous pouvez également ajouter les fichiers audio sur une base par livre en utilisant les paramètres du livre individuel, dans quel cas ils apparaîtront automatiquement ici. Pour plus de détails sur l&apos;ajout d&apos;audio, voir </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I_3" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Comment puis-je associer des fichiers audio avec le texte ?</text:span></text:span></text:a></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Audio_Synchronization"/><text:bookmark-start text:name="_Toc233871303"/><text:span text:style-name="T9">Synchronisation Audio</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871303"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet Synchronisation Audio vous permet de configurer les paramètres de création de fichiers de chronométrage afin de mettre en surbrillance le texte tel qu&apos;il est lu et/ou créer des vidéos de diaporama.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">Synchronisation Audio</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier des marqueurs de fin de phrase pour séparer vos fichiers texte en phrases discrètes pour les mettre en surbrillance. Ceux-ci peuvent être définis au niveau de l&apos;application (i.e. pour toutes les collections de livres) sous </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Média &gt; Audio &gt; Synchronisation Audio</text:span></text:span></text:a><text:span text:style-name="T18"> ou remplacée ici pour cette collection spécifique.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Listes de phrases pour la synchronisation audio</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez créer des fichiers texte de liste de phrases en fonction des marqueurs de fin de phrase définis ci-dessus. Ces fichiers peuvent être utilisés pour créer des fichiers de synchronisation avec Audacity (plutôt qu&apos;avec Aeneas).</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Cliquez </text:span><text:span text:style-name="T26">Créer des listes de phrases…</text:span><text:span text:style-name="T18"> entrer dans l&apos;assistant </text:span><text:span text:style-name="T26">Liste</text:span><text:span text:style-name="T18"> qui a les écrans suivants :</text:span></text:p>
   <text:list text:style-name="WWNum105">
    <text:list-item>
     <text:p text:style-name="P170" loext:marker-style-name="T18"><text:span text:style-name="T26">Phrase List File Type</text:span><text:span text:style-name="T18"> – Choisissez parmi Word, des valeurs séparées par des virgules ou délimitées par des tabulations.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P170" loext:marker-style-name="T18"><text:span text:style-name="T26">Niveau de synchronisation</text:span><text:span text:style-name="T18"> – Choisissez une phrase par phrase ou verset par verset.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P170" loext:marker-style-name="T18"><text:span text:style-name="T26">Phrases</text:span><text:span text:style-name="T18"> – confirme les signes de ponctuation que vous souhaitez utiliser pour délimiter les phrases.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P170" loext:marker-style-name="T18"><text:span text:style-name="T26">Headings and Markers</text:span><text:span text:style-name="T18"> – spécifie si les en-têtes de section doivent être inclus (i. si les en-têtes de section sont enregistrés dans l&apos;audio) et si les marqueurs abc doivent être utilisés.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P170" loext:marker-style-name="T18"><text:span text:style-name="T26">Output Folder</text:span><text:span text:style-name="T18"> – specify the output folder.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionnez </text:span><text:span text:style-name="T26">Créer des fichiers</text:span><text:span text:style-name="T18"> pour créer les listes de phrases.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Synchronisation en utilisant aeneas</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionnez ce bouton pour lancer la synchronisation audio </text:span><text:span text:style-name="T26">à l&apos;aide de l&apos;assistant</text:span><text:span text:style-name="T18"> aéneas. Pour plus de détails, veuillez consulter le document </text:span><text:span text:style-name="T97">en utilisant aeneas pour la synchronisation de texte audio</text:span><text:span text:style-name="T92">,</text:span><text:span text:style-name="T97"> </text:span><text:span text:style-name="T41">disponible dans le menu Aide SAB.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Validation du fichier de Timing</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez ceci pour valider vos fichiers de chronométrage pour trouver des étiquettes manquantes.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Changes_tab"/><text:bookmark-start text:name="_Toc233871304"/><text:span text:style-name="T9">Modifie</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871304"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez définir un ensemble d&apos;expression régulière ou trouver / remplacer les entrées qui seront appliquées aux livres de cette collection pendant le processus de construction, n&apos;affectant pas les fichiers d&apos;origine. The entries under this book collection </text:span><text:span text:style-name="T26">Changes</text:span><text:span text:style-name="T18"> tab override the app-level entries set under </text:span><text:a xlink:type="simple" xlink:href="#_Changes" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Changes</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871305"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Caractères</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871305"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB va créer une liste de tous les caractères trouvés dans tous les livres de cette collection et les lister sous l&apos;onglet </text:span><text:span text:style-name="T26">Caractères</text:span><text:span text:style-name="T18">. Cliquez sur </text:span><text:span text:style-name="T26">Validez la police</text:span><text:span text:style-name="T18"> pour vous assurer que la police que vous avez sélectionnée sous </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Styles</text:span></text:span></text:a><text:span text:style-name="T18"> onglet peut afficher tous les caractères.</text:span></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871306"/><text:span text:style-name="T18">Tableau de livres de collections de livres Actions</text:span><text:bookmark-end text:name="_Toc233871306"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Le tableau des livres de collection apparaît lorsque le nom de la collection de livres est cliqué sur dans la vue de l&apos;arborescence du projet. C&apos;est la liste des livres de la collection qui apparaît dans la zone de configuration du projet à droite de l&apos;écran.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Selecting one or more books</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Dans la table de livres de la Collection de Livres, sélectionnez un livre en cliquant dessus. Pour sélectionner plus d&apos;un livre, maintenez la touche Ctrl enfoncée et cliquez sur les livres. Pour sélectionner une série de livres, cliquez sur le premier livre, maintenez la touche Majuscule enfoncée et cliquez sur le dernier livre de l&apos;intervalle. Vous pouvez également cliquer n&apos;importe où dans la table de livres et utiliser Cntrl + A pour sélectionner tous les livres. Dans l&apos;exemple ci-dessous, un seul livre (MAT) est sélectionné dans la collection du livre de Wamey .</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr4" draw:name="Picture 23" text:anchor-type="as-char" svg:width="6in" svg:height="3.2in" draw:z-index="0"><draw:image xlink:href="SAB02/78.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Réorganisation de l&apos;ordre des livres</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">Sélectionnez le livre ou les livres que vous souhaitez déplacer, puis cliquez et faites-les glisser vers la position désirée.</text:span><text:span text:style-name="T138"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Le menu contextuel du livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Avec un ou plusieurs livres sélectionnés dans la table, faites un clic droit sur l&apos;un d&apos;eux pour afficher le menu contextuel de la collection. Voir les actions du menu contextuel </text:span><text:a xlink:type="simple" xlink:href="#_Book_Collection_book" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">de la collection</text:span></text:span></text:a><text:span text:style-name="T18"> ci-dessous. Notez que ceci est différent du menu contextuel du livre qui s&apos;affiche lorsque vous cliquez avec le bouton droit sur un livre dans l&apos;arborescence du projet.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P80" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_Book_Collection_book"/><text:bookmark-start text:name="_Toc233871307"/><text:soft-page-break/><text:span text:style-name="T18">Tableau de livre de la collection de livres actions du menu contextuel</text:span><text:bookmark-end text:name="_Toc233871307"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Avec un ou plusieurs livres sélectionnés dans la table des livres de collection, faites un clic droit sur l&apos;un d&apos;eux pour afficher le menu contextuel du livre de la collection. Il y a les éléments suivants :</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Voir le livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Cela ouvre la fenêtre de configuration du livre cible.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Retirer le livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Ceci supprime le livre cible de la collection. Notez que cela ne supprimera pas le dossier de données du projet ou ne supprimera pas le fichier source original, mais ajoutera un </text:span><text:span text:style-name="T26">. Suffixe</text:span><text:span text:style-name="T18"> élémenté à la copie dans le dossier de données, l&apos;empêchant d&apos;être incorporé dans le projet.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T29"><text:span text:style-name="T29">Ajouter au menu Contenu</text:span><text:span text:style-name="T29"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T21"><text:span text:style-name="T41">You can quickly add an existing book to a contents menu by choosing “</text:span><text:span text:style-name="T54">Add to Contents Menu</text:span><text:span text:style-name="T41">”. Si vous avez plus d&apos;un menu de contenu « écran », vous pouvez choisir à quel écran l&apos;ajouter. Allez à </text:span><text:span text:style-name="T54">Navigation &gt; Menu de contenu</text:span><text:span text:style-name="T41"> pour personnaliser davantage l&apos;entrée du menu.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers HTML</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci convertira le livre en fichiers HTML, un par chapitre, ainsi que les fichiers CSS (Cascading Style Sheets), les polices et les fichiers JS (java Script). Tous ces éléments seront placés dans un dossier nommé avec le nom du package du projet et placés dans App Builder &gt; Scripture Apps &gt; HTML Output sur votre ordinateur. Le premier chapitre sera ensuite affiché dans votre navigateur. Vous pouvez passer en page à travers les chapitres pour voir leur mise en forme, et tester tous les fichiers audio et de timing.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers les paramètres HTML</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Selecting this displays the Export to HTML settings dialog box with two tabs:</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:style-name="WWNum111">
    <text:list-item>
     <text:p text:style-name="P171" loext:marker-style-name="T26"><text:span text:style-name="T15">Fichiers Audio</text:span><text:span text:style-name="T26"> onglet</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier d&apos;où la sortie HTML récupère tous les fichiers audio nécessaires.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:list xml:id="list164753272676404" text:continue-numbering="true" text:style-name="WWNum111">
    <text:list-item>
     <text:p text:style-name="P171" loext:marker-style-name="T26"><text:span text:style-name="T15">Progressive Web App</text:span><text:span text:style-name="T26"> tab</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T18"><text:span text:style-name="T18">If you have a </text:span><text:a xlink:type="simple" xlink:href="#_Progressive_Web_App" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Progressive Web App</text:span></text:span></text:a><text:span text:style-name="T18"> set up, you can select to have that included in the HTML output.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers EPUB</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci convertira le livre en un . fichier pub qui sera placé dans le dossier App Builder &gt; Scripture Apps &gt; EPUB Sortie sur votre ordinateur. </text:span><text:span text:style-name="T39">Voir </text:span><text:a xlink:type="simple" xlink:href="#_E-books_(EPUB)" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Publier </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T73">&lt;unk&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">E-books (EPUB)</text:span></text:span></text:a><text:span text:style-name="T39"> pour plus de détails.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Créer des listes de phrases…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">For help with Phrase Lists, see the book collection’s </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Audio Synchronization tab</text:span></text:span></text:a><text:span text:style-name="T18"> for more details.</text:span></text:p>
   <text:p text:style-name="P472" loext:marker-style-name="T26"><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Synchroniser l&apos;audio et le texte…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci ouvrira l&apos;assistant </text:span><text:span text:style-name="T26">Synchroniser l&apos;audio et le texte</text:span><text:span text:style-name="T18">. Pour plus de détails, voir le livre </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization_2" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Synchronisation Audio</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">onglet</text:span></text:span></text:a><text:span text:style-name="T26">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Chronométrage fin…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">En sélectionnant cette option, vous ouvrirez l&apos;interface Fine Tune Timings dans votre navigateur.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">For more details, please see the document </text:span><text:span text:style-name="T12">Using Audacity for Audio Text Synchronization</text:span><text:span text:style-name="T16"> under the SAB </text:span><text:span text:style-name="T23">Help</text:span><text:span text:style-name="T16"> menu.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Optimisation du gestionnaire de fichiers…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Selecting this will open the </text:span><text:span text:style-name="T26">Fine Tuning File Manager</text:span><text:span text:style-name="T18"> wizard for exporting timing files to be fine-tuned. Voir </text:span><text:a xlink:type="simple" xlink:href="#_Fine_Tuning_File" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Gestion de fichiers</text:span></text:span></text:a><text:span text:style-name="T18"> pour plus de détails.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">Créer des vidéos de diaporama</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">For more information on slideshow videos, see </text:span><text:a xlink:type="simple" xlink:href="#_How_do_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">How can I create slideshow videos using audio and timing files?</text:span></text:a> et <text:span text:style-name="T138">le document </text:span><text:span text:style-name="T100">Création des vidéos Diaporama</text:span><text:span text:style-name="T138"> sous le menu SAB </text:span><text:span text:style-name="T59">Aide</text:span><text:span text:style-name="T138"> Notez que vous aurez besoin de fichiers audio avec des informations de chronométrage pour créer les vidéos. </text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Afficher la source originale</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Ceci affichera une boîte de dialogue indiquant l&apos;emplacement du fichier source du livre et sa dernière mise à jour.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Mise à jour depuis la source</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si le fichier source du livre est plus récent que la copie du SAB dans le dossier de données du projet, la copie du SAB sera mise à jour.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Changer le nom en cas mixte</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si le nom du livre est en majuscules, cela le changera en majuscules.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Changer le groupe de livres…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci vous permet d&apos;assigner ou de modifier le groupe de livres de ce livre à l&apos;un des groupes de livres par défaut ou ajoutés. Pour plus de détails sur les groupes de livres, voir </text:span><text:a xlink:type="simple" xlink:href="#_Adding_a_New" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Ajouter un nouveau groupe de livres</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871308"/><text:span text:style-name="T18">Configurer un livre</text:span><text:bookmark-end text:name="_Toc233871308"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">To configure an individual book, click on </text:span><text:span text:style-name="T26">Books</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T79"></text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">&lt;the book collection name&gt;</text:span><text:span text:style-name="T18"> to display the list of books in that collection. Ils apparaîtront sous forme de table dans la zone de configuration à droite, ainsi que sous forme de liste dans la vue de l&apos;arborescence du projet. Double-cliquez sur un livre dans la table ou cliquez sur un livre dans la liste de vue de l&apos;arborescence du projet pour afficher ses onglets de configuration. Vous pouvez également faire un clic droit sur un livre dans la vue de l&apos;arborescence de la collection sur le côté gauche de l&apos;écran pour faire apparaître le menu contextuel </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_tree" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">de l&apos;arborescence</text:span></text:span></text:a><text:span text:style-name="T18">. Ceci est légèrement différent du menu contextuel qui s&apos;affiche lorsque vous cliquez avec le bouton droit sur un livre dans le tableau du livre.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Book_tab"/><text:bookmark-start text:name="_Toc233871309"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Livre</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871309"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet Livre affiche les informations que le SAB a déterminées à partir de l&apos;ID du livre et les informations de marqueur dans le fichier du livre. </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/><text:s/></text:p>
   <table:table table:name="Table94" table:style-name="Table94">
    <table:table-column table:style-name="Table94.A"/>
    <table:table-column table:style-name="Table94.B"/>
    <table:table-row table:style-name="Table94.1">
     <table:table-cell table:style-name="Table94.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table94.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">For Scripture books, it is important to follow the </text:span><text:a xlink:type="simple" xlink:href="https://ubsicap.github.io/usfm/identification/books.html" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">USFM book ID conventions for Scripture texts</text:span></text:span></text:a><text:span text:style-name="T39">. For non-Scripture books, they must have a unique id using only </text:span><text:span text:style-name="T52">alpha-numeric characters or underscores</text:span><text:span text:style-name="T39">. </text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Nom du livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB fera de son mieux pour trouver le nom du livre dans le fichier du livre. Normalement, le nom du livre est spécifié en utilisant le marqueur </text:span><text:span text:style-name="T26">\toc2</text:span><text:span text:style-name="T18">. Si SAB ne peut pas trouver le nom du livre, il utilisera simplement l&apos;ID du livre. Voir </text:span><text:a xlink:type="simple" xlink:href="#_Where_do_the" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">D&apos;où viennent les noms de livres et abréviations par défaut ?</text:span></text:span></text:a><text:span text:style-name="T18"> Vous pouvez modifier le nom du livre en utilisant le champ de saisie de texte. Cliquez sur </text:span><text:span text:style-name="T26">Plus…</text:span><text:span text:style-name="T18"> pour entrer des orthographes supplémentaires.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Abréviation</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB fera de son mieux pour trouver l&apos;abréviation du livre dans le dossier du livre. Normalement, l&apos;abréviation du livre est spécifiée à l&apos;aide du marqueur </text:span><text:span text:style-name="T26">\toc3</text:span><text:span text:style-name="T18"> Si le SAB ne peut pas trouver le nom du livre, il laissera le champ vide. L&apos;abréviation du livre peut être affichée sous la forme d&apos;un bouton sélectionnable en haut à droite de l&apos;écran de visualisation de la page dans l&apos;application. Cliquer dessus affichera l&apos;écran </text:span><text:span text:style-name="T26">Sélectionner la langue et la mise en page</text:span><text:span text:style-name="T18">. Voir l&apos;onglet </text:span><text:span text:style-name="T18">pour plus de détails.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Type de livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Il y a cinq types de livres. SAB essaiera de trouver le type de livre basé sur l&apos;ID spécifique ou par le contenu.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">The book types are the following:</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:style-name="WWNum106">
    <text:list-item>
     <text:p text:style-name="P172" loext:marker-style-name="T18"><text:span text:style-name="T26">Default</text:span><text:span text:style-name="T18"> – c&apos;est le type le plus couramment utilisé pour les textes bibliques et représente une série de pages centrée sur le texte.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P172" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Multiple_Translations" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Livre d&apos;histoires d&apos;images</text:span></text:span></text:a><text:span text:style-name="T18"> – il s&apos;agit d&apos;un type particulier de livre qui inclut au moins une image par page, normalement avec le texte d&apos;accompagnement. Si le livre utilise un marqueur d&apos;image \img, SAB définira automatiquement son type à livre de séries.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P172" loext:marker-style-name="T18"><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">livre de chansons</text:span></text:span></text:a><text:span text:style-name="T18"> – Si votre livre est destiné à être un livre de chansons, avec une chanson par page, vous devez définir manuellement son type de livre sur le livre de chansons. Consultez la section du livre de chansons pour plus de détails. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P172" loext:marker-style-name="T18"><text:span text:style-name="T26">Glossaire </text:span><text:span text:style-name="T18">– Un glossaire est traité légèrement différemment des autres livres. Il a un ID de GLO et peut être lié à via des mots de glossaire marqués dans les autres textes. Voir </text:span><text:a xlink:type="simple" xlink:href="#_How_do_the" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Comment fonctionnent les popups d&apos;entrée de glossaire ?</text:span></text:span></text:a><text:span text:style-name="T18"> pour plus de détails.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P172" loext:marker-style-name="T138"><text:span text:style-name="T59">Plan Notes</text:span><text:span text:style-name="T138">—</text:span> <text:span text:style-name="T138">A book where each page represents a devotional section that can be referenced in a </text:span><text:a xlink:type="simple" xlink:href="#_Bible_Reading_Plans" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T138">Bible reading plan</text:span></text:span></text:a><text:span text:style-name="T138">..</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Groupe et sous-groupe</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T18">Les livres peuvent être assignés à un groupe et à un sous-groupe si désiré. Dans le menu du sélecteur de livre de l’application, les livres seront listés sous leur groupe. Dans la vue grille, les dalles de livres seront colorées en fonction de leur sous-groupe.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB est livré avec trois groupes de livres définis : </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table95" table:style-name="Table95">
    <table:table-column table:style-name="Table95.A" table:number-columns-repeated="2"/>
    <table:table-column table:style-name="Table95.C"/>
    <table:table-row table:style-name="Table95.1">
     <table:table-cell table:style-name="Table95.A1" office:value-type="string">
      <text:p text:style-name="P11" loext:marker-style-name="T26"><text:span text:style-name="T26">Réservez le nom abrégé du groupe</text:span><text:span text:style-name="T26"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table95.A1" office:value-type="string">
      <text:p text:style-name="P11" loext:marker-style-name="T26"><text:span text:style-name="T26">Réservez le nom complet du groupe</text:span><text:span text:style-name="T26"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table95.A1" office:value-type="string">
