   </table:table>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">You can change the names and/or add translations for the book groups under the </text:span><text:span text:style-name="T26">Appearance </text:span><text:span text:style-name="T82"></text:span><text:span text:style-name="T26"> Interface </text:span><text:span text:style-name="T82"></text:span><text:span text:style-name="T26"> Translations</text:span><text:span text:style-name="T18"> tab. Rechercher le nom de la chaîne de traduction.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">For details on how to add your own groups, see </text:span><text:a xlink:type="simple" xlink:href="#_Adding_a_New" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Adding a New Book Group</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB est livré avec huit sous-groupes définis :</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:style-name="WWNum107">
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Évangile</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Agit</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Pentateuch</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Historique</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">PoetryWisdom</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">MajorProphet</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">MinorProphet</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">PaulineEpistle</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Épître Générale</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P173" loext:marker-style-name="T26"><text:span text:style-name="T26">Révélation</text:span><text:span text:style-name="T26"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P222" loext:marker-style-name="T26"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Ils n&apos;ont pas de traductions d&apos;interface car elles n&apos;apparaissent pas dans l&apos;application. Ils sont utilisés pour définir les couleurs dans la vue de la grille du sélecteur de livres, pour que leurs couleurs puissent être attribuées sous </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_Colors" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Apparence &gt; Couleurs &gt; Couleurs du livre</text:span></text:span></text:a><text:span text:style-name="T18">. Pour plus de détails sur comment ajouter vos propres sous-groupes, voir </text:span><text:a xlink:type="simple" xlink:href="#_Adding_a_New_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Ajouter un nouveau sous-groupe</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_Adding_a_New"/><text:bookmark-start text:name="_Toc233871310"/><text:span text:style-name="T18">Ajouter un nouveau groupe de livres</text:span><text:bookmark-end text:name="_Toc233871310"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez ajouter vos propres groupes de livres si vous voulez différencier certains livres non bibliques qui sont dans la même collection de livres. </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T18">Par exemple, vous pouvez avoir une application avec des textes bibliques et des études bibliques, tous dans la même collection. Vous pouvez ajouter un groupe de livres « Études bibliques » comme catégorie dans le sélecteur de livres. Pour ce faire, allez dans l&apos;onglet Livre de n&apos;importe quel livre et tapez le nom du nouveau groupe directement dans le champ Liste de groupes. Gardez le nom assez court – il ne sera qu&apos;un nom interne pour représenter le groupe. Maintenant, allez dans l&apos;onglet </text:span><text:span text:style-name="T26">Apparence </text:span><text:span text:style-name="T26">Interface </text:span><text:span text:style-name="T82">&lt;unk&gt;</text:span><text:span text:style-name="T26"> Traductions </text:span><text:span text:style-name="T18">et recherchez </text:span><text:span text:style-name="T26">Groupe</text:span><text:span text:style-name="T18">. Vous verrez une nouvelle entrée de groupe nommée avec le nom de votre groupe. Par exemple, si le nom de votre groupe est «</text:span><text:span text:style-name="T26">Studies</text:span><text:span text:style-name="T18">», vous verrez une entrée nommée</text:span><text:span text:style-name="T26"> Book_Group_Studies. </text:span><text:span text:style-name="T18">Vous pouvez alors remplir le nom traduit que vous souhaitez voir apparaître par exemple</text:span><text:span text:style-name="T26"> Études de la Bible.</text:span></text:p>
   <text:p text:style-name="P222" loext:marker-style-name="T26"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_Adding_a_New_1"/><text:bookmark-start text:name="_Toc233871311"/><text:span text:style-name="T18">Ajout d&apos;un nouveau sous-groupe de livres</text:span><text:bookmark-end text:name="_Toc233871311"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez ajouter vos propres sous-groupes de livres si vous voulez différencier entre certains types de livres non bibliques qui sont dans la même collection de livres. Celles-ci apparaîtront sous la forme de différents fonds colorés dans la vue de la grille du sélecteur de livres.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T18">Par exemple, vous pouvez avoir une application avec des textes bibliques, des livres de chansons et des études bibliques, tous dans la même collection. Vous pouvez ajouter un groupe de livres « Ressources» en tant que catégorie dans le sélecteur de livre (voir ci-dessus). Ensuite, créez un livre de chansons et un sous-groupe d&apos;étude biblique pour regrouper davantage ces ressources dans la vue de grille du sélecteur de livres. Pour cela, allez dans l&apos;onglet Livre de n&apos;importe quel livre et tapez le nom du nouveau sous-groupe directement dans le champ de la liste des sous-groupes. Gardez le nom assez court — il ne sera qu&apos;un nom interne pour représenter le sous-groupe. Now go to the </text:span><text:a xlink:type="simple" xlink:href="#_Book_Colors" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Colors </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Book Colors</text:span></text:span></text:a><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">tab. Vous verrez une nouvelle entrée de sous-groupe nommée avec le nom de votre sous-groupe. Par exemple, si le nom de votre groupe est «</text:span><text:span text:style-name="T26">Livres de chansons</text:span><text:span text:style-name="T18">», vous verrez une entrée nommée</text:span><text:span text:style-name="T26"> Livres de chansons. </text:span><text:span text:style-name="T18">Vous pouvez ensuite sélectionner les couleurs que vous souhaitez voir apparaître avec</text:span><text:span text:style-name="T26">.</text:span></text:p>
   <text:p text:style-name="P222" loext:marker-style-name="T26"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Song_Index"/><text:bookmark-start text:name="_Toc233871312"/><text:span text:style-name="T9">Indice</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871312"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">This tab only appears if your book type is set to </text:span><text:span text:style-name="T26">Song Book</text:span><text:span text:style-name="T18"> and your book file has the correct song book format. Voir </text:span><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Livres de chansons</text:span></text:span></text:a><text:span text:style-name="T18"> pour plus de détails. L&apos;onglet Index des chansons affiche comment l&apos;index du livre de chansons généré automatiquement dans l&apos;application, permettant à l&apos;utilisateur de sélectionner une chanson par numéro de chanson ou par titre par ordre alphabétique.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:h text:style-name="P75" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Styles_tab_1"/><text:bookmark-start text:name="_Toc233871313"/><text:span text:style-name="T9">Styles</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871313"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">The book </text:span><text:span text:style-name="T26">Styles</text:span><text:span text:style-name="T18"> tab presents two choices:</text:span></text:p>
   <text:list text:style-name="WWNum108">
    <text:list-item>
     <text:p text:style-name="P174" loext:marker-style-name="T18"><text:span text:style-name="T26">Use default styles for this book</text:span><text:span text:style-name="T18"> – This sets the book style based on the book collection’s style set under </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Book Collection </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Styles</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P174" loext:marker-style-name="T18"><text:span text:style-name="T26">Personnaliser les styles pour ce livre</text:span><text:span text:style-name="T18"> – Choisir ceci transforme l&apos;onglet Styles pour ressembler à l&apos;onglet styles de la collection de livres avec tous les mêmes paramètres. Cependant, modifier ces paramètres n&apos;affectera que le livre actuel. Pour plus d&apos;informations sur les différents paramètres, voir l&apos;onglet </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Style de collection de livres</text:span></text:span></text:a><text:span text:style-name="T18"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P75" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871314"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Fontes</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871314"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">The book </text:span><text:span text:style-name="T26">Fonts</text:span><text:span text:style-name="T18"> tab presents two choices:</text:span></text:p>
   <text:list text:style-name="WWNum109">
    <text:list-item>
     <text:p text:style-name="P175" loext:marker-style-name="T18"><text:span text:style-name="T26">Use the same fonts as specified for the book collection</text:span><text:span text:style-name="T18"> – This sets the book’s available fonts as those set on the book collection’s </text:span><text:span text:style-name="T26">Fonts</text:span><text:span text:style-name="T18"> tab. Voir </text:span><text:a xlink:type="simple" xlink:href="#_The_Fonts_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Collection de livres </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Fontes</text:span></text:span></text:a></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P175" loext:marker-style-name="T18"><text:span text:style-name="T26">Utiliser l&apos;une des polices sélectionnées ci-dessous</text:span><text:span text:style-name="T18"> – Choisir ceci transforme l&apos;onglet Polices pour afficher le tableau </text:span><text:a xlink:type="simple" xlink:href="#_The_Fonts_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">des polices</text:span></text:span></text:a><text:span text:style-name="T18"> disponible dans la collection de livres associée. Sélectionnez ou désélectionnez toutes les polices que vous voulez que l&apos;utilisateur puisse utiliser pour ce livre dans la popup d&apos;apparence de texte et de verset dans l&apos;éditeur d&apos;image.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Features_tab"/><text:bookmark-start text:name="_Toc233871315"/><text:span text:style-name="T18">Les </text:span><text:span text:style-name="T9">Fonctionnalités</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871315"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Par défaut, les livres héritent des paramètres de configuration des livres au niveau de l&apos;application et de la collection. L&apos;onglet Fonctionnalités vous permet de remplacer les paramètres spécifiques du livre actuel.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Show in book selector</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Par défaut, tous les livres d&apos;une collection apparaissent dans le sélecteur de livres de l&apos;application. Utilisez ce paramètre pour masquer un livre de la liste des sélecteurs. </text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table96" table:style-name="Table96">
    <table:table-column table:style-name="Table96.A"/>
    <table:table-column table:style-name="Table96.B"/>
    <table:table-row table:style-name="Table96.1">
     <table:table-cell table:style-name="Table96.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table96.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">Si, par exemple, vous avez un mélange de textes bibliques et d&apos;autres ressources de livres (questionnaires, livres de chansons, études bibliques, etc.). dans la même collection de livres, le sélecteur de liste de livres deviendra très long. Dans ce cas, il serait peut-être préférable de cacher les livres de ressources non-bibliques dans la liste, et de fournir un menu de contenu pour y accéder. Cela peut être beaucoup plus facile à utiliser.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">Afficher les numéros de chapitre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Par défaut, les numéros de chapitre (en utilisant le marqueur \c) sont affichés. Vous pouvez décider de les cacher dans certains cas – par exemple, dans un livre d’histoires d’images.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Position des numéros de chapitre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Pour des raisons de style, vous avez la possibilité de remplacer les paramètres d&apos;affichage du numéro de chapitre de ce livre.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Afficher les numéros de verset</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Le marqueur de verset \v permet à SAB de permettre aux utilisateurs de cliquer sur une phrase pour la mettre en surbrillance et accéder aux fonctionnalités de verset sélectionnées. Vous pouvez autoriser les utilisateurs à utiliser ces fonctionnalités, même si ce livre n&apos;a pas de versets. Dans ce cas, vous pouvez ajouter les marqueurs de verset \v au fichier du livre, mais les cacher d&apos;être affichés.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Continuer à jouer de l&apos;audio à la fin du chapitre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">You can override this setting if for some reason you want this book’s audio setting to be different than that </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Toolbar" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">set at the app level</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Orientation du verrouillage de l&apos;écran</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez ce paramètre pour forcer une certaine orientation (portrait ou paysage) pour la visualisation de ce livre.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Pied de page</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Par défaut, ceci est configuré pour afficher n&apos;importe quel pied de page appliqué au niveau de la collection du livre. Vous pouvez choisir de spécifier un pied de page particulier pour ce livre en choisissant le paramètre </text:span><text:span text:style-name="T26">spécifique au livre</text:span><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">This will cause an extra </text:span><text:span text:style-name="T26">Footer</text:span><text:span text:style-name="T18"> tab to appear in this book’s configuration screen.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871316"/><text:soft-page-break/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Pied de page</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871316"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Par défaut, les livres héritent des informations de pied de page définies au niveau de la collection du livre. Pour remplacer ceci, entrez les informations nécessaires dans l&apos;onglet </text:span><text:span text:style-name="T26">de ce livre.</text:span><text:span text:style-name="T18">. Voir l&apos;explication </text:span><text:a xlink:type="simple" xlink:href="#_The_Footer_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">pied de page pour la collection de livres</text:span></text:span></text:a><text:span text:style-name="T18"> pour plus de détails.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871317"/><text:span text:style-name="T18">L&apos;onglet Fichiers Audio</text:span><text:bookmark-end text:name="_Toc233871317"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Spécifiez les fichiers audio de ce livre sous l&apos;onglet </text:span><text:span text:style-name="T26">Fichiers Audio</text:span><text:span text:style-name="T18">. Alternativement, vous pouvez ajouter les fichiers audio par collection à l&apos;aide de l&apos;onglet Fichiers audio de la collection de livres, dans quel cas ils apparaîtront automatiquement ici. Pour plus de détails sur l&apos;ajout d&apos;audio, voir </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I_3" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Comment puis-je associer des fichiers audio avec le texte ?</text:span></text:span></text:a></text:p>
   <text:h text:style-name="P82" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Audio_Synchronization_2"/><text:bookmark-start text:name="_Toc233871318"/><text:span text:style-name="T9">Synchronisation Audio</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871318"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet </text:span><text:span text:style-name="T26">Synchronisation Audio</text:span><text:span text:style-name="T18"> vous permet de configurer les paramètres de création de fichiers de chronométrage afin de mettre en surbrillance le texte tel qu&apos;il est lu et/ou créer des vidéos de diaporama. Cet onglet est identique à celui de la collection de livres, mais vous permet de modifier les caractères de fin de phrase pour ce seul livre. Il fournit également un moyen de créer des listes de phrases, d&apos;exécuter la synchronisation et de valider les fichiers de chronométrage pour ce seul livre.</text:span></text:p>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Tabs_tab"/><text:bookmark-start text:name="_Toc233871319"/><text:span text:style-name="T9">Tabulations</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871319"/></text:h>
   <text:p text:style-name="Standard">Il est possible de créer une application qui affiche des livres avec deux ou plusieurs onglets, avec des contenus différents sur chacun. Vous devrez d&apos;abord configurer quels types d&apos;onglets vous avez disponibles. Voir <text:a xlink:type="simple" xlink:href="#_Tab_Types_(Book" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Navigation </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Types d&apos;onglet</text:span></text:span></text:a> pour plus de détails.</text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P15" loext:marker-style-name="T55"><text:span text:style-name="T55">To add a tab to a book:</text:span><text:span text:style-name="T55"/></text:p>
   <text:list text:style-name="WWNum110">
    <text:list-item>
     <text:p text:style-name="P176">Sélectionnez le livre dans lequel vous souhaitez ajouter l’onglet, et allez à son onglet <text:span text:style-name="T55">Onglets</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Cliquez sur le bouton <text:span text:style-name="T55">Ajouter un onglet</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Sur la page <text:span text:style-name="T55">Tab Type</text:span> de l&apos;assistant, sélectionnez le type d&apos;onglet pour l&apos;onglet que vous souhaitez ajouter. Puis cliquez sur <text:span text:style-name="T55">Next</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Sur la page <text:span text:style-name="T55">Réserver</text:span> de l&apos;assistant, cliquez sur le bouton <text:span text:style-name="T55">Parcourir</text:span> et sélectionnez le fichier de livre à utiliser dans l&apos;onglet. Il peut s&apos;agir d&apos;un fichier texte au format SFM ou d&apos;un document Word.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Si le livre que vous choisissez pour l&apos;onglet a un seul chapitre, qui sera affiché dans l&apos;onglet quel que soit le chapitre choisi dans l&apos;onglet principal (e. ., la même découverte de la Bible study questions pour chaque chapitre).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Si le livre que vous choisissez pour l&apos;onglet a plusieurs chapitres, l&apos;application affichera le chapitre dans l&apos;onglet qui correspond au chapitre sélectionné dans l&apos;onglet principal (e. . - un ensemble différent de questions d’étude biblique pour chaque chapitre).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Click <text:span text:style-name="T55">Finish</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176">Si vous avez des fichiers audio pour l’onglet, allez dans l’onglet <text:span text:style-name="T55">Fichiers audio</text:span> et ajoutez les fichiers audio et de timing.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P176" loext:marker-style-name="T18">Compiler l&apos;application et la tester sur votre appareil.<text:bookmark text:name="_The_Book_context"/><text:span text:style-name="T18"/></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T139"><text:bookmark-start text:name="_Toc233871320"/><text:soft-page-break/><text:span text:style-name="T139">The </text:span><text:span text:style-name="T140">Cover</text:span><text:span text:style-name="T139"> tab</text:span><text:bookmark-end text:name="_Toc233871320"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">En plus de construire une application pour smartphone, vous pouvez créer des livres électroniques au format EPUB. Les documents EPUB sont lisibles par un certain nombre de lecteurs de livres électroniques sur Windows, Mac, iOS et Android. Voir </text:span><text:a xlink:type="simple" xlink:href="#_E-books_(EPUB)" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Publier </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">E-books (EPUB)</text:span></text:span></text:a><text:span text:style-name="T39"> pour plus de détails.</text:span></text:p>
   <text:p text:style-name="P467" loext:marker-style-name="T138"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T138"><text:span text:style-name="T138">If you want to create an EPUB book from a single book, you can specify its cover here on the </text:span><text:span text:style-name="T59">Cover</text:span><text:span text:style-name="T138"> tab. Les spécifications de l&apos;image sont énumérées dans la description de l&apos;onglet dans SAB.</text:span></text:p>
   <text:p text:style-name="P259" loext:marker-style-name="T46"/>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T138"><text:bookmark-start text:name="_Toc233871321"/><text:span text:style-name="T138">Le </text:span><text:span text:style-name="T101">Modifie</text:span><text:span text:style-name="T138"> onglet</text:span><text:bookmark-end text:name="_Toc233871321"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez définir un ensemble d&apos;expressions régulières ou trouver / remplacer des entrées qui seront appliquées à un livre pendant le processus de compilation, n&apos;affectant pas le fichier original. The entries under this book </text:span><text:span text:style-name="T26">Changes</text:span><text:span text:style-name="T18"> tab override the app-level and collection-level entries set under </text:span><text:a xlink:type="simple" xlink:href="#_Changes" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Changes</text:span></text:span></text:a><text:span text:style-name="T18"> and </text:span><text:a xlink:type="simple" xlink:href="#_The_Changes_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Books </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> &lt;book collection name&gt; </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26"> Changes</text:span></text:span></text:a><text:span text:style-name="T18">.</text:span></text:p>
   <text:p text:style-name="P262" loext:marker-style-name="T49"/>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871322"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Caractères</text:span><text:span text:style-name="T18"> onglet</text:span><text:bookmark-end text:name="_Toc233871322"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">SAB va créer une liste de tous les caractères trouvés dans ce livre et les lister sous l&apos;onglet </text:span><text:span text:style-name="T26">Caractères</text:span><text:span text:style-name="T18">. Click </text:span><text:span text:style-name="T26">Validate Font</text:span><text:span text:style-name="T18"> to make sure that the font you selected under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">book</text:span></text:span></text:a><text:span text:style-name="T18"> or </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">book collection’s</text:span></text:span></text:a><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Styles</text:span><text:span text:style-name="T18"> tabs can display all the characters.</text:span></text:p>
   <text:p text:style-name="P262" loext:marker-style-name="T49"/>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871323"/><text:span text:style-name="T18">Le </text:span><text:span text:style-name="T9">Onglet Fichier</text:span><text:span text:style-name="T18"> Onglet</text:span><text:bookmark-end text:name="_Toc233871323"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez l&apos;onglet Fichier de livre pour voir le fichier SFM du livre. Notez que même si le livre a été ajouté en tant que document Word, SAB le convertira en interne en SFM. L&apos;afficher de cette façon peut vous aider à cerner les problèmes de mise en forme.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Chapitre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez le sélecteur de chapitre pour passer par les chapitres.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="P10" loext:marker-style-name="T26"><text:span text:style-name="T26">Projet</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Le champ Projet montre le chemin vers lequel SAB stocke sa copie du fichier, généralement dans le sous-dossier livres du dossier de données du projet. À droite du chemin est la dernière fois que le fichier a été mis à jour. Si à la place, il est dit </text:span><text:span text:style-name="T26">(non trouvé)</text:span><text:span text:style-name="T18">, ce fichier a été supprimé ou déplacé.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Source</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Le champ Source montre le chemin depuis lequel le fichier du livre source a été ajouté. Pour les projets Paratext, il peut s&apos;agir du dossier de données local du projet Paratext. Voir l&apos;utilisation de SAB avec les fichiers Paratext. À droite du chemin est la dernière fois que le fichier a été mis à jour. Si à la place, il est dit </text:span><text:span text:style-name="T26">(non trouvé)</text:span><text:span text:style-name="T18">, ce fichier a été supprimé ou déplacé.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <table:table table:name="Table97" table:style-name="Table97">
    <table:table-column table:style-name="Table97.A"/>
    <table:table-column table:style-name="Table97.B"/>
    <table:table-row table:style-name="Table97.1">
     <table:table-cell table:style-name="Table97.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table97.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">Il n&apos;est généralement pas recommandé de modifier directement les fichiers de livres dans le dossier de données du projet, car la mise à jour de leur fichier source effacera toutes les modifications.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Modifier la source</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si SAB peut trouver votre fichier source, le bouton </text:span><text:span text:style-name="T26">Edit Source</text:span><text:span text:style-name="T18"> sera affiché. Cliquez pour ouvrir le fichier source du livre dans votre éditeur de texte. Notez que cela ne modifiera pas la copie du livre du SAB. Une fois la modification terminée, enregistrez le fichier, puis cliquez sur le bouton </text:span><text:span text:style-name="T26">Mise à jour depuis le bouton</text:span><text:span text:style-name="T18"> .</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Mise à jour depuis la source</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">If you have edited your source file, click </text:span><text:span text:style-name="T26">Update from Source</text:span><text:span text:style-name="T18"> to make sure SAB copies this updated file to its project folder. Un message sera affiché indiquant que le fichier a été mis à jour.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter en tant que fichier texte</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si vous avez importé un document Word comme fichier de livre, SAB le convertira en interne en SFM. Vous pouvez exporter ce fichier converti en fichier .txt qui vous permettra d&apos;avoir un plus grand contrôle sur les marqueurs et le formatage. Vous devrez supprimer le fichier doc original de Word puis ajouter le fichier texte comme votre nouveau fichier de livre.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Afficher après les changements</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">If any Change expressions have been added at the app, collection or book level, the </text:span><text:span text:style-name="T26">Show After Changes</text:span><text:span text:style-name="T18"> checkbox will be displayed. Cliquez pour afficher le fichier du livre après que les modifications ont été appliquées. C&apos;est un bon moyen de s&apos;assurer que vos modifications ont été appliquées correctement avant de construire l&apos;application.</text:span></text:p>
   <text:h text:style-name="P80" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark-start text:name="_Toc233871324"/><text:span text:style-name="T18">Onglet</text:span><text:bookmark-end text:name="_Toc233871324"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">L&apos;onglet </text:span><text:span text:style-name="T26">Visionneuse</text:span><text:span text:style-name="T18"> affiche le fichier du livre en utilisant tous les styles, couleurs, formatage et paramètres actuels. Si un fichier audio est associé au fichier du livre, une barre d&apos;outils audio s&apos;affichera en bas de la visionneuse permettant de tester l&apos;audio. S&apos;il y a des informations de chronométrage associées au fichier et que la mise en surbrillance est activée, le texte et l&apos;audio doivent être synchronisés dans le visualiseur.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Rafraîchir</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Utilisez le bouton Actualiser pour mettre à jour la visionneuse si vous avez modifié le fichier source.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Voir dans le navigateur</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Use the </text:span><text:span text:style-name="T26">View in Browser</text:span><text:span text:style-name="T18"> button to convert your book to HTML and open a browser window to display it.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P81" text:outline-level="3" loext:marker-style-name="T18"><text:bookmark text:name="_The_Book_tree"/><text:bookmark-start text:name="_Toc233871325"/><text:span text:style-name="T18">L&apos;arborescence du menu contextuel</text:span><text:bookmark-end text:name="_Toc233871325"/><text:span text:style-name="T18"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si vous faites un clic droit sur un seul livre dans la liste des livres d&apos;une collection dans la vue de l&apos;arborescence de son projet (sur le côté gauche de l&apos;écran), le menu contextuel du livre s&apos;affiche.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><draw:frame draw:style-name="fr4" draw:name="Picture 27" text:anchor-type="as-char" svg:width="4.9272in" svg:height="3.8437in" draw:z-index="0"><draw:image xlink:href="SAB02/79.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers HTML</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci convertira le livre en fichiers HTML, un par chapitre, ainsi que les fichiers CSS (Cascading Style Sheets), les polices et les fichiers JS (java Script). Tous ces éléments seront placés dans un dossier nommé avec le nom du package du projet et placés dans App Builder &gt; Scripture Apps &gt; HTML Output sur votre ordinateur. Le premier chapitre sera ensuite affiché dans votre navigateur. Vous pouvez passer en page à travers les chapitres pour voir leur mise en forme, et tester tous les fichiers audio et de timing.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers les paramètres HTML</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Selecting this displays the Export to HTML settings dialog box with two tabs:</text:span><text:span text:style-name="T18"/></text:p>
   <text:list text:continue-list="list164753272676404" text:style-name="WWNum111">
    <text:list-item>
     <text:p text:style-name="P171" loext:marker-style-name="T26"><text:span text:style-name="T15">Fichiers Audio</text:span><text:span text:style-name="T26"> onglet</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T18"><text:span text:style-name="T18">Vous pouvez spécifier d&apos;où la sortie HTML récupère tous les fichiers audio nécessaires.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum111">
    <text:list-item>
     <text:p text:style-name="P171" loext:marker-style-name="T26"><text:span text:style-name="T15">Progressive Web App</text:span><text:span text:style-name="T26"> tab</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T18"><text:span text:style-name="T18">If you have a </text:span><text:a xlink:type="simple" xlink:href="#_Progressive_Web_App" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Progressive Web App</text:span></text:span></text:a><text:span text:style-name="T18"> set up, you can select to have that included in the HTML output.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Exporter vers EPUB</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci convertira le livre en un . fichier pub qui sera placé dans le dossier App Builder &gt; Scripture Apps &gt; EPUB Sortie sur votre ordinateur. </text:span><text:span text:style-name="T39">Voir </text:span><text:a xlink:type="simple" xlink:href="#_E-books_(EPUB)" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Publier </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T73">&lt;unk&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">E-books (EPUB)</text:span></text:span></text:a><text:span text:style-name="T39"> pour plus de détails.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Créer des listes de phrases…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">For help with Phrase Lists, see the book collection’s </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18">Audio Synchronization tab</text:span></text:span></text:a><text:span text:style-name="T18"> for more details.</text:span></text:p>
   <text:p text:style-name="P222" loext:marker-style-name="T26"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Synchroniser l&apos;audio et le texte…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Sélectionner ceci ouvrira l&apos;assistant </text:span><text:span text:style-name="T26">Synchroniser l&apos;audio et le texte</text:span><text:span text:style-name="T18">. Pour plus de détails, voir le livre </text:span><text:a xlink:type="simple" xlink:href="#_The_Audio_Synchronization_2" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">Synchronisation Audio</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T18"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T26">onglet</text:span></text:span></text:a><text:span text:style-name="T26">.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Chronométrage fin…</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Selecting this will actually open the </text:span><text:span text:style-name="T26">Fine Tuning File Manager</text:span><text:span text:style-name="T18"> wizard for exporting timing files to be fine-tuned. Voir </text:span><text:span text:style-name="T18">pour plus de détails. Pour affiner les timings de ce livre, à la place, Faites un clic droit sur le livre dans la table du livre dans la zone de configuration du projet et sélectionnez </text:span><text:span text:style-name="T26">Minuteries…</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:span text:style-name="T26">Mise à jour depuis la source</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Si le fichier source du livre est plus récent que la copie du SAB dans le dossier de données du projet, la copie du SAB sera mise à jour.</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">Retirer le livre</text:span><text:span text:style-name="T26"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Ceci supprime le livre cible de la collection. Notez que cela ne supprimera pas le dossier de données du projet ou ne supprimera pas le fichier source original, mais ajoutera un </text:span><text:span text:style-name="T26">. Suffixe</text:span><text:span text:style-name="T18"> élémenté à la copie dans le dossier de données, l&apos;empêchant d&apos;être incorporé dans le projet.</text:span></text:p>
   <text:p text:style-name="P218" loext:marker-style-name="T18"/>
   <text:h text:style-name="P50" text:outline-level="1"><text:bookmark text:name="_Multiple_Translations"/><text:bookmark text:name="_Picture_Story_Books"/><text:bookmark text:name="_Bible_Plans"/><text:bookmark-start text:name="_Toc233871326"/><text:bookmark-start text:name="_Ref459652838"/><text:bookmark-start text:name="_Ref459652820"/><text:bookmark-start text:name="_Ref459652806"/>Livres d&apos;histoires d&apos;images<text:bookmark-end text:name="_Toc233871326"/><text:bookmark-end text:name="_Ref459652838"/><text:bookmark-end text:name="_Ref459652820"/><text:bookmark-end text:name="_Ref459652806"/><text:bookmark text:name="Section_Picture_Story_Books"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Dans la plupart des cas, un livre d’histoire d’images est un livre avec une image en haut de chaque page et quelques phrases de texte en dessous. Dans l&apos;application, l&apos;image restera en haut de l&apos;écran et le texte défilera, même s&apos;il est possible de faire défiler l&apos;image ou les images avec le texte à la place. Les livres d’histoires d’images sont destinés à être des livres assez simples pour des choses comme des histoires bibliques illustrées, des études bibliques, d’autres ressources bibliques, des livres d’alphabétisation ou des livres de santé. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P226" loext:marker-style-name="T39"/>
   <text:p text:style-name="P189" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 188" text:anchor-type="as-char" svg:width="2in" svg:height="3.5374in" draw:z-index="0"><draw:image xlink:href="SAB02/80.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Screenshot_20160823-112001</svg:desc>
    </draw:frame><text:span text:style-name="T39"><text:s/></text:span><draw:frame draw:style-name="fr4" draw:name="Picture 187" text:anchor-type="as-char" svg:width="2in" svg:height="3.5736in" draw:z-index="0"><draw:image xlink:href="SAB02/81.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Screenshot_20160823-112052</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P8" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">La mise en évidence du texte audio fonctionne comme pour le texte biblique, et lorsque l&apos;audio atteint la fin d&apos;une page, l&apos;application se déplacera vers la page suivante de l&apos;histoire. De cette façon, l&apos;histoire sera automatiquement lue dans son intégralité.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Lorsque l&apos;écran de l&apos;appareil est en orientation paysage, l&apos;image s&apos;affiche pour prendre la totalité de l&apos;écran. Si vous spécifiez un fichier de chronométrage à côté du fichier audio, chaque phrase sera affichée en tant que sous-titre sur l&apos;image. L&apos;effet est une vidéo de diaporama narré de l&apos;histoire.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P3" loext:marker-style-name="T39"><draw:frame draw:style-name="fr7" draw:name="Picture 186" text:anchor-type="as-char" svg:width="4.989in" svg:height="2.6535in" draw:z-index="0"><draw:image xlink:href="SAB02/82.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>Story3</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous pouvez choisir d&apos;associer un seul fichier audio à l&apos;ensemble du livre de contes ou un fichier audio par page. Un fichier par page semble mieux fonctionner lorsque l&apos;audio s&apos;interrompt entre les tours de page.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table98" table:style-name="Table98">
    <table:table-column table:style-name="Table98.A"/>
    <table:table-column table:style-name="Table98.B"/>
    <table:table-row table:style-name="Table98.1">
     <table:table-cell table:style-name="Table98.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table98.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Assurez-vous que les fichiers audio ont un nom clair et unique. SAB devra déterminer quel fichier audio associer avec quelle page, ainsi inclure clairement le numéro dans le nom du fichier (i. . à la fin du nom) en utilisant un zéro supérieur. Inclure le nom du livre pour ne pas confondre l’audio pour plusieurs livres.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T39"><text:span text:style-name="T90">Par ex. </text:span><text:span text:style-name="T95">mon_book_page_01.mp3</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871327"/><text:span text:style-name="T39">Comment définir un livre d’histoires d’images?</text:span><text:bookmark-end text:name="_Toc233871327"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">Les livres d&apos;histoires d&apos;images peuvent être définis dans l&apos;un des deux formats :</text:span><text:span text:style-name="T16"/></text:p>
   <text:list xml:id="list1236735835" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P473" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_What_do_picture" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:soft-page-break/><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Microsoft Word (.docx) documents</text:span></text:span></text:a><text:span text:style-name="T16">, ou</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P473" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_What_do_picture_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Fichiers texte utilisant des marqueurs de format standard (SFM</text:span></text:span></text:a><text:span text:style-name="T16">).</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <table:table table:name="Table99" table:style-name="Table99">
    <table:table-column table:style-name="Table99.A"/>
    <table:table-column table:style-name="Table99.B"/>
    <table:table-row table:style-name="Table99.1">
     <table:table-cell table:style-name="Table99.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table99.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Même si les documents Word peuvent sembler plus simples, ils ne fonctionnent mieux que pour des livres d&apos;histoires très simples. Si vous voulez plus de contrôle sur le formatage et les fonctionnalités du livre, utilisez le format SFM.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_What_do_picture"/><text:bookmark-start text:name="_Toc233871328"/><text:bookmark-start text:name="_Ref459709545"/><text:bookmark-start text:name="_Ref459709538"/><text:span text:style-name="T39">À quoi ressemblent les livres d&apos;histoires d&apos;images dans les documents Word?</text:span><text:bookmark-end text:name="_Toc233871328"/><text:bookmark-end text:name="_Ref459709545"/><text:bookmark-end text:name="_Ref459709538"/><text:bookmark text:name="Section_Picture_Story_Books_Word"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">To create a Microsoft Word document to define a picture story book:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P474" loext:marker-style-name="T16"><text:span text:style-name="T16">Commencez par un nouveau document vide dans Word.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P475" loext:marker-style-name="T16"><text:span text:style-name="T16">Insérez une image en haut de la première page. </text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P476" loext:marker-style-name="T16"><text:span text:style-name="T16">Ajoutez le texte de l&apos;histoire de cette page sous l&apos;image.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15" loext:marker-style-name="T16"><draw:frame draw:style-name="fr4" draw:name="Image13" text:anchor-type="as-char" svg:width="5.9854in" svg:height="4.5709in" draw:z-index="0"><draw:image xlink:href="SAB02/83.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P477" loext:marker-style-name="T16"><text:span text:style-name="T16">Insérer un saut de page après le texte à l&apos;aide de </text:span><text:span text:style-name="T23">CTRL+Entrer</text:span><text:span text:style-name="T16">, ou </text:span><text:span text:style-name="T23">Insérer</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T23">Page Break</text:span><text:span text:style-name="T16">. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P475" loext:marker-style-name="T16"><text:span text:style-name="T16">Insérez une image en haut de la deuxième page et placez le texte de l&apos;histoire en dessous.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P475" loext:marker-style-name="T16"><text:span text:style-name="T16">Insérez un saut de page après le texte en utilisant </text:span><text:span text:style-name="T23">CTRL+Entrer</text:span><text:span text:style-name="T16">, ou </text:span><text:span text:style-name="T23">Insérer</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T23">Page Break</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P475" loext:marker-style-name="T16"><text:span text:style-name="T16">Continuer à ajouter des pages supplémentaires de cette façon.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P475" loext:marker-style-name="T16"><text:span text:style-name="T16">Enregistrer le document au format </text:span><text:span text:style-name="T23">.docx</text:span><text:span text:style-name="T16"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T19"><text:span text:style-name="T19">Vous pouvez ajouter des images au document en .jpeg, .jpg, .png, .tif ou . si les formats et Microsoft Word les convertissent automatiquement au format reconnu par le constructeur d&apos;applications bibliques.</text:span><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez de gros fichiers d&apos;image, il est préférable de les redimensionner. Vous pouvez le faire avant de les ajouter au document ou dans Word lui-même :</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P479" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez l&apos;une des images dans Word.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P481" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur </text:span><text:span text:style-name="T23">Compressez les images</text:span><text:span text:style-name="T16"> sur le ruban ou la barre d&apos;outils.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P481" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez </text:span><text:span text:style-name="T23">Toutes les images dans le document</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P481" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez la résolution comme </text:span><text:span text:style-name="T23">Web/Écran</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P3" loext:marker-style-name="T19"><draw:frame draw:style-name="fr4" draw:name="Picture 184" text:anchor-type="as-char" svg:width="2.2764in" svg:height="3.0598in" draw:z-index="0"><draw:image xlink:href="SAB02/84.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P478" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur </text:span><text:span text:style-name="T23">OK</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P480" loext:marker-style-name="T16"><text:span text:style-name="T16">Enregistrer le document.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P211" loext:marker-style-name="T19"/>
   <table:table table:name="Table100" table:style-name="Table100">
    <table:table-column table:style-name="Table100.A"/>
    <table:table-column table:style-name="Table100.B"/>
    <table:table-row table:style-name="Table100.1">
     <table:table-cell table:style-name="Table100.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table100.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">SAB convertit des documents Word dans son propre format de document interne SFM avec un ID unique de livre. Lorsque vous cliquez sur le fichier du livre dans l&apos;arborescence du projet dans SAB, choisissez l&apos;onglet </text:span><text:span text:style-name="T95">Book File</text:span><text:span text:style-name="T90"> dans la zone de configuration à droite. Ceci affichera le fichier converti et pourra vous aider à corriger les problèmes de formatage. En général, il est préférable de créer votre propre fichier SFM sur lequel vous aurez un plus grand contrôle de formatage.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P8" loext:marker-style-name="T39"/>
   <text:h text:style-name="P70" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_What_do_picture_1"/><text:bookmark-start text:name="_Toc233871329"/><text:bookmark-start text:name="_Ref459709560"/><text:span text:style-name="T39">À quoi ressemblent les livres d&apos;histoires d&apos;images au format SFM ?</text:span><text:bookmark-end text:name="_Toc233871329"/><text:bookmark-end text:name="_Ref459709560"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">They start with an id of your choice (using only </text:span><text:span text:style-name="T23">alpha-numeric characters or underscores</text:span><text:span text:style-name="T16">):</text:span></text:p>
   <text:p text:style-name="P482" loext:marker-style-name="T16"><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P342" loext:marker-style-name="T155"><text:span text:style-name="T155">\id STO29<text:line-break/></text:span><text:span text:style-name="T155"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">et un titre :<text:line-break/></text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P21" loext:marker-style-name="T155"><text:soft-page-break/><text:span text:style-name="T155">\toc2 L&apos;histoire du serviteur impitoyable</text:span><text:span text:style-name="T155"/></text:p>
   <text:p text:style-name="P358" loext:marker-style-name="T155"/>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">Each page begins with the \page marker:</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P21" loext:marker-style-name="T155"><text:span text:style-name="T156">\page</text:span><text:span text:style-name="T155"> 1</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">suivi d&apos;un nom de fichier image :</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P21" loext:marker-style-name="T16"><text:span text:style-name="T155">\img obs-29-01.jpg</text:span><text:span text:style-name="T155"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">puis le texte pour cette page, en utilisant des marqueurs USFM comme \p pour les paragraphes :</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P17" loext:marker-style-name="T155"><text:span text:style-name="T155">\p Un jour, Pierre demanda à Jésus, « Maître, combien de fois devrais-je pardonner à mon frère quand il pèche contre moi ? Jusqu’à sept fois? » <text:line-break/>\p Jésus a dit: « Pas sept fois, mais soixante-dix fois sept fois ! » <text:line-break/>\p Par cela, Jésus voulait dire que nous devrions toujours pardonner. Alors Jésus raconta cette histoire. </text:span><text:span text:style-name="T155"/></text:p>
   <text:p text:style-name="P358" loext:marker-style-name="T155"><text:s/></text:p>
   <text:p text:style-name="P358" loext:marker-style-name="T155"/>
   <text:p text:style-name="P10" loext:marker-style-name="T16"><text:span text:style-name="T16">Here is an example:</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P204" loext:marker-style-name="T16"/>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T155">------------------------------------<text:line-break/>\id STO29<text:line-break/>\toc2 The Story of the Unmerciful Servant<text:line-break/><text:line-break/></text:span><text:span text:style-name="T156">\page</text:span><text:span text:style-name="T155"> 1<text:line-break/>\img obs-29-01. Pg<text:line-break/>\p Un jour, Pierre demanda à Jésus, « Maître, combien de fois devrais-je pardonner à mon frère quand il pèche contre moi ? Jusqu’à sept fois? » <text:line-break/>\p Jésus a dit: « Pas sept fois, mais soixante-dix fois sept fois ! » <text:line-break/>\p Par cela, Jésus voulait dire que nous devrions toujours pardonner. Alors Jésus raconta cette histoire. <text:line-break/><text:line-break/>\page 2<text:line-break/>\img obs-29-02.jpg<text:line-break/>\p Jésus a dit: « Le royaume de Dieu est comme un roi qui voulait régler les comptes avec ses serviteurs. Un de ses serviteurs a dû une énorme dette de 200 000 ans de salaire.&amp;#160;» <text:line-break/><text:line-break/>\page 3<text:line-break/>\img obs-29-03. pg<text:line-break/>\p &quot;Puisque le serviteur n&apos;a pas pu payer la dette, le roi a dit, &quot;Vendez cet homme et sa famille en tant qu&apos;esclaves pour le paiement de sa dette.&quot; <text:line-break/><text:line-break/>\page 4<text:line-break/>\img obs-29-04. Pg<text:line-break/>\p « Le serviteur est tombé à genoux devant le roi et a dit : &quot;S&apos;il vous plaît, soyez patient avec moi et je paierai le montant total que je vous dois.&quot; Le roi a ressenti de la pitié pour le serviteur, il a donc annulé toute sa dette et l’a laissé partir. » <text:line-break/></text:span><text:span text:style-name="T16"><text:line-break/>etc.<text:line-break/></text:span></text:p>
   <table:table table:name="Table101" table:style-name="Table101">
    <table:table-column table:style-name="Table101.A"/>
    <table:table-column table:style-name="Table101.B"/>
    <table:table-row table:style-name="Table101.1">
     <table:table-cell table:style-name="Table101.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table101.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">For a more complete list of SFM markers you can use with Scripture App Builder, see </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_2:_App" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">Appendix 2</text:span></text:span></text:a></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P238" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">The book files must be </text:span><text:span text:style-name="T52">plain text files</text:span><text:span text:style-name="T39">. Si vous avez des caractères Unicode, les fichiers texte doivent utiliser l&apos;encodage </text:span><text:span text:style-name="T52">UTF-8</text:span><text:span text:style-name="T39">. Pour créer un fichier texte sous Windows, utilisez un éditeur de texte tel que Bloc-notes. Pour créer un fichier texte sur un Mac, utilisez TextEdit, en se rappelant de choisir les fichiers texte bruts dans les préférences, sinon le type de fichier par défaut est RTF (qui contient beaucoup de codes de formatage supplémentaires).</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P66" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871330"/><text:span text:style-name="T39">Où vont les photos?</text:span><text:bookmark-end text:name="_Toc233871330"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez défini le livre d’histoires d’images comme un document Word, les images dans le document seront ajoutées automatiquement à la collection d&apos;illustrations d&apos;application lorsque vous ajoutez le livre. Vous pouvez les voir sur la page </text:span><text:span text:style-name="T23">Illustrations</text:span><text:span text:style-name="T16"> pour le livre.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16"><text:line-break/>Si vous avez défini le livre d’histoires d’images comme un fichier texte SFM, vous devez ajouter les images au constructeur d’applications bibliques séparément. Do this on the </text:span><text:bookmark-start text:name="OLE_LINK17"/><text:bookmark-start text:name="OLE_LINK16"/><text:a xlink:type="simple" xlink:href="#_Illustrations" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Media</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T78"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Illustrations</text:span></text:span></text:a><text:span text:style-name="T16"> page</text:span><text:bookmark-end text:name="OLE_LINK17"/><text:bookmark-end text:name="OLE_LINK16"/><text:span text:style-name="T16">. Vous pouvez utiliser des fichiers PNG ou JPG. Essayez de les rendre aussi petits que possible sans compromettre la qualité de l&apos;image. Cela conservera la taille de votre application et réduira le temps de chargement de la page.<text:line-break/></text:span></text:p>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871331"/><text:span text:style-name="T39">Comment puis-je faire bouger les photos lorsque l&apos;audio est en cours de lecture ?</text:span><text:bookmark-end text:name="_Toc233871331"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez de l&apos;audio dans votre livre, vous pouvez ajouter des effets de panoramique et de zoom aux images lors de la lecture de l&apos;audio. Pour spécifier la motion:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P483" loext:marker-style-name="T16"><text:span text:style-name="T16">Allez à l&apos;onglet </text:span><text:span text:style-name="T23">Pages</text:span><text:span text:style-name="T16"> pour le livre.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P483" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez une image en haut de la page.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P483" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez l&apos;onglet </text:span><text:span text:style-name="T23">Motion</text:span><text:span text:style-name="T16"> sous les images.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P484" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez </text:span><text:span text:style-name="T23">Spécifiez les positions de début et de fin</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P192" loext:marker-style-name="T16"><draw:frame draw:style-name="fr4" draw:name="Picture 183" text:anchor-type="as-char" svg:width="5.298in" svg:height="3.7236in" draw:z-index="0"><draw:image xlink:href="SAB02/85.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P483" loext:marker-style-name="T16"><text:span text:style-name="T16">Glisser et redimensionner les rectangles de début et de fin dans les images pour spécifier les positions de début et de fin.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P283" loext:marker-style-name="T104"/>
   <table:table table:name="Table102" table:style-name="Table102">
    <table:table-column table:style-name="Table102.A"/>
    <table:table-column table:style-name="Table102.B"/>
    <table:table-row table:style-name="Table102.1">
     <table:table-cell table:style-name="Table102.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T126"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T126"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table102.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Varier les positions pour ajouter un peu d&apos;intérêt. Par exemple, alternez entre le pannage d&apos;entrée et le pannage, ou suivez le mouvement indiqué de l&apos;image elle-même (e. . - de gauche à droite si les gens marchent vers la gauche).</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P246" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum22">
    <text:list-item>
     <text:p text:style-name="P483" loext:marker-style-name="T16"><text:span text:style-name="T16">Faites cela pour chaque image dans le livre. </text:span><text:span text:style-name="T39">Par défaut, l&apos;effet de mouvement est chronométré pour correspondre à la longueur de l&apos;audio.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"><text:soft-page-break/></text:p>
   <table:table table:name="Table103" table:style-name="Table103">
    <table:table-column table:style-name="Table103.A"/>
    <table:table-column table:style-name="Table103.B"/>
    <table:table-row table:style-name="Table103.1">
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Si votre audio est plus long que 20 secondes, le mouvement peut se produire trop lentement. Cliquez sur l&apos;onglet </text:span><text:span text:style-name="T95">Durée</text:span><text:span text:style-name="T90"> et réglez la durée d&apos;environ 20 secondes et ajustez si nécessaire.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P63" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871332"/><text:span text:style-name="T39">Qu&apos;en est-il de la police et de la taille de la police ?</text:span><text:bookmark-end text:name="_Toc233871332"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T16">A popular font designed for those learning to read is </text:span><text:span text:style-name="T23">Andika</text:span><text:span text:style-name="T16"> or </text:span><text:span text:style-name="T23">Andika Compact</text:span><text:span text:style-name="T16">.</text:span></text:p>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T16">Spécifiez les polices disponibles pour l&apos;utilisateur sous </text:span><text:a xlink:type="simple" xlink:href="#_The_Main_Font" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Apparence </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T83">&lt;unk&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23"> Polices</text:span></text:span></text:a><text:span text:style-name="T16"> menu. Set the specific book collection’s font under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Fonts_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">&lt;book collection&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"> </text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T78"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Fonts</text:span></text:span></text:a><text:span text:style-name="T23"> </text:span><text:span text:style-name="T16">tab.</text:span></text:p>
   <text:p text:style-name="P205" loext:marker-style-name="T16"/>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T16">Si vous avez une petite quantité de texte par image, il est préférable d&apos;utiliser une plus grande taille de police par défaut. You can change this within Scripture App Builder on the </text:span><text:a xlink:type="simple" xlink:href="#_The_Styles_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">&lt;book collection&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"> </text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T78"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Styles</text:span></text:span></text:a><text:span text:style-name="T16"> tab by modifying the </text:span><text:span text:style-name="T23">Default text size</text:span><text:span text:style-name="T16"> property.</text:span></text:p>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T16">Use </text:span><text:a xlink:type="simple" xlink:href="#_The_Text_Size" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23">Appearance </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T83"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23"> Formatting </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T83"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T23"> Text Size</text:span></text:span></text:a><text:span text:style-name="T16"> to set the range of text sizes from which the user can select.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P63" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871333"/><text:span text:style-name="T39">Quelles sont les étiquettes de synchronisation sonores utilisées?</text:span><text:bookmark-end text:name="_Toc233871333"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">If you have one audio file for the whole book, timing labels are of the form:</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P485" loext:marker-style-name="T143"><text:span text:style-name="T191"><text:line-break/></text:span><text:span text:style-name="T143">1a - 1a - 1a phrase à la page 1<text:line-break/>1b - 2e phrase à la page 1<text:line-break/>1c - 3e phrase à la page 1<text:line-break/>2a - 1a - 1e phrase à la page 2<text:line-break/>2b - 2ème phrase à la page 2, etc.</text:span></text:p>
   <text:p text:style-name="P316" loext:marker-style-name="T143"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">If you have one audio file per page, timing labels are of the form:</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P485" loext:marker-style-name="T39"><text:span text:style-name="T190"><text:line-break/></text:span><text:span text:style-name="T39">A - 1ère phrase sur la page<text:line-break/>b - 2ème phrase sur la page<text:line-break/>c - 3ème phrase sur la page</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P16" loext:marker-style-name="T16"><text:span text:style-name="T16">To help with the creation of the timing files, generate phrase lists on the </text:span><text:span text:style-name="T23">Audio Synchronization</text:span><text:span text:style-name="T16"> tab for the book, or use </text:span><text:span text:style-name="T24">aeneas</text:span><text:span text:style-name="T16"> to automate the synchronization process.</text:span></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P63" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871334"/><text:soft-page-break/><text:span text:style-name="T39">Comment puis-je ajouter de la musique de fond lorsque l&apos;audio est en cours de lecture ?</text:span><text:bookmark-end text:name="_Toc233871334"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous pouvez ajouter de la musique de fond et des effets sonores derrière la piste audio narrative. Pour faire ceci :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P486" loext:marker-style-name="T16"><text:span text:style-name="T16">Allez à l&apos;onglet </text:span><text:span text:style-name="T23">Pages</text:span><text:span text:style-name="T16"> pour le livre.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P487" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez la première image en haut de la page.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P487" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez l&apos;onglet </text:span><text:span text:style-name="T23">Musique d&apos;arrière-plan</text:span><text:span text:style-name="T16"> sous les images.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P487" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez </text:span><text:span text:style-name="T23">Jouez ce fichier audio comme musique de fond</text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P488" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur </text:span><text:span text:style-name="T23">Sélectionnez le fichier…</text:span><text:span text:style-name="T16"> et choisissez le fichier audio de musique de fond.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P192" loext:marker-style-name="T16"><draw:frame draw:style-name="fr4" draw:name="Picture 182" text:anchor-type="as-char" svg:width="5.3311in" svg:height="3.7472in" draw:z-index="0"><draw:image xlink:href="SAB02/86.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum23">
    <text:list-item>
     <text:p text:style-name="P488" loext:marker-style-name="T16"><text:span text:style-name="T16">Faites glisser le curseur pour modifier le volume de la musique de fond.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P488" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez chacune des pages suivantes dans le livre et spécifiez s&apos;il faut continuer à jouer la musique de fond de la page précédente, que ce soit pour jouer une piste de musique de fond différente ou pour arrêter de jouer une musique de fond.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P63" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871335"/><text:span text:style-name="T39">Où puis-je obtenir des textes et des photos de livres d&apos;histoires d&apos;échantillons?</text:span><text:bookmark-end text:name="_Toc233871335"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard"><text:span text:style-name="T16">Have a look at </text:span><text:span text:style-name="T23">Open Bible Stories</text:span><text:span text:style-name="T16"> here: </text:span><text:a xlink:type="simple" xlink:href="https://door43.org/en/obs" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">https://door43.org/en/obs</text:span></text:span></text:a><text:span text:style-name="T16"><text:line-break/></text:span>See <text:a xlink:type="simple" xlink:href="https://www.freebibleimages.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">FreeBibleImages.org</text:span></text:a> for many image sets for Bible stories and characters. Assurez-vous d&apos;ajouter des informations sur les droits d&apos;auteur dans la boîte <text:span text:style-name="T51">À propos de</text:span> si vous utilisez des images dans vos applications.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table104" table:style-name="Table104">
    <table:table-column table:style-name="Table104.A"/>
    <table:table-column table:style-name="Table104.B"/>
    <table:table-row table:style-name="Table104.1">
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T126"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T126"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If you have translated Bible texts, it is fairly simple to create Bible story books using free images from places like </text:span><text:a xlink:type="simple" xlink:href="https://www.freebibleimages.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">FreeBibleImages.org</text:span></text:span></text:a></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">You can make these into separate apps, or group them into Bible story sets in a single app, using a </text:span><text:a xlink:type="simple" xlink:href="#_Contents_Menu" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">Contents Menu</text:span></text:span></text:a><text:span text:style-name="T90"> to allow the user to access them.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <text:h text:style-name="P67" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871336"/><text:span text:style-name="T39">Comment puis-je enregistrer les fichiers audio ?</text:span><text:bookmark-end text:name="_Toc233871336"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Utilisez votre logiciel d’enregistrement audio préféré, comme Audacity. Vous devrez décider à quelle vitesse ou à quelle vitesse vous voulez que le lecteur lisse. Dans certains contextes, il pourrait être bon que les livres de contes soient lus assez lentement. N&apos;oubliez pas qu&apos;il est généralement préférable d&apos;enregistrer un fichier pour chaque page.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:h text:style-name="P50" text:outline-level="1"><text:bookmark text:name="_Song_Books"/><text:bookmark-start text:name="_Toc233871337"/><text:bookmark-start text:name="_Ref459652851"/>Livres de chansons<text:bookmark-end text:name="_Toc233871337"/><text:bookmark-end text:name="_Ref459652851"/></text:h>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871338"/><text:span text:style-name="T39">Comment définir un livre de chansons ?</text:span><text:bookmark-end text:name="_Toc233871338"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous pouvez construire un fichier de livres de chansons similaire aux autres fichiers du livre, mais avec une chanson par chapitre. </text:span><text:span text:style-name="T16">Les livres de chansons sont définis dans l&apos;un des deux formats :</text:span></text:p>
   <text:list text:continue-list="list1236735835" text:style-name="WWNum9">
    <text:list-item>
     <text:p text:style-name="P473" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_What_do_song" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Microsoft Word (.docx) documents</text:span></text:span></text:a><text:span text:style-name="T16">, ou</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P473" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_What_do_song_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16">Fichiers texte utilisant des marqueurs de format standard (SFM)</text:span></text:span></text:a><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T16"><text:span text:style-name="T16">Voir les sections ci-dessous pour une description de ces formats.</text:span><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">L&apos;audio peut être ajouté à l&apos;aide de la synchronisation de texte audio, de sorte que chaque ligne de la chanson est surlignée au fur et à mesure qu&apos;elle est chantée.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table105" table:style-name="Table105">
    <table:table-column table:style-name="Table105.A"/>
    <table:table-column table:style-name="Table105.B"/>
    <table:table-row table:style-name="Table105.1">
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T39">When you add your songbook to the app, click on the book in the project tree view and select the </text:span><text:span text:style-name="T52">Book</text:span><text:span text:style-name="T39"> tab. Assurez-vous que le sélecteur </text:span><text:span text:style-name="T52">Type</text:span><text:span text:style-name="T39"> est réglé sur </text:span><text:span text:style-name="T52">Livre de Chansons</text:span><text:span text:style-name="T39">. Si c&apos;est le cas, SAB sera automatiquement un index de musique composé de 2 menus de contenu — l&apos;un listé par titre de chanson et l&apos;autre par numéro de chanson</text:span><text:span text:style-name="T90">. </text:span><text:span text:style-name="T39">Vous pouvez les prévisualiser sous l&apos;onglet </text:span><text:span text:style-name="T52">Indice de musique</text:span><text:span text:style-name="T39"> .</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:h text:style-name="P68" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_What_do_song"/><text:bookmark-start text:name="_Toc233871339"/><text:span text:style-name="T39">À quoi ressemblent les livres de chansons dans les documents Word ?</text:span><text:bookmark-end text:name="_Toc233871339"/><text:bookmark text:name="Section_Song_Books_Word"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P20" loext:marker-style-name="T16"><text:span text:style-name="T16">To create a Microsoft Word document to define a song book:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P489" loext:marker-style-name="T16"><text:span text:style-name="T16">Commencez par un nouveau document vide dans Word.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P489" loext:marker-style-name="T16"><text:span text:style-name="T16">Tapez les morceaux ou copiez-les à partir d&apos;un autre document.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P489" loext:marker-style-name="T16"><text:span text:style-name="T16">Pour chaque chanson, placez le numéro de la chanson sur une ligne par elle-même avant son titre et ses paroles.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P387" loext:marker-style-name="T20"><draw:frame draw:style-name="fr4" draw:name="Picture 181" text:anchor-type="as-char" svg:width="5.6965in" svg:height="5.1827in" draw:z-index="0"><draw:image xlink:href="SAB02/87.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:list xml:id="list164753150297542" text:continue-numbering="true" text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P490" loext:marker-style-name="T16"><text:soft-page-break/><text:span text:style-name="T16">Créer les styles de paragraphe suivants :</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <table:table table:name="Table106" table:style-name="Table106">
    <table:table-column table:style-name="Table106.A"/>
    <table:table-column table:style-name="Table106.B"/>
    <table:table-row table:style-name="Table106.1">
     <table:table-cell table:style-name="Table106.A1" office:value-type="string">
      <text:p text:style-name="P188" loext:marker-style-name="T24"><text:span text:style-name="T24">Style</text:span><text:span text:style-name="T24"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table106.A1" office:value-type="string">
      <text:p text:style-name="P298" loext:marker-style-name="T24"><text:span text:style-name="T24">Utiliser</text:span><text:span text:style-name="T24"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table106.2">
     <table:table-cell table:style-name="Table106.A2" office:value-type="string">
      <text:p text:style-name="P193" loext:marker-style-name="T16"><text:span text:style-name="T16">c</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table106.B2" office:value-type="string">
      <text:p text:style-name="P29" loext:marker-style-name="T16"><text:span text:style-name="T16">Chapitre numéro</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table106.3">
     <table:table-cell table:style-name="Table106.A3" office:value-type="string">
      <text:p text:style-name="P193" loext:marker-style-name="T16"><text:span text:style-name="T16">s</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table106.B3" office:value-type="string">
      <text:p text:style-name="P29" loext:marker-style-name="T16"><text:span text:style-name="T16">Titre de la chanson</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table106.4">
     <table:table-cell table:style-name="Table106.A4" office:value-type="string">
      <text:p text:style-name="P193" loext:marker-style-name="T16"><text:span text:style-name="T16">q1</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table106.B4" office:value-type="string">
      <text:p text:style-name="P29" loext:marker-style-name="T16"><text:span text:style-name="T16">Ligne de la chanson</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table106.5">
     <table:table-cell table:style-name="Table106.A5" office:value-type="string">
      <text:p text:style-name="P194" loext:marker-style-name="T16"><text:span text:style-name="T16">q2</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table106.B5" office:value-type="string">
      <text:p text:style-name="P432" loext:marker-style-name="T16"><text:span text:style-name="T16">Ligne d&apos;un chœur (plus d&apos;indentation)</text:span><text:span text:style-name="T16"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P292" loext:marker-style-name="T16"><text:span text:style-name="T16">To create a style:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P492" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez la ligne/paragraphe de texte qui correspond à ce style, i.e. si vous créez le style ‘cc , sélectionnez une des lignes avec un numéro de chanson. Si vous créez le style ‘q1’, sélectionnez une ligne des paroles de la chanson.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P492" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur la flèche vers le bas à droite du ruban de style.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P185" loext:marker-style-name="T16"><draw:custom-shape text:anchor-type="char" draw:z-index="12" draw:name="AutoShape 150" draw:style-name="gr1" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (4.10833333333333in 1.53125in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 180" text:anchor-type="as-char" svg:width="3.7728in" svg:height="0.9835in" draw:z-index="0"><draw:image xlink:href="SAB02/88.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P203" loext:marker-style-name="T16"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P492" loext:marker-style-name="T16"><text:span text:style-name="T16">Puis sélectionnez </text:span><text:span text:style-name="T24">Créer un style</text:span><text:span text:style-name="T16"> dans le menu qui apparaît.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P186" loext:marker-style-name="T20"><draw:frame draw:style-name="fr4" draw:name="Picture 179" text:anchor-type="as-char" svg:width="3.6374in" svg:height="1.9154in" draw:z-index="0"><draw:image xlink:href="SAB02/89.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P492" loext:marker-style-name="T20"><text:span text:style-name="T20">Tapez le nom du style dans la boîte de dialogue et appuyez sur OK.</text:span><text:span text:style-name="T20"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P292" loext:marker-style-name="T16"><text:span text:style-name="T16">Faites cela pour c, s, q1 et q2.</text:span><text:span text:style-name="T16"/></text:p>
   <text:list xml:id="list164754286240724" text:continue-list="list164753150297542" text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P491" loext:marker-style-name="T16"><text:span text:style-name="T16">Appliquez les styles ci-dessus à tous les numéros de chapitre, titres de chanson et les lignes des paroles de la chanson. </text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P292" loext:marker-style-name="T16"><text:span text:style-name="T16">To apply a style:</text:span><text:span text:style-name="T16"/></text:p>
   <text:list text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P493" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez la ligne/paragraphe sur laquelle vous souhaitez appliquer le style.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P493" loext:marker-style-name="T16"><text:span text:style-name="T16">Cliquez sur la flèche vers le bas à droite du ruban de style.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P494" loext:marker-style-name="T16"><draw:custom-shape text:anchor-type="char" draw:z-index="8" draw:name="AutoShape 149" draw:style-name="gr1" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (4.10833333333333in 1.53125in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:soft-page-break/><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 178" text:anchor-type="as-char" svg:width="3.7728in" svg:height="0.9835in" draw:z-index="0"><draw:image xlink:href="SAB02/90.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P217" loext:marker-style-name="T20"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum15">
    <text:list-item>
     <text:p text:style-name="P493" loext:marker-style-name="T16"><text:span text:style-name="T16">Sélectionnez le style que vous souhaitez appliquer.</text:span><text:span text:style-name="T16"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P217" loext:marker-style-name="T20"/>
   <text:p text:style-name="P495" loext:marker-style-name="T16"><draw:custom-shape text:anchor-type="char" style:rel-height="20%" draw:z-index="9" draw:name="Text Box 148" draw:style-name="gr11" draw:text-style-name="P521" svg:width="1.1925in" svg:height="0.3024in" svg:x="-0.1937in" svg:y="2.0752in">
     <text:p text:style-name="Frame_20_contents">Appliquer le style &apos;c&apos;</text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="10" draw:name="AutoShape 147" draw:style-name="gr14" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (0.662876049907446) translate (0.725694444444444in 1.88472222222222in)">
     <text:p/>
