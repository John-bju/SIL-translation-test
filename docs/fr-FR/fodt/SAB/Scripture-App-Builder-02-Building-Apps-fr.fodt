      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="26" draw:name="AutoShape 152" draw:style-name="gr1" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (0.979166666666667in 3.525in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 200" text:anchor-type="as-char" svg:width="1.822in" svg:height="3.2402in" draw:z-index="0"><draw:image xlink:href="SAB02/50.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 199" text:anchor-type="as-char" svg:width="1.822in" svg:height="3.2402in" draw:z-index="0"><draw:image xlink:href="SAB02/51.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 198" text:anchor-type="as-char" svg:width="1.822in" svg:height="3.2402in" draw:z-index="0"><draw:image xlink:href="SAB02/52.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To view a list of notes, select </text:span><text:span text:style-name="T52">Notes</text:span><text:span text:style-name="T39"> from the app’s navigation drawer menu. Sur cet écran, l&apos;utilisateur peut trier les notes par date ou référence (appuyez sur le bouton Tri de la barre d&apos;application). Ils peuvent modifier ou supprimer des notes ou appuyer sur un élément pour aller au verset avec la note. Ils peuvent également partager la liste des notes avec quelqu&apos;un d&apos;autre (appuyez sur le bouton Partager sur la barre d&apos;application).</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les utilisateurs peuvent utiliser la fonctionnalité de partage de notes pour permettre aux utilisateurs de la communauté linguistique d&apos;envoyer des commentaires sur une traduction. Pour cela, spécifiez une adresse e-mail et une ligne de sujet sous </text:span><text:span text:style-name="T52">Annotations de partage</text:span><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:bookmark-start text:name="_Hlk498706821"/><text:span text:style-name="T51">signets</text:span><text:bookmark-end text:name="_Hlk498706821"/><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="P25" loext:marker-style-name="T39"><text:span text:style-name="T39">To add a bookmark to a verse, a user can do the following:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum32">
    <text:list-item>
     <text:p text:style-name="P436" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Tapotez sur le verset. L&apos;application va le souligner.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P437" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez le bouton de signet dans la barre d&apos;outils de sélection de texte. Une icône rouge de signet </text:span><draw:frame draw:style-name="fr4" draw:name="Picture 197" text:anchor-type="as-char" svg:width="0.1681in" svg:height="0.1681in" draw:z-index="0"><draw:image draw:mime-type="image/png">
        <office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABgAAAAYCAYAAADgdz34AAAACXBIWXMAAAsTAAALEwEAmpwY
         AAAAxUlEQVRIx+2VPQrCQBSEv8WfQhsLQY/gDSw9gCCIjWIpaGeZVs9gJ5LOwlbBO5gbeAhB
         ENRKxiZVshgDhoDswLKwb958u7xijSSyVJGMlQ/AGNOfwrYNlXpCwAU4wXMDI0n7WJZtBjNj
         7l2opLnpER5rqfrVC2opwz/1/OmQHcABHCBHwDncW78GHODlww5YhUfzCQx7UEhslhRbHsgH
         deAKLIBG1AM0geUAbj7IA9myrAAgAMZAyVaPeMuhN7DVjfv0k/QGAHSKMXfkKxsAAAAASUVO
         RK5CYII=
        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T39"><text:s/>sera affichée à la fin du verset sélectionné.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P3" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" draw:z-index="4" draw:name="AutoShape 151" draw:style-name="gr1" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (2.15902777777778in 3.53472222222222in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 196" text:anchor-type="as-char" svg:width="1.822in" svg:height="3.2402in" draw:z-index="0"><draw:image xlink:href="SAB02/53.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 195" text:anchor-type="as-char" svg:width="1.822in" svg:height="3.2402in" draw:z-index="0"><draw:image xlink:href="SAB02/54.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P25" loext:marker-style-name="T39"><text:span text:style-name="T39">To remove a bookmark from a verse, a user does the following:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum33">
    <text:list-item>
     <text:p text:style-name="P438" loext:marker-style-name="T39"><text:span text:style-name="T39">Appuyez sur l&apos;icône de signet </text:span><draw:frame draw:style-name="fr4" draw:name="Picture 194" text:anchor-type="as-char" svg:width="0.1681in" svg:height="0.1681in" draw:z-index="0"><draw:image draw:mime-type="image/png">
        <office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABgAAAAYCAYAAADgdz34AAAACXBIWXMAAAsTAAALEwEAmpwY
         AAAAxUlEQVRIx+2VPQrCQBSEv8WfQhsLQY/gDSw9gCCIjWIpaGeZVs9gJ5LOwlbBO5gbeAhB
         ENRKxiZVshgDhoDswLKwb958u7xijSSyVJGMlQ/AGNOfwrYNlXpCwAU4wXMDI0n7WJZtBjNj
         7l2opLnpER5rqfrVC2opwz/1/OmQHcABHCBHwDncW78GHODlww5YhUfzCQx7UEhslhRbHsgH
         deAKLIBG1AM0geUAbj7IA9myrAAgAMZAyVaPeMuhN7DVjfv0k/QGAHSKMXfkKxsAAAAASUVO
         RK5CYII=
        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T39"><text:s/>à la fin du verset. L&apos;application soulignera le verset.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P439" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez le bouton de signet rouge dans la barre d&apos;outils de sélection de texte. Le favori sera supprimé.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To view a list of bookmarks, select </text:span><text:span text:style-name="T52">Bookmarks</text:span><text:span text:style-name="T39"> in the app’s navigation drawer menu. Sur cet écran, vous pouvez trier les signets par date ou référence (appuyez sur le bouton Tri de la barre d&apos;application). Vous pouvez supprimer les signets ou appuyer sur un élément pour aller au verset avec le signet. Vous pouvez également partager la liste des versets signet avec quelqu&apos;un d&apos;autre (appuyez sur le bouton Partager sur la barre d&apos;application).</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Jouer l&apos;audio à partir du texte sélectionné</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Si l&apos;audio est présent dans le chapitre courant de l&apos;utilisateur, activer ceci permet à un utilisateur de toucher un verset ou des versets puis de cliquer sur le bouton Play dans la barre d&apos;outils de sélection de texte. La lecture audio commencera au premier des versets sélectionnés.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:h text:style-name="P69" text:outline-level="2"><text:bookmark-start text:name="_Toc233871224"/>Assistant (AI)<text:bookmark-end text:name="_Toc233871224"/></text:h>
   <text:p text:style-name="P16">L&apos;Assistant AI fournit une aide pour l&apos;engagement biblique sur un passage sélectionné, tel qu&apos;un chapitre entier ou des versets sélectionnés. Vous pouvez configurer l&apos;Assistant avec une liste de tâches possibles, par exemple :</text:p>
   <text:list text:style-name="WWNum78">
    <text:list-item>
     <text:p text:style-name="P138">« Donnez-moi des questions sur l&apos;étude biblique»</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138">« Partagez quelques pensées dévotionnelles»</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:soft-page-break/>« Suggérer des façons d&apos;appliquer cela à ma vie »</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138">« Montre comment ce passage s&apos;intègre dans le message du livre»</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P15"><text:line-break/>Ces tâches sont affichées dans l&apos;onglet Assistant. Lorsque l&apos;utilisateur sélectionne l&apos;un d&apos;eux, l&apos;application se connecte à un fournisseur IA, pose la question et affiche la réponse reçue à l&apos;écran.</text:p>
   <text:p text:style-name="P4"><draw:frame draw:style-name="fr4" draw:name="Picture 36" text:anchor-type="as-char" svg:width="2.3626in" svg:height="5.248in" draw:z-index="0"><draw:image xlink:href="SAB02/55.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Image6" text:anchor-type="as-char" svg:width="2.3626in" svg:height="5.248in" draw:z-index="0"><draw:image xlink:href="SAB02/56.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T93"><text:span text:style-name="T93">The list of tasks on the Assistant tab The response generated by the AI provider</text:span><text:span text:style-name="T93"/></text:p>
   <text:p text:style-name="P15"/>
   <text:p text:style-name="P15">Pour configurer l&apos;assistant AI :</text:p>
   <text:list xml:id="list915715488" text:style-name="WWNum79">
    <text:list-item>
     <text:p text:style-name="P139" loext:marker-style-name="T17"><text:span text:style-name="T16">Sur </text:span><text:span text:style-name="T24">Tâches Assistant</text:span><text:span text:style-name="T16"> onglet, ajouter quelques tâches, soit en cliquant sur </text:span><text:span text:style-name="T24">Ajouter une tâche</text:span><text:span text:style-name="T16"> ou </text:span><text:span text:style-name="T24">Ajouter une tâche depuis la galerie</text:span><text:span text:style-name="T16">. Pour chaque tâche, vous aurez besoin de :</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:list text:style-name="WWNum80">
    <text:list-item>
     <text:p text:style-name="P140" loext:marker-style-name="T8"><text:span text:style-name="T23">Un nom de tâche</text:span><text:span text:style-name="T17">: Il s&apos;agit du nom interne de la tâche, non affiché à l&apos;utilisateur.<text:line-break/>Exemple : </text:span><text:span text:style-name="T8">« Questions d&apos;étude biblique ».</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P141" loext:marker-style-name="T8"><text:span text:style-name="T23">Un titre de tâche</text:span><text:span text:style-name="T17">: C&apos;est le titre de la tâche qui est affiché à l&apos;utilisateur. Exemple: </text:span><text:span text:style-name="T8">« Donnez-moi quelques questions d&apos;étude biblique ».</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P130" loext:marker-style-name="T17"><text:span text:style-name="T17">Écrivez le titre dans les langues de l&apos;interface utilisateur de l&apos;application. Vous pouvez fournir des traductions.</text:span><text:span text:style-name="T17"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum80">
    <text:list-item>
     <text:p text:style-name="P141" loext:marker-style-name="T8"><text:span text:style-name="T23">Une demande de tâche</text:span><text:span text:style-name="T17">: C&apos;est l&apos;invite à être envoyée au fournisseur d&apos;AI lorsqu&apos;un utilisateur sélectionne cette tâche. Il n&apos;est pas visible pour l&apos;utilisateur.<text:line-break/></text:span><text:span text:style-name="T150"><text:line-break/></text:span><text:span text:style-name="T17">Exemple : </text:span><text:span text:style-name="T8">“Regardez %reference% et donnez-moi six questions pour une étude biblique. Il devrait s’agir de questions de style d’étude biblique qui encouragent l’engagement dans le texte et la discussion sur le contenu, le sens et l’application. »</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P130" loext:marker-style-name="T17"><text:span text:style-name="T17">When defining prompts, you can use the following variables:</text:span><text:span text:style-name="T17"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum80">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P142" loext:marker-style-name="T17"><text:span text:style-name="T23">%reference%</text:span><text:span text:style-name="T17"> - pour le repère biblique</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P142" loext:marker-style-name="T17"><text:span text:style-name="T23">%book%</text:span><text:span text:style-name="T17"> - pour le nom du livre courant</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P142" loext:marker-style-name="T17"><text:span text:style-name="T23">%chapter%</text:span><text:span text:style-name="T17"> - pour le numéro de chapitre actuel</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P140" loext:marker-style-name="T17"><text:span text:style-name="T23">%biblical-language%</text:span><text:span text:style-name="T17"> - pour la langue biblique actuelle (grec ou hébreu).</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list text:continue-list="list915715488" text:style-name="WWNum79">
    <text:list-item>
     <text:p text:style-name="P139" loext:marker-style-name="T17"><text:span text:style-name="T16">On the </text:span><text:span text:style-name="T24">AI Provider</text:span><text:span text:style-name="T16"> tab, choose a provider from the possible options.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P139" loext:marker-style-name="T17"><text:span text:style-name="T16">Sur les </text:span><text:span text:style-name="T24">Paramètres</text:span><text:span text:style-name="T16"> correspondants, par exemple « Paramètres OpenAI » ou « Paramètres Groq », entrez la clé API pour le fournisseur. Vous devrez avoir créé un compte avec le fournisseur pour cela, ainsi que spécifier une méthode de facturation.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P139" loext:marker-style-name="T17"><text:soft-page-break/><text:span text:style-name="T16">Tester l&apos;Assistant dans l&apos;onglet </text:span><text:span text:style-name="T16">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T16"/>
   <text:h text:style-name="P69" text:outline-level="2"><text:bookmark text:name="_Notifications"/><text:bookmark text:name="_News_Feeds"/><text:bookmark-start text:name="_Toc233871225"/>Flux d&apos;actualité<text:bookmark-end text:name="_Toc233871225"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51">Les fils d&apos;actualité permettent d&apos;afficher un contenu dynamique et à jour dans votre application. Un fil d&apos;actualité est distribué à votre application via un flux RSS. Il s&apos;agit d&apos;un format de flux web standardisé (généralement XML) qui permet aux applications d&apos;extraire les mises à jour de données d&apos;un site Web. Pour que votre application dispose d&apos;un fil d&apos;actualité provenant d&apos;un site Web particulier, ce site Web doit avoir une URL accessible qui pointe vers le fil RSS. Ceci est généralement l&apos;adresse principale du site web avec <text:span text:style-name="T51">/feed/</text:span> ajoutée à la fin, par exemple <text:span text:style-name="T51">https://www.biblesociety-nigeria.org/feed/</text:span></text:p>
   <text:h text:style-name="P78" text:outline-level="3"><text:bookmark-start text:name="_Toc233871226"/>The <text:span text:style-name="T89">Feeds</text:span> tab<text:bookmark-end text:name="_Toc233871226"/></text:h>
   <text:p text:style-name="Standard">Utilisez l&apos;onglet <text:span text:style-name="T51">Flux</text:span> pour ajouter un ou plusieurs flux RSS à votre application. Une fois ajouté ici, vous devrez fournir un accès au flux en l&apos;ajoutant au menu Contents, au panneau de navigation et/ou à la barre d&apos;outils de navigation du bas. Vous pouvez le faire sous leurs paramètres respectifs, ou faire un clic droit sur un flux pour les ajouter directement.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51">Cliquez sur <text:span text:style-name="T51">Ajouter un flux…</text:span> pour ajouter un flux RSS. Vous devrez ajouter un titre puis entrer l&apos;URL du flux. Comme indiqué ci-dessus, il s&apos;agit généralement de l&apos;adresse principale du site web avec <text:span text:style-name="T51">/feed/</text:span> ajouté à la fin, par exemple <text:span text:style-name="T51">https://scripture-engagement.org/feed/</text:span></text:p>
   <text:p text:style-name="Standard">Cliquez sur le bouton <text:span text:style-name="T51">Test</text:span> pour tester l&apos;URL.</text:p>
   <text:h text:style-name="P78" text:outline-level="3"><text:bookmark-start text:name="_Toc233871227"/>The <text:span text:style-name="T89">Settings</text:span> tab<text:bookmark-end text:name="_Toc233871227"/></text:h>
   <text:p text:style-name="Standard">Utilisez le paramètre <text:span text:style-name="T51">Image Resizing</text:span> pour définir une limite à la taille des images provenant du flux. La largeur maximale par défaut est de 1,080 pixels, mais vous pouvez avoir un maximum plus petit. Teste quelques tailles pour voir.</text:p>
   <text:h text:style-name="P78" text:outline-level="3"><text:bookmark-start text:name="_Toc233871228"/>The <text:span text:style-name="T89">Viewer</text:span> tab<text:bookmark-end text:name="_Toc233871228"/></text:h>
   <text:p text:style-name="Standard">Utilisez l&apos;onglet <text:span text:style-name="T51">Viewer</text:span> pour voir comment un flux sera affiché dans votre application. Utilisez la liste déroulante pour sélectionner un flux à afficher. Cliquez sur <text:span text:style-name="T51">Voir dans le navigateur</text:span> pour voir le flux dans une page du navigateur.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P69" text:outline-level="2"><text:bookmark text:name="_Bible_Reading_Plans"/><text:bookmark-start text:name="_Toc233871229"/>Plan de lecture de la Bible<text:bookmark-end text:name="_Toc233871229"/></text:h>
   <text:p text:style-name="Standard">Les applications bibliques peuvent contenir une sélection de plans bibliques, qui incluent une ou plusieurs lectures quotidiennes. Pour ajouter un plan, utilisez l&apos;onglet <text:span text:style-name="T51">Plans</text:span>. Pour plus d&apos;informations sur l&apos;ajustement des styles des différents éléments des plans, voir <text:a xlink:type="simple" xlink:href="#_Reading_Plan_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Annexe 3</text:span></text:span></text:a>.</text:p>
   <text:p text:style-name="P258" loext:marker-style-name="T45"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871230"/>L&apos;onglet <text:span text:style-name="T89">Plans</text:span> (pour ajouter et réorganiser des plans)<text:bookmark-end text:name="_Toc233871230"/></text:h>
   <text:p text:style-name="P15">Vous pouvez créer vos propres plans de lecture, ou en ajouter ceux que quelqu&apos;un d&apos;autre a créés.</text:p>
   <text:p text:style-name="P15"><text:soft-page-break/>Dans l’onglet Plans, utilisez l’onglet <text:span text:style-name="T51">Ajouter un plan à partir de la galerie…</text:span> pour ajouter l&apos;un des plans fournis avec SAB.</text:p>
   <text:p text:style-name="P15">Utilisez le <text:span text:style-name="T51">Ajouter un plan…</text:span> pour ajouter un plan que vous ou quelqu&apos;un d&apos;autre avez créé.</text:p>
   <text:p text:style-name="P15">Les forfaits sont définis dans des fichiers texte avec le format suivant :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P3"><draw:custom-shape text:anchor-type="as-char" draw:z-index="5" draw:name="Text Box 140" draw:style-name="gr7" draw:text-style-name="P521" svg:width="4.5004in" svg:height="3.0941in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107"><text:line-break/>\id</text:span><text:span text:style-name="T182"> PLAN1</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\t</text:span><text:span text:style-name="T182"> Lire à travers les Évangiles</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\descr</text:span><text:span text:style-name="T182"> Lisez les Évangiles de Matthieu et Mark, apprenant sur Jésus, ce qu&apos;il a fait, ce qu&apos;il a dit et pourquoi il est venu.</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\img</text:span><text:span text:style-name="T108"> </text:span><text:span text:style-name="T182">plan1.jpg</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\day</text:span><text:span text:style-name="T108"> </text:span><text:span text:style-name="T182">1</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\ref</text:span><text:span text:style-name="T182"> MAT 1:1-17</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\day</text:span><text:span text:style-name="T182"> 2</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\ref</text:span><text:span text:style-name="T182"> MAT 1:18-25</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\ref</text:span><text:span text:style-name="T182"> MRK 1:1-8</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\day</text:span><text:span text:style-name="T182"> 3</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\ref</text:span><text:span text:style-name="T182"> MAT 2</text:span></text:p>
