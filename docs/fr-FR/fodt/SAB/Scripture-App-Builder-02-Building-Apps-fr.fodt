   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P10" loext:marker-style-name="T17"><text:span text:style-name="T17">Les marqueurs de format type à utiliser sont les suivants :</text:span><text:span text:style-name="T17"/></text:p>
   <text:p text:style-name="P208" loext:marker-style-name="T17"/>
