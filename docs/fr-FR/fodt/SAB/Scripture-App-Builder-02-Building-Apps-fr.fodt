         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">L&apos;arrière-plan de la référence et le style du texte</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table61.A2" office:value-type="string">
