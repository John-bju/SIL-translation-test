     <table:table-cell table:style-name="Table66.A1" office:value-type="string">
      <text:p text:style-name="P11" loext:marker-style-name="T17"><text:span text:style-name="T17">En-tête à inclure avant une ou plusieurs références pour une journée.</text:span><text:span text:style-name="T17"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P209" loext:marker-style-name="T17"><text:s/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T17"><text:span text:style-name="T17">If you need to translate a plan for different user interface languages, you can do this by adding the language code in square brackets after the standard format marker:</text:span><text:span text:style-name="T17"/></text:p>
   <text:p text:style-name="P209" loext:marker-style-name="T17"/>
   <text:p text:style-name="P17" loext:marker-style-name="T17"><draw:custom-shape text:anchor-type="as-char" draw:z-index="6" draw:name="Text Box 140" draw:style-name="gr7" draw:text-style-name="P521" svg:width="4.5004in" svg:height="2.4634in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107"><text:line-break/>\id</text:span><text:span text:style-name="T182"> PLAN1</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\t [en]</text:span><text:span text:style-name="T182"> Lire à travers les Évangiles</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\title [fr]</text:span><text:span text:style-name="T182"> Lire les évangiles</text:span></text:p>
     <text:p text:style-name="P38" loext:marker-style-name="T182"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\descr [en]</text:span><text:span text:style-name="T182"> Lire les évangiles de Matthieu et Marque, apprenant sur Jésus, ce qu&apos;il a fait, ce qu&apos;il a dit et pourquoi il est venu.</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T183"><text:span text:style-name="T109">\descr [fr]</text:span><text:span text:style-name="T183"> Lire les évangiles de Matthieu et de Marc, et apprendre à connaître Jésus, ce qu&apos;il a fait, ce qu&apos;il a dit et pourquoi il est venu.</text:span></text:p>
     <text:p text:style-name="P39" loext:marker-style-name="T183"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T182"><text:span text:style-name="T107">\day</text:span><text:span text:style-name="T108"> </text:span><text:span text:style-name="T182">1</text:span></text:p>
