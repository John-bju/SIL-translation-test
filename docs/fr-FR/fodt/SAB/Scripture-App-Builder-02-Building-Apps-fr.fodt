        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Formatage des numéros de liste à deux chiffres pour une liste de niveau 2?</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">div. li2-vv</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table121.1">
        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Formatage de la liste niveau 3 incluant l&apos;arrière-plan</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">div.li3</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table121.1">
        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Une ligne optionnelle de pied de page pour la liste</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table121.A2" office:value-type="string">
