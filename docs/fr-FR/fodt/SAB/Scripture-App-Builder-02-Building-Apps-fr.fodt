        <table:table-cell table:style-name="Table58.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">ui.bottom-navigation. Le texte a été sélectionné</text:span></text:p>
