   </text:table-of-content>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P43" text:outline-level="1"><text:bookmark-start text:name="_Toc452459025"/><text:bookmark-start text:name="_Toc233871024"/>Préparation du contenu pour votre application<text:bookmark-end text:name="_Toc452459025"/><text:bookmark-end text:name="_Toc233871024"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Avant de construire une application avec Scripture App Builder (SAB), vous devez obtenir votre contenu (texte, images et audio) dans des formats que SAB peut gérer.</text:span><text:span text:style-name="T39"/></text:p>
   <text:h text:style-name="P52" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_Preparing_text"/><text:bookmark-start text:name="_Toc233871025"/><text:span text:style-name="T39">Préparation du texte</text:span><text:bookmark-end text:name="_Toc233871025"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Le format de texte dont vous avez besoin dépend du type de contenu de l&apos;application que vous avez.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum20">
    <text:list-item>
     <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T52">Livres de la Bible</text:span><text:span text:style-name="T39">: </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">The Scripture text needs to be in one of the following formats:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum20">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P288" loext:marker-style-name="T143"><text:span text:style-name="T143">Fichiers Paratext (.usfm, .sfm, .ptx, etc.)</text:span><text:span text:style-name="T143"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T39">Fichiers USX (.usx)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T39">Bundles de sortie de texte de la bibliothèque biblique numérique (.zip)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P229" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum20">
    <text:list-item>
     <text:p text:style-name="P287" loext:marker-style-name="T52"><text:span text:style-name="T52">Livres de chansons avec accords :</text:span><text:span text:style-name="T52"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">These need to be in the .chordpro (or .cho) format</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum20">
    <text:list-item>
     <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T52">Other types of app content such as commentaries, picture story books, song books and Bible studies</text:span><text:span text:style-name="T39">: </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Le texte doit être dans l&apos;un des formats suivants :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum20">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P288" loext:marker-style-name="T39"><text:span text:style-name="T39">Documents Word (.docx)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T39">Fichiers texte SFM (.sfm)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P287" loext:marker-style-name="T39"><text:span text:style-name="T39">Fichiers HTML (.html)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P287" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Livres Bloom (.bloompub)</text:span><text:span text:style-name="T39"/></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <table:table table:name="Table4" table:style-name="Table4">
    <table:table-column table:style-name="Table4.A"/>
    <table:table-column table:style-name="Table4.B"/>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">For more information on how SAB stores your text files, see </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T89">How SAB stores your project data files</text:span></text:span></text:a><text:span text:style-name="T89">.</text:span></text:p>
      <text:p text:style-name="P293" loext:marker-style-name="T146"/>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Here are some more details about each of these formats:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871026"/>Fichiers Paratext pour livres bibliques<text:bookmark-end text:name="_Toc233871026"/></text:h>
   <text:p text:style-name="P298" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB peut importer du texte à partir de fichiers USFM Paratext (Unified Standard Format Marker). Ce sont les fichiers utilisés dans les projets Paratext – un par livre de la Bible. Voir l&apos;exemple ci-dessous:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P224" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" draw:z-index="273" draw:name="Text Box 164" draw:style-name="gr10" draw:text-style-name="P522" svg:width="3.563in" svg:height="2.2189in" svg:x="1.202in" svg:y="0.1681in">
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T151"><text:span text:style-name="markerplain"><text:span text:style-name="T151">\c</text:span></text:span><text:span text:style-name="T151"> 5<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\s</text:span></text:span><text:span text:style-name="T151">Kilɛ Kafila yɛrɛ lemu lʼa pye faaboboŋɔ ki ɲuŋɔ ni ge<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\p</text:span></text:span><text:span text:style-name="T151"><text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\v</text:span></text:span><text:span text:style-name="T151"> 1 Ayiwa, ba Yesu ya sipyiire ti ɲa wɛ, na dugi tiin faaboboŋɔ ki ɲuŋɔ ni. A wu wo kalaapiire tʼi fulo wu na.<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\v</text:span></text:span><text:span text:style-name="T151"> 2 A wu ɲɔ kɔn na pu kalaa na:<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\s</text:span></text:span><text:span text:style-name="T151">Piikɛ pʼi ɲɛ duba nagoo pu wɛ?<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\r</text:span></text:span><text:span text:style-name="T151">(Luka 6:20-23)<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\q1</text:span></text:span><text:span text:style-name="T151"><text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\v</text:span></text:span><text:span text:style-name="T151"> 3 «Piimu pʼa li cɛ na funmɔ fɛɛ pee ɲɛ<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\q2</text:span></text:span><text:span text:style-name="T151">Kilɛ shizhaa na ge,<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\q2</text:span></text:span><text:span text:style-name="T151">pee ɲɛ duba nagoo,<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\q1</text:span></text:span><text:span text:style-name="T151">bani pee wuuro ti ɲɛ<text:line-break/></text:span><text:span text:style-name="markerplain"><text:span text:style-name="T151">\q2</text:span></text:span><text:span text:style-name="T151">fugba saanra te.</text:span></text:p>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="P299" loext:marker-style-name="T39"><text:span text:style-name="T39">Dans les fichiers USFM, les chapitres, les en-têtes de section et les paragraphes sont marqués par des marqueurs de format standard tels que \c, \s et \p. Pour plus de détails, veuillez consulter </text:span><text:a xlink:type="simple" xlink:href="http://paratext.org/about/usfm" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">http://paratext.org/about/usfm</text:span></text:span></text:a><text:span text:style-name="T39">. </text:span></text:p>
   <text:p text:style-name="P231" loext:marker-style-name="T39"/>
   <text:p text:style-name="P299" loext:marker-style-name="T39"><text:span text:style-name="T39">For more information about how SAB and Paratext work together, see </text:span><text:a xlink:type="simple" xlink:href="#_Using_SAB_with" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Using SAB with Paratext files</text:span></text:a>. Vous pouvez ajouter des fichiers Paratext pendant l&apos;assistant de nouvelle application, ou plus tard en utilisant <text:span text:style-name="T55">Ajouter des livres…</text:span> dans la fenêtre de configuration d&apos;une collection de livres.</text:p>
   <text:p text:style-name="P231" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Il est recommandé d&apos;exécuter les vérifications de base de Paratext pour s&apos;assurer que le texte est aussi propre que possible pour la publication. Select </text:span><text:span text:style-name="T52">Checking</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T69"></text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Run Basic Checks…</text:span><text:span text:style-name="T39"> depuis le menu principal de Paratext.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vérifications critiques :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P300" loext:marker-style-name="T39"><text:span text:style-name="T52">Numéros de Chapitre/Verset</text:span><text:span text:style-name="T39">: Vérifie les numéros de chapitre ou de verset dupliqués ou non valides. Vérifie que tous les chapitres et versets définis dans la versification du projet sont présents.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P300" loext:marker-style-name="T39"><text:span text:style-name="T52">Marqueurs</text:span><text:span text:style-name="T39">: Vérifie que vous utilisez des marqueurs USFM valides et ils ne sont pas dans des endroits inattendus.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P300" loext:marker-style-name="T39"><text:span text:style-name="T52">Références</text:span><text:span text:style-name="T39">: vérifie que les Écritures font référence, par exemple « Mat 6:1-5 », suivent les abréviations et la syntaxe exactes. Sinon, ils ne fonctionneront pas en tant que liens dans l&apos;application.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:p text:style-name="P301" loext:marker-style-name="T39"><text:span text:style-name="T39">Vérifications importantes :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum19">
    <text:list-item>
     <text:p text:style-name="P300" loext:marker-style-name="T39"><text:span text:style-name="T52">Toutes les vérifications de base restantes :</text:span><text:span text:style-name="T39"> Caractères, Ponctuation, Capitalisation, Mots répétés et Paires de Ponctuation, Quotations, Nombres.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P300" loext:marker-style-name="T39"><text:span text:style-name="T52">orthographe</text:span><text:span text:style-name="T39">: dans Paratext, sélectionnez </text:span><text:span text:style-name="T52">Vérifier</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T69">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T52">Vérifier orthographe…</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P253" loext:marker-style-name="T43"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark text:name="_Other_SFM_text"/><text:bookmark-start text:name="_Toc233871027"/>Accords de guitare / piano en utilisant des fichiers au format ChordPro<text:bookmark-end text:name="_Toc233871027"/></text:h>
   <text:p text:style-name="Standard">Vous pouvez ajouter des fichiers au format .chordpro (ou .cho) pour afficher les paroles de la chanson avec les symboles d&apos;accords respectifs au-dessus de chaque ligne.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871028"/>Autres fichiers texte SFM<text:bookmark-end text:name="_Toc233871028"/> </text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB peut importer du texte à partir de fichiers SFM qui contiennent du contenu autre que des livres bibliques, tels que des commentaires, des études bibliques, des histoires ou des chansons. Comme les fichiers USFM de Paratext, les chapitres, les en-têtes de section et les paragraphes doivent être marqués par des marqueurs de format standard tels que \c, \page, \s et \p. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Le premier marqueur dans le fichier doit être de la forme </text:span><text:span text:style-name="T52">\id XYZ</text:span><text:span text:style-name="T39">, où XYZ est un code alphanumérique unique que vous choisissez (sans espaces ni tirets, mais vous pouvez avoir des tirets bas). </text:span><text:span text:style-name="T95">Ne choisissez pas un code déjà réservé pour un livre biblique, par exemple GEN, ou tout autre livre dans votre projet.</text:span></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Les fichiers du livre SFM doivent être </text:span><text:span text:style-name="T52">des fichiers texte brut</text:span><text:span text:style-name="T39">. Si vous avez des caractères Unicode, les fichiers texte doivent utiliser l&apos;encodage UTF-8. </text:span></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour créer un fichier texte SFM sous Windows, utiliser un éditeur de texte tel que Notepad (ce qui vous permet de définir l&apos;encodage à UTF-8 lorsque vous enregistrez).</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour créer un fichier texte sur un Mac, utilisez TextEdit, en se rappelant de choisir les fichiers texte bruts dans les préférences, sinon le type de fichier par défaut est RTF (qui contient beaucoup de codes de formatage supplémentaires).</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">For more details about how to define </text:span><text:a xlink:type="simple" xlink:href="#_Multiple_Translations" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">picture story books</text:span></text:span></text:a><text:span text:style-name="T39"> and </text:span><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">song books</text:span></text:span></text:a><text:span text:style-name="T39"> using SFM text files, please follow the links to see their respective sections.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark text:name="_Word_documents_(.docx)"/><text:bookmark-start text:name="_Toc233871029"/>Documents Word (.docx)<text:bookmark-end text:name="_Toc233871029"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">SAB peut importer du texte et des images de documents Microsoft Word (.docx).</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Lorsque les documents Word sont affichés dans l&apos;application, la mise en forme de base sera préservée comme les styles de caractères (gras, italique, souligné), listes numérotées, points de puce, hyperliens, notes de bas de page et tables simples. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour définir des chapitres ou des pages séparées, insérez des sauts de page à l&apos;aide de CTRL+Entrée.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P279" loext:marker-style-name="T102"><text:s/></text:p>
   <table:table table:name="Table5" table:style-name="Table5">
    <table:table-column table:style-name="Table5.A"/>
    <table:table-column table:style-name="Table5.B"/>
    <table:table-row table:style-name="Table5.1">
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Même si les documents Word peuvent sembler plus simples, ils ne fonctionnent mieux que pour des livres d&apos;histoires très simples. Si vous voulez plus de contrôle sur le formatage et les fonctionnalités du livre, utilisez le format SFM.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P276" loext:marker-style-name="T90"/>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">As a starting point, you can add a Word file to SAB, click on its </text:span><text:span text:style-name="T95">Book File</text:span><text:span text:style-name="T90"> tab and then the </text:span><text:span text:style-name="T95">Export as Text File</text:span><text:span text:style-name="T90"> button. Cela convertira votre doc Word au format de fichier SFM. Vous pouvez ensuite éditer ce fichier SFM, en ajoutant le bon chapitre, verset et autres marqueurs nécessaires. Enlevez ensuite le livre de Word et remplacez par celui de SFM.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">For more details about how to define picture story books and song books using Word documents, please see the sections on </text:span><text:a xlink:type="simple" xlink:href="#_Picture_Story_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Picture Story Books</text:span></text:span></text:a><text:span text:style-name="T39"> and </text:span><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Song Books</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871030"/>Bundles de libération de texte de la bibliothèque de la Bible numérique<text:bookmark-end text:name="_Toc233871030"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB peut importer du texte à partir de la Bibliothèque biblique numérique (DBL) paquets de publication de texte. Ce sont des fichiers zip contenant des fichiers USX pour chaque livre ainsi que d&apos;autres informations de configuration.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">For more information about the DBL, see: </text:span><text:a xlink:type="simple" xlink:href="https://www.thedigitalbiblelibrary.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">https://www.thedigitalbiblelibrary.org/</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T16"><text:span text:style-name="T39">You can find some DBL text release bundles available for free use on Biblica’s Open.Bible website: </text:span><text:a xlink:type="simple" xlink:href="https://open.bible/bibles/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">https://open.bible/bibles/</text:span></text:span></text:a><text:span text:style-name="T39"> <text:line-break/></text:span></text:p>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871031"/>Fichiers HTML (.html)<text:bookmark-end text:name="_Toc233871031"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB peut afficher des fichiers HTML et utiliser des feuilles de style (CSS) et des images. La synchronisation du texte audio n&apos;est pas encore prise en charge avec ce format.<text:line-break/></text:span><text:span text:style-name="T39"/></text:p>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark text:name="_Bloom_books_(.bloompub)"/><text:bookmark-start text:name="_Hlk16010275"/><text:bookmark-start text:name="_Toc233871032"/>Livres Bloom (.bloompub)<text:bookmark-end text:name="_Toc233871032"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:span text:style-name="T39">SAB peut afficher les livres Bloom en utilisant un Bloom Player intégré, tel qu&apos;utilisé dans l&apos;application Bloom Reader. Les livres doivent être au format .bloompub.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T39"><text:span text:style-name="T39">For more information about Bloom, please see: </text:span><text:a xlink:type="simple" xlink:href="https://bloomlibrary.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://bloomlibrary.org</text:span></text:a><text:bookmark-end text:name="_Hlk16010275"/><text:span text:style-name="T39"><text:line-break/></text:span></text:p>
   <text:h text:style-name="P52" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_Preparing_images"/><text:bookmark-start text:name="_Toc233871033"/><text:span text:style-name="T39">Préparation des images</text:span><text:bookmark-end text:name="_Toc233871033"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Les images sont importées automatiquement à partir de documents Word ou doivent être spécifiées séparément si vous utilisez le format SFM. Elles doivent être au format JPEG ou PNG. Certains éléments de l&apos;interface requièrent un format, une taille ou une forme particuliers, qui seront spécifiés dans le texte descriptif de cet écran dans SAB. Par exemple, l&apos;image du panneau de navigation doit être un fichier PNG avec un ratio de 16:9.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Gardez la taille de l&apos;image suffisamment petite pour que la taille de l&apos;application ne soit pas trop grande, mais qu&apos;elle s&apos;affiche bien sur un petit écran. Si vos photos sont dans un document Word, vous pouvez utiliser l&apos;outil </text:span><text:span text:style-name="T52">Compresser les images</text:span><text:span text:style-name="T39"> dans Word. Sinon, SAB vous permettra de redimensionner les images après les avoir ajoutées au projet d&apos;application.</text:span></text:p>
   <text:p text:style-name="P305" loext:marker-style-name="T52"/>
   <text:h text:style-name="P52" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871034"/><text:span text:style-name="T39">Préparation de l&apos;audio</text:span><text:bookmark-end text:name="_Toc233871034"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous voulez inclure des fichiers audio dans votre application, ceux-ci doivent être au format audio MP3, 3GP ou WebM (Ogg Opus). Normalement, ce devrait être un fichier audio par page ou chapitre. Vous pouvez également inclure des clips audio qui sont de courts fichiers audio qui sont joués lorsque l&apos;utilisateur tape sur un mot, une phrase ou une image. Si vous voulez inclure des fichiers de chronométrage pour que le texte et l&apos;audio soient synchronisés, l&apos;audio doit être un débit de bits constant (CBR).</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P298" loext:marker-style-name="T39"><text:a xlink:type="simple" xlink:href="#_Audio_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Allez ici pour plus d&apos;informations sur l&apos;inclusion de l&apos;audio</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P298" loext:marker-style-name="T39"><text:span text:style-name="T39">Gardez les fichiers audio à une taille où la qualité est suffisante pour un téléphone et où la taille du fichier n&apos;est pas trop grande. </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Allez ici pour plus d&apos;informations sur la compression des fichiers audio pour les réduire</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P311" loext:marker-style-name="T43"><text:span text:style-name="T43"/></text:p>
   <table:table table:name="Table6" table:style-name="Table6">
    <table:table-column table:style-name="Table6.A"/>
    <table:table-column table:style-name="Table6.B"/>
    <table:table-row table:style-name="Table6.1">
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T42"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Assurez-vous que les fichiers audio ont un nom clair et unique. SAB devra déterminer quel fichier audio associer avec quelle page ou chapitre, ainsi inclure clairement ce nombre dans le nom du fichier (i. . à la fin du nom) en utilisant un zéro supérieur.</text:span><text:span text:style-name="T90"/></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Par ex. </text:span><text:span text:style-name="T95">mon_book_page_01.mp3</text:span></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Audio from Faith comes By Hearing aura déjà des noms de fichiers uniques, il n&apos;est donc pas recommandé de les modifier.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P232" loext:marker-style-name="T39"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark text:name="_How_to_build"/><text:bookmark-start text:name="_Toc233871035"/>Comment construire votre première application<text:bookmark-end text:name="_Toc233871035"/></text:h>
   <text:p text:style-name="P265" loext:marker-style-name="T39"><text:span text:style-name="T39">To build your first app with Scripture App Builder, you should use the </text:span><text:span text:style-name="T52">New App</text:span><text:span text:style-name="T39"> wizard. </text:span></text:p>
   <text:p text:style-name="P233" loext:marker-style-name="T39"/>
   <table:table table:name="Table7" table:style-name="Table7">
    <table:table-column table:style-name="Table7.A"/>
    <table:table-column table:style-name="Table7.B"/>
    <table:table-row table:style-name="Table7.1">
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">L&apos;assistant vous proposera de nombreux choix dans la configuration de votre application. Si vous ne savez pas encore exactement ce dont vous avez besoin, choisissez l&apos;option par défaut pour le moment. Tous les éléments de l&apos;application peuvent être ajoutés ou modifiés plus tard dans SAB, avant de publier l&apos;application. Chaque page de l&apos;assistant aura un texte explicatif pour vous aider à choisir des options.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P233" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">Lancez </text:span><text:span text:style-name="T52">Scripture App Builder</text:span><text:span text:style-name="T39"> à partir de son icône sur le bureau.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P234" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Nouvelle application</text:span><text:span text:style-name="T39"> sur la barre d&apos;outils. L&apos;assistant de nouvelle application va apparaître.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <table:table table:name="Table8" table:style-name="Table8">
    <table:table-column table:style-name="Table8.A"/>
    <table:table-column table:style-name="Table8.B"/>
    <table:table-row table:style-name="Table8.1">
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If this is your very first app, or you have no projects opened in SAB, the </text:span><text:span text:style-name="T95">New App</text:span><text:span text:style-name="T90"> button will show in the middle of screen.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the first page of the wizard, specify the </text:span><text:span text:style-name="T52">App Name</text:span><text:span text:style-name="T39">, such as “Dogon Bible”, “Livre de Luc”, “Supyiré NT”, etc. Ceci est le titre principal de votre application et apparaîtra sous l&apos;icône de l&apos;application sur le téléphone de l&apos;utilisateur. N&apos;incluez pas de tirets bas ou des abréviations difficiles à comprendre et essayez de garder la longueur inférieure à 20 caractères. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_App_Name" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Name &amp; Package</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T73"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> App Name</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">Sur la deuxième page de l&apos;assistant, spécifiez le </text:span><text:span text:style-name="T52">Nom du paquet</text:span><text:span text:style-name="T39">--une chaîne séparée par des points qui identifie de manière unique votre application. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Package" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Package</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P313" loext:marker-style-name="T39"><text:span text:style-name="T39">Plus de détails sur le choix d&apos;un bon nom de package peuvent être trouvés dans la section</text:span><text:span text:style-name="T90"> </text:span><text:a xlink:type="simple" xlink:href="#_How_should_I" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Comment choisir le nom du package ?</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P234" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the </text:span><text:span text:style-name="T52">Book Type</text:span><text:span text:style-name="T39"> page, you have several choices for the file source from which to select. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:p text:style-name="P184" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 37" text:anchor-type="as-char" svg:width="5.5102in" svg:height="4.0134in" draw:z-index="0"><draw:image xlink:href="SAB02/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P306" loext:marker-style-name="T53"/>
   <text:p text:style-name="P12" loext:marker-style-name="T145"><text:span text:style-name="T145">Fichiers texte, documents Word, bibliothèque biblique numérique ou Bloom</text:span><text:span text:style-name="T145"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T143"><text:span text:style-name="T143">Choisissez si vous souhaitez des données de livres provenant de Bloom, Word, de la bibliothèque biblique numérique, de fichiers ChordPro ou d&apos;autres fichiers texte. Sélectionnez un ou plusieurs fichiers et cliquez sur </text:span><text:span text:style-name="T145">Suivant</text:span><text:span text:style-name="T143"> lorsque vous avez terminé.</text:span></text:p>
   <text:p text:style-name="P314" loext:marker-style-name="T145"/>
   <text:p text:style-name="P12" loext:marker-style-name="T145"><text:span text:style-name="T145">Livres de votre projet Paratext</text:span><text:span text:style-name="T145"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T143"><text:span text:style-name="T143">Si vous choisissez cette option, SAB affichera une liste des projets qu&apos;il trouve dans votre dossier </text:span><text:span text:style-name="T145">Mes projets Paratext 9</text:span><text:span text:style-name="T143">. Vous pouvez effectuer une recherche par projet ou par nom de langue, ou simplement sélectionner l&apos;un des projets dans la liste. Cliquez sur </text:span><text:span text:style-name="T145">Suivant</text:span><text:span text:style-name="T143"> pour afficher une liste des livres du projet et des informations utiles sur leur statut, y compris le pourcentage de versets répertoriés dans chaque livre. Double-cliquez sur un livre pour voir encore plus de détails. Sélectionnez les livres que vous souhaitez ajouter et cliquez sur </text:span><text:span text:style-name="T145">Suivant</text:span><text:span text:style-name="T143">.</text:span></text:p>
   <text:p text:style-name="P314" loext:marker-style-name="T145"><text:soft-page-break/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T145"><text:span text:style-name="T145">Livres audio uniquement (sans texte)</text:span><text:span text:style-name="T145"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T143"><text:span text:style-name="T143">Si vous choisissez l&apos;audio uniquement, l&apos;assistant présentera plusieurs écrans vous demandant quels fichiers audio vous souhaitez ajouter et quelle image vous souhaitez afficher pendant la lecture audio. Cliquez sur </text:span><text:span text:style-name="T145">Suivant</text:span><text:span text:style-name="T143"> lorsque vous avez terminé.</text:span></text:p>
   <text:p text:style-name="P314" loext:marker-style-name="T145"/>
   <text:p text:style-name="P12" loext:marker-style-name="T145"><text:span text:style-name="T145">Livres de la plateforme YouVersion</text:span><text:span text:style-name="T145"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T143"><text:span text:style-name="T143">Si vous choisissez la plateforme YouVersion, l&apos;assistant vous demandera de sélectionner une langue, des livres possibles et vous demandera de renseigner une clé API YouVersion (les détails sont expliqués sur cet écran).</text:span><text:span text:style-name="T143"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T143"><text:span text:style-name="T143">Cliquez sur </text:span><text:span text:style-name="T145">Suivant</text:span><text:span text:style-name="T143"> pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P315" loext:marker-style-name="T143"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">If you choose to add books with text, the next page of the wizard is titled </text:span><text:span text:style-name="T52">Books.</text:span><text:span text:style-name="T39"> Cliquez </text:span><text:span text:style-name="T52">Ajouter des livres… </text:span><text:span text:style-name="T39">et sélectionnez les livres que vous voulez voir dans l&apos;application. Il peut s&apos;agir de fichiers USFM (Paratext), de fichiers USX, de packs de textes de la bibliothèque biblique numérique, Fichiers ChordPro, documents Word (docx) ou un fichier compressé de fichiers USFM ou USX. (You can add more books later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_Collection" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">&lt;Collection Name&gt; </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Book Collection </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Add Books</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">If you have selected Scripture books, the next page will be titled </text:span><text:span text:style-name="T52">Book Order</text:span><text:span text:style-name="T39">. Choisissez l&apos;ordre du livre en fonction de la tradition ecclésiale des utilisateurs cibles. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_Order" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">&lt;Collection Name&gt; </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Book Order</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P225" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T39"><text:span text:style-name="T39">If the book names are in all-caps, the next page of the wizard is titled </text:span><text:span text:style-name="T52">Book Names </text:span><text:span text:style-name="T39">and will allow you to change them to mixed case if desired. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P93" loext:marker-style-name="T39"><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Language</text:span><text:span text:style-name="T39">, specify the language code and name of the main language used in the app. Cliquez sur </text:span><text:span text:style-name="T53">Sélectionnez…</text:span><text:span text:style-name="T39"> pour choisir le code de langue dans une liste de langues. Si nécessaire, cochez la case pour spécifier des informations d&apos;identification supplémentaires, telles que le script, la région et la variante. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Language_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">&lt;Collection Name&gt; </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Language</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the </text:span><text:span text:style-name="T52">Copyright </text:span><text:span text:style-name="T53">and</text:span><text:span text:style-name="T52"> Licensing</text:span><text:span text:style-name="T39"> page, specify the copyright and licensing information that you would like to appear on the About box in the app. Ceci inclut le détenteur des droits d&apos;auteur pour le texte. Utilisez l&apos;assistant </text:span><text:span text:style-name="T53">Copyright Helper</text:span><text:span text:style-name="T39"> pour vous aider.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P17" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous ne savez pas quoi mettre ici, veuillez demander conseil au service de l&apos;édition de votre organisation. Ils voudront vous assurer que vous avez bien compris et ne pas vous contenter de deviner ce qu&apos;il faut inclure. (You may add this information at a later time if you do not have it available right now under </text:span><text:a xlink:type="simple" xlink:href="#_The_Copyright_&amp;" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">&lt;Collection Name&gt; </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Copyright &amp; Licensing</text:span></text:span></text:a><text:span text:style-name="T39">. Voir aussi comment inclure des informations sur les droits d&apos;auteur dans la section </text:span><text:a xlink:type="simple" xlink:href="#_About_Page" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">À propos de la page</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">You can select one or more </text:span><text:span text:style-name="T52">Additional Bible Versions</text:span><text:span text:style-name="T39"> to add to your app, available to the user in the Language and Layout screen. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to move to the next page.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Font</text:span><text:span text:style-name="T39">, choose the font. Vous pouvez soit sélectionner dans la liste de polices ou spécifier un fichier de police TrueType différent. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Main_Font" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Main Font</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P322" loext:marker-style-name="T16"><text:span text:style-name="T16"/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">If this next page is titled </text:span><text:span text:style-name="T53">Choice of Fonts</text:span><text:span text:style-name="T39">, choose some more fonts to add to the app. L&apos;utilisateur de l&apos;application sera en mesure de changer la police par défaut pour l&apos;une de ces polices dans le sélecteur de police et dans l&apos;éditeur de verset dans l&apos;éditeur d&apos;image. (You can modify these settings later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Files" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Font Files</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:bookmark-start text:name="_Hlk66431126"/><text:span text:style-name="T39">Sur la page de l&apos;assistant intitulée </text:span><text:span text:style-name="T52">Gestion des polices</text:span><text:span text:style-name="T39">, vous pouvez sélectionner GeckoView si vous savez que les composants standard Android auront des difficultés à afficher correctement le texte (e. , si c&apos;est un script complexe). (You can modify this setting later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Handling" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Font Handling</text:span></text:span></text:a><text:span text:style-name="T39">.) Plus d&apos;informations sur GeckoView peuvent être trouvées dans la section </text:span><text:a xlink:type="simple" xlink:href="#_Fonts_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Fontes</text:span></text:span></text:a><text:span text:style-name="T39"> de ce document.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P199" loext:marker-style-name="T16"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span><text:bookmark-end text:name="_Hlk66431126"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Color Scheme</text:span><text:span text:style-name="T39">, choose the color scheme for the app. La couleur que vous choisissez est celle qui sera utilisée pour la barre d&apos;application principale. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Color_Scheme" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Colors </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Color Scheme</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Les couleurs individuelles pour le texte, les titres, les liens, les arrière-plans, etc. peuvent être personnalisées plus tard.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312">On the page of the wizard titled <text:span text:style-name="T51">Default Interface Language</text:span>, choose the language you want users to see when they first enter the app (the language for the app menus). Ceci peut être la langue actuelle du système, mais vous pouvez spécifier une langue par défaut juste dans le cas - peut-être une langue <text:span text:style-name="T89">de communication plus large</text:span>. <text:span text:style-name="T39">(You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Languages_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Interface </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Languages</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P19"/>
   <text:p text:style-name="P12">Cliquer sur <text:span text:style-name="T51">A Suivant</text:span> pour passer à la page suivante.</text:p>
   <text:p text:style-name="P12"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312">Sur la page de l&apos;assistant intitulé <text:span text:style-name="T51">Langues d&apos;interface</text:span>, choisissez les langues de l&apos;interface dans lesquelles l&apos;utilisateur peut choisir dans les paramètres de l&apos;application. <text:span text:style-name="T39">(You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Interface" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Interface</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P12">Cliquer sur <text:span text:style-name="T51">A Suivant</text:span> pour passer à la page suivante.</text:p>
   <text:p text:style-name="P12"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Features</text:span><text:span text:style-name="T39">, choose the features you want to enable in the app.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">You can modify the details for the Verse of the Day (and the Daily Reminder)</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T39">later under </text:span><text:a xlink:type="simple" xlink:href="#_Notifications" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Engagement</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Notifications</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12"><text:span text:style-name="T39">You can modify the details for saving as a video</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T39">later under </text:span><text:a xlink:type="simple" xlink:href="#_Verse_on_Image_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Engagement</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Verse on Image</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table9" table:style-name="Table9">
    <table:table-column table:style-name="Table9.A"/>
    <table:table-column table:style-name="Table9.B"/>
    <table:table-row table:style-name="Table9.1">
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table9.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Si vous avez des versions audio des livres dans votre application, vous avez la possibilité de permettre aux utilisateurs de partager des versets audio avec d&apos;autres. Ils peuvent également partager une vidéo qui combine le texte et l&apos;audio ensemble. Voir </text:span><text:a xlink:type="simple" xlink:href="#_Configuring_Verse_on" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">Configurer le verset sur l&apos;image dans le constructeur d&apos;applications</text:span></text:span></text:a><text:span text:style-name="T90"> pour plus de détails. </text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P83" loext:marker-style-name="T39"><text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Icon</text:span><text:span text:style-name="T39">, choose the application launcher icon. Vous pouvez sélectionner une des images dans le tableau ou si vous avez vos propres fichiers image PNG pour l&apos;icône, cliquez sur </text:span><text:span text:style-name="T52">Parcourir</text:span><text:span text:style-name="T39"> et sélectionnez-les. (You can see more options for creating an icon and/or modifying the icon later under </text:span><text:a xlink:type="simple" xlink:href="#_Icons" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Icons</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P323" loext:marker-style-name="T39"><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T39">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list xml:id="list164752346822369" text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Signing</text:span><text:span text:style-name="T39">, you need to specify the keystore and alias to use to sign the app. Un magasin de clés est un fichier de certificat numérique qui garantit que l&apos;application est légitime. Une application doit être signée de cette manière afin qu&apos;elle puisse être installée sur un téléphone.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:bookmark-start text:name="_Hlk66431771"/><text:span text:style-name="T39">If you already have created a keystore for another app, see </text:span><text:a xlink:type="simple" xlink:href="#_Do_I_have" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">reusing a keytore</text:span></text:span></text:a><text:span text:style-name="T39">. Si vous n&apos;avez pas encore de fichier de stockage de clés (ce que vous n&apos;aurez probablement pas si c&apos;est la première fois que vous utilisez le programme), o les suivants :</text:span></text:p>
   <text:list text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P325" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Créer un KeyStore</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P235" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P324" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Entrez un nouveau nom de fichier pour le keystore, tel que « keystore1 ». Spécifiez un mot de passe. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P324" loext:marker-style-name="T39"><text:span text:style-name="T39">Entrez un nom d&apos;alias pour une clé à créer dans votre nouveau magasin de clés, comme la clé par défaut « key1». Spécifiez un mot de passe, qui peut être le même que le mot de passe que vous avez entré sur la page précédente. </text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-column table:style-name="Table10.B"/>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Il est très important de stocker le mot de passe de façon sécurisée pour votre magasin de clés. Une fois l&apos;application publiée, elle ne peut pas être mise à jour sans le mot de passe du magasin de clés. Assurez-vous que quelqu&apos;un d&apos;autre de votre organisation a accès aux mots de passe du magasin de clés de l&apos;application.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="P326" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez </text:span><text:span text:style-name="T39">pour continuer.</text:span></text:p>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P324" loext:marker-style-name="T39"><text:span text:style-name="T39">On the </text:span><text:span text:style-name="T53">Certificate Issuer</text:span><text:span text:style-name="T39"> page, provide details of your organisation in at least one of the fields. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P324" loext:marker-style-name="T39"><text:span text:style-name="T39">Un nouveau magasin de clés sera créé pour vous. Cliquez sur </text:span><text:span text:style-name="T52">Fermez</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"><text:bookmark-end text:name="_Hlk66431771"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-list="list164752346822369" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P312" loext:marker-style-name="T39"><text:span text:style-name="T39">Back on the </text:span><text:span text:style-name="T52">Signing</text:span><text:span text:style-name="T39"> page of the New App wizard, you need to specify the keystore password, select the key alias and enter the alias password--just as you entered them in the step above. (You can modify your keystore settings later under </text:span><text:a xlink:type="simple" xlink:href="#_App_Signing" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">App Signing</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P234" loext:marker-style-name="T39"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez </text:span><text:span text:style-name="T39">pour continuer.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P92" loext:marker-style-name="T39"><text:span text:style-name="T39">On the page of the wizard titled </text:span><text:span text:style-name="T52">Project</text:span><text:span text:style-name="T39">, you can enter or modify the project name and add an optional description of the app project. Aucun de ces éléments ne sera visible par l&apos;utilisateur de votre application. Ils sont juste pour votre propre utilisation et peuvent vous aider à distinguer entre plusieurs projets d&apos;applications. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Project" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Project</text:span></text:span></text:a><text:span text:style-name="T39">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P327" loext:marker-style-name="T39"><text:span text:style-name="T39"/></text:p>
   <table:table table:name="Table11" table:style-name="Table11">
    <table:table-column table:style-name="Table11.A"/>
    <table:table-column table:style-name="Table11.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table11.1">
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">SAB créera un dossier de projet en utilisant le titre de votre projet. Il est recommandé de ne pas inclure de caractères spéciaux dans le nom du projet car ils peuvent ne pas être compatibles avec les règles de noms de dossiers.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez sur </text:span><text:span text:style-name="T52">Terminez</text:span><text:span text:style-name="T39"> pour continuer. L&apos;assistant de nouvelle application se fermera et la définition du projet d&apos;application sera ajoutée à l&apos;arborescence à gauche de l&apos;écran.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Jetez un coup d&apos;œil à chacune des pages de configuration de l&apos;application en les sélectionnant dans l&apos;arborescence à gauche. Regardez dans chacun des onglets de chaque page pour vérifier que vous avez les paramètres que vous voulez. Vous pouvez toujours y revenir plus tard pour les modifier si vous trouvez que vous devez apporter des modifications aux polices, couleurs, styles, etc.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">When you have finished configuring the app, </text:span><text:bookmark-start text:name="_Hlk66431800"/><text:span text:style-name="T39">click the </text:span><text:span text:style-name="T52">Build Android App </text:span><text:span text:style-name="T40">button on the toolbar at the top of the screen</text:span><text:span text:style-name="T39">.</text:span><text:bookmark-end text:name="_Hlk66431800"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Si quelque chose n&apos;est pas configuré correctement pour que la compilation fonctionne, vous serez notifié. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <table:table table:name="Table12" table:style-name="Table12">
    <table:table-column table:style-name="Table12.A"/>
    <table:table-column table:style-name="Table12.B"/>
    <table:table-row table:style-name="Table12.1">
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If you need to see the error information at a later time (e.g. to send to one of the support staff for help), you can find it on the menu bar under </text:span><text:a xlink:type="simple" xlink:href="#_View_Logs…" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T95">Tools</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T76"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T95">View Logs… </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T76"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T95">Error Log</text:span></text:span></text:a><text:span text:style-name="T90">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:span text:style-name="T39">Une fenêtre de compilation apparaîtra. Attendez pendant la compilation de l&apos;application. Cela peut prendre plusieurs minutes ou plus.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P17" loext:marker-style-name="T39"><text:span text:style-name="T39">La première fois que le processus de compilation est lancé, le compilateur doit se connecter à Internet pour télécharger des fichiers. Après cela, les versions ultérieures des applications ne nécessiteront pas l&apos;accès à Internet. See the menu </text:span><text:a xlink:type="simple" xlink:href="#_The_Build_Settings" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Tools</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T78"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T16"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Settings…</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Paramètres de compilation</text:span></text:span></text:a><text:span text:style-name="T39"> pour activer le mode hors ligne après la première compilation de l&apos;application.</text:span></text:p>
   <text:p text:style-name="P234" loext:marker-style-name="T39"/>
   <text:p text:style-name="P12" loext:marker-style-name="T39"><text:bookmark-start text:name="_Hlk66431096"/><text:span text:style-name="T39">Si le build réussit, vous aurez un nouveau fichier APK - le fichier d&apos;installation pour une application Android.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <table:table table:name="Table13" table:style-name="Table13">
    <table:table-column table:style-name="Table13.A"/>
    <table:table-column table:style-name="Table13.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table13.1">
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">To understand more about where SAB stores files like your APK file, see </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T90">How SAB stores your project data files</text:span></text:span></text:a><text:span text:style-name="T90">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P230" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">La section suivante décrit comment copier ce fichier APK sur votre téléphone et lancer l&apos;application.</text:span><text:bookmark-end text:name="_Hlk66431096"/><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark text:name="_Installing_the_app"/><text:bookmark-start text:name="_Hlk66431018"/><text:bookmark-start text:name="_Toc233871036"/>Installation de l&apos;application sur votre téléphone<text:bookmark-end text:name="_Toc233871036"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Dans la section ci-dessus, vous avez vu comment compiler une application Android. Le résultat est un fichier APK, le fichier d&apos;installation d&apos;une application Android. Vous devez maintenant copier ce fichier APK sur votre téléphone, l&apos;installer et lancer l&apos;application. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table14" table:style-name="Table14">
    <table:table-column table:style-name="Table14.A"/>
    <table:table-column table:style-name="Table14.B"/>
    <table:table-row table:style-name="Table14.1">
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Parce que vous installez votre APK directement (un processus appelé side-loading) au lieu de via le Play Store, votre téléphone peut vous avertir du fait qu&apos;il s&apos;agit d&apos;un fichier suspect et qu&apos;il nécessite une étape supplémentaire pour permettre l&apos;installation et/ou l&apos;analyse de virus. C&apos;est normal, mais si vous partagez votre APK de cette façon, vous voudrez préparer les utilisateurs à rencontrer ces vérifications.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">There are several ways to do this:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Copiez l&apos;APK via le transfert WIFI</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Utilisez une application de transfert WIFI (Xender, WhatsApp) sur votre téléphone et votre ordinateur. Ouvrez le dossier de sortie </text:span><text:span text:style-name="T39">, sélectionnez votre APK et copiez-le ou envoyez-le sur votre téléphone. Localisez le fichier APK et appuyez dessus pour l&apos;installer.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P10" loext:marker-style-name="T52"><text:span text:style-name="T52">Copier l&apos;APK directement</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous avez un câble de données USB, connectez votre téléphone à votre ordinateur pour qu&apos;il apparaisse comme un périphérique (comme un disque dur externe ou une clé USB). Ouvrez le dossier de sortie </text:span><text:span text:style-name="T39">, sélectionnez votre APK et copiez-le dans un dossier facilement trouvé (e. . Téléchargements) sur votre téléphone. Ensuite, sur le téléphone, trouvez l&apos;APK et appuyez pour l&apos;installer.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Installez automatiquement l&apos;APK à partir de SAB</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">C&apos;est un moyen très pratique de tester votre APK et de l&apos;installer. Utilisez les étapes suivantes :</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum57">
    <text:list-item>
     <text:p text:style-name="P94" loext:marker-style-name="T39"><text:span text:style-name="T39">Connectez votre téléphone Android à votre ordinateur à l&apos;aide d&apos;un câble de données </text:span><text:span text:style-name="T39">. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T39"><text:span text:style-name="T39">(Sometimes you get cheap USB cables that can only charge a phone but cannot transfer data, so make sure you have the right kind of cable.)</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <table:table table:name="Table15" table:style-name="Table15">
    <table:table-column table:style-name="Table15.A"/>
    <table:table-column table:style-name="Table15.B"/>
    <table:table-row table:style-name="Table15.1">
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">Lorsque vous connectez votre téléphone à votre ordinateur, si votre téléphone apparaît comme une icône sous « Ce PC », vous avez un câble de données.</text:span><text:span text:style-name="T90"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P84" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum57">
    <text:list-item>
     <text:p text:style-name="P94" loext:marker-style-name="T39"><text:span text:style-name="T39">Assurez-vous que les options </text:span><text:span text:style-name="T53">Développeur </text:span><text:span text:style-name="T78">&lt;unk&gt;</text:span><text:span text:style-name="T16"> </text:span><text:span text:style-name="T24">USB Debogging</text:span><text:span text:style-name="T39"> est activé sur votre téléphone. Par défaut, sur les nouveaux téléphones, les options développeur sont désactivées. Voici comment vous pouvez l&apos;activer :</text:span></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Open the </text:span><text:span text:style-name="T53">Settings </text:span><text:span text:style-name="T39">menu of your phone.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Faites défiler vers le bas du menu et appuyez sur </text:span><text:span text:style-name="T53">À propos du téléphone</text:span><text:span text:style-name="T39">.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Find the </text:span><text:span text:style-name="T53">Build Number</text:span><text:span text:style-name="T39">. Cela pourrait se trouver sur la page À propos du téléphone ou dans un sous-menu tel que « Informations sur le logiciel ».</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P85" loext:marker-style-name="T39"/>
   <table:table table:name="Table16" table:style-name="Table16">
    <table:table-column table:style-name="Table16.A"/>
    <table:table-column table:style-name="Table16.B"/>
    <table:table-row table:style-name="Table16.1">
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T90"><text:span text:style-name="T90">If you have trouble finding the Build Number, search for “</text:span><text:span text:style-name="T95">Build Number</text:span><text:span text:style-name="T90">” in the settings Search bar.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P85" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum57">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P95" loext:marker-style-name="T39"><text:span text:style-name="T39">Tap on the Build Number </text:span><text:span text:style-name="T53">seven times</text:span><text:span text:style-name="T39">. Comme vous le faites, vous verrez apparaître une série de messages : « Vous êtes maintenant à 3 étapes de votre développement », « Vous êtes maintenant à 2 étapes de votre développement », « Vous êtes maintenant à 1 étape de votre développement », « Vous êtes maintenant un développeur !</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P4" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" draw:z-index="274" draw:name="AutoShape 160" draw:style-name="gr6" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.39583333333333in 2.87222222222222in)">
