        </office:binary-data>
       </draw:image>
      </draw:frame><text:span text:style-name="T37"> à droite de l&apos;en-tête </text:span><text:span text:style-name="T47">Identificateurs</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:soft-page-break/><text:span text:style-name="T37">Sélectionnez </text:span><text:span text:style-name="T47">App IDs</text:span><text:span text:style-name="T37"> et cliquez sur le bouton </text:span><text:span text:style-name="T47">Continuer</text:span><text:span text:style-name="T37"> .</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:span text:style-name="T37">Sélectionnez </text:span><text:span text:style-name="T47">App</text:span><text:span text:style-name="T37"> et horloge le </text:span><text:span text:style-name="T47">Continuer</text:span><text:span text:style-name="T37"> bouton</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:bookmark-start text:name="OLE_LINK22"/><text:bookmark-start text:name="OLE_LINK21"/><text:bookmark-start text:name="OLE_LINK20"/><text:bookmark-start text:name="OLE_LINK23"/><text:span text:style-name="T37">Entrez une</text:span><text:span text:style-name="T47"> Description</text:span><text:span text:style-name="T37"> de votre choix.<text:line-break/>Cela peut être le </text:span><text:span text:style-name="T47">App Name</text:span><text:span text:style-name="T37"> depuis </text:span><text:span text:style-name="T47">App</text:span><text:span text:style-name="T37"> </text:span><text:span text:style-name="T42">&lt;unk&gt;</text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T47">Package</text:span><text:span text:style-name="T37"> page de Dictionary App Builder.</text:span><text:bookmark-end text:name="OLE_LINK22"/><text:bookmark-end text:name="OLE_LINK23"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:bookmark-start text:name="OLE_LINK24"/><text:bookmark-start text:name="OLE_LINK25"/><text:span text:style-name="T37">For Bundle ID, choose </text:span><text:span text:style-name="T47">Explicit </text:span><text:span text:style-name="T37">and enter your app package name from the </text:span><text:span text:style-name="T47">App</text:span><text:span text:style-name="T37"> </text:span><text:bookmark-start text:name="OLE_LINK19"/><text:bookmark-start text:name="OLE_LINK18"/><text:span text:style-name="T42"></text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T47">Package</text:span><text:span text:style-name="T37"> page of Dictionary App Builder.</text:span><text:bookmark-end text:name="OLE_LINK24"/><text:bookmark-end text:name="OLE_LINK25"/><text:bookmark-end text:name="OLE_LINK19"/><text:bookmark-end text:name="OLE_LINK18"/><text:bookmark-end text:name="OLE_LINK21"/><text:bookmark-end text:name="OLE_LINK20"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:span text:style-name="T37">Ne pas cocher tous les services de l&apos;application. Aucun n&apos;est nécessaire dans l&apos;application. </text:span><text:span text:style-name="T37"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T37"><text:span text:style-name="T37">Cliquez sur le bouton </text:span><text:span text:style-name="T47">Continuer</text:span><text:span text:style-name="T37"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P67" loext:marker-style-name="T37"/>
   <text:p text:style-name="P109" loext:marker-style-name="T37"><text:span text:style-name="T37">To register a </text:span><text:span text:style-name="T62">device</text:span><text:span text:style-name="T37"> (i.e. a specific iPhone or iPad for testing):</text:span></text:p>
   <text:list text:style-name="WWNum17">
    <text:list-item>
     <text:p text:style-name="P110" loext:marker-style-name="T37"><text:span text:style-name="T37">Sélectionnez </text:span><text:span text:style-name="T47">Périphériques</text:span><text:span text:style-name="T37"> à gauche de la page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P110" loext:marker-style-name="T37"><text:span text:style-name="T37">Cliquez sur le bouton</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 30" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
