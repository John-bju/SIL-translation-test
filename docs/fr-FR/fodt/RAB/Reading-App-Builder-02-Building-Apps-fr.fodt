   <text:p text:style-name="P95" loext:marker-style-name="T36"><text:span text:style-name="T36">Lorsque vous faites cela, vous recevrez probablement un message « Autoriser le débogage USB ? » Appuyez sur </text:span><text:span text:style-name="T48">OK</text:span><text:span text:style-name="T36">.</text:span></text:p>
   <text:p text:style-name="P93" loext:marker-style-name="T36"><draw:custom-shape text:anchor-type="char" draw:z-index="194" draw:name="AutoShape 160" draw:style-name="gr1" draw:text-style-name="P417" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.61180555555556in 2.15902777777778in)">
