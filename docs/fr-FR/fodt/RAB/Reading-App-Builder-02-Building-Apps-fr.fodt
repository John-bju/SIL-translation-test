        </table:table-cell>
        <table:table-cell table:style-name="Table3.B2" office:value-type="string">
         <text:p text:style-name="P9" loext:marker-style-name="T36"><text:span text:style-name="T36">tiroir ui.ui</text:span></text:p>
        </table:table-cell>
       </table:table-row>
