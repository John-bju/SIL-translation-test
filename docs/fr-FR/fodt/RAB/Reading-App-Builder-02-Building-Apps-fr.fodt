     <table:table-cell table:style-name="Table78.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T36">A</text:span><text:span text:style-name="T15">s que vous appliquez les styles, la touche F4 peut être utile pour répéter votre action précédente.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P196" loext:marker-style-name="T36"><text:s/></text:p>
   <text:p text:style-name="P269" loext:marker-style-name="T36"><text:span text:style-name="T36">Toutes les chansons sont contenues dans un seul document Word.</text:span><text:span text:style-name="T36"/></text:p>
   <text:list text:continue-list="list164807832846445" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P386" loext:marker-style-name="T15"><text:span text:style-name="T15">Enregistrer le document au format </text:span><text:span text:style-name="T21">.docx</text:span><text:span text:style-name="T15"> .</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P157" loext:marker-style-name="T15"><text:soft-page-break/></text:p>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:h text:style-name="P61" text:outline-level="2" loext:marker-style-name="T36"><text:bookmark text:name="_What_do_song_1"/><text:bookmark-start text:name="_Toc233660249"/><text:span text:style-name="T36">À quoi ressemblent les livres de chansons au format SFM ?</text:span><text:bookmark-end text:name="_Toc233660249"/><text:bookmark text:name="Section_Song_Books_SFM"/><text:span text:style-name="T36"/></text:h>
   <text:p text:style-name="P8" loext:marker-style-name="T15"><text:span text:style-name="T15">Commencez avec un identifiant de votre choix (en utilisant seulement </text:span><text:span text:style-name="T21">caractères alphanumériques ou des traits de soulignement</text:span><text:span text:style-name="T15">) :</text:span></text:p>
   <text:p text:style-name="P165" loext:marker-style-name="T15"/>
   <text:p text:style-name="P271" loext:marker-style-name="T147"><text:span text:style-name="T147">\id SONGBOOK1<text:line-break/></text:span><text:span text:style-name="T147"/></text:p>
   <text:p text:style-name="P8" loext:marker-style-name="T15"><text:span text:style-name="T15">et un titre :<text:line-break/></text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P269" loext:marker-style-name="T147"><text:span text:style-name="T147">\toc2 Notre livre de chansons</text:span><text:span text:style-name="T147"/></text:p>
   <text:p text:style-name="P282" loext:marker-style-name="T146"/>
   <text:p text:style-name="P8" loext:marker-style-name="T15"><text:span text:style-name="T15">Each song begins with the </text:span><text:span text:style-name="T22">\c</text:span><text:span text:style-name="T15"> marker and the number of the song:</text:span></text:p>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="P269" loext:marker-style-name="T146"><text:span text:style-name="T147">\c 1</text:span><text:span text:style-name="T147"/></text:p>
   <text:p text:style-name="P182" loext:marker-style-name="T36"/>
   <text:p text:style-name="P182" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T37">Le marqueur </text:span><text:span text:style-name="T47">\q</text:span><text:span text:style-name="T37"> (ou </text:span><text:span text:style-name="T47">\q1</text:span><text:span text:style-name="T37">)</text:span><text:span text:style-name="T47"> </text:span><text:span text:style-name="T36">est utilisé pour la ligne des paroles de la chanson et </text:span><text:span text:style-name="T47">\q2</text:span><text:span text:style-name="T36"> pour les lignes en retrait, comme pour un choeur. </text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Utiliser </text:span><text:span text:style-name="T47">\b</text:span><text:span text:style-name="T36"> pour des lignes vides entre les versets.</text:span></text:p>
   <text:p text:style-name="P182" loext:marker-style-name="T36"/>
   <text:p text:style-name="P3" loext:marker-style-name="T145"><draw:custom-shape text:anchor-type="as-char" draw:z-index="190" draw:name="Text Box 30" draw:style-name="gr3" draw:text-style-name="P417" svg:width="4.5004in" svg:height="4.5524in">
     <svg:desc>P3092TB1#y1</svg:desc>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\id SONGS</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\toc2 livre de chansons</text:span></text:p>
     <text:p text:style-name="P36" loext:marker-style-name="T142"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T139"><text:span text:style-name="T139">\c 1</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T143"><text:span text:style-name="T143">\s Mes objets favoris</text:span></text:p>
     <text:p text:style-name="P36" loext:marker-style-name="T142"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Raindrops sur les roses et les mouchoirs sur les chatons</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Bouilloires en cuivre brillantes et mitaines chaudes en laine</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Pack de papier marron attaché avec des chaînes de caractères</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Ce sont quelques-unes de mes choses préférées</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\b</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Des poneys de couleur crème et des strudels de pomme croustillants</text:span></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Doorbells et cloches de traîneau et schnitzel avec nouilles</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Oies sauvages qui volent avec la lune sur leurs ailes</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Ce sont quelques-unes de mes choses préférées.</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\b</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Filles en robes blanches avec écharpe de satin bleue</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Flocons de neige qui restent sur mon nez et cils</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Hivers blancs d&apos;argent qui fondent en ressorts</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Ce sont quelques-unes de mes choses préférées</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\b</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q2 Quand le chien pique, quand l&apos;abeille pique</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q2 Quand je me sens triste</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q2 Je me souviens simplement de mes choses préférées</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q2 Et puis je ne me sens pas si mal</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\b</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Raindrops sur les roses et les mouchoirs sur les chatons</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Bright copper kettles and warm woolen mittens</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Pack papier Brown attaché avec les chaînes</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Ce sont quelques-unes de mes choses préférées</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape></text:p>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:p text:style-name="P3" loext:marker-style-name="T145"><text:soft-page-break/><draw:custom-shape text:anchor-type="as-char" draw:z-index="191" draw:name="Text Box 31" draw:style-name="gr2" draw:text-style-name="P417" svg:width="4.5004in" svg:height="2.2858in">
     <svg:desc>P3094TB2#y1</svg:desc>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T139"><text:span text:style-name="T139">\c 2</text:span><text:span text:style-name="T139"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T143"><text:span text:style-name="T143">\s Edelweiss</text:span><text:span text:style-name="T143"/></text:p>
     <text:p text:style-name="P36" loext:marker-style-name="T142"/>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Edelweiss, edelweiss</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Chaque matin, vous me saluez</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Petit et blanc</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Clean and bright</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Vous avez l&apos;air heureux de me rencontrer</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\b</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Fleur de neige</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Que vous épanouissiez et poussiez</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Bloom et croître à jamais</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Edelweiss, edelweiss</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"><text:span text:style-name="T142">\q1 Bless ma patrie pour toujours</text:span><text:span text:style-name="T142"/></text:p>
     <text:p text:style-name="Frame_20_contents" loext:marker-style-name="T142"/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f0 0 0 ?f1 ?f0 ?f2 ?f3 ?f1" draw:text-areas="0 0 ?f3 ?f2" draw:type="ooxml-rect" draw:enhanced-path="M 0 0 L ?f3 0 ?f3 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="logwidth/2"/>
      <draw:equation draw:name="f1" draw:formula="logheight/2"/>
      <draw:equation draw:name="f2" draw:formula="logheight"/>
      <draw:equation draw:name="f3" draw:formula="logwidth"/>
     </draw:enhanced-geometry>
    </draw:custom-shape></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Si vous êtes habitué à utiliser Paratext, ces codes SFM sont familiers puisqu&apos;ils sont la façon dont vous marquez la poésie dans telle que les psaumes. Pour une liste de marqueurs de poésie, voir </text:span><text:a xlink:type="simple" xlink:href="#_Poetry_Styles" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Styles de poésie</text:span></text:span></text:a><text:span text:style-name="T36">.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Toutes les chansons sont contenues dans un seul fichier.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">The SFM songbook file must be a </text:span><text:span text:style-name="T47">plain text file</text:span><text:span text:style-name="T36">. Si vous avez des caractères Unicode, les fichiers texte doivent utiliser l&apos;encodage </text:span><text:span text:style-name="T47">UTF-8</text:span><text:span text:style-name="T36">. Pour créer un fichier texte dans Windows, utilisez </text:span><text:span text:style-name="T47">Notepad</text:span><text:span text:style-name="T36">. Pour créer un fichier texte sur un Mac, utilisez </text:span><text:span text:style-name="T47">TextEdit</text:span><text:span text:style-name="T36">, en se rappelant de choisir les fichiers texte bruts dans les préférences, sinon le type de fichier par défaut est RTF (qui contient beaucoup de codes de formatage supplémentaires).</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <table:table table:name="Table79" table:style-name="Table79">
    <table:table-column table:style-name="Table79.A"/>
    <table:table-column table:style-name="Table79.B"/>
    <table:table-row table:style-name="Table79.1">
     <table:table-cell table:style-name="Table79.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T56"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table79.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T127"><text:span text:style-name="T82">Lorsque vous ajoutez votre livre à l&apos;application, cliquez sur le livre dans l&apos;arborescence du projet et sélectionnez l&apos;onglet Livre. Assurez-vous que le sélecteur de type livre est réglé sur </text:span><text:span text:style-name="T86">Livre de Chansons</text:span><text:span text:style-name="T82">. Si c&apos;est le cas, RAB affichera automatiquement un index de musique composé de 2 menus de contenu, l&apos;une est listée par titre de chanson et l&apos;autre par numéro de chanson. </text:span><text:span text:style-name="T127">You can preview them under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Song_Index" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T128">Song Index</text:span></text:span></text:a><text:span text:style-name="T127"> tab.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <table:table table:name="Table80" table:style-name="Table80">
    <table:table-column table:style-name="Table80.A"/>
    <table:table-column table:style-name="Table80.B"/>
    <table:table-row table:style-name="Table80.1">
     <table:table-cell table:style-name="Table80.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T3"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table80.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T36">If you do not see a </text:span><text:a xlink:type="simple" xlink:href="#_The_Song_Index" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Song Index</text:span></text:span></text:a><text:span text:style-name="T36"> tab for the song book, make sure the </text:span><text:span text:style-name="T47">Book Type</text:span><text:span text:style-name="T36"> is set to </text:span><text:span text:style-name="T47">Song Book</text:span><text:span text:style-name="T36">. Si vous essayez d&apos;ajouter une image dans votre livre de chansons en utilisant un marqueur </text:span><text:span text:style-name="T47">\img</text:span><text:span text:style-name="T36"> RAB changera votre livre de musique en livre d’images. À la place, utilisez les marqueurs </text:span><text:span text:style-name="T47">\fig &lt;image filename&gt; \fig*</text:span><text:span text:style-name="T36"> .</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:h text:style-name="P60" text:outline-level="2" loext:marker-style-name="T36"><text:bookmark-start text:name="_Toc233660250"/><text:span text:style-name="T36">Comment associer l&apos;audio à chaque chanson ?</text:span><text:bookmark-end text:name="_Toc233660250"/><text:span text:style-name="T36"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">Un fichier audio distinct et un fichier de chronométrage correspondant doivent être créés pour chaque chanson.</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">Les étiquettes de chronométrage sont de la forme :</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P379" loext:marker-style-name="T36"><text:span text:style-name="T159"><text:line-break/></text:span><text:span text:style-name="T36">a - 1ère ligne de la chanson<text:line-break/>b - 2ème ligne de la chanson<text:line-break/>c - 3ème ligne de la chanson </text:span></text:p>
   <text:p text:style-name="P379" loext:marker-style-name="T36"><text:span text:style-name="T36">d - 4ème ligne de la chanson, etc. <text:line-break/></text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">Pour aider à la création des fichiers de chronométrage, générer des listes de phrases sur la page </text:span><text:span text:style-name="T21">Synchronisation Audio</text:span><text:span text:style-name="T15"> pour le livre.</text:span></text:p>
   <text:p text:style-name="P157" loext:marker-style-name="T15"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T15"><text:span text:style-name="T15">Il est peu probable que la synchronisation automatique fonctionne pour les morceaux, vous devrez donc utiliser la méthode de marquage manuelle en utilisant l&apos;Assistant Audacity et Timing Labels. Veuillez consulter le document </text:span><text:span text:style-name="T7">Utilisation d&apos;Audacity pour la synchronisation du texte audio</text:span><text:span text:style-name="T15"> pour obtenir des instructions.</text:span></text:p>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <table:table table:name="Table81" table:style-name="Table81">
    <table:table-column table:style-name="Table81.A"/>
    <table:table-column table:style-name="Table81.B"/>
    <table:table-row table:style-name="Table81.1">
     <table:table-cell table:style-name="Table81.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T164"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T165"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table81.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Si le texte de votre chanson correspond exactement aux paroles de la chanson, y compris à toutes les répétitions, vous pouvez créer des fichiers de synchronisation automatiquement à l&apos;aide d&apos;aeneas. Il devient plus difficile s&apos;il y a des introductions musicales ou des conclusions pour les chansons, et surtout s&apos;il y a un ou plusieurs interludes musicaux pendant la chanson.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:h text:style-name="P41" text:outline-level="1"><text:bookmark text:name="_User_Accounts"/><text:bookmark-start text:name="_Toc233660251"/><text:bookmark-start text:name="_Hlk16004026"/>Écran d&apos;enregistrement<text:bookmark-end text:name="_Toc233660251"/></text:h>
   <text:p text:style-name="P8"/>
   <text:p text:style-name="P8">Vous pouvez définir un écran d&apos;enregistrement à afficher lorsqu&apos;un utilisateur lance l&apos;application pour la première fois. Cela vous permet de collecter des informations de contact, par exemple pour connecter des personnes avec des groupes de lecture/écoute.</text:p>
   <text:p text:style-name="P8"/>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Picture 170" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="RAB02/45.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
     <svg:desc>P3130#yIS1</svg:desc>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 169" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="RAB02/46.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
     <svg:desc>P3130#yIS2</svg:desc>
    </draw:frame><text:s/><draw:frame draw:style-name="fr4" draw:name="Picture 168" text:anchor-type="as-char" svg:width="1.8075in" svg:height="3.7835in" draw:z-index="0"><draw:image xlink:href="RAB02/47.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
     <svg:desc>P3130#yIS3</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P24">Pour configurer un écran d&apos;inscription, vous devez faire un travail de configuration en deux endroits :</text:p>
   <text:list text:style-name="WWNum36">
    <text:list-item>
     <text:p text:style-name="P394">dans Reading App Builder, et</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P393">dans la console Google Firebase.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc233660252"/>Mise en place de l&apos;écran d&apos;inscription<text:bookmark-end text:name="_Toc233660252"/></text:h>
   <text:p text:style-name="P13">Pour configurer l&apos;écran d&apos;enregistrement dans le constructeur d&apos;application:</text:p>
   <text:list text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P395">Allez à la page <text:span text:style-name="T50">App</text:span> <text:span text:style-name="T70">&lt;unk&gt;</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T22">Security</text:span><text:span text:style-name="T15"> page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P395">Sélectionnez <text:span text:style-name="T50">Exiger que chaque utilisateur s&apos;inscrive avec ses détails lorsqu&apos;il utilise l&apos;application</text:span> pour la première fois.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P395"><text:soft-page-break/>Cliquez sur le bouton <text:span text:style-name="T50">Configurer l&apos;inscription</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P395">Suivez les instructions dans chacun des onglets dans la boîte de dialogue Configurer les inscriptions :</text:p>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Écran d’inscription :</text:span> spécifiez le titre et le texte à afficher sur l’écran d’inscription.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Détails de l&apos;utilisateur :</text:span> spécifiez les champs d&apos;entrée (tels que nom, numéro de téléphone, adresse e-mail), que vous demanderez à l&apos;utilisateur de fournir. Vous pouvez spécifier lesquels sont requis et ceux qui sont optionnels.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Ignorer l&apos;inscription:</text:span> choisissez si vous voulez que l&apos;utilisateur soit en mesure de passer le processus d&apos;inscription. S&apos;ils n&apos;appuient pas sur le bouton Ignorer, indiquez quand vous voulez que l&apos;application leur demande à nouveau.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Inscription terminée :</text:span> spécifiez le titre et le texte à afficher sur l&apos;écran qui est affiché à l&apos;utilisateur après avoir été enregistré avec succès.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Image :</text:span> spécifiez une image à afficher en haut de l&apos;écran, comme le logo de votre organisation ou l&apos;icône de l&apos;application.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Base de données :</text:span> choisissez si les données utilisateur seront stockées dans un chemin spécifique à l&apos;application dans la base de données (ce qui est utile si vous utilisez la même base de données pour plusieurs applications), ou au niveau supérieur de la base de données (ce qui est bien si vous n&apos;avez qu&apos;une seule application). Vous trouverez plus d&apos;informations sur la configuration de votre base de données dans la section suivante.</text:p>
        </text:list-item>
        <text:list-item>
         <text:p text:style-name="P396"><text:span text:style-name="T50">Styles :</text:span> vous pouvez ajuster le style des écrans en ajustant les déclarations de style.</text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P19"><text:line-break/>Use the <text:span text:style-name="T50">Test</text:span> buttons on the <text:span text:style-name="T50">Registration Screen</text:span> and <text:span text:style-name="T50">Registration Completed</text:span> tabs to preview the screens in a browser.<text:line-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P395">Cliquez sur <text:span text:style-name="T50">OK</text:span> lorsque vous avez terminé dans la boîte de dialogue.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc233660253"/>Mise en place de la base de données dans la console Google Firebase<text:bookmark-end text:name="_Toc233660253"/></text:h>
   <text:p text:style-name="P13">Pour configurer la base de données, qui contiendra les informations des utilisateurs enregistrés, vous devez ajouter Firebase à votre application, créer une base de données, configurer des règles d&apos;authentification et de configuration.</text:p>
   <text:p text:style-name="P397" loext:marker-style-name="T90"><text:span text:style-name="T90">Ajouter Firebase à votre application</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P13">Suivez les instructions pour configurer un projet Firebase, décrit dans la section ci-dessus sur <text:a xlink:type="simple" xlink:href="#_Firebase_Analytics" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Analytiques Firebase</text:span></text:a>.</text:p>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P25" loext:marker-style-name="T90"><text:span text:style-name="T90">Créer une base de données</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="Standard">Pour créer une base de données:</text:p>
   <text:list text:style-name="WWNum40">
    <text:list-item>
     <text:p text:style-name="P398">Dans votre console de projet Firebase, sélectionnez <text:span text:style-name="T50">Base de données en temps réel</text:span> dans le menu à gauche de l&apos;écran (option ci-dessous Firestore Database).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P398"><text:soft-page-break/>Cliquer sur le bouton <text:span text:style-name="T50">Créer une base de données</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P398">On the first page of <text:span text:style-name="T50">Set up database</text:span>, choose where you would like the data to be stored, then click <text:span text:style-name="T50">Next</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P398">Sur la deuxième page de <text:span text:style-name="T50">Configurer la base de données</text:span>, choisissez <text:span text:style-name="T50">Démarrer en mode verrouillé</text:span>, et cliquez sur <text:span text:style-name="T50">Activer</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P317" loext:marker-style-name="T90"><text:span text:style-name="T90">Configurer l&apos;authentification</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P26">Pour configurer l&apos;authentification :</text:p>
   <text:list text:style-name="WWNum41">
    <text:list-item>
     <text:p text:style-name="P399">Dans votre console de projet Firebase, sélectionnez <text:span text:style-name="T46">Authentification</text:span> dans le menu à gauche de l&apos;écran.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P399">Sélectionnez l&apos;onglet <text:span text:style-name="T46">méthode de connexion</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P399"><text:span text:style-name="T152">Cliquez sur </text:span><text:span text:style-name="T46">Email/Mot de passe</text:span><text:span text:style-name="T152"> et activez cette méthode d&apos;authentification. T</text:span>son est utilisé lors de la visualisation des utilisateurs enregistrés dans un navigateur web</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P399"><text:span text:style-name="T152">Cliquez sur </text:span><text:span text:style-name="T46">Enregistrez</text:span><text:span text:style-name="T152"> pour confirmer vos modifications et retourner à l&apos;onglet de la méthode de connexion.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P399"><text:span text:style-name="T152">Cliquez sur </text:span><text:span text:style-name="T46">Anonyme</text:span><text:span text:style-name="T152"> (au bas de la liste des fournisseurs de connexion de connexion) et activez cette méthode d&apos;authentification.</text:span> Ceci est utilisé lors de l&apos;inscription de l&apos;utilisateur dans l&apos;application.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P399"><text:span text:style-name="T152">Cliquez sur </text:span><text:span text:style-name="T46">Enregistrez</text:span><text:span text:style-name="T152"> pour confirmer vos modifications et retourner à l&apos;onglet de la méthode de connexion.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P26"/>
   <text:p text:style-name="P400" loext:marker-style-name="T166"/>
   <text:p text:style-name="P317" loext:marker-style-name="T90"><text:span text:style-name="T90">Configurer les règles</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="Standard">Les règles sont requises pour indiquer à Firebase qui aura les droits d&apos;accès pour lire et écrire dans la base de données. Pour configurer les règles de la base de données : </text:p>
   <text:list text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P401">Dans votre console de projet Firebase, sélectionnez <text:span text:style-name="T50">Base de données en temps réel</text:span> dans le menu à gauche de l&apos;écran.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P401">Sélectionnez l&apos;onglet <text:span text:style-name="T46">Règles</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P401">Les règles que vous spécifiez dépendront du chemin que vous avez choisi dans l&apos;onglet <text:span text:style-name="T50">Base de données</text:span> dans la configuration d&apos;enregistrement.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P11"><text:soft-page-break/>Si vous avez choisi de stocker les informations utilisateur dans un <text:span text:style-name="T50">emplacement spécifique à l&apos;application</text:span>, par exemple « /apps/your-app-package-name/users/», les règles doivent être les suivantes :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">{</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;rules&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;apps&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$package&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$uid&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.read&quot;: false,</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P12">Si vous avez choisi de stocker les informations utilisateur au niveau <text:span text:style-name="T50">supérieur de la base de données</text:span>, e. . « /users/», les règles doivent être les suivantes :</text:p>
   <text:p text:style-name="P8"/>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">{</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:soft-page-break/><text:span text:style-name="T144">&quot;rules&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$uid&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144"><text:s/>&quot;.read&quot;: false,</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P18">Ces règles donnent un accès en écriture uniquement à l&apos;utilisateur qui fait l&apos;enregistrement. Personne n&apos;aura accès en lecture (sauf pour vous lorsque vous consultez la base de données depuis la console Firebase). <text:bookmark-end text:name="_Hlk16004026"/></text:p>
   <text:p text:style-name="P18"/>
   <table:table table:name="Table82" table:style-name="Table82">
    <table:table-column table:style-name="Table82.A"/>
    <table:table-column table:style-name="Table82.B"/>
    <table:table-row table:style-name="Table82.1">
     <table:table-cell table:style-name="Table82.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T162"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T163"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table82.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T127"><text:span text:style-name="T5">Assurez-vous de copier exactement les règles. Un moyen facile d&apos;obtenir les règles dont vous avez besoin est de cliquer sur le bouton </text:span><text:span text:style-name="T13">Règles de base de données</text:span><text:span text:style-name="T5"> dans l&apos;onglet Base de données. Cela vous donnera les règles que vous pouvez copier.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P283" loext:marker-style-name="T148"/>
   <table:table table:name="Table83" table:style-name="Table83">
    <table:table-column table:style-name="Table83.A"/>
    <table:table-column table:style-name="Table83.B"/>
    <table:table-row table:style-name="Table83.1">
     <table:table-cell table:style-name="Table83.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T114"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T114"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table83.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T5">If you are also using </text:span><text:a xlink:type="simple" xlink:href="#_User_Accounts" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T13">User Accounts</text:span></text:span></text:a><text:span text:style-name="T5"> in this app, you will need to combine the database rules for the registered users (Registration screen) with the rules for the signed up users (User Accounts). Veuillez consulter la FAQ </text:span><text:span text:style-name="T13">Règles</text:span><text:span text:style-name="T5">, pour plus de détails</text:span><text:span text:style-name="T82">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P401" loext:marker-style-name="T152"><text:span text:style-name="T152">Cliquez </text:span><text:span text:style-name="T46">Publiez</text:span><text:span text:style-name="T152"> pour </text:span>confirmer<text:span text:style-name="T152"> vos modifications.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:p text:style-name="P281" loext:marker-style-name="T145"><text:soft-page-break/></text:p>
   <text:p text:style-name="P317" loext:marker-style-name="T90"><text:span text:style-name="T90">Règles FAQ</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P8" loext:marker-style-name="T90"><text:span text:style-name="T90">Q. Si nous avons également activé les comptes utilisateur pour cette application, quelles règles devons-nous utiliser ?</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P29">If you are using both <text:span text:style-name="T84">User Accounts</text:span> and a <text:span text:style-name="T84">Registration Screen</text:span>, you need to combine the rules as follows:</text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">{</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;rules&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;apps&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$package&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$uid&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.read&quot;: false,</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">},</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;authentifié-utilisateurs&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$uid&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.read&quot;: &quot;$uid == auth.uid&quot;,</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.write&quot;: &quot;$uid == auth.uid &quot;</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:soft-page-break/><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Les règles ci-dessus supposent que vous voulez stocker les informations de l&apos;utilisateur dans un emplacement spécifique à l&apos;application. Si vous avez choisi l’emplacement de niveau supérieur, vous devez supprimer les éléments « apps» et «$package» ci-dessus.<text:line-break/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P8" loext:marker-style-name="T90"><text:span text:style-name="T90">Q. Si nous voulons qu&apos;un administrateur ait un accès en lecture aux utilisateurs enregistrés pour s&apos;afficher dans un navigateur Web, quelle règle utilisons-nous?</text:span><text:span text:style-name="T90"/></text:p>
   <text:p text:style-name="P29">Si vous voulez donner à un administrateur un accès en lecture aux données, pour être affiché dans un navigateur web (Voir <text:span text:style-name="T46">Configurer l&apos;inscription</text:span> <text:span text:style-name="T70">&lt;unk&gt;</text:span> <text:span text:style-name="T46">Informations utilisateur</text:span> <text:span text:style-name="T70">&lt;unk&gt;</text:span> <text:span text:style-name="T46">Voir les données</text:span>), voici la règle à utiliser:</text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">{</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;rules&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;apps&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$package&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;utilisateurs&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;$uid&quot;: {</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.read&quot;: &quot;(auth != null) &amp;&amp; (auth.token.email == &apos;me@abcd.com&apos;)&quot;,</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">&quot;.write&quot; : &quot;$uid === auth.uid &quot;</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:soft-page-break/><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P260" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="P257" loext:marker-style-name="T144"><text:span text:style-name="T144">}</text:span><text:span text:style-name="T144"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P30">(où me@abcd.com est un utilisateur ajouté sur la page <text:span text:style-name="T46">Authentification </text:span>)</text:p>
   <text:p text:style-name="P30"/>
   <text:p text:style-name="Standard">Les règles ci-dessus supposent que vous voulez stocker les informations de l&apos;utilisateur dans un emplacement spécifique à l&apos;application. Si vous avez choisi l’emplacement de niveau supérieur, vous devez supprimer les éléments « apps» et «$package» ci-dessus.</text:p>
   <text:p text:style-name="P281" loext:marker-style-name="T145"/>
   <text:h text:style-name="P41" text:outline-level="1"><text:bookmark text:name="_Progressive_Web_Apps"/><text:bookmark text:name="_Progressive_Web_App"/><text:bookmark-start text:name="_Toc233660254"/>Édition et distribution<text:bookmark-end text:name="_Toc233660254"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36"><text:line-break/>Avant de distribuer votre application, veuillez utiliser la liste de contrôle </text:span><text:span text:style-name="T82">de publication d&apos;applications</text:span><text:span text:style-name="T36"> (disponible via le menu Aide dans RAB ou sur le site web du RAB) pour vérifier qu&apos;elle est prête à publier.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Les applications construites avec Reading App Builder peuvent être publiées sur le Google Play Store, distribuées par carte mémoire, partagé par Bluetooth ou transfert Wi-Fi, téléversé sur des sites Web ou envoyé par courriel. Pour plus d&apos;informations, veuillez consulter le manuel utilisateur </text:span><text:span text:style-name="T82">Distributing Apps</text:span><text:span text:style-name="T36"> (disponible via le menu Aide en RAB ou sur le site web du RAB).</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:h text:style-name="P42" text:outline-level="1"><text:bookmark text:name="_Appendix_1:_How"/><text:bookmark-start text:name="_Toc233660255"/>Annexe 1 : comment RAB stocke les fichiers de données de votre projet<text:bookmark-end text:name="_Toc233660255"/></text:h>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table84" table:style-name="Table84">
    <table:table-column table:style-name="Table84.A"/>
    <table:table-column table:style-name="Table84.B"/>
    <table:table-row table:style-name="Table84.1">
     <table:table-cell table:style-name="Table84.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T56"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table84.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Lorsque vous sélectionnez un fichier source à charger dans votre application, RAB en fera une copie dans le dossier de données du projet. Cependant, il maintiendra le lien vers le fichier source. Si vous mettez à jour le fichier source, vous devrez sélectionner le fichier dans l&apos;arborescence du projet, cliquez dessus avec le bouton droit de la souris et sélectionnez </text:span><text:span text:style-name="T86">Update from Source</text:span><text:span text:style-name="T82">. Ceci copiera le fichier mis à jour dans le dossier de données du projet.</text:span></text:p>
      <text:p text:style-name="P220" loext:marker-style-name="T82"/>
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Alternatively, select the file, select the </text:span><text:span text:style-name="T86">Book File</text:span><text:span text:style-name="T82"> tab in the configuration area and click the </text:span><text:span text:style-name="T86">Update From Source</text:span><text:span text:style-name="T82"> button.</text:span></text:p>
      <text:p text:style-name="P238" loext:marker-style-name="T130"/>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Dans le cadre du processus d&apos;installation, RAB crée un certain nombre de dossiers pour ses fichiers de données. Par défaut, ceux-ci sont dans une hiérarchie sous votre dossier </text:span><text:span text:style-name="T47">Documents</text:span><text:span text:style-name="T36">. Ce qui suit est une explication des différents dossiers du niveau supérieur vers le bas :</text:span></text:p>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark-start text:name="_Toc233660256"/>Utiliser généralement les dossiers de données RAB<text:bookmark-end text:name="_Toc233660256"/></text:h>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Constructeurs d&apos;applications :</text:span><text:span text:style-name="T36"> ce dossier contient les dossiers de haut niveau pour les différents constructeurs d&apos;applications installés i.e. Applications de dictionnaire, Lecture d&apos;applications, etc.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Applications de lecture :</text:span><text:span text:style-name="T36"> ce dossier contient tous les sous-dossiers liés à la lecture des fichiers de données du constructeur d&apos;applications.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">sortie APK :</text:span><text:span text:style-name="T36"> ce dossier est l&apos;endroit où RAB place vos fichiers APK compilés (les fichiers d&apos;installation de l&apos;application qui doivent être copiés sur un téléphone). You can open this folder by selecting </text:span><text:span text:style-name="T47">File</text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T63"></text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T47">View APK Output Folder</text:span><text:span text:style-name="T36">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list xml:id="list164808285158487" text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Projets de l&apos;application:</text:span><text:span text:style-name="T36"> RAB stocke vos projets d&apos;application dans ce dossier, avec les sous-dossiers nommés d&apos;après chaque projet. If you have a project selected in the Tree View, you can view its project folder by selecting </text:span><text:span text:style-name="T47">File</text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T63"></text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T47">View Project Folder</text:span><text:span text:style-name="T36">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <table:table table:name="Table85" table:style-name="Table85">
    <table:table-column table:style-name="Table85.A"/>
    <table:table-column table:style-name="Table85.B"/>
    <table:table-row table:style-name="Table85.1">
     <table:table-cell table:style-name="Table85.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T3"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table85.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Si vous voulez partager votre projet d&apos;application avec quelqu&apos;un d&apos;autre (i.e. quelqu&apos;un qui peut vous aider à tester et à trouver des problèmes avec votre application), vous devrez leur donner votre dossier de projet et tout ce qu&apos;il contient. Ils peuvent le copier dans leur propre dossier de projets d&apos;applications, l&apos;ouvrir en RAB et utiliser le leur, stockage temporaire de clés pour construire, exécuter et tester votre projet. Si des fichiers audio sont nécessaires pour votre application et qu&apos;ils ne sont pas stockés dans le sous-dossier audio de votre projet, vous devrez les copier séparément.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-list="list164807732867610" text:style-name="WWNum26">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P116" loext:marker-style-name="T36"><text:span text:style-name="T47">&lt;group names&gt;:</text:span><text:span text:style-name="T36"> Si vous avez créé un groupe pour vos fichiers de projet, le dossier de groupe sera à ce niveau.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P197" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum26">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P116" loext:marker-style-name="T36"><text:span text:style-name="T47">&lt;project names&gt;:</text:span><text:span text:style-name="T36"> Les dossiers de votre projet seront soit à ce niveau soit sous le dossier &lt;group name&gt; s&apos;il y a lieu.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P198" loext:marker-style-name="T36"><text:soft-page-break/></text:p>
   <text:list text:continue-list="list164808285158487" text:style-name="WWNum51">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">&lt;project name&gt;.appDef</text:span><text:span text:style-name="T36">: Par exemple, </text:span><text:span text:style-name="T47">My_Stories_App.appDef</text:span><text:span text:style-name="T36">. Ceci est le fichier de définition de votre projet – le fichier qui stocke la plupart des attributs du projet.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P84" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:list>
        <text:list-item>
         <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">&lt;project name&gt;_données</text:span><text:span text:style-name="T36">: Par exemple : </text:span><text:span text:style-name="T47">My_Stories_App_data</text:span><text:span text:style-name="T36">. Ceci est le dossier de données parent du projet. Tous les éléments de données du projet sont dans des sous-répertoires en dessous.</text:span></text:p>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Audio :</text:span><text:span text:style-name="T36"> Tous les fichiers audio convertis dans RAB sont placés ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Sortie Epub :</text:span><text:span text:style-name="T36"> Tous les fichiers Epub créés sont placés ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Sortie HTML :</text:span><text:span text:style-name="T36"> Si vous utilisez la fonction Export vers HTML, les fichiers de sortie iront ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Sortie IPA </text:span><text:span text:style-name="T36">(Mac seulement)</text:span><text:span text:style-name="T47">:</text:span><text:span text:style-name="T36"> Si vous construisez des applications pour iOS, les fichiers de sortie seront placés ici. You can open this folder by selecting </text:span><text:span text:style-name="T47">File</text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T63"></text:span><text:span text:style-name="T36"> </text:span><text:span text:style-name="T47">View IPA Output Folder</text:span><text:span text:style-name="T36">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T36"><text:span text:style-name="T47">Phrases :</text:span><text:span text:style-name="T36"> Les fichiers de la liste de phrases générés dans le cadre du processus de synchronisation texte / audio vont ici.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum51">
    <text:list-item>
     <text:p text:style-name="P137" loext:marker-style-name="T82"><text:span text:style-name="T47">Sortie PWA :</text:span><text:span text:style-name="T36"> La sortie de la fonction Build PWA est placée ici</text:span><text:span text:style-name="T82">. You can open this folder by selecting </text:span><text:span text:style-name="T86">File</text:span><text:span text:style-name="T82"> </text:span><text:span text:style-name="T68"></text:span><text:span text:style-name="T82"> </text:span><text:span text:style-name="T86">View PWA Output Folder</text:span><text:span text:style-name="T82">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:h text:style-name="P66" text:outline-level="2"><text:bookmark text:name="_Project-specific_data_folders"/><text:bookmark-start text:name="_Toc233660257"/>Dossiers de données spécifiques au projet<text:bookmark-end text:name="_Toc233660257"/></text:h>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Les dossiers du projet RAB ont le fichier de définition du projet (<text:span text:style-name="T46">&lt;project-name&gt;.appDef</text:span>) et un dossier de données parent <text:span text:style-name="T46">(&lt;project-name_data</text:span>). Voici les explications des différents sous-dossiers de données du projet:</text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:list text:style-name="WWNum58">
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">À propos de</text:span>: plusieurs fichiers texte incluant le texte de la zone À propos de la boîte À Propos, la notification d&apos;expiration et la notification « audio non trouvée ».</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Audio</text:span>: les fichiers audio de votre application. Celles-ci sont copiées ici à partir de votre dossier audio source si vous avez sélectionné <text:span text:style-name="T46">Copier des fichiers vers le dossier de données </text:span>dans la section <text:span text:style-name="T46">Fichiers Audio</text:span> de la section <text:span text:style-name="T46">Outils</text:span> <text:span text:style-name="T63">&lt;unk&gt;</text:span> <text:span text:style-name="T46">Paramètres</text:span> <text:span text:style-name="T63">&lt;unk&gt;</text:span> <text:span text:style-name="T46">Fichiers</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Books</text:span>: RAB stores your book files here in folders named after the book collection’s ID.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Contenu</text:span>: le Contenu <text:span text:style-name="T46">. ml</text:span> fichier qui décrit la structure et les données du menu de votre contenu, et un sous-dossier <text:span text:style-name="T46">images</text:span> pour les images du menu de contenu.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Firebase</text:span>: si votre projet utilise Firebase, le fichier <text:span text:style-name="T46">google-services.json </text:span>est placé ici.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Fontes</text:span>: les fichiers de police inclus dans votre application</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Images</text:span>: la plupart des images associées à votre application dans leurs sous-dossiers respectifs, y compris les illustrations, arrière-plans, bordures, menus, filigranes et toutes les tailles de fichiers d&apos;icônes.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Plans</text:span>: reading plan text files and their images.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Publier</text:span>: toutes les données du Google Play Store listant dans ses différents sous-dossiers et fichiers json associés.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Timings</text:span>: fichiers de synchronisation audio</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Versets</text:span>: le fichier verses.txt décrivant les versets du jour</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P138"><text:span text:style-name="T46">Vidéo</text:span>: MP4s inclus dans votre application et images vidéo immobiles.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P41" text:outline-level="1"><text:bookmark text:name="_Appendix_2:_Useful"/><text:bookmark text:name="_Using_SAB_with"/><text:bookmark-start text:name="_Toc233660258"/>Annexe 2 : Marqueurs SFM utiles du constructeur d&apos;applications<text:bookmark-end text:name="_Toc233660258"/></text:h>
   <text:h text:style-name="P57" text:outline-level="2"><text:bookmark-start text:name="_Toc233660259"/>Titres<text:bookmark-end text:name="_Toc233660259"/></text:h>
   <text:list text:style-name="WWNum53">
    <text:list-item>
     <text:p text:style-name="P402" loext:marker-style-name="T115"><text:span text:style-name="T101">\id</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">un identifiant interne unique pour le livre, non visible pour l&apos;utilisateur. </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P403" loext:marker-style-name="T115"><text:span text:style-name="T101">\h</text:span><text:span text:style-name="T115"> ou </text:span><text:span text:style-name="T101">\toc2</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">le libellé qui apparaît dans le menu de sélection de la liste de livres</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P403" loext:marker-style-name="T115"><text:span text:style-name="T101">\toc3</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">l&apos;abréviation qui apparaît dans le menu de sélection de la grille de livre</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P403" loext:marker-style-name="T115"><text:span text:style-name="T101">\rem</text:span><text:span text:style-name="T103"> </text:span><text:span text:style-name="T115">Non affiché. Ligne de commentaire pour votre utilisation</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P57" text:outline-level="2"><text:bookmark-start text:name="_Toc233660260"/><text:soft-page-break/>Pages et chapitres<text:bookmark-end text:name="_Toc233660260"/></text:h>
   <text:list text:style-name="WWNum54">
    <text:list-item>
     <text:p text:style-name="P404" loext:marker-style-name="T115"><text:span text:style-name="T101">\c</text:span><text:span text:style-name="T115"> ou </text:span><text:span text:style-name="T101">\page</text:span><text:span text:style-name="T103"> </text:span><text:span text:style-name="T115">Utilisé pour séparer le matériau en différents chapitres ou pages</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P57" text:outline-level="2"><text:bookmark-start text:name="_Toc233660261"/>Paragraphes<text:bookmark-end text:name="_Toc233660261"/></text:h>
   <text:list text:style-name="WWNum55">
    <text:list-item>
     <text:p text:style-name="P405" loext:marker-style-name="T115"><text:span text:style-name="T101">\s1</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">en-tête de section ou pour les chansons un titre de chanson</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\b</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">une ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\p</text:span><text:span text:style-name="T115"> a paragraph with indented first line</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\pi</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">un paragraphe indenté à la première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\pc</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">un paragraphe centré </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\pmr</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">paragraphe droit aligné, utilisé pour les accords dans les livres de chansons</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\m</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">un paragraphe sans indentation de première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\mi</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">un paragraphe indenté sans indentation de première ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\q1</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">utilisé dans les chansons pour le verset de la chanson, indenté avec la première ligne suspendue l&apos;indentation</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P406" loext:marker-style-name="T115"><text:span text:style-name="T101">\q2</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">utilisé dans les chansons pour le choeur de chansons, plus indenté avec la première ligne l&apos;indentation</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P60" text:outline-level="2"><text:bookmark text:name="_Media"/><text:bookmark-start text:name="_Toc233660262"/>Médias<text:bookmark-end text:name="_Toc233660262"/></text:h>
   <text:list text:style-name="WWNum56">
    <text:list-item>
     <text:p text:style-name="P407" loext:marker-style-name="T115"><text:span text:style-name="T101">\video</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">ID vidéo</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P408" loext:marker-style-name="T115"><text:span text:style-name="T101">\img</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">Nom du fichier de l&apos;image pour aller en haut de la page (défilements de texte indépendants) – utilisé pour les livres d&apos;histoires</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P408" loext:marker-style-name="T115"><text:span text:style-name="T101">\fig filename.jpg\fig*</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">Utilisé pour l&apos;insertion d&apos;image en ligne</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P408" loext:marker-style-name="T115"><text:span text:style-name="T101">\fig |filename.jpg||Légende ici|\fig*</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">Utilisé pour une image en ligne avec la légende.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P408" loext:marker-style-name="T115"><text:span text:style-name="T101">\fig DESC|FILE|SIZE|LOC|COPY|CAP|REF\fig*</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">Full spécification de référence USFM.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="P60" text:outline-level="2"><text:bookmark text:name="_Links_to_other"/><text:bookmark-start text:name="_Toc233660263"/>Liens vers d&apos;autres livres ou fichiers audio.<text:bookmark-end text:name="_Toc233660263"/></text:h>
   <text:p text:style-name="P285" loext:marker-style-name="T115"><text:soft-page-break/><text:span text:style-name="T101">[Texte Hyperlien](emplacement du lien)</text:span><text:span text:style-name="T102"> </text:span><text:span text:style-name="T115">utilisé pour les hyperliens internes ou externes.</text:span></text:p>
   <text:h text:style-name="P70" text:outline-level="3"><text:bookmark-start text:name="_Toc233660264"/>Exemples<text:bookmark-end text:name="_Toc233660264"/></text:h>
   <text:p text:style-name="P287" loext:marker-style-name="T116"><text:span text:style-name="T116">To link to a website: </text:span><text:span text:style-name="T116"/></text:p>
   <text:p text:style-name="P285" loext:marker-style-name="T116"><text:span text:style-name="T101">[cette page](</text:span><text:a xlink:type="simple" xlink:href="https://github.com/SILAsiaPub/AppBuilder-workaround/edit/master/RAB-cheat-sheet.md" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T116">https://github.com/SILAsiaPub/AppBuilder-workaround/edit/master/RAB-cheat-sheet. d</text:span></text:span></text:a><text:span text:style-name="T101">) </text:span><text:span text:style-name="T115">– cela montre un lien « cette page » qui lien vers le site web spécifié</text:span></text:p>
   <text:p text:style-name="P287" loext:marker-style-name="T116"><text:span text:style-name="T116">Pour créer un lien vers une page de livre dans la collection actuelle : </text:span><text:span text:style-name="T116"/></text:p>
   <text:p text:style-name="P285" loext:marker-style-name="T115"><text:span text:style-name="T101">[aller à Book Id B001 page 2 dans l&apos;application](B001.2) </text:span><text:span text:style-name="T115">– l&apos;ID du livre est B001</text:span></text:p>
   <text:p text:style-name="P287" loext:marker-style-name="T116"><text:span text:style-name="T116">To tap on a link to play a sound: </text:span><text:span text:style-name="T116"/></text:p>
   <text:p text:style-name="P285" loext:marker-style-name="T115"><text:span text:style-name="T101">[Jouer le son](audioclip.mp3) </text:span><text:span text:style-name="T116">-- </text:span><text:span text:style-name="T115">Appuyez sur </text:span><text:span text:style-name="T117">Jouez le son</text:span><text:span text:style-name="T115"> pour jouer le clip </text:span></text:p>
   <text:p text:style-name="P287" loext:marker-style-name="T116"><text:span text:style-name="T116">To tap on an image to play a sound: </text:span><text:span text:style-name="T116"/></text:p>
   <text:p text:style-name="P285" loext:marker-style-name="T115"><text:span text:style-name="T101">[\fig image.jpg \fig*](audioclip.mp3) </text:span><text:span text:style-name="T115">Appuyez sur l&apos;image jpg pour jouer un son </text:span></text:p>
   <text:p text:style-name="P409" loext:marker-style-name="T118"/>
   <text:h text:style-name="P57" text:outline-level="2"><text:bookmark text:name="_Character_markup"/><text:bookmark-start text:name="_Toc233660265"/>Balises de caractères<text:bookmark-end text:name="_Toc233660265"/></text:h>
