   <text:p text:style-name="P185" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum39">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Appuyez sur </text:span><text:span text:style-name="T48">Options développeur</text:span><text:span text:style-name="T36"> et assurez-vous qu&apos;il est activé.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Faites défiler vers le bas la page Options du développeur et trouvez </text:span><text:span text:style-name="T48">USB Debugging</text:span><text:span text:style-name="T36">. Activer ce paramètre. </text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
