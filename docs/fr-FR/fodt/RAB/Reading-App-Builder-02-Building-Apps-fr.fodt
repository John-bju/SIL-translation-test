     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660279" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.13.<text:span text:style-name="T111"> </text:span>Style de bloc formaté<text:span text:style-name="T121"> 140</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660280" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.14.<text:span text:style-name="T111"> </text:span>Styles de Surligneur Styles<text:span text:style-name="T121"> 140</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660281" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.15.<text:span text:style-name="T111"> </text:span>Styles de pied de page (avec des styles de référence)<text:span text:style-name="T121"> 140</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660282" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.16.<text:span text:style-name="T111"> </text:span>Contents Menu Styles<text:span text:style-name="T121"> 141</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660283" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.17.<text:span text:style-name="T111"> </text:span>Style de mise en page<text:span text:style-name="T121"> 142</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660284" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.18.<text:span text:style-name="T111"> </text:span>Verset par verset / Styles de la palette interlinéaire<text:span text:style-name="T121"> 142</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660285" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.19.<text:span text:style-name="T111"> </text:span>Styles d’annotations<text:span text:style-name="T121"> 143</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660286" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.20.<text:span text:style-name="T111"> </text:span>History Styles<text:span text:style-name="T121"> 143</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660287" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.21.<text:span text:style-name="T111"> </text:span>Downloads Styles<text:span text:style-name="T121"> 144</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660288" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.22.<text:span text:style-name="T111"> </text:span>Style des résultats de recherche<text:span text:style-name="T121"> 144</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660289" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.23.<text:span text:style-name="T111"> </text:span>Quiz Styles<text:span text:style-name="T121"> 144</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660290" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.24.<text:span text:style-name="T111"> </text:span>Style<text:span text:style-name="T121"> 145</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660291" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22,25.<text:span text:style-name="T111"> </text:span>Paramètres Styles<text:span text:style-name="T121"> 146</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660292" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.26.<text:span text:style-name="T111"> </text:span>Style de boîte de message<text:span text:style-name="T121"> 147</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660293" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.27.<text:span text:style-name="T111"> </text:span>Styles d&apos;écran d&apos;intégration<text:span text:style-name="T121"> 147</text:span></text:a></text:p>
     <text:p text:style-name="P35" loext:marker-style-name="T107"><text:a xlink:type="simple" xlink:href="#_Toc233660294" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">22.28.<text:span text:style-name="T111"> </text:span>Styles des comptes utilisateurs<text:span text:style-name="T121"> 147</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:h text:style-name="P37" text:outline-level="1"><text:bookmark-start text:name="_Toc233659999"/><text:bookmark-start text:name="_Toc452459025"/>Préparation du contenu pour votre application<text:bookmark-end text:name="_Toc233659999"/><text:bookmark-end text:name="_Toc452459025"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Avant de construire une application avec Reading App Builder (RAB), vous devez obtenir votre contenu (texte, images et audio) dans des formats que RAB peut gérer.</text:span><text:span text:style-name="T36"/></text:p>
   <text:h text:style-name="P46" text:outline-level="2" loext:marker-style-name="T36"><text:bookmark text:name="_Preparing_images"/><text:bookmark text:name="_Preparing_text"/><text:bookmark-start text:name="_Toc231461043"/><text:bookmark-start text:name="_Toc233660000"/><text:span text:style-name="T36">Préparation du texte</text:span><text:bookmark-end text:name="_Toc231461043"/><text:bookmark-end text:name="_Toc233660000"/><text:span text:style-name="T36"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Le format de texte dont vous avez besoin dépend du type de contenu de l&apos;application que vous avez.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:style-name="WWNum16">
    <text:list-item>
     <text:p text:style-name="P230" loext:marker-style-name="T36"><text:span text:style-name="T47">Contenu du texte tel que du matériel d&apos;alphabétisation, des livres d&apos;histoires d&apos;images ou des livres de chansons</text:span><text:span text:style-name="T36">: </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Le texte doit être dans l&apos;un des formats suivants :</text:span><text:span text:style-name="T36"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum16">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P231" loext:marker-style-name="T36"><text:span text:style-name="T36">Documents Word (.docx)</text:span><text:span text:style-name="T36"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P230" loext:marker-style-name="T36"><text:span text:style-name="T36">Fichiers texte SFM (.sfm)</text:span><text:span text:style-name="T36"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P230" loext:marker-style-name="T36"><text:span text:style-name="T36">Fichiers HTML (.html)</text:span><text:span text:style-name="T36"/></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P230" loext:marker-style-name="T36"><text:span text:style-name="T36">Livres Bloom (.bloompub)</text:span><text:span text:style-name="T36"/></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P230" loext:marker-style-name="T47"><text:span text:style-name="T47">Livres de chansons avec accords :</text:span><text:span text:style-name="T47"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">These need to be in the .chordpro (or .cho) format</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P184" loext:marker-style-name="T36"/>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <table:table table:name="Table4" table:style-name="Table4">
    <table:table-column table:style-name="Table4.A"/>
    <table:table-column table:style-name="Table4.B"/>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T56"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">For more information on how RAB stores your text files, see </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T81">How RAB stores your project data files</text:span></text:span></text:a><text:span text:style-name="T81">.</text:span></text:p>
      <text:p text:style-name="P237" loext:marker-style-name="T130"/>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P13" loext:marker-style-name="T36"><text:span text:style-name="T36">Here are some more details about each of these formats:</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P223" loext:marker-style-name="T94"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:bookmark text:name="_Word_document_(.docx)"/><text:bookmark-start text:name="_Toc231461044"/><text:bookmark-start text:name="_Toc233660001"/>Document Word (.docx)<text:bookmark-end text:name="_Toc231461044"/><text:bookmark-end text:name="_Toc233660001"/></text:h>
   <text:p text:style-name="P15"><text:soft-page-break/>RAB peut importer du texte et des images à partir de documents Microsoft Word (.docx). C&apos;est le format recommandé pour le texte et est susceptible d&apos;être utilisé par la plupart des utilisateurs de RAB.</text:p>
   <text:p text:style-name="P15">Lorsque les documents Word sont affichés dans l&apos;application, la mise en forme de base sera préservée comme les styles de caractères (gras, italique, souligné), listes numérotées, points de puce, hyperliens et tables simples. </text:p>
   <text:p text:style-name="P15">Pour définir des chapitres ou des pages séparées, insérez des sauts de page à l&apos;aide de CTRL+Entrée.<text:line-break/></text:p>
   <table:table table:name="Table5" table:style-name="Table5">
    <table:table-column table:style-name="Table5.A"/>
    <table:table-column table:style-name="Table5.B"/>
    <table:table-row table:style-name="Table5.1">
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T39"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T62"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Même si les documents Word peuvent sembler plus simples, ils ne fonctionnent mieux que pour des livres d&apos;histoires très simples. Si vous voulez plus de contrôle sur le formatage et les fonctionnalités du livre, utilisez le format SFM.</text:span><text:span text:style-name="T82"/></text:p>
      <text:p text:style-name="P220" loext:marker-style-name="T82"/>
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">As a starting point, you can add a Word file to RAB, click on its </text:span><text:span text:style-name="T86">Book File</text:span><text:span text:style-name="T82"> tab and then the </text:span><text:span text:style-name="T86">Export as Text File</text:span><text:span text:style-name="T82"> button. Cela convertira votre doc Word au format de fichier SFM. Vous pouvez ensuite éditer ce fichier SFM, en ajoutant le titre correct, la page et d&apos;autres marqueurs nécessaires. Enlevez ensuite le livre de Word et remplacez par celui de SFM.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P233" loext:marker-style-name="T36"><text:span text:style-name="T36">For more details about how to define picture story books and song books using Word documents, please see the sections on </text:span><text:a xlink:type="simple" xlink:href="#_Picture_Story_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Picture Story Books</text:span></text:span></text:a><text:span text:style-name="T36"> and </text:span><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Song Books</text:span></text:span></text:a><text:span text:style-name="T36">.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:bookmark text:name="_SFM_text_files"/><text:bookmark-start text:name="_Toc231461045"/><text:bookmark-start text:name="_Toc233660002"/>Fichiers texte SFM<text:bookmark-end text:name="_Toc231461045"/><text:bookmark-end text:name="_Toc233660002"/> </text:h>
   <text:p text:style-name="P15">RAB peut importer du texte à partir de fichiers SFM (marqueur de format standard). C&apos;est une bonne option pour ceux qui connaissent les marqueurs Paratext et USFM.</text:p>
   <text:p text:style-name="P15">Dans les fichiers texte SFM, les pages, les en-têtes de section et les paragraphes sont marqués par des marqueurs de format standard tels que \page, \s et \p. Pour plus de détails, veuillez consulter <text:a xlink:type="simple" xlink:href="http://paratext.org/about/usfm" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://paratext.org/about/usfm</text:span></text:a>. </text:p>
   <text:p text:style-name="P15"><text:span text:style-name="T36">Le premier marqueur dans le fichier doit être de la forme </text:span><text:span text:style-name="T47">\id XYZ</text:span><text:span text:style-name="T36">, où XYZ est unique, code alphanumérique que vous choisissez (</text:span><text:span text:style-name="T86">sans espace ou tirets</text:span><text:span text:style-name="T36">, mais vous pouvez avoir des tirets bas. </text:span><text:span text:style-name="T86">Ne choisissez pas de code déjà réservé pour un autre livre dans votre projet. </text:span>SFM book files must be <text:span text:style-name="T46">plain text files</text:span>. Si vous avez des caractères Unicode, les fichiers texte doivent utiliser l&apos;encodage UTF-8. </text:p>
   <text:p text:style-name="P16">Pour créer un fichier texte SFM sous Windows, utilisez un éditeur de texte tel que Bloc-notes. </text:p>
   <text:p text:style-name="P15">Pour créer un fichier texte sur un Mac, utilisez TextEdit, en se rappelant de choisir les fichiers texte bruts dans les préférences, sinon le type de fichier par défaut est RTF (qui contient beaucoup de codes de formatage supplémentaires).</text:p>
   <text:p text:style-name="P233" loext:marker-style-name="T36"><text:span text:style-name="T36">For more details about how to define </text:span><text:a xlink:type="simple" xlink:href="#_Multiple_Translations" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">picture story books</text:span></text:span></text:a><text:span text:style-name="T36"> and </text:span><text:a xlink:type="simple" xlink:href="#_Song_Books" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">song books</text:span></text:span></text:a><text:span text:style-name="T36"> using SFM text files, please follow the links to see their respective sections.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:bookmark-start text:name="_Toc233660003"/><text:bookmark-start text:name="_Toc231461046"/>Fichiers HTML (.html)<text:bookmark-end text:name="_Toc233660003"/><text:bookmark-end text:name="_Toc231461046"/></text:h>
   <text:p text:style-name="P15">RAB peut afficher des fichiers HTML et utiliser des feuilles de style (CSS) et des images. La synchronisation du texte audio n&apos;est pas encore prise en charge avec ce format.<text:line-break/></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:bookmark text:name="_Bloom_books_(.bloompub)"/><text:bookmark-start text:name="_Toc231461047"/><text:bookmark-start text:name="_Toc233660004"/>Livres Bloom (.bloompub)<text:bookmark-end text:name="_Toc231461047"/><text:bookmark-end text:name="_Toc233660004"/></text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T15">RAB peut créer des applications avec des livres créés avec Bloom. <text:span text:style-name="T15">Il utilise un lecteur Bloom intégré, comme il est utilisé dans l&apos;application Bloom Reader.</text:span><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T15"><text:span text:style-name="T15">To create a Bloom Reader file for use in RAB:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum77">
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:soft-page-break/><text:span text:style-name="T15">Open the Bloom book in </text:span><text:span text:style-name="T22">Bloom</text:span><text:span text:style-name="T15">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:span text:style-name="T15">Sélectionnez l&apos;onglet </text:span><text:span text:style-name="T22">Publiez</text:span><text:span text:style-name="T15"> en haut de l&apos;écran Bloom.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:span text:style-name="T15">Sélectionnez </text:span><text:span text:style-name="T22">Bloom Reader</text:span><text:span text:style-name="T15"> à gauche de l&apos;écran.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:span text:style-name="T15">Sélectionnez l’option </text:span><text:span text:style-name="T22">Enregistrer le fichier du lecteur Bloom</text:span><text:span text:style-name="T15">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:span text:style-name="T15">Cliquez sur le bouton </text:span><text:span text:style-name="T22">Enregistrer</text:span><text:span text:style-name="T15"> .</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P246" loext:marker-style-name="T15"><text:span text:style-name="T15">Save the Bloom book to your computer as a </text:span><text:span text:style-name="T22">.bloompub</text:span><text:span text:style-name="T15"> file. C&apos;est le fichier dont vous aurez besoin dans la lecture de l&apos;App Builder.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P13" loext:marker-style-name="T15"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647605" text:anchor-type="as-char" svg:width="5.5417in" svg:height="4.9063in" draw:z-index="0"><draw:image xlink:href="RAB02/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>P456#yIS1</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P16">Pour en savoir plus sur Bloom, voir : <text:a xlink:type="simple" xlink:href="http://bloomlibrary.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://bloomlibrary.org</text:span></text:a> </text:p>
   <text:p text:style-name="P15"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:bookmark-start text:name="_Toc233660005"/><text:bookmark-start text:name="_Toc231461048"/>Documents EPUB (.epub)<text:bookmark-end text:name="_Toc233660005"/><text:bookmark-end text:name="_Toc231461048"/></text:h>
   <text:p text:style-name="P11">Il existe un support de base pour l&apos;affichage du contenu des documents EPUB, y compris les images et les styles associés. La synchronisation audio et texte audio n&apos;est pas encore prise en charge avec ce format.<text:line-break/></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P46" text:outline-level="2" loext:marker-style-name="T36"><text:bookmark text:name="_Preparing_images_1"/><text:bookmark-start text:name="_Toc233660006"/><text:span text:style-name="T36">Préparation des images</text:span><text:bookmark-end text:name="_Toc233660006"/><text:span text:style-name="T36"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Les images sont importées automatiquement à partir de documents Word ou doivent être spécifiées séparément si vous utilisez le format SFM. Elles doivent être au format JPEG ou PNG. Certains éléments de l&apos;interface nécessitent un format, une taille ou une forme particuliers, et qui seront spécifiés dans le texte descriptif de cet écran en RAB. Par exemple, l&apos;image du panneau de navigation doit être un fichier PNG avec un ratio de 16:9.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P13" loext:marker-style-name="T36"><text:span text:style-name="T36">Gardez la taille de l&apos;image suffisamment petite pour que la taille de l&apos;application ne soit pas trop grande, mais qu&apos;elle s&apos;affiche bien sur un petit écran. Si vos photos sont dans un document Word, vous pouvez utiliser l&apos;outil </text:span><text:span text:style-name="T47">Compresser les images</text:span><text:span text:style-name="T36"> dans Word. Sinon, RAB vous permettra de redimensionner les images après les avoir ajoutées au projet d&apos;application.</text:span></text:p>
   <text:p text:style-name="P247" loext:marker-style-name="T47"/>
   <text:h text:style-name="P46" text:outline-level="2" loext:marker-style-name="T36"><text:bookmark-start text:name="_Toc233660007"/><text:span text:style-name="T36">Préparation de l&apos;audio</text:span><text:bookmark-end text:name="_Toc233660007"/><text:span text:style-name="T36"/></text:h>
   <text:p text:style-name="P8" loext:marker-style-name="T36"><text:span text:style-name="T36">Si vous voulez inclure des fichiers audio dans votre application, ceux-ci doivent être au format audio MP3, 3GP ou WebM (Ogg Opus). Normalement, ce devrait être un fichier audio par page ou chapitre. Vous pouvez également inclure des clips audio qui sont de courts fichiers audio qui sont joués lorsque l&apos;utilisateur tape sur un mot, une phrase ou une image. Si vous voulez inclure des fichiers de chronométrage pour que le texte et l&apos;audio soient synchronisés, l&apos;audio doit être un débit de bits constant (CBR).</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P14" loext:marker-style-name="T36"><text:a xlink:type="simple" xlink:href="#_Audio_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Rendez-vous ici pour plus d&apos;informations sur l&apos;inclusion de l&apos;audio</text:span></text:span></text:a><text:span text:style-name="T36">.</text:span></text:p>
   <text:p text:style-name="P14" loext:marker-style-name="T36"><text:span text:style-name="T36">Gardez les fichiers audio à une taille où la qualité est suffisante pour un téléphone et où la taille du fichier n&apos;est pas trop grande. </text:span><text:a xlink:type="simple" xlink:href="#_How_can_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Allez ici pour plus d&apos;informations sur la compression des fichiers audio pour les réduire</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P253" loext:marker-style-name="T40"><text:soft-page-break/><text:span text:style-name="T40"/></text:p>
   <table:table table:name="Table6" table:style-name="Table6">
    <table:table-column table:style-name="Table6.A"/>
    <table:table-column table:style-name="Table6.B"/>
    <table:table-row table:style-name="Table6.1">
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T39"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T39"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Assurez-vous que les fichiers audio ont un nom clair et unique. RAB devra déterminer quel fichier audio associer avec quelle page ou chapitre, ainsi inclure clairement ce nombre dans le nom du fichier (i. . à la fin du nom) en utilisant un zéro supérieur.</text:span><text:span text:style-name="T82"/></text:p>
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Par ex. </text:span><text:span text:style-name="T86">mon_book_page_01.mp3</text:span></text:p>
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Audio from Faith comes By Hearing aura déjà des noms de fichiers uniques, il n&apos;est donc pas recommandé de les modifier.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P185" loext:marker-style-name="T36"/>
   <text:h text:style-name="P38" text:outline-level="1"><text:bookmark text:name="_How_to_build"/><text:bookmark-start text:name="_Toc233660008"/>Comment construire votre première application<text:bookmark-end text:name="_Toc233660008"/></text:h>
   <text:p text:style-name="P209" loext:marker-style-name="T36"><text:span text:style-name="T36">To build your first app with Reading App Builder, you should use the </text:span><text:span text:style-name="T47">New App</text:span><text:span text:style-name="T36"> wizard. </text:span></text:p>
   <text:p text:style-name="P186" loext:marker-style-name="T36"/>
   <table:table table:name="Table7" table:style-name="Table7">
    <table:table-column table:style-name="Table7.A"/>
    <table:table-column table:style-name="Table7.B"/>
    <table:table-row table:style-name="Table7.1">
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T39"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T62"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">L&apos;assistant vous proposera de nombreux choix dans la configuration de votre application. Si vous ne savez pas encore exactement ce dont vous avez besoin, choisissez l&apos;option par défaut pour le moment. Tous les éléments de l&apos;application peuvent être ajoutés ou modifiés plus tard dans le RAB, avant de publier l&apos;application. Chaque page de l&apos;assistant aura un texte explicatif pour vous aider à choisir des options.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P186" loext:marker-style-name="T36"/>
   <text:list text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">Lancez </text:span><text:span text:style-name="T47">Reading App Builder</text:span><text:span text:style-name="T36"> depuis son icône sur le bureau.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P187" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T47">Nouvelle App…</text:span><text:span text:style-name="T36"> sur la barre d&apos;outils. L&apos;assistant de nouvelle application va apparaître.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <table:table table:name="Table8" table:style-name="Table8">
    <table:table-column table:style-name="Table8.A"/>
    <table:table-column table:style-name="Table8.B"/>
    <table:table-row table:style-name="Table8.1">
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T58"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">If this is your very first app, or you have no projects opened in RAB, the </text:span><text:span text:style-name="T86">New App</text:span><text:span text:style-name="T82"> button will show in the middle of screen.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the first page of the wizard, specify the </text:span><text:span text:style-name="T47">App Name</text:span><text:span text:style-name="T36">, such as “Dogon Stories”, “Manuel de santé”, “Supyiré Proverbs”, etc. Ceci est le titre principal de votre application et apparaîtra sous l&apos;icône de l&apos;application sur le téléphone de l&apos;utilisateur. Do not include underscores or hard to understand abbreviations and try to keep the length under about 20 characters. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_App_Name" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Name &amp; Package</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T65"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47"> App Name</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">Sur la deuxième page de l&apos;assistant, spécifiez le </text:span><text:span text:style-name="T47">nom de paquet</text:span><text:span text:style-name="T36">--une chaîne séparée par des points qui identifie de manière unique votre application. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Package" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Package</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P255" loext:marker-style-name="T36"><text:span text:style-name="T36">Plus de détails sur le choix d&apos;un bon nom de package peuvent être trouvés dans la section</text:span><text:span text:style-name="T82"> </text:span><text:a xlink:type="simple" xlink:href="#_How_should_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Comment choisir le nom du package ?</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"><text:soft-page-break/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P187" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P85"><text:span text:style-name="T36">Sur la page </text:span><text:span text:style-name="T47">de type</text:span><text:span text:style-name="T36"> choisissez si vous voulez une application avec des données provenant de Word, Bloom, Word ou d&apos;autres fichiers texte, ou une application audio seule. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P17"><text:s/></text:p>
   <text:p text:style-name="List_20_Paragraph"><text:span text:style-name="T36">If you choose audio-only, the wizard will present several screens asking the name of the audio-only book, which audio files you want to add and which image you want to display while the audio is playing</text:span>. Il vous donnera également la possibilité de l&apos;ajouter à un menu de contenu</text:p>
   <text:p text:style-name="List_20_Paragraph"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">If you choose to add books with text, the next page of the wizard is titled </text:span><text:span text:style-name="T47">Books.</text:span><text:span text:style-name="T36"> Cliquez </text:span><text:span text:style-name="T47">Ajouter des livres… </text:span><text:span text:style-name="T36">et sélectionnez les livres que vous voulez voir dans l&apos;application. Il peut s&apos;agir de documents Word (docx), de fichiers texte SFM (marqueurs de format standard), de fichiers ChordPro, ou d&apos;un fichier compressé de fichiers USFM ou USX. (You can add more books later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Book_Collection" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Books </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Add Books</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T36"><text:span text:style-name="T36">If the book names are in all-caps, the next page of the wizard is titled </text:span><text:span text:style-name="T47">Book Names </text:span><text:span text:style-name="T36">and will allow you to change them to mixed case if desired. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P86" loext:marker-style-name="T36"><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Language</text:span><text:span text:style-name="T36">, specify the language code and name of the main language used in the app. Cliquez sur </text:span><text:span text:style-name="T48">Sélectionnez…</text:span><text:span text:style-name="T36"> pour choisir le code de langue dans une liste de langues. Si nécessaire, cochez la case pour spécifier des informations d&apos;identification supplémentaires, telles que le script, la région et la variante. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Language_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Books</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Language</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the </text:span><text:span text:style-name="T47">Copyright </text:span><text:span text:style-name="T48">and</text:span><text:span text:style-name="T47"> Licensing</text:span><text:span text:style-name="T36"> page, specify the copyright and licensing information that you would like to appear on the About box in the app. Cette inclut le détenteur des droits d&apos;auteur pour le texte. Utilisez l&apos;assistant </text:span><text:span text:style-name="T48">Copyright Helper</text:span><text:span text:style-name="T36"> pour vous aider.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P18" loext:marker-style-name="T36"><text:span text:style-name="T36">Si vous ne savez pas quoi mettre ici, veuillez demander conseil au service de l&apos;édition de votre organisation. Ils voudront vous assurer que vous avez bien compris et ne pas vous contenter de deviner ce qu&apos;il faut inclure. (You may add this information at a later time if you do not have it available right now under </text:span><text:a xlink:type="simple" xlink:href="#_The_Copyright_and" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App &gt; About </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Copyright &amp; Licensing</text:span></text:span></text:a><text:span text:style-name="T36">. Voir aussi comment inclure des informations sur les droits d&apos;auteur dans la section </text:span><text:a xlink:type="simple" xlink:href="#_About" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">À propos de la page</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez </text:span><text:span text:style-name="T36">suivant pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Font</text:span><text:span text:style-name="T36">, choose the font. Vous pouvez soit sélectionner dans la liste de polices ou spécifier un fichier de police TrueType différent. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Main_Font" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Main Font</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P261" loext:marker-style-name="T15"><text:span text:style-name="T15"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">If this next page is titled </text:span><text:span text:style-name="T48">Choice of Fonts</text:span><text:span text:style-name="T36">, choose some more fonts to add to the app. L&apos;utilisateur de l&apos;application sera en mesure de changer la police par défaut pour l&apos;une de ces polices dans le sélecteur de police et dans l&apos;éditeur de verset dans l&apos;éditeur d&apos;image. (You can modify these settings later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Files" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Font Files</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:bookmark-start text:name="_Hlk66431126"/><text:span text:style-name="T36">Sur la page de l&apos;assistant intitulée </text:span><text:span text:style-name="T47">Gestion des polices</text:span><text:span text:style-name="T36">, vous pouvez sélectionner GeckoView si vous savez que les composants standard Android auront des difficultés à afficher correctement le texte (e. , si c&apos;est un script complexe). (You can modify this setting later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Font_Handling" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Fonts </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Font Handling</text:span></text:span></text:a><text:span text:style-name="T36">.) Plus d&apos;informations sur GeckoView peuvent être trouvées dans la section </text:span><text:a xlink:type="simple" xlink:href="#_Fonts_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T48">Fontes</text:span></text:span></text:a><text:span text:style-name="T36"> de ce document.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P157" loext:marker-style-name="T15"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span><text:bookmark-end text:name="_Hlk66431126"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Color Scheme</text:span><text:span text:style-name="T36">, choose the color scheme for the app. La couleur que vous choisissez est celle qui sera utilisée pour la barre d&apos;application principale. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Color_Scheme" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Colors </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Color Scheme</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:soft-page-break/><text:span text:style-name="T36">Les couleurs individuelles pour le texte, les titres, les liens, les arrière-plans, etc. peuvent être personnalisées plus tard.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254">On the page of the wizard titled <text:span text:style-name="T46">Default Interface Language</text:span>, choose the language you want users to see when they first enter the app (the language for the app menus). Ceci peut être la langue actuelle du système, mais vous pouvez spécifier une langue par défaut juste dans le cas - peut-être une langue <text:span text:style-name="T81">de communication plus large</text:span>. <text:span text:style-name="T36">(You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_The_Languages_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Interface </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Languages</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P20"/>
   <text:p text:style-name="P10">Click <text:span text:style-name="T46">Next</text:span> to move to the next page.</text:p>
   <text:p text:style-name="P10"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254">Sur la page de l&apos;assistant intitulé <text:span text:style-name="T46">Langues d&apos;interface</text:span>, choisissez les langues de l&apos;interface dans lesquelles l&apos;utilisateur peut choisir dans les paramètres de l&apos;application. <text:span text:style-name="T36">(You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Interface" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Interface</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P10">Cliquer sur <text:span text:style-name="T46">A Suivant</text:span> pour passer à la page suivante.</text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Icon</text:span><text:span text:style-name="T36">, choose the application launcher icon. Vous pouvez sélectionner une des images dans le tableau ou si vous avez vos propres fichiers image PNG pour l&apos;icône, cliquez sur </text:span><text:span text:style-name="T47">Parcourir</text:span><text:span text:style-name="T36"> et sélectionnez-les. (You can see more options for creating an icon and/or modifying the icon later under </text:span><text:a xlink:type="simple" xlink:href="#_Icons" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Appearance</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Icons</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P262" loext:marker-style-name="T36"><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T36">pour passer à la page suivante.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list xml:id="list164807673146849" text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Signing</text:span><text:span text:style-name="T36">, you need to specify the keystore and alias to use to sign the app. Un magasin de clés est un fichier de certificat numérique qui garantit que l&apos;application est légitime. Une application doit être signée de cette manière afin qu&apos;elle puisse être installée sur un téléphone.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:bookmark-start text:name="_Hlk66431771"/><text:span text:style-name="T36">If you already have created a keystore for another app, see </text:span><text:a xlink:type="simple" xlink:href="#_Do_I_have" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">reusing a keytore</text:span></text:span></text:a><text:span text:style-name="T36">. Si vous n&apos;avez pas encore de fichier de stockage de clés (ce que vous n&apos;aurez probablement pas si c&apos;est la première fois que vous utilisez le programme), faire ce qui suit :</text:span></text:p>
   <text:list text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P264" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T47">Créer un KeyStore</text:span><text:span text:style-name="T36">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P189" loext:marker-style-name="T36"><text:soft-page-break/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P263" loext:marker-style-name="T36"><text:span text:style-name="T36">Entrez un nouveau nom de fichier pour le keystore, tel que « keystore1 ». Spécifiez un mot de passe. Click </text:span><text:span text:style-name="T47">Next</text:span><text:span text:style-name="T36"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P263" loext:marker-style-name="T36"><text:span text:style-name="T36">Entrez un nom d&apos;alias pour une clé à créer dans votre nouveau magasin de clés, comme la clé par défaut « key1». Spécifiez un mot de passe, qui peut être le même que le mot de passe que vous avez entré sur la page précédente. </text:span><text:span text:style-name="T36"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <table:table table:name="Table9" table:style-name="Table9">
    <table:table-column table:style-name="Table9.A"/>
    <table:table-column table:style-name="Table9.B"/>
    <table:table-row table:style-name="Table9.1">
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T58"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table9.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Il est très important de stocker le mot de passe de façon sécurisée pour votre magasin de clés. Une fois l&apos;application publiée, elle ne peut pas être mise à jour sans le mot de passe du magasin de clés. Assurez-vous que quelqu&apos;un d&apos;autre de votre organisation a accès aux mots de passe du magasin de clés de l&apos;application.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:p text:style-name="P265" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez </text:span><text:span text:style-name="T36">pour continuer.</text:span></text:p>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P263" loext:marker-style-name="T36"><text:span text:style-name="T36">On the </text:span><text:span text:style-name="T48">Certificate Issuer</text:span><text:span text:style-name="T36"> page, provide details of your organisation in at least one of the fields. Click </text:span><text:span text:style-name="T47">Next</text:span><text:span text:style-name="T36"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum4">
    <text:list-item>
     <text:p text:style-name="P263" loext:marker-style-name="T36"><text:span text:style-name="T36">Un nouveau magasin de clés sera créé pour vous. Cliquez sur </text:span><text:span text:style-name="T47">Fermez</text:span><text:span text:style-name="T36">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"><text:bookmark-end text:name="_Hlk66431771"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-list="list164807673146849" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P254" loext:marker-style-name="T36"><text:span text:style-name="T36">Back on the </text:span><text:span text:style-name="T47">Signing</text:span><text:span text:style-name="T36"> page of the New App wizard, you need to specify the keystore password, select the key alias and enter the alias password--just as you entered them in the step above. (You can modify your keystore settings later under </text:span><text:a xlink:type="simple" xlink:href="#_The_App_Signing" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App Signing</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P187" loext:marker-style-name="T36"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez </text:span><text:span text:style-name="T36">pour continuer.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum3">
    <text:list-item>
     <text:p text:style-name="P85" loext:marker-style-name="T36"><text:span text:style-name="T36">On the page of the wizard titled </text:span><text:span text:style-name="T47">Project</text:span><text:span text:style-name="T36">, you can enter or modify the project name and add an optional description of the app project. Aucun de ces éléments ne sera visible par l&apos;utilisateur de votre application. Ils sont juste pour votre propre utilisation et peuvent vous aider à distinguer entre plusieurs projets d&apos;applications. (You can modify this later under </text:span><text:a xlink:type="simple" xlink:href="#_Project" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">App</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T63"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Project</text:span></text:span></text:a><text:span text:style-name="T36">.)</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P266" loext:marker-style-name="T36"><text:span text:style-name="T36"/></text:p>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-column table:style-name="Table10.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table10.1">
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T58"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">RAB va créer un dossier de projet en utilisant le titre de votre projet. Il est recommandé de ne pas inclure de caractères spéciaux dans le nom du projet car ils peuvent ne pas être compatibles avec les règles de noms de dossiers.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P267" loext:marker-style-name="T36"><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Cliquez sur </text:span><text:span text:style-name="T47">Terminez</text:span><text:span text:style-name="T36"> pour continuer. L&apos;assistant de nouvelle application se fermera et la définition du projet d&apos;application sera ajoutée à l&apos;arborescence à gauche de l&apos;écran.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Jetez un coup d&apos;œil à chacune des pages de configuration de l&apos;application en les sélectionnant dans l&apos;arborescence à gauche. Regardez dans chacun des onglets de chaque page pour vérifier que vous avez les paramètres que vous voulez. Vous pouvez toujours y revenir plus tard pour les modifier si vous trouvez que vous devez apporter des modifications aux polices, couleurs, styles, etc.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P179" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">When you have finished configuring the app, </text:span><text:bookmark-start text:name="_Hlk66431800"/><text:span text:style-name="T36">click the </text:span><text:span text:style-name="T47">Build Android App </text:span><text:span text:style-name="T37">button on the toolbar at the top of the screen</text:span><text:span text:style-name="T36">.</text:span><text:bookmark-end text:name="_Hlk66431800"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"><text:s/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Si quelque chose n&apos;est pas configuré correctement pour que la compilation fonctionne, vous serez notifié. </text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <table:table table:name="Table11" table:style-name="Table11">
    <table:table-column table:style-name="Table11.A"/>
    <table:table-column table:style-name="Table11.B"/>
    <table:table-row table:style-name="Table11.1">
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T56"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T58"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">If you need to see the error information at a later time (e.g. to send to one of the support staff for help), you can find it on the menu bar under </text:span><text:a xlink:type="simple" xlink:href="#_View_Logs…" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T86">Tools</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T68"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T86">View Logs… </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T68"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T86">Error Log</text:span></text:span></text:a><text:span text:style-name="T82">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P268" loext:marker-style-name="T36"><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:span text:style-name="T36">Une fenêtre de compilation apparaîtra. Attendez pendant la compilation de l&apos;application. Cela peut prendre plusieurs minutes ou plus.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P18" loext:marker-style-name="T36"><text:span text:style-name="T36">La première fois que le processus de compilation est lancé, le compilateur doit se connecter à Internet pour télécharger des fichiers. Après cela, les versions ultérieures des applications ne nécessiteront pas l&apos;accès à Internet. See the menu </text:span><text:a xlink:type="simple" xlink:href="#_Settings…" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Tools</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T70"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T15"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Settings…</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T47">Paramètres de compilation</text:span></text:span></text:a><text:span text:style-name="T36"> pour activer le mode hors ligne après la première compilation de l&apos;application.</text:span></text:p>
   <text:p text:style-name="P187" loext:marker-style-name="T36"/>
   <text:p text:style-name="P10" loext:marker-style-name="T36"><text:bookmark-start text:name="_Hlk66431096"/><text:span text:style-name="T36">Si le build réussit, vous aurez un nouveau fichier APK - le fichier d&apos;installation pour une application Android.</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P188" loext:marker-style-name="T36"/>
   <table:table table:name="Table12" table:style-name="Table12">
    <table:table-column table:style-name="Table12.A"/>
    <table:table-column table:style-name="Table12.B"/>
    <table:table-row table:style-name="Table12.1">
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T39"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T62"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">To understand more about where RAB stores files like your APK file, see </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T82">How RAB stores your project data files</text:span></text:span></text:a><text:span text:style-name="T82">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P188" loext:marker-style-name="T36"><text:soft-page-break/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">La section suivante décrit comment copier ce fichier APK sur votre téléphone et lancer l&apos;application.</text:span><text:bookmark-end text:name="_Hlk66431096"/><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:h text:style-name="P38" text:outline-level="1"><text:bookmark text:name="_Installing_the_app"/><text:bookmark-start text:name="_Toc233660009"/><text:bookmark-start text:name="_Hlk66431018"/>Installation de l&apos;application sur votre téléphone<text:bookmark-end text:name="_Toc233660009"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Dans la section ci-dessus, vous avez vu comment compiler une application Android. Le résultat est un fichier APK, le fichier d&apos;installation d&apos;une application Android. Vous devez maintenant copier ce fichier APK sur votre téléphone, l&apos;installer et lancer l&apos;application. </text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <table:table table:name="Table13" table:style-name="Table13">
    <table:table-column table:style-name="Table13.A"/>
    <table:table-column table:style-name="Table13.B"/>
    <table:table-row table:style-name="Table13.1">
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T39"><text:span text:style-name="T57">&lt;unk&gt;</text:span><text:span text:style-name="T62"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Parce que vous installez votre APK directement (un processus appelé side-loading) au lieu de via le Play Store, votre téléphone peut vous avertir du fait qu&apos;il s&apos;agit d&apos;un fichier suspect et qu&apos;il nécessite une étape supplémentaire pour permettre l&apos;installation et/ou l&apos;analyse de virus. C&apos;est normal, mais si vous partagez votre APK de cette façon, vous voudrez préparer les utilisateurs à rencontrer ces vérifications.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Il y a plusieurs façons de faire ceci :</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T47"><text:span text:style-name="T47">Copier l&apos;APK via le transfert WIFI</text:span><text:span text:style-name="T47"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Utilisez une application de transfert WIFI (Xender, WhatsApp) sur votre téléphone et votre ordinateur. Ouvrez le dossier de sortie </text:span><text:span text:style-name="T36">, sélectionnez votre APK et copiez-le ou envoyez-le sur votre téléphone. Localisez le fichier APK et appuyez dessus pour l&apos;installer.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P8" loext:marker-style-name="T47"><text:span text:style-name="T47">Copier l&apos;APK directement</text:span><text:span text:style-name="T47"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">Si vous avez un câble de données USB, connectez votre téléphone à votre ordinateur pour qu&apos;il apparaisse comme un périphérique (comme un disque dur externe ou une clé USB). Ouvrez le dossier de sortie </text:span><text:span text:style-name="T36">, sélectionnez votre APK et copiez-le dans un dossier facilement trouvé (e. . Téléchargements) sur votre téléphone. Ensuite, sur le téléphone, trouvez l&apos;APK et appuyez pour l&apos;installer.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T47"><text:span text:style-name="T47">Installez automatiquement l&apos;APK à partir de RAB</text:span><text:span text:style-name="T47"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">C&apos;est un moyen très pratique de tester votre APK et de l&apos;installer. Utilisez les étapes suivantes :</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:list text:style-name="WWNum39">
    <text:list-item>
     <text:p text:style-name="P87" loext:marker-style-name="T36"><text:soft-page-break/><text:span text:style-name="T36">Connectez votre téléphone Android à votre ordinateur à l&apos;aide d&apos;un câble de données </text:span><text:span text:style-name="T36">. </text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <text:p text:style-name="List_20_Paragraph" loext:marker-style-name="T36"><text:span text:style-name="T36">(Sometimes you get cheap USB cables that can only charge a phone but cannot transfer data, so make sure you have the right kind of cable.)</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P78" loext:marker-style-name="T36"/>
   <table:table table:name="Table14" table:style-name="Table14">
    <table:table-column table:style-name="Table14.A"/>
    <table:table-column table:style-name="Table14.B"/>
    <table:table-row table:style-name="Table14.1">
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T3"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">Lorsque vous connectez votre téléphone à votre ordinateur, si votre téléphone apparaît comme une icône sous « Ce PC », vous avez un câble de données.</text:span><text:span text:style-name="T82"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P79" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum39">
    <text:list-item>
     <text:p text:style-name="P87" loext:marker-style-name="T36"><text:span text:style-name="T36">Assurez-vous que les options </text:span><text:span text:style-name="T48">Développeur </text:span><text:span text:style-name="T70">&lt;unk&gt;</text:span><text:span text:style-name="T15"> </text:span><text:span text:style-name="T22">USB Debogging</text:span><text:span text:style-name="T36"> est activé sur votre téléphone. Par défaut, sur les nouveaux téléphones, les options développeur sont désactivées. Voici comment vous pouvez l&apos;activer :</text:span></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Open the </text:span><text:span text:style-name="T48">Settings </text:span><text:span text:style-name="T36">menu of your phone.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Faites défiler vers le bas du menu et appuyez sur </text:span><text:span text:style-name="T48">À propos du téléphone</text:span><text:span text:style-name="T36">.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Find the </text:span><text:span text:style-name="T48">Build Number</text:span><text:span text:style-name="T36">. Cela pourrait se trouver sur la page À propos du téléphone ou dans un sous-menu tel que « Informations sur le logiciel ».</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P80" loext:marker-style-name="T36"><text:s/></text:p>
   <table:table table:name="Table15" table:style-name="Table15">
    <table:table-column table:style-name="Table15.A"/>
    <table:table-column table:style-name="Table15.B"/>
    <table:table-row table:style-name="Table15.1">
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T3"><text:span text:style-name="T59">&lt;unk&gt;</text:span><text:span text:style-name="T60"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.B1" office:value-type="string">
      <text:p text:style-name="P213" loext:marker-style-name="T82"><text:span text:style-name="T82">If you have trouble finding the Build Number, search for “</text:span><text:span text:style-name="T86">Build Number</text:span><text:span text:style-name="T82">” in the settings Search bar.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P80" loext:marker-style-name="T36"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum39">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P88" loext:marker-style-name="T36"><text:span text:style-name="T36">Tap on the Build Number </text:span><text:span text:style-name="T48">seven times</text:span><text:span text:style-name="T36">. Comme vous le faites, vous verrez apparaître une série de messages : « Vous êtes maintenant à 3 étapes de votre développement », « Vous êtes maintenant à 2 étapes de votre développement », « Vous êtes maintenant à 1 étape de votre développement », « Vous êtes maintenant un développeur !</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P4" loext:marker-style-name="T36"><draw:custom-shape text:anchor-type="char" draw:z-index="17" draw:name="AutoShape 160" draw:style-name="gr1" draw:text-style-name="P417" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.39583333333333in 2.87222222222222in)">
