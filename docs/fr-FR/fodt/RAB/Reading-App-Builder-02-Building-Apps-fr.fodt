   <text:p text:style-name="P190" loext:marker-style-name="T36"/>
   <text:p text:style-name="P245" loext:marker-style-name="T36"><text:span text:style-name="T36">If you see a message box like this, check the box “</text:span><text:span text:style-name="T47">Always allow from this computer</text:span><text:span text:style-name="T36">” and tap </text:span><text:span text:style-name="T48">OK</text:span><text:span text:style-name="T36">:</text:span></text:p>
   <text:p text:style-name="P4" loext:marker-style-name="T36"><draw:custom-shape text:anchor-type="char" draw:z-index="193" draw:name="AutoShape 160" draw:style-name="gr1" draw:text-style-name="P417" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.39027777777778in 2.19166666666667in)">
     <svg:desc>P665#y1</svg:desc>
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
