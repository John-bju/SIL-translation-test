    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P35" loext:marker-style-name="T21"><draw:frame draw:style-name="fr2" draw:name="Picture 20" text:anchor-type="as-char" svg:width="0.5307in" svg:height="0.6in" draw:z-index="0"><draw:image xlink:href="RAB05/3.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
        <svg:desc>Icône Google Play - Graphique vectoriel gratuit sur Pixabay</svg:desc>
       </draw:frame></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T23"><text:span text:style-name="T23">Google Play </text:span><text:span text:style-name="T23"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T21"><text:span text:style-name="T21">Publiez l&apos;application sur </text:span><text:a xlink:type="simple" xlink:href="http://play.google.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T21">Google Play</text:span></text:span></text:a><text:span text:style-name="T21"> pour que les gens puissent la trouver et la télécharger. C&apos;est là que la plupart des applications Android sont distribuées.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.2">
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P4" loext:marker-style-name="T7"><draw:frame draw:style-name="fr2" draw:name="Picture 19" text:anchor-type="as-char" svg:width="0.5736in" svg:height="0.5736in" draw:z-index="0"><draw:image xlink:href="RAB05/4.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
        <svg:desc>Forme

Description générée automatiquement avec une faible confiance</svg:desc>
       </draw:frame></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T23"><text:span text:style-name="T23">Sites Web</text:span><text:span text:style-name="T23"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T21"><text:span text:style-name="T21">Postez le fichier d&apos;installation de l&apos;application (APK) sur votre site Web pour que les gens puissent le trouver et le télécharger. Une fois que les gens ont téléchargé le fichier, ils appuient dessus pour l&apos;installer.</text:span><text:span text:style-name="T21"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.3">
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P4"><draw:frame draw:style-name="fr2" draw:name="Picture 18" text:anchor-type="as-char" svg:width="0.7827in" svg:height="0.7909in" draw:z-index="0"><draw:image xlink:href="RAB05/5.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
        <svg:desc>Icône

Description générée automatiquement</svg:desc>
       </draw:frame></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T23"><text:span text:style-name="T23">Dropbox, Google Drive, etc.</text:span><text:span text:style-name="T23"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T21"><text:span text:style-name="T21">Téléchargez le fichier d&apos;installation de l&apos;application (APK) dans un dossier d&apos;un service de stockage cloud (comme Dropbox ou Google Drive). Partagez le lien avec les autres. Une fois que les gens ont téléchargé le fichier, ils appuient dessus pour l&apos;installer.</text:span><text:span text:style-name="T21"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.4">
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P4"><draw:frame draw:style-name="fr2" draw:name="Picture 17" text:anchor-type="as-char" svg:width="0.7307in" svg:height="0.7307in" draw:z-index="0"><draw:image xlink:href="RAB05/6.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/jpeg"/>
        <svg:desc>Amazon.com: Amazon Appstore: Appstore for Android</svg:desc>
       </draw:frame></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T23"><text:span text:style-name="T23">Amazon Appstore</text:span><text:span text:style-name="T23"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B1" office:value-type="string">
      <text:p text:style-name="P54" loext:marker-style-name="T21"><text:span text:style-name="T21">Publiez l&apos;application sur </text:span><text:a xlink:type="simple" xlink:href="https://www.amazon.com/appstore" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T21">Amazon Appstore</text:span></text:span></text:a><text:span text:style-name="T21"> pour que les gens puissent la trouver et la télécharger.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P41" loext:marker-style-name="T7"/>
   <text:p text:style-name="P55" loext:marker-style-name="T6"><text:soft-page-break/><text:span text:style-name="T6">Distribution hors ligne</text:span><text:span text:style-name="T6"/></text:p>
