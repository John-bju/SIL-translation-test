   <text:p text:style-name="P50" loext:marker-style-name="T15"/>
   <text:h text:style-name="P5" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc78982836"/><text:span text:style-name="T3">Introduction</text:span><text:bookmark-end text:name="_Toc78982836"/><text:span text:style-name="T3"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc78982837"/>Vérification que votre application est prête à être publiée<text:bookmark-end text:name="_Toc78982837"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T21"><text:span text:style-name="T21">Before you distribute your app, please use the </text:span><text:span text:style-name="T22">App Publishing Checklist</text:span><text:span text:style-name="T21"> (available via the Help menu in RAB or on the RAB website) to verify that it is ready to publish.</text:span></text:p>
   <text:p text:style-name="P51" loext:marker-style-name="T21"/>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="_Toc78982272"/><text:bookmark-start text:name="_Toc78982838"/>Options de distribution pour les applications Android<text:bookmark-end text:name="_Toc78982272"/><text:bookmark-end text:name="_Toc78982838"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Il existe plusieurs façons possibles de transférer des applications Android vers un smartphone. Celles-ci incluent à la fois les options en ligne et hors ligne : </text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="P53" loext:marker-style-name="T6"><text:span text:style-name="T6">Distribution en ligne</text:span><text:span text:style-name="T6"/></text:p>
   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A"/>
