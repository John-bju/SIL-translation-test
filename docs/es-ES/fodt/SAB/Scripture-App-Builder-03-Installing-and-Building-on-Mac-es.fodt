   <text:p text:style-name="P68" loext:marker-style-name="T29"/>
   <text:h text:style-name="P13" text:outline-level="2"><text:bookmark-start text:name="_Toc228354129"/>Manually Installing Apps into the Simulator<text:bookmark-end text:name="_Toc228354129"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T57"><text:span text:style-name="T57">If there is a problem with launching the simulator from the </text:span><text:span text:style-name="T52">Run iOS Simulator</text:span><text:span text:style-name="T57"> dialog, you can manually install the app by dragging the built app from the Simulator output folder (found in ~/App Builder/Scripture Apps/Sim Output) onto the Simulator.</text:span></text:p>
   <text:p text:style-name="P110" loext:marker-style-name="T57"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T57"><text:span text:style-name="T57">To start the Simulator, launch </text:span><text:span text:style-name="T52">Xcode</text:span><text:span text:style-name="T57"> and from the </text:span><text:span text:style-name="T52">Xcode</text:span><text:span text:style-name="T57"> menu select </text:span><text:span text:style-name="T52">Open Developer Tool</text:span><text:span text:style-name="T57"> </text:span><text:span text:style-name="T47">Ø</text:span><text:span text:style-name="T57"> </text:span><text:span text:style-name="T52">Simulator</text:span><text:span text:style-name="T57">. You will still need to rebuild the app from the </text:span><text:span text:style-name="T52">Run iOS Simulator</text:span><text:span text:style-name="T57"> dialog.</text:span></text:p>
   <text:p text:style-name="P110" loext:marker-style-name="T57"/>
   <text:p text:style-name="P110" loext:marker-style-name="T57"/>
   <text:h text:style-name="P12" text:outline-level="1"><text:bookmark-start text:name="_Toc228354130"/>Creating iOS Certificates and Provisioning<text:bookmark-end text:name="_Toc475369919"/> Profiles<text:bookmark-end text:name="_Toc228354130"/></text:h>
   <text:h text:style-name="P13" text:outline-level="2"><text:bookmark-start text:name="OLE_LINK11"/><text:bookmark-start text:name="_Toc228354131"/>Enroll in the Apple Developer Program<text:bookmark-end text:name="OLE_LINK11"/><text:bookmark-end text:name="_Toc228354131"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T29"><text:span text:style-name="T29">To build iOS apps and distribute them through the Apple App Store, you will need to be enrolled in the Apple Developer Program. You can do this as either (i) an individual, or (ii) an organisation. The cost is USD $99 per year.</text:span><text:span text:style-name="T29"/></text:p>
   <text:p text:style-name="P83" loext:marker-style-name="T29"><text:span text:style-name="T29">To enroll:</text:span><text:span text:style-name="T29"/></text:p>
   <text:list text:style-name="WWNum37">
    <text:list-item>
     <text:p text:style-name="P32" loext:marker-style-name="T29"><text:bookmark-start text:name="OLE_LINK10"/><text:span text:style-name="T29">Go to </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/programs/enroll/" text:style-name="ListLabel_20_445" text:visited-style-name="ListLabel_20_445"><text:span text:style-name="T70">https://developer.apple.com/programs/enroll/</text:span></text:a><text:bookmark-end text:name="OLE_LINK10"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P33" loext:marker-style-name="T29"><text:span text:style-name="T29">Press the </text:span><text:span text:style-name="T33">Start Your Enrollment</text:span><text:span text:style-name="T29"> button to start.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P69" loext:marker-style-name="T29"/>
   <text:h text:style-name="P13" text:outline-level="2"><text:bookmark-start text:name="_Toc228354132"/>Create Signing Certificate<text:bookmark-end text:name="_Toc228354132"/></text:h>
   <text:p text:style-name="P7" loext:marker-style-name="T29"><text:span text:style-name="T29">When you create an iOS app, it needs to be signed with a certificate.</text:span><text:span text:style-name="T29"/></text:p>
   <text:p text:style-name="P70" loext:marker-style-name="T29"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T29"><text:span text:style-name="T29">To create a certificate:</text:span><text:span text:style-name="T29"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P117" loext:marker-style-name="T29"><text:span text:style-name="T29">Go to the </text:span><text:a xlink:type="simple" xlink:href="https://developer.apple.com/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T29">Apple Developer</text:span></text:span></text:a><text:span text:style-name="T29"> website and log in to your account if you are not already.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P117" loext:marker-style-name="T29"><text:span text:style-name="T29">Select </text:span><text:span text:style-name="T33">Certificates, Identifiers &amp; Profiles</text:span><text:span text:style-name="T29">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P117" loext:marker-style-name="T28"><text:span text:style-name="T28">Click the</text:span><draw:frame draw:style-name="fr1" draw:name="Picture 16" text:anchor-type="as-char" svg:width="0.1945in" svg:height="0.2362in" draw:z-index="0"><draw:image draw:mime-type="image/png">
