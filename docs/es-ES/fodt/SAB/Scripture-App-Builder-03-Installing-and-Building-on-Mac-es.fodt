   <text:p text:style-name="P6"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum25">
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T29"><text:span text:style-name="T29">A “Read Me” screen will display next followed by a “License” screen. Press </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29"> on both screens.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T29"><text:span text:style-name="T29">Pressing the </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29"> button on the License screen will bring up a screen asking if you agree to the terms of the license. Press </text:span><text:span text:style-name="T33">Agree</text:span><text:span text:style-name="T29">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T29"><text:span text:style-name="T29">The “Destination Select” screen selects the default drive. Press </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T29"><text:span text:style-name="T29">The “Installation Type” screen displays next for a standard install. Press </text:span><text:span text:style-name="T33">Install</text:span><text:span text:style-name="T29">.</text:span></text:p>
    </text:list-item>
   </text:list>
