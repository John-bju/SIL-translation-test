   <text:h text:style-name="P14" text:outline-level="2"><text:bookmark-start text:name="_Toc228354140"/><text:bookmark-start text:name="OLE_LINK1"/><text:bookmark-start text:name="_Toc78036942"/>App Type (iOS) Tab<text:bookmark-end text:name="_Toc228354140"/><text:bookmark-end text:name="_Toc78036942"/></text:h>
