       </draw:image>
      </draw:frame><text:span text:style-name="T28"> button to the right of the </text:span><text:span text:style-name="T35">Identifiers</text:span><text:span text:style-name="T28"> header.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:span text:style-name="T29">Select </text:span><text:span text:style-name="T33">App IDs</text:span><text:span text:style-name="T29"> and click the </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29"> button.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:span text:style-name="T29">Select </text:span><text:span text:style-name="T33">App</text:span><text:span text:style-name="T29"> and clock the </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29"> button</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:bookmark-start text:name="OLE_LINK23"/><text:bookmark-start text:name="OLE_LINK20"/><text:bookmark-start text:name="OLE_LINK21"/><text:bookmark-start text:name="OLE_LINK22"/><text:span text:style-name="T29">Enter a</text:span><text:span text:style-name="T33"> Description</text:span><text:span text:style-name="T29"> of your choice.<text:line-break/>It can be the </text:span><text:span text:style-name="T33">App Name</text:span><text:span text:style-name="T29"> from the </text:span><text:span text:style-name="T33">App</text:span><text:span text:style-name="T29"> </text:span><text:span text:style-name="T47">Ø</text:span><text:span text:style-name="T56"> </text:span><text:span text:style-name="T33">Package</text:span><text:span text:style-name="T29"> page of Scripture App Builder.</text:span><text:bookmark-end text:name="OLE_LINK23"/><text:bookmark-end text:name="OLE_LINK22"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:bookmark-start text:name="OLE_LINK25"/><text:bookmark-start text:name="OLE_LINK24"/><text:span text:style-name="T29">For Bundle ID, choose </text:span><text:span text:style-name="T33">Explicit </text:span><text:span text:style-name="T29">and enter your app package name from the </text:span><text:span text:style-name="T33">App</text:span><text:span text:style-name="T29"> </text:span><text:bookmark-start text:name="OLE_LINK18"/><text:bookmark-start text:name="OLE_LINK19"/><text:span text:style-name="T47">Ø</text:span><text:span text:style-name="T56"> </text:span><text:span text:style-name="T33">Package</text:span><text:span text:style-name="T29"> page of Scripture App Builder.</text:span><text:bookmark-end text:name="OLE_LINK25"/><text:bookmark-end text:name="OLE_LINK24"/><text:bookmark-end text:name="OLE_LINK18"/><text:bookmark-end text:name="OLE_LINK19"/><text:bookmark-end text:name="OLE_LINK20"/><text:bookmark-end text:name="OLE_LINK21"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:span text:style-name="T29">Of the App Capabilities, there are only two that may need to be checked. Check the Push Notifications capability if the app uses Firebase Cloud Messaging, Verse of the Day, or Daily Reminders. Check the Associated Domain capability if using Deep Linking.</text:span><text:span text:style-name="T29"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P121" loext:marker-style-name="T29"><text:span text:style-name="T29">Click the </text:span><text:span text:style-name="T33">Continue</text:span><text:span text:style-name="T29"> button.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P67" loext:marker-style-name="T29"><text:soft-page-break/></text:p>
   <text:p text:style-name="P122" loext:marker-style-name="T29"><text:span text:style-name="T29">To register a </text:span><text:span text:style-name="T38">device</text:span><text:span text:style-name="T29"> (i.e. a specific iPhone or iPad for testing):</text:span></text:p>
   <text:list text:style-name="WWNum17">
    <text:list-item>
     <text:p text:style-name="P123" loext:marker-style-name="T29"><text:span text:style-name="T29">Select </text:span><text:span text:style-name="T33">Devices</text:span><text:span text:style-name="T29"> on the left of the page.</text:span></text:p>
    </text:list-item>
    <text:list-item>
