     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354155" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">16.<text:span text:style-name="T22"> </text:span>Building from Terminal<text:span text:style-name="T27"> 41</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354156" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">16.1.<text:span text:style-name="T23"> </text:span>Installing Command Line Interface<text:span text:style-name="T27"> 42</text:span></text:a></text:p>
