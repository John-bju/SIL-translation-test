   <text:p text:style-name="P61" loext:marker-style-name="T3"/>
   <text:p text:style-name="P61" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum28">
    <text:list-item>
     <text:p text:style-name="P98" loext:marker-style-name="T3"><text:span text:style-name="T3">Follow the instructions on each page of the </text:span><text:span text:style-name="T12">Install Android SDK</text:span><text:span text:style-name="T3"> wizard to download each of the Android SDK packages and install them.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P62" loext:marker-style-name="T3"/>
   <text:p text:style-name="P94" loext:marker-style-name="T3"><text:span text:style-name="T3">When you are asked to specify a target folder, a good place is:</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P94" loext:marker-style-name="T3"><text:span text:style-name="T11">/Users/</text:span><text:span text:style-name="T7">your-name</text:span><text:span text:style-name="T11">/Android-SDK</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P63" loext:marker-style-name="T3"/>
   <text:p text:style-name="P101" loext:marker-style-name="T3"><text:span text:style-name="T3">Four packages will be downloaded and installed:</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum45">
    <text:list-item>
     <text:p text:style-name="P21" loext:marker-style-name="T3"><text:span text:style-name="T3">Command line tools, </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P21" loext:marker-style-name="T3"><text:span text:style-name="T3">Build Tools, </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P21" loext:marker-style-name="T3"><text:span text:style-name="T3">Platform Tools, and </text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P21" loext:marker-style-name="T3"><text:span text:style-name="T3">Platform API.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P62" loext:marker-style-name="T3"/>
   <text:p text:style-name="P5" loext:marker-style-name="T3"><text:span text:style-name="T3">If the installation was successful, you will see the version numbers displayed in green.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P3" loext:marker-style-name="T49"><draw:frame draw:style-name="fr1" draw:name="Picture 7" text:anchor-type="as-char" svg:width="5.25in" svg:height="3.3165in" draw:z-index="0"><draw:image draw:mime-type="image/png">
