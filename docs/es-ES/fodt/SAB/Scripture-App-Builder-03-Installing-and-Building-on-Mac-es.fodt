   <text:p text:style-name="P67" loext:marker-style-name="T29"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum25">
    <text:list-item>
     <text:p text:style-name="P109" loext:marker-style-name="T29"><text:span text:style-name="T29">The installer will prompt for credentials to install the software. Enter a username and password with permissions and press </text:span><text:span text:style-name="T33">Install Software</text:span><text:span text:style-name="T29">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P108" loext:marker-style-name="T29"><text:span text:style-name="T29">At this point the installation will start and will show progress screens until it completes. A terminal window will popup briefly to test the installation. When the application completes successfully, the original screen will show:</text:span><text:span text:style-name="T29"/></text:p>
    </text:list-item>
   </text:list>
