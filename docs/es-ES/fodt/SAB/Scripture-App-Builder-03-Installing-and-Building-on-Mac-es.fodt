   <text:p text:style-name="P57" loext:marker-style-name="T3"/>
   <text:h text:style-name="P12" text:outline-level="1"><text:bookmark-start text:name="_Toc228354122"/>Installing Prerequisites for Progressive Web App<text:bookmark-end text:name="_Toc228354122"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T10"><text:span text:style-name="T10">If you want to build a Progressive Web App (PWA) that can be downloaded from the browser on any platform instead of going through an app store, you need to install the following components:</text:span><text:span text:style-name="T10"/></text:p>
   <text:p text:style-name="P59" loext:marker-style-name="T10"/>
   <text:list text:style-name="WWNum42">
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T14"><text:span text:style-name="T14">Node.js</text:span><text:span text:style-name="T14"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P28" loext:marker-style-name="T14"><text:span text:style-name="T14">Workbox-cli</text:span><text:span text:style-name="T14"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P64" loext:marker-style-name="T14"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T10"><text:span text:style-name="T10">For more information on what PWAs are, why you might use them, and how to export the files needed, see </text:span><text:a xlink:type="simple" xlink:href="https://software.sil.org/scriptureappbuilder/resources/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T10">Scripture App Builder Documentation</text:span></text:span></text:a><text:span text:style-name="T10"> 2: Building Apps.</text:span></text:p>
   <text:h text:style-name="P13" text:outline-level="2" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc228354123"/><text:span text:style-name="T3">Install Node.js</text:span><text:bookmark-end text:name="_Toc228354123"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard">Go to the Node.js Downloads page:</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P104" loext:marker-style-name="T67"><text:a xlink:type="simple" xlink:href="https://nodejs.org/en/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">https://nodejs.org/en/download/</text:span></text:a><text:span text:style-name="T67"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">There are many download files on this page. You are looking for the file that corresponds to your computer’s operating system type. It is easiest to download the .pkg file (installer package file) rather than the tar file.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P56" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><draw:custom-shape text:anchor-type="char" draw:z-index="0" draw:name="Left Arrow 1" draw:style-name="gr2" draw:text-style-name="P141" svg:width="0.6335in" svg:height="0.2504in" draw:transform="rotate (-3.14159265358979) translate (0.311111111111111in 2.61597222222222in)">
