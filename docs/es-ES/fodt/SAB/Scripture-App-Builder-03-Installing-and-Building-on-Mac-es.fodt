     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354161" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.3.<text:span text:style-name="T23"> </text:span>Security Feature Support in iOS App<text:span text:style-name="T27"> 49</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354162" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.4.<text:span text:style-name="T23"> </text:span>Firebase Messaging<text:span text:style-name="T27"> 49</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354163" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">17.5.<text:span text:style-name="T23"> </text:span>Firebase Crashlytics for iOS<text:span text:style-name="T27"> 52</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T22"><text:a xlink:type="simple" xlink:href="#_Toc228354164" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">18.<text:span text:style-name="T22"> </text:span>Deep Linking for iOS<text:span text:style-name="T27"> 52</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354165" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">18.1.</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T3">Provisioning Profile Changes (Associated Domains)</text:span><text:span text:style-name="T27"> 52</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354166" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">18.2.</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T3">Deep Linking using URL Scheme</text:span><text:span text:style-name="T27"> 53</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T23"><text:a xlink:type="simple" xlink:href="#_Toc228354167" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">18.3.</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T3">Deferred Deep Linking – Using Branch</text:span><text:span text:style-name="T27"> 54</text:span></text:a></text:p>
    </text:index-body>
