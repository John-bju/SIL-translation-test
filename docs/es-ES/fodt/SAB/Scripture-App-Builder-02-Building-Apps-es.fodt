    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P71" text:outline-level="2"><text:bookmark-start text:name="_Toc233871385"/>Introduction Styles<text:bookmark-end text:name="_Toc233871385"/></text:h>
   <text:p text:style-name="Standard">These are used for the various standard formatting requirements for introductions. Most of these styles relate directly to the <text:span text:style-name="T51">Introductions</text:span> styles in the <text:a xlink:type="simple" xlink:href="https://ubsicap.github.io/usfm/usfm3.0.3/index.html" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">USFM documentation</text:span></text:a>.</text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:h text:style-name="P71" text:outline-level="2"><text:bookmark text:name="_Study_Bible_Styles"/><text:bookmark-start text:name="_Toc233871386"/>Study Bible Styles<text:bookmark-end text:name="_Toc233871386"/></text:h>
   <text:p text:style-name="Standard">These are used for the various formatting requirements for <text:a xlink:type="simple" xlink:href="#_The_Study_Bible" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">study Bible notes</text:span></text:a>, defined using \im and \ip markers. Turning on the notes feature causes a horizontal block to be displayed with a title and + symbol for expanding the block.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame40" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="313" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table125" table:style-name="Table125">
