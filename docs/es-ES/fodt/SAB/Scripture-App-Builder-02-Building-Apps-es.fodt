        </table:table-cell>
        <table:table-cell table:style-name="Table58.B5" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">ui.bottom-navigation.item.icon</text:span></text:p>
