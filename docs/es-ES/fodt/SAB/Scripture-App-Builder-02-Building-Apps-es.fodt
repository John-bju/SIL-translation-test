     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T117"><text:a xlink:type="simple" xlink:href="#_Toc233871028" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.1.3.<text:span text:style-name="T122"> </text:span>Other SFM text files<text:span text:style-name="T132"> 17</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T117"><text:a xlink:type="simple" xlink:href="#_Toc233871029" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.1.4.<text:span text:style-name="T122"> </text:span>Word documents (.docx)<text:span text:style-name="T132"> 17</text:span></text:a></text:p>
