     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T115"><text:a xlink:type="simple" xlink:href="#_Toc233871024" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.<text:span text:style-name="T120"> </text:span>Preparing content for your app<text:span text:style-name="T132"> 15</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T116"><text:a xlink:type="simple" xlink:href="#_Toc233871025" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.1.<text:span text:style-name="T121"> </text:span><text:span text:style-name="T39">Preparing text</text:span><text:span text:style-name="T132"> 15</text:span></text:a></text:p>
