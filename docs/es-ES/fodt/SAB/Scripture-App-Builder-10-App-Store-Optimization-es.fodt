   <text:p text:style-name="P37" loext:marker-style-name="T3"/>
   <text:p text:style-name="P3">You are free to print this manual for personal use and for training workshops.</text:p>
   <text:p text:style-name="P3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P3">The latest version is available at</text:p>
   <text:p text:style-name="P3"><text:a xlink:type="simple" xlink:href="http://software.sil.org/scriptureappbuilder/resources/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">http://software.sil.org/scriptureappbuilder/resources/</text:span></text:a> </text:p>
   <text:p text:style-name="P3"/>
   <text:p text:style-name="P3" loext:marker-style-name="T3"><text:span text:style-name="T3">and on the Help menu of Scripture App Builder.</text:span><text:span text:style-name="T3"/></text:p>
