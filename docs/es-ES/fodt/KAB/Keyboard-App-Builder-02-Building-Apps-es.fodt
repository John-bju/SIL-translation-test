      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:custom-shape text:anchor-type="char" draw:z-index="2" draw:name="Shape14" draw:style-name="gr2" draw:text-style-name="P70" svg:width="0.5941in" svg:height="0.3335in" svg:x="0.2646in" svg:y="2.2839in">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/><draw:frame draw:style-name="fr2" draw:name="Image13" text:anchor-type="as-char" svg:width="2.2571in" svg:height="4.7429in" draw:z-index="0"><draw:image xlink:href="KAB02/13.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/><draw:frame draw:style-name="fr2" draw:name="Image14" text:anchor-type="as-char" svg:width="2.2555in" svg:height="4.7417in" draw:z-index="0"><draw:image xlink:href="KAB02/14.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T17"><text:soft-page-break/></text:p>
   <text:p text:style-name="P40" loext:marker-style-name="T17"/>
   <text:p text:style-name="P26" loext:marker-style-name="T3"><text:s/></text:p>
   <text:p text:style-name="P67" loext:marker-style-name="T5"><text:span text:style-name="T5">Change Keyboard</text:span><text:span text:style-name="T5"/></text:p>
   <text:p text:style-name="P67" loext:marker-style-name="T3"><text:span text:style-name="T3">When the user taps the </text:span><text:span text:style-name="T9">Change Keyboard</text:span><text:span text:style-name="T3"> button, the phone’s </text:span><text:span text:style-name="T9">Change Keyboard</text:span><text:span text:style-name="T3"> dialog box will appear. They need to tap on the new keyboard to make it the current one.</text:span></text:p>
   <text:p text:style-name="P31" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P42" loext:marker-style-name="T17"/>
   <text:p text:style-name="P23" loext:marker-style-name="T17"><draw:custom-shape text:anchor-type="char" draw:z-index="4" draw:name="Shape17" draw:style-name="gr2" draw:text-style-name="P70" svg:width="0.5941in" svg:height="0.3335in" draw:transform="rotate (-3.14159265358979) translate (5.55625in 2.80486111111111in)">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:text-areas="0 ?f0 ?f5 ?f2" draw:type="right-arrow" draw:modifiers="16200 5400" draw:enhanced-path="M 0 ?f0 L ?f1 ?f0 ?f1 0 21600 10800 ?f1 21600 ?f1 ?f2 0 ?f2 Z N">
      <draw:equation draw:name="f0" draw:formula="$1 "/>
      <draw:equation draw:name="f1" draw:formula="$0 "/>
      <draw:equation draw:name="f2" draw:formula="21600-$1 "/>
      <draw:equation draw:name="f3" draw:formula="21600-?f1 "/>
      <draw:equation draw:name="f4" draw:formula="?f3 *?f0 /10800"/>
      <draw:equation draw:name="f5" draw:formula="?f1 +?f4 "/>
      <draw:equation draw:name="f6" draw:formula="?f1 *?f0 /10800"/>
      <draw:equation draw:name="f7" draw:formula="?f1 -?f6 "/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="21600" draw:handle-range-y-minimum="0" draw:handle-range-y-maximum="10800" draw:handle-position="$0 $1"/>
     </draw:enhanced-geometry>
