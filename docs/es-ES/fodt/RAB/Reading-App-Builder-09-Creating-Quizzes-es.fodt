     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951951" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">1.<text:span text:style-name="T14"> </text:span>Quiz files<text:span text:style-name="T15"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951952" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.<text:span text:style-name="T14"> </text:span>Questions and answers in words<text:span text:style-name="T15"> 6</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951953" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.<text:span text:style-name="T14"> </text:span>Question with picture, and answers in words<text:span text:style-name="T15"> 7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951954" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">4.<text:span text:style-name="T14"> </text:span>Question in words, and answers in pictures<text:span text:style-name="T15"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951955" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">5.<text:span text:style-name="T14"> </text:span>Question and answer in words, with audio<text:span text:style-name="T15"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951956" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">6.<text:span text:style-name="T14"> </text:span>Question and answer in words, with explanations<text:span text:style-name="T15"> 10</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951957" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/>7.<text:span text:style-name="T14"> </text:span>Question and answer in words, with explanations and audio<text:span text:style-name="T15"> 11</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="#_Toc89951958" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">8.<text:span text:style-name="T14"> </text:span>Sound effects for right and wrong answers<text:span text:style-name="T15"> 12</text:span></text:a></text:p>
