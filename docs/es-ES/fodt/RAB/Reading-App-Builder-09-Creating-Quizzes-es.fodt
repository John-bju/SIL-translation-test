   </text:table-of-content>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P13" loext:marker-style-name="T5"/>
   <text:h text:style-name="P4" text:outline-level="1"><text:bookmark-start text:name="_Toc89893446"/><text:bookmark-start text:name="_Toc89951951"/>Quiz files<text:bookmark-end text:name="_Toc89893446"/><text:bookmark-end text:name="_Toc89951951"/> </text:h>
   <text:p text:style-name="P15" loext:marker-style-name="T16"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">Quizzes are developed using </text:span><text:span text:style-name="T10">text files </text:span><text:span text:style-name="T9">(.txt), created with a text editor such as </text:span><text:span text:style-name="T10">Notepad</text:span><text:span text:style-name="T9">. Do not use a word processor such as Word or LibreOffice.</text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T9">A quiz file contains :</text:span><text:span text:style-name="T9"/></text:p>
   <text:list text:style-name="WWNum2">
    <text:list-item>
     <text:p text:style-name="P6" loext:marker-style-name="T9"><text:span text:style-name="T9">Some information at the beginning: ID, name, short name;</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6" loext:marker-style-name="T9"><text:span text:style-name="T9">Questions: at least one question (there is no limit to the number of questions).</text:span><text:span text:style-name="T9"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T9"><text:span text:style-name="T17"><text:line-break/></text:span><text:span text:style-name="T9">In Reading App Builder, you add quiz files as you do with other kinds of books on the </text:span><text:span text:style-name="T10">Books </text:span><text:span text:style-name="T9">page. Click </text:span><text:span text:style-name="T10">Add Book... </text:span><text:span text:style-name="T9">and select the file.<text:line-break/></text:span></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Codes to use</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T19"><text:soft-page-break/></text:p>
   <text:p text:style-name="P30" loext:marker-style-name="T33"><text:span text:style-name="T21">\id </text:span><text:span text:style-name="T22">abc </text:span><text:span text:style-name="T33">Quiz ID</text:span></text:p>
   <text:p text:style-name="P30" loext:marker-style-name="T33"><text:span text:style-name="T21">\quiz </text:span><text:span text:style-name="T33">Specify that this file is a quiz</text:span></text:p>
   <text:p text:style-name="P30" loext:marker-style-name="T33"><text:span text:style-name="T21">\qn</text:span><text:span text:style-name="T23"> xyz</text:span><text:span text:style-name="T33"> Quiz Name</text:span></text:p>
   <text:p text:style-name="P30" loext:marker-style-name="T24"><text:span text:style-name="T21">\qs </text:span><text:span text:style-name="T22">hjk </text:span><text:span text:style-name="T33">Short name or abbreviation</text:span></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T20"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T18"><text:span text:style-name="T18">Example 1</text:span><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P16" loext:marker-style-name="T19"><text:soft-page-break/></text:p>
   <text:p text:style-name="P31" loext:marker-style-name="T23"><text:span text:style-name="T21">\id </text:span><text:span text:style-name="T23">QUIZ1</text:span></text:p>
   <text:p text:style-name="P31" loext:marker-style-name="T21"><text:span text:style-name="T21">\quiz</text:span><text:span text:style-name="T21"/></text:p>
