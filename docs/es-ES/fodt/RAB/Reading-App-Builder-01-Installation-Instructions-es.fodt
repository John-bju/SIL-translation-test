      <text:p text:style-name="Standard" loext:marker-style-name="T27"><text:span text:style-name="T27">Word documents</text:span><text:span text:style-name="T27"/></text:p>
      <text:p text:style-name="P37" loext:marker-style-name="T27"><text:span text:style-name="T27">or Bloom books</text:span></text:p>
