   <text:list text:continue-numbering="true" text:style-name="WWNum12">
    <text:list-item>
     <text:p text:style-name="P389" loext:marker-style-name="T18"><text:span text:style-name="T18">Type the style name into the dialog box and press OK.</text:span><text:span text:style-name="T18"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P236" loext:marker-style-name="T15"><text:span text:style-name="T15">Do this for c, s, q1 and q2.</text:span><text:span text:style-name="T15"/></text:p>
   <text:list xml:id="list164739239714576" text:continue-list="list164740976083870" text:style-name="WWNum11">
    <text:list-item>
     <text:p text:style-name="P386" loext:marker-style-name="T15"><text:span text:style-name="T15">Apply the above styles to all the page numbers, song titles and the lines of the song lyrics. </text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P236" loext:marker-style-name="T15"><text:span text:style-name="T15">To apply a style:</text:span><text:span text:style-name="T15"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P390" loext:marker-style-name="T15"><text:span text:style-name="T15">Select the line/paragraph to which you want to apply the style.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P390" loext:marker-style-name="T15"><text:span text:style-name="T15">Click on the down arrow to the right of the styles ribbon.</text:span><text:span text:style-name="T15"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P391" loext:marker-style-name="T15"><draw:custom-shape text:anchor-type="char" draw:z-index="8" draw:name="AutoShape 149" draw:style-name="gr8" draw:text-style-name="P417" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.17590197846133) translate (4.10833333333333in 1.53125in)">
