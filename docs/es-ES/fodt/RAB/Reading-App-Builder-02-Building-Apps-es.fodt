    </draw:custom-shape><draw:frame draw:style-name="fr4" draw:name="Picture 12" text:anchor-type="as-char" svg:width="2.0252in" svg:height="3.6in" draw:z-index="0"><draw:image xlink:href="RAB02/8.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>P659#yIS1</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P80" loext:marker-style-name="T36"/>
   <text:p text:style-name="P95" loext:marker-style-name="T36"><text:span text:style-name="T36">When you do this, you will probably get a message “Allow USB Debugging?” Tap </text:span><text:span text:style-name="T48">OK</text:span><text:span text:style-name="T36">.</text:span></text:p>
   <text:p text:style-name="P93" loext:marker-style-name="T36"><draw:custom-shape text:anchor-type="char" draw:z-index="194" draw:name="AutoShape 160" draw:style-name="gr1" draw:text-style-name="P417" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.61180555555556in 2.15902777777778in)">
     <svg:desc>P662#y1</svg:desc>
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
