      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard">For the reference popup title, and actual reference background, see <text:a xlink:type="simple" xlink:href="#_Footer_Styles_(with" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Footer Styles (with reference styles)</text:span></text:a>.</text:p>
   <text:h text:style-name="P67" text:outline-level="2"><text:bookmark-start text:name="_Toc233660276"/>Illustrations and Video Styles<text:bookmark-end text:name="_Toc233660276"/></text:h>
   <text:p text:style-name="Standard">These are used for formatting the parts of the app screen used for displaying images or videos. This includes formatting the captions and video titles.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame30" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="208" loext:may-break-between-pages="true">
