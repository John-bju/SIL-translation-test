         <text:p text:style-name="P9" loext:marker-style-name="T47"><text:span text:style-name="T47">To modify this…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.A1" office:value-type="string">
         <text:p text:style-name="P9" loext:marker-style-name="T47"><text:span text:style-name="T47">Adjust this style…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table93.1">
        <table:table-cell table:style-name="Table93.A2" office:value-type="string">
         <text:p text:style-name="P9" loext:marker-style-name="T36"><text:span text:style-name="T36">The cross reference popup body including background color</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table93.A2" office:value-type="string">
