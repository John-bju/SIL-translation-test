   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">See </text:span><text:a xlink:type="simple" xlink:href="#_Appendix_3:_SAB" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Appendix 3</text:span></text:span></text:a><text:span text:style-name="T36"> for a comprehensive list of styles and explanations.</text:span></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:soft-page-break/><text:span text:style-name="T36">RAB includes a helpful search feature to aid in finding the various features and settings. Click on </text:span><text:span text:style-name="T47">Find…</text:span><text:span text:style-name="T36"> at the right side of the RAB tool bar. See also </text:span><text:a xlink:type="simple" xlink:href="#_Find_Settings_and" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T36">Find Settings and Features…</text:span></text:span></text:a></text:p>
   <text:p text:style-name="P7" loext:marker-style-name="T36"><text:s/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T36"><text:span text:style-name="T36">To change RAB’s interface language, click on the language button at the far right side of the RAB tool bar. See the example below:</text:span><text:span text:style-name="T36"/></text:p>
   <text:p text:style-name="P179" loext:marker-style-name="T36"><draw:frame draw:style-name="fr9" draw:name="Picture 1986647598" text:anchor-type="char" svg:x="1.6709in" svg:y="0.1071in" svg:width="2.6354in" svg:height="1.9409in" draw:z-index="193"><draw:image xlink:href="RAB02/3.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>P95#y1</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P179" loext:marker-style-name="T36"/>
   <text:p text:style-name="P228" loext:marker-style-name="T36"><text:span text:style-name="T36">The RAB software interface has four main areas: The </text:span><text:span text:style-name="T94">Menu bar</text:span><text:span text:style-name="T36">, the </text:span><text:span text:style-name="T95">Tool bar</text:span><text:span text:style-name="T36">, the </text:span><text:span text:style-name="T101">Project menu area (tree view)</text:span><text:span text:style-name="T36"> and the </text:span><text:span text:style-name="T102">Configuration </text:span><text:span text:style-name="T36">area. These will be referenced in the various chapters.</text:span></text:p>
   <text:p text:style-name="P183" loext:marker-style-name="T36"/>
   <text:p text:style-name="P143" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 22" text:anchor-type="as-char" svg:width="5.9791in" svg:height="3.9898in" draw:z-index="0"><draw:image xlink:href="RAB02/4.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
     <svg:desc>P99#yIS1</svg:desc>
    </draw:frame></text:p>
   <text:p text:style-name="P222" loext:marker-style-name="T91"/>
   <text:p text:style-name="P7" loext:marker-style-name="T36"/>
   <text:p text:style-name="P229" loext:marker-style-name="T39"/>
