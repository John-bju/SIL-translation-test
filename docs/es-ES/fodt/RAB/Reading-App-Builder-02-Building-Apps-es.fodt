         <text:p text:style-name="P9" loext:marker-style-name="T36"><text:span text:style-name="T36">Section reference range – shows what verses this section applies to</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table88.A2" office:value-type="string">
         <text:p text:style-name="P9" loext:marker-style-name="T36"><text:span text:style-name="T36">div.sr</text:span></text:p>
        </table:table-cell>
