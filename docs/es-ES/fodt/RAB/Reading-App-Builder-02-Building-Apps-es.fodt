     <text:p text:style-name="P389" loext:marker-style-name="T15"><text:span text:style-name="T15">Then select </text:span><text:span text:style-name="T22">Create a style</text:span><text:span text:style-name="T15"> from the menu that appears.</text:span></text:p>
    </text:list-item>
   </text:list>
