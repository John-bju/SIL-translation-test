   <text:h text:style-name="P60" text:outline-level="2"><text:bookmark-start text:name="_Toc233660269"/>Heading Styles<text:bookmark-end text:name="_Toc233660269"/></text:h>
   <text:p text:style-name="Standard">Most of these header styles relate directly to styles in the <text:a xlink:type="simple" xlink:href="https://ubsicap.github.io/usfm/usfm3.0.3/index.html" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">USFM documentation</text:span></text:a>.</text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame24" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="202" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table88" table:style-name="Table88">
